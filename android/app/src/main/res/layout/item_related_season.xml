<?xml version="1.0" encoding="utf-8"?>
<!-- 「相关」列表项：卡片 + 圆角封面 + 标题/集数 + 当前标记。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:minHeight="92dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/related_cover"
        android:layout_width="52dp"
        android:layout_height="70dp"
        android:background="@drawable/bg_cover_rounded"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/related_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/related_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip_type"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/app_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/related_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_chip_selected"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="当前"
        android:textColor="@color/app_on_bg"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
