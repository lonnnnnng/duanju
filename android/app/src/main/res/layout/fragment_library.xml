<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- 顶栏：搜索胶囊占满整行（点击进入搜索页） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <LinearLayout
            android:id="@+id/search_pill"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_home_search_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="搜索短剧、漫剧、演员"
                android:textColor="@color/app_on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- long: 完整筛选入口独立于横向滚动，快捷分类再多也不会把入口挤出屏幕。 -->
    <LinearLayout
        android:id="@+id/filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/filter_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filter_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:paddingVertical="0dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/filter_entry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_home_filter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxWidth="160dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:minWidth="64dp"
            android:paddingHorizontal="12dp"
            android:text="@string/home_filter"
            android:textColor="@color/home_filter_foreground"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 内容区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="@dimen/home_bottom_clearance"
                android:scrollbars="none" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- long: 分页反馈独立于列表滚动，始终显示在悬浮导航上方，避免页脚动画被菜单盖住。 -->
        <LinearLayout
            android:id="@+id/home_pagination_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/home_bottom_clearance"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_footer_hint"
            android:elevation="4dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/home_pagination_progress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/home_pagination_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在加载更多…"
                android:textColor="@color/app_on_bg"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/home_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/home_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/home_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/app_on_surface_variant"
                android:textSize="13sp" />

            <Button
                android:id="@+id/home_retry"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="重试"
                android:textColor="@color/accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="这里空空如也\n换个分类看看吧"
            android:textColor="@color/app_on_surface_variant"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
