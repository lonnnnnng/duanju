<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/home_filter"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/filter_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/home_filter_clear"
            android:textColor="@color/home_filter_selected_foreground"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/filter_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:text="@string/home_filter_current_default"
        android:textColor="@color/app_on_surface_variant"
        android:textSize="13sp" />

    <!-- long: 分组用于查找分类，所有分组共享一个选择，避免被误认为可组合条件。 -->
    <LinearLayout
        android:id="@+id/filter_body"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/filter_group_scroll"
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:background="@color/home_filter_group_background"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filter_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp" />
        </ScrollView>

        <ScrollView
            android:id="@+id/filter_item_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filter_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
