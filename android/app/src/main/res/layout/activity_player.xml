<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- 顶栏：返回 + 剧名（全屏时隐藏，改用播放器内的悬浮返回栏） -->
    <com.duanju.player.TopBar
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/app_bg_elevated"
        android:paddingHorizontal="6dp" />

    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF000000">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:controller_layout_id="@layout/duanju_controller"
            app:resize_mode="fit" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/fullscreen_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_bottom_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="24dp"
            android:paddingBottom="10dp"
            android:paddingHorizontal="6dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/fullscreen_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_glass_button"
                android:contentDescription="返回"
                android:padding="9dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/fullscreen_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 状态行：集数进度 + 自动连播开关（原型：11sp 暗灰 + 珊瑚开关） -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 集数进度 + 清晰度/文件大小 + 下一集预取状态 -->
            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="准备播放"
                android:textColor="@color/nav_icon_inactive"
                android:textSize="11sp" />

            <Switch
                android:id="@+id/auto_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="0dp"
                android:text="自动连播"
                android:textColor="@color/nav_icon_inactive"
                android:textSize="11sp"
                android:thumb="@drawable/switch_thumb"
                android:track="@drawable/switch_track" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/episode_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tab_episodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="2dp"
                    android:paddingVertical="3dp"
                    android:text="选集"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />

                <View
                    android:id="@+id/tab_episodes_indicator"
                    android:layout_width="20dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_tab_indicator" />
            </LinearLayout>

            <TextView
                android:id="@+id/tab_related"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:paddingHorizontal="2dp"
                android:paddingVertical="3dp"
                android:text="相关"
                android:textColor="@color/app_on_surface_variant"
                android:textSize="15sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/episode_group_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nav_icon_inactive"
                android:textSize="11sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/group_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/episode_groups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episode_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingBottom="8dp" />

        <!-- 「相关」：同一部剧的其他季，紧凑列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/related_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/related_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp"
            android:text="加载中…"
            android:textColor="@color/app_on_surface_variant"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
