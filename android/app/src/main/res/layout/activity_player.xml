<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- long: 普通播放返回栏与状态栏共用页面底色；全屏时由视频内悬浮返回栏接管。 -->
    <com.duanju.player.TopBar
        android:id="@+id/player_top_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/app_bg"
        android:paddingHorizontal="6dp" />

    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF000000">

        <!-- long: 关闭分两阶段的显隐，按钮与进度条随同一个控制器同时收起，小窗和全屏行为一致。 -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:animation_enabled="false"
            app:controller_layout_id="@layout/duanju_controller"
            app:resize_mode="fit" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <!-- long: 取流或解码失败时在视频内保留恢复入口，全屏也能直接重试本集。 -->
        <LinearLayout
            android:id="@+id/playback_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:background="@drawable/bg_playback_error"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playback_unavailable"
                android:textColor="@color/player_icon"
                android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/playback_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/playback_retry"
                android:textSize="13sp"
                android:textColor="@color/choice_selected_foreground"
                app:backgroundTint="@color/choice_selected_background"
                app:cornerRadius="999dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fullscreen_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_bottom_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingHorizontal="6dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/fullscreen_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_player_glass"
                android:contentDescription="@string/exit_fullscreen"
                android:padding="14dp"
                android:src="@drawable/ic_back"
                app:tint="@color/player_icon" />

            <!-- long: 全屏顶栏覆盖在视频与黑色遮罩上，文字固定白色，避免浅色主题的深色正文在此不可读。 -->
            <TextView
                android:id="@+id/fullscreen_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/player_icon"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 状态行：本集清晰度/大小/进度 + 下一集状态（11sp 暗灰，自动连播开关已移到 tab 行） -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 集数进度 + 清晰度/文件大小 + 下一集预取状态 -->
            <!-- 固定两行高度：文案从一行变两行时布局不能跳（下方选集面板会被顶着上下晃）。 -->
            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:lines="2"
                android:maxLines="2"
                android:minLines="2"
                android:text="准备播放"
                android:textColor="@color/app_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/episode_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tab_episodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="2dp"
                    android:paddingVertical="3dp"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:gravity="center"
                    android:text="选集"
                    android:textColor="@color/app_on_bg"
                    android:textSize="15sp" />

                <View
                    android:id="@+id/tab_episodes_indicator"
                    android:layout_width="20dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_tab_indicator" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tab_related"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="2dp"
                    android:paddingVertical="3dp"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:gravity="center"
                    android:text="相关"
                    android:textColor="@color/app_on_surface_variant"
                    android:textSize="15sp" />

                <View
                    android:id="@+id/tab_related_indicator"
                    android:layout_width="20dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_tab_indicator"
                    android:visibility="gone" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 自动连播开关放到 tab 行最右侧，状态行只留文案。 -->
            <Switch
                android:id="@+id/auto_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="自动连播"
                android:textColor="@color/app_on_surface_variant"
                android:textSize="11sp"
                android:thumb="@drawable/switch_thumb"
                android:track="@drawable/switch_track" />

        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/group_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/episode_groups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episode_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingBottom="8dp" />

        <!-- 「相关」：同一部剧的其他季，紧凑列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/related_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/related_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp"
            android:text="加载中…"
            android:textColor="@color/app_on_surface_variant"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
