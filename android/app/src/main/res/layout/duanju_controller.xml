<?xml version="1.0" encoding="utf-8"?>
<!-- 自定义 Media3 控制器：毛玻璃圆钮 + 渐变进度条 + 倍速/静音/全屏。 -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <View android:id="@id/exo_controls_background"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:background="@color/exo_black_opacity_60"/>

  <!-- long: 进度与工具按钮横向共用一行，背景只占 48dp，避免小窗和全屏出现两层底栏遮挡画面。 -->
  <LinearLayout android:id="@id/exo_bottom_bar"
      android:layout_width="match_parent"
      android:layout_height="@dimen/exo_styled_bottom_bar_height"
      android:layout_gravity="bottom"
      android:background="@color/exo_bottom_bar_background"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="6dp"
      android:layoutDirection="ltr">

    <LinearLayout android:id="@id/exo_time"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layoutDirection="ltr">

      <TextView android:id="@id/exo_position"
          style="@style/ExoStyledControls.TimeText.Position"
          android:paddingLeft="2dp"
          android:paddingRight="2dp"
          android:singleLine="true"
          android:textSize="11sp"/>

      <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress"
          style="@style/ExoStyledControls.TimeBar"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          app:bar_gravity="center"/>

      <TextView android:id="@id/exo_duration"
          style="@style/ExoStyledControls.TimeText.Duration"
          android:paddingLeft="2dp"
          android:paddingRight="2dp"
          android:singleLine="true"
          android:textSize="11sp"/>

    </LinearLayout>

    <LinearLayout android:id="@id/exo_basic_controls"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layoutDirection="ltr">

      <androidx.appcompat.widget.AppCompatButton android:id="@+id/custom_speed"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_gravity="center_vertical"
          android:background="@drawable/bg_player_compact_button"
          android:insetTop="0dp"
          android:insetBottom="0dp"
          android:minWidth="0dp"
          android:padding="0dp"
          android:text="1.0×"
          android:textColor="@color/player_icon"
          android:textSize="11sp"/>

      <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/custom_mute"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_gravity="center_vertical"
          android:background="@drawable/bg_player_compact_button"
          android:contentDescription="静音"
          android:insetTop="0dp"
          android:insetBottom="0dp"
          android:padding="14dp"
          android:scaleType="fitCenter"
          android:src="@drawable/ic_volume_on"/>

      <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/custom_fullscreen"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_gravity="center_vertical"
          android:background="@drawable/bg_player_compact_button"
          android:contentDescription="全屏"
          android:insetTop="0dp"
          android:insetBottom="0dp"
          android:padding="14dp"
          android:scaleType="fitCenter"
          android:src="@drawable/ic_fullscreen_enter"/>

    </LinearLayout>

  </LinearLayout>

  <!-- long: 五槽等宽分散；保留水平内边距，让 Media3 将中央行宽与播放器宽区分开，避免误判为简化布局并隐藏底栏。 -->
  <LinearLayout
      android:id="@id/exo_center_controls"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:background="@android:color/transparent"
      android:gravity="center"
      android:baselineAligned="false"
      android:paddingHorizontal="8dp"
      android:paddingVertical="4dp"
      android:clipToPadding="false"
      android:layoutDirection="ltr">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_weight="1"
        android:gravity="center">

      <ImageButton android:id="@+id/custom_prev"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:layout_gravity="center"
          android:background="@drawable/bg_player_glass"
          android:contentDescription="上一集"
          android:padding="14dp"
          android:src="@drawable/ic_skip_previous"/>
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_weight="1"
        android:gravity="center">

      <include
          layout="@layout/control_rewind_15"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:layout_gravity="center" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_weight="1"
        android:gravity="center">

      <ImageButton android:id="@id/exo_play_pause"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:layout_gravity="center"
          android:background="@drawable/bg_player_glass"
          android:contentDescription="播放/暂停"
          android:padding="6dp"
          android:scaleType="fitCenter" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_weight="1"
        android:gravity="center">

      <include
          layout="@layout/control_forward_15"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:layout_gravity="center" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_weight="1"
        android:gravity="center">

      <ImageButton android:id="@+id/custom_next"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:layout_gravity="center"
          android:background="@drawable/bg_player_glass"
          android:contentDescription="下一集"
          android:padding="14dp"
          android:src="@drawable/ic_skip_next"/>
    </FrameLayout>

  </LinearLayout>

</merge>
