{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7467591654224972825","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/68645a496eac27ff47fbcdf5cb93815d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164578&x-signature=dk0pG8%2BtuI%2FewRh0VHVeyRZi6lY%3D","duration":5000,"title":"缚心","video_desc":"顾玥岚乃是京都首富顾家大小姐，她善良坚韧，敢爱敢恨，与司晨结婚6年，却没想到司晨狼子野心，为了得到顾家财产，不但设计害死了顾玥岚父母，还让情人楚歌取代了她的人生。顾玥岚得知竟然是自己的丈夫谋害自己，震惊又愤怒。","series_id":"7466393282210188312","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235617DFC781804B35B8A8A479\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7466393282210188312\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.04208773002028465,\\\"absolute_staytime\\\":0.13639673590660095,\\\"stream_ctr\\\":0.02823438122868538,\\\"like\\\":0.060086652636528015,\\\"staytime_stream\\\":1.202856421470642,\\\"normalized_duration\\\":0.9302837252616882,\\\"finish\\\":0.04535258188843727}\"}","recommend_group_id":"7466393282210188312","play_cnt":68774,"book_exist":false,"copyright":"树下的椰子","sub_title":"都市·逆袭翻身","score":"8.1","use_video_model":true,"episode_cnt":62,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=0&source=det