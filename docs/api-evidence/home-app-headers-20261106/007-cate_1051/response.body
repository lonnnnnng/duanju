sign.fqnovelpic.com/novel-pic/b1ee5f32c478ce92103c84cd893a8f3c~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164578&x-signature=6T8ZKjNxta%2FSAxUvt4FBw1pAiWE%3D","duration":6241,"title":"我妈居然是台球女王","video_desc":"60岁的余锦琴，曾是世界台球冠军，为避世仇隐于城中村，与儿子罗晨相依为命。不料，罗晨在赌球中输掉她丈夫的50万救命钱。为追回钱款并查明真相，余锦琴决定亲自出手。她凭借高超球技，在与陈宏志等人的赌局中连胜，却意外引出了二十年前的恩怨——师弟叶志鹏投靠倭国人小谷冰川，害死师傅，如今更是胁迫她为倭国效力。余锦琴坚决不从，由此展开了一系列台球对决。","series_id":"7526857024169069630","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235617DFC781804B35B8A8A479\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7526857024169069630\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.034100428223609924,\\\"normalized_duration\\\":0.9352938532829285,\\\"collect\\\":0.05500529333949089,\\\"staytime_stream\\\":1.464234709739685,\\\"absolute_staytime\\\":0.19385886192321777,\\\"stream_ctr\\\":0.02085377834737301,\\\"like\\\":0.08632347732782364}\"}","recommend_group_id":"7526857024169069630","play_cnt":23306,"book_exist":false,"copyright":"湖南六翼影视","sub_title":"都市·都市日常","score":"8.2","use_video_model":true,"episode_cnt":63,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5078,\"name\":\"都市日常\",\"schema\":\"dragon8662://categorySearch?categoryId=5078&categoryName=都市日常&genreType=130&gender=0&source=detail\"},{\"category_id\":5165,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5165&categoryName=隐藏大佬&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=