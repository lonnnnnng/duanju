ge?lk3s=ae45642e&x-expires=1799164578&x-signature=KSjFtvcfqrqq6N7z7jpxUWZk8os%3D","duration":13446,"title":"大明王朝，我为大明续运三百年","video_desc":"现代人叶轩穿越成登基23天的崇祯，绝境开局。他收服猛人方正化，秘调秦良玉夺兵权；对魏忠贤借力打力，命其查勋贵家底充实内帑。清理朝堂、颁永不加赋令、凌迟客氏、敲打东林党，召李邦华整顿兵政。微服查灾情，颁永不加赋令稳民心。面对京营示威、阉党掣肘，他步步为营，于刀尖上起舞，誓为大明逆天改命！","series_id":"7648520552428096536","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235617DFC781804B35B8A8A479\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7648520552428096536\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.27768996357917786,\\\"normalized_duration\\\":1.1487470865249634,\\\"stream_ctr\\\":0.03629563748836517,\\\"staytime_stream\\\":1.5660814046859741,\\\"like\\\":0.09138210117816925,\\\"finish\\\":0.025565212592482567,\\\"collect\\\":0.07263670861721039}\"}","recommend_group_id":"7648520552428096536","play_cnt":1270131,"book_exist":false,"copyright":"tomatotv","sub_title":"古装·朝堂权谋","score":"8.2","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5137,\"name\":\"朝堂权谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5137&categoryName=朝堂权谋&genreType=130&gender=1&source=detail\"},{\"category_id\":5139,\"name\":\"古装传奇\",\"schema\":\"dragon8662://categorySearch?categoryId=5139&categoryName=古装传奇&genreType=130&gender=1&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662