cal":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623575726C3D15E84D222B8EAE8\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7417665047268183065\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.0955979824066162,\\\"finish\\\":0.014503581449389458,\\\"collect\\\":0.04146227985620499,\\\"stream_ctr\\\":0.026685679331421852,\\\"absolute_staytime\\\":0.14072643220424652,\\\"normalized_duration\\\":1.1243301630020142,\\\"like\\\":0.06371499598026276}\"}","recommend_group_id":"7417665047268183065","play_cnt":9593,"book_exist":false,"copyright":"心动短剧","sub_title":"都市·超凡逆袭","score":"8.3","use_video_model":true,"episode_cnt":101,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5158,\"name\":\"强者回归\",\"schema\":\"dragon8662://categorySearch?categoryId=5158&categoryName=强者回归&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=1&source=detail\"},{\"category_id\":5346,\"name\":\"战神归来\",\"schema\":\"dragon8662://categorySearch?categoryId=5346&categoryName=战神归来&genreType=130&gender=1&source=detail\"}]","color_dominate":"#301010","horiz_cover":"","sub_title_list":[{"content":"都市","data_type":3},{"content":"1775万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"都市\",\"data_type\":3},