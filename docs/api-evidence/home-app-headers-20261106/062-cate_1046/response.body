{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7561344100088171545","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/6ab25ba4f38c7358b219c8d018773954~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164679&x-signature=%2FNcm9AwdhtMffU0AjMnbgMfkLFg%3D","duration":10191,"title":"厨修在上","video_desc":"叶高仁本身已经是神明，但他却对自己的身份毫无察觉，始终觉得自己做的只是用来饱腹的普通菜品 —— 实际上，是堪比仙丹的神级菜品，能助无数人实现梦寐以求的白日飞升！他始终不知，自己随手做的家常菜，竟有逆天改命的奇效。","series_id":"7561340428230855704","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623575726C3D15E84D222B8EAE8\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7561340428230855704\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":1.167977213859558,\\\"staytime_stream\\\":1.2438526153564453,\\\"collect\\\":0.05184546485543251,\\\"stream_ctr\\\":0.042846985161304474,\\\"absolute_staytime\\\":0.1893681138753891,\\\"like\\\":0.06656919419765472,\\\"finish\\\":0.026759283617138863}\"}","recommend_group_id":"7561340428230855704","play_cnt":183769,"book_exist":false,"copyright":"u书网","sub_title":"玄幻·玄幻仙侠","score":"8.0","use_video_model":true,"episode_cnt":97,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5008,\"name\":\"玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5008&categoryName=玄幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5072,\"name\":\"玄幻仙侠\",\"schema\":\"dragon8662://categorySearch?categoryId=5072&categoryName=玄幻仙侠&genreType=130&gender=1&source=de