group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7631590028254137368","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/747553d8ef2185dcc78697f600321e1d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164679&x-signature=e0PlR%2BE9RNOEavND1fYffzPREiY%3D","duration":10404,"title":"我女仙尊，回来宠孙了","video_desc":"仙界仙尊林羽曦，本是地球人，在60年前意外落江穿越修仙界，历时六万年成就仙尊！她剑开天门后，回到地球，才发现仅过去六十年，而唯一的弟弟林建国不仅还活着，且为林家开枝散叶！林羽曦与弟弟林建国相认，也认下一众子孙后代，却发现自己家族后人都是受尽欺负的废柴。羽曦仙尊表示：“没关系，有我在，无人能欺负我儿孙后辈！你们随意，姑奶奶无敌！” 于是，年轻的姑奶奶，带领着孱弱的林家，一步步成为巅峰世家。","series_id":"7631587986286595097","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623575726C3D15E84D222B8EAE8\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7631587986286595097\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.029760098084807396,\\\"collect\\\":0.0541987344622612,\\\"stream_ctr\\\":0.034327443689107895,\\\"absolute_staytime\\\":0.239383727312088,\\\"normalized_duration\\\":1.1177616119384766,\\\"like\\\":0.08035746961832047,\\\"staytime_stream\\\":1.3452571630477905}\"}","recommend_group_id":"7631587986286595097","play_cnt":425355,"book_exist":false,"copyright":"硕才短剧","sub_title":"都市·都市玄幻","score":"8.1","use_video_model":true,"episode_cnt":79,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5073,\"name\":\"都市玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5073&categoryName=都市玄幻&genreType=130&gender=0&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5157,\"name\":\"天下无敌\",\"schema\":\"dragon8662://categorySearch?categoryId=5157&categoryName=天下无敌&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#402018","horiz_cover":"","sub_title_list":[{"content":"都市","data_type":3},{"content":"3804万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"都市\",\"data_type\":3},{\"content\":\"3804万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7654415327215766552","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/6ec9bd8574b6707c268b154720dce680~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164679&x-signature=Y5T3i%2BHTScyByw5qo4T3yGOD5Vw%3D","duration":9280,"title":"大小姐的无敌神丐","video_desc":"上官家顶美的千金上官冰瑶正在沐浴，但手下人来报告，找到了当年帮过她的小男孩，只是，他现在是个乞丐，上官冰瑶二话没说，当即前往，于是，惊掉路人下巴的一幕发生了，唐不凡正在沿街乞讨，恶棍曹霸作死地招惹他，却不知他来头恐怖，就在他打算惩治曹霸的时候，上官冰瑶却惊艳的出现，并当街下向他求婚！","series_id":"7654413330567662617","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623575726C3D15E84D222B8EAE8\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7654413330567662617\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.031143829226493835,\\\"absolute_staytime\\\":0.21626517176628113,\\\"normalized_duration\\\":1.1509929895401,\\\"staytime_stream\\\":1.2767966985702515,\\\"collect\\\":0.05500529333949089,\\\"stream_ctr\\\":0.028560394421219826,\\\"like\\\":0.07477004826068878}\"}","recommend_group_id":"7654413330567662617","play_cnt":21591,"book_exist":false,"copyright":"湖南六翼影视","sub_title":"都市·都市玄幻","score":"8.2","use_video_model":true,"episode_cnt":101,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5073,\"name\":\"都市玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5073&categoryName=都市玄幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5163,\"name\":\"马甲文\",\"schema\":\"dragon8662://categorySearch?categoryId=5163&categoryName=马甲文&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=