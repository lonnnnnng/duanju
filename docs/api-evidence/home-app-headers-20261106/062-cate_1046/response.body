118528113688","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/abc389b5d499a2e60d7554731a7f154f~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164679&x-signature=ie8gqFNpBPtFmzEzMlUiPPXnpik%3D","duration":9248,"title":"方寸之外","video_desc":"千年修仙者方外为守承诺，化身赘婿隐入天海市赵家，默默庇护高傲任性的赵雨萱三年。三年期满，赵雨萱执意离婚，方外淡然放手，净身出户。失去庇护的赵家迅速崩盘，赵雨萱追悔莫及开启“追夫火葬场”。此时上京方家少主方致远携仇怨降临，欲借商战与联姻阴谋铲除方外。方外不再隐藏实力，以千年修为与通天手段强势回归，一路打脸虐渣、逆转商战，最终清算旧怨、重立家族秩序。","series_id":"7641529979330645016","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623575726C3D15E84D222B8EAE8\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7641529979330645016\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.06853749603033066,\\\"collect\\\":0.04401865601539612,\\\"stream_ctr\\\":0.03149041905999184,\\\"absolute_staytime\\\":0.21291227638721466,\\\"normalized_duration\\\":1.2530567646026611,\\\"staytime_stream\\\":1.1630767583847046,\\\"finish\\\":0.04146227985620499}\"}","recommend_group_id":"7641529979330645016","play_cnt":1046273,"book_exist":false,"copyright":"百川中文","sub_title":"都市·都市玄幻","score":"8.0","use_video_model":true,"episode_cnt":73,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5073,\"name\":\"都市玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5073&categoryName=都市玄幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5165,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5165&categoryName=隐藏大佬&genreType=130&gender=1&source=detail\"},{\"category_id\":5157,\"name\":\"天下无敌\",\"schema\":\"dragon8662://categorySearch?categoryId=5157&categoryName=天下无敌&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"