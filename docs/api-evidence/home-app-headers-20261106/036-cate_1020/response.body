7d769aac661a47de1c2738bf~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164632&x-signature=UJeEDEZl8t3gTw%2FtirKV42B%2BI8o%3D","duration":3464,"title":"白蛇缘生","video_desc":"修炼千年的蛇仙白璃正值突破之际，法力虚弱，被猎人抓住，赶考回家的穷书生许西安用仅剩的半块饼从猎人手里救出了白璃，白璃暗誓必报恩情。许西安是一个穷书生，和妹妹许琳相依为命。为了报恩，白璃化身落难女子，住进许家，用法宝空间的钱财米粮接济许家兄妹，制服了村里强抢许家祖宅的恶霸赵天禄。赵天禄心有不甘，联合和尚法江，下药将白璃收服，却阴差阳错害死了许琳和小青，白璃伤心欲绝，叹人性凉薄......","series_id":"7540678206538386494","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235711055BB001CBC3419375AA\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7540678206538386494\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.6819407343864441,\\\"staytime_stream\\\":0.9752835631370544,\\\"stream_ctr\\\":0.030649477615952492,\\\"like\\\":0.05108273774385452,\\\"absolute_staytime\\\":0.08737902343273163,\\\"finish\\\":0.011687260121107101,\\\"collect\\\":0.040845710784196854}\"}","recommend_group_id":"7540678206538386494","play_cnt":3211,"book_exist":false,"copyright":"青猫剧场","sub_title":"爱情·奇幻爱情","score":"8.3","use_video_model":true,"episode_cnt":46,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5314,\"name\":\"乡村\",\"schema\":\"dragon8662://categorySearch?categoryId=5314&categoryName=乡村&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&ge