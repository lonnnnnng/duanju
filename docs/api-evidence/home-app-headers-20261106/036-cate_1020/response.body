,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7704685116705999896","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/f20afdadc6aa3e95a4cf29d1a9e161d2~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164632&x-signature=d7EoVbMRr5upjS2MK9r3EDOYa8Q%3D","duration":3473,"title":"冷面王爷偏听她","video_desc":"二十二世纪天才医生沈南星，穿成遭继母庶妹下毒、被太子嫌弃退婚的肥胖丑女。绑定医疗系统后，她当众休夫，靠打脸赚积分、解毒瘦身，以绝世医术逆袭京城。一次意外，她救下了身中寒毒的九皇叔慕容渊，从欢喜冤家变成彼此救赎的恋人。面对宅门算计与皇权阴谋，两人携手揭穿毒计、平定危局，最终登上帝后之位，开创医学盛世。","series_id":"7704683508521782297","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235711055BB001CBC3419375AA\",\"rank\":\"6\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7704683508521782297\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.1247248649597168,\\\"stream_ctr\\\":0.05011943355202675,\\\"like\\\":0.049589015543460846,\\\"absolute_staytime\\\":0.1271357387304306,\\\"collect\\\":0.04535258188843727,\\\"finish\\\":0.024053551256656647,\\\"normalized_duration\\\":0.6940339803695679}\"}","recommend_group_id":"7704683508521782297","play_cnt":1015,"book_exist":false,"copyright":"两江新区兴影传媒工作室个体工商户","sub_title":"3D·全61集","score":"8.5","use_video_model":true,"episode_cnt":61,"video_platform":3,"disable_pla