,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7704731448112057368","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/be177738d048e22884513a9b63d3ee07~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164632&x-signature=AVMNJCt0uPMZJDuJ2PqJqIjPmv4%3D","duration":2208,"title":"蛟龙守乡","video_desc":"石怀宁本是被苏知予幼时救下的花斑狸精，遭难后被石守直、温桂婆夫妇收养。为求迎娶苏知予，他依苏景垣的考验，凭自身本事修好危桥、盖起新房、改良大片盐碱地。苏知予看中他本心良善，不因他的异类身份退缩。婚后村里新田缺水，他带领乡亲合力开凿水渠，让田地得以灌溉。后来山洪暴发，石怀宁舍身疏导洪水保护村庄，失联许久，历经波折，最终平安归来，和苏知予在桥头重逢，相守相伴，和一村人安稳度日。","series_id":"7704729894059527230","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235711055BB001CBC3419375AA\",\"rank\":\"5\",\"queue_names\":\"aigc\",\"final_queue_name\":\"aigc\",\"gid\":\"7704729894059527230\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.13323712348937988,\\\"finish\\\":0.09534947574138641,\\\"like\\\":0.05108273774385452,\\\"collect\\\":0.04603390023112297,\\\"normalized_duration\\\":0.6507123708724976,\\\"staytime_stream\\\":1.233121633529663,\\\"stream_ctr\\\":0.04988500103354454}\"}","recommend_group_id":"7704729894059527230","play_cnt":998,"book_exist":false,"copyright":"厦门素屿沐文化传媒有限公司","sub_title":"奇幻·更新至42集","score":"8.4","use_video_model":true,"episode_cnt":42,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5477,\"name\":\"奇幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5477&categoryName=奇幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5496,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5496&categoryName=奇幻爱情&genreType=130&gender=1&source=detail\"},{\"category_id\":5510,\"name\":\"家庭温情\",\"schema\":\"dragon8662://categorySearch?categoryId=5510&categoryName=家庭温情&genreType=130&gender=1&source=detail\"},{\"category_id\":5677,\"name\":\"报恩\",\"schema\":\"dragon8662://categorySearch?categoryId=5677&categ