:[{"content":"爱情","data_type":3},{"content":"3447万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"爱情\",\"data_type\":3},{\"content\":\"3447万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7535298239474453566","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/2b19e73abb3500837368de4e15a0252d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164632&x-signature=GNTWXnX%2BX%2FHtJSe50NPv%2F2Pvo9s%3D","duration":9079,"title":"野火撩过姐姐心","video_desc":"漫画家宋温迎意外进入书中世界，成为小说男主宋祈年身边的恶毒女配。为完成任务回家并获得高额奖金，她需要让性情温和的宋祈年黑化。然而，她逐渐发现宋祈年并非表面那般任人欺凌。任务完成之际，宋温迎却面临残酷真相，现实世界已无她的容身之所。七年后，命运让他们再次重逢，身份反转，宋祈年精心布局设下温柔陷阱，而她也在试探与拉扯中，直面内心。（改编自番茄小说《姐姐哭起来，更漂亮了呢》，作者婳宁她姓沈）","series_id":"7534293303072672830","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235711055BB001CBC3419375AA\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7534293303072672830\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.036220062524080276,\\\"absolute_staytime\\\":0.0833776593208313,\\\"finish\\\":0.0012448437046259642,\\\"normalized_duration\\\"