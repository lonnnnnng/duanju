.4012583494186401,\\\"absolute_staytime\\\":0.1710798293352127,\\\"collect\\\":0.04885777458548546,\\\"normalized_duration\\\":1.0431410074234009}\"}","recommend_group_id":"7510879002026839065","play_cnt":47892,"book_exist":false,"copyright":"tomatotv","sub_title":"爱情·年代爱情","score":"8.3","use_video_model":true,"episode_cnt":76,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5131,\"name\":\"年代爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5131&categoryName=年代爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5170,\"name\":\"穿书\",\"schema\":\"dragon8662://categorySearch?categoryId=5170&categoryName=穿书&genreType=130&gender=0&source=detail\"},{\"category_id\":5095,\"name\":\"先婚后爱\",\"schema\":\"dragon8662://categorySearch?categoryId=5095&categoryName=先婚后爱&genreType=130&gender=0&source=detail\"},{\"category_id\":5191,\"name\":\"空间\",\"schema\":\"dragon8662://categorySearch?categoryId=5191&categoryName=空间&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&source=detail\"}]","color_dominate":"#482008","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"1987万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"爱情\",\"data_type\":3},{\"content\":\"1987万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7475217114601638937","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/2256cd0b70b99bbfb91dde49708d455c~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164599&x-signature=00C7F3SPz6QzfqM5PTZeV0zeV0o%3D","duration":6770,"title":"只需待我如初心","video_desc":"十年前，陆升是富家少爷，风光无限，身边不乏追求者，虞芷溪则是贫穷拮据的校花。陆升对虞芷溪一见钟情，为追求她，包下其奶奶医药费，让她留在自己身边工作。可陆家突遭变故，陆升无奈选择离开。十年后，虞芷溪凭借自身努力成为女总裁，意外发现陆升成了这里的服务员。虞芷溪公司遇危机，陆升带着专利相助，两人过往误会逐渐解开，感情再度升温。","series_id":"7475178956895816766","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235638D3215C16642CF1B02773\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7475178956895816766\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.033589500933885574,\\\"collect\\\":0.04023794084787369,\\\"stream_ctr\\\":0.04833531752228737,\\\"absolute_staytime\\\":0.14980250597000122,\\\"normalized_duration\\\":1.0273447036743164,\\\"like\\\":0.06097517907619476,\\\"staytime_stream\\\":1.2465124130249023}\"}","recommend_group_id":"7475178956895816766","play_cnt":369704,"book_exist":false,"copyright":"文无media","sub_title":"爱情·都市爱情","score":"8.2","use_video_model":true,"episode_cnt":59,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5092,\"name\":\"故人重逢\",\"schema\":\"dragon8662://categorySearch?categoryId=5092&categoryName=故人重逢&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=总裁&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"},{\"category_id\":5371,\"name\":\"熟龄浪漫\",\"schema\":\"dragon8662://categorySearch?categoryId=5371&categoryName=熟龄浪漫&genreType=130&gender=0&source=detail\"}]","color_dominate":"#302820","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"3458万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"爱情\",\"data_type\":3},{\"content\":\"3458万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7472210403951381566","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/26bb10ee1e8c77e1234621f21c97c433~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164599&x-signature=osFzmhGodEQbwnp6Rm%2F2%2Be5Rz7U%3D","duration":4231,"title":"财神请归位","video_desc":"苏念念因失误致霍凌风濒临破产，为弥补过错前去救助却适得其反，还失去特殊技能，被迫限期助其重回巅峰。过程中，两人屡遭挫折，苏念念也对霍凌风渐生情愫。最终，她拼尽全力助霍凌风挽回财产，自己却身份降级。霍凌风找到苏念念坚持追求，两人甜蜜相恋，但苏念念被迫归位。春节时，装扮成财神发糖的苏念念再现，两人故事得以延续，再续前缘。","series_id":"7471878173219638297","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235638D3215C16642CF1B02773\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7471878173219638297\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.02161533571779728,\\\"normalized_duration\\\":0.8066674470901489,\\\"stream_ctr\\\":0.052185554057359695,\\\"like\\\":0.05108273774385452,\\\"collect\\\":0.039048295468091965,\\\"staytime_stream\\\":0.8648616075515747,\\\"absolute_staytime\\\":0.07832605391740799}\"}","recommend_group_id":"7471878173219638297","play_cnt":11541,"book_exist":false,"copyright":"麦芽短剧","sub_title":"爱情·奇幻爱情","score":"8.2","use_video_model":true,"episode_cnt":50,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5119,\"name\":\"轻松搞笑\",\"schema\":\"dragon8662://categorySearch?categoryId=5119&categoryName=轻松搞笑&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=总裁&genreType=130&gender=0&source=detail\"},{\"category_id\":5294,\"name\":\"甜妹\",\"schema\":\"dragon8662://categorySearch?categoryId=5294&categoryName=甜妹&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#581010","horiz_cover":"","sub_title_list":[{"co