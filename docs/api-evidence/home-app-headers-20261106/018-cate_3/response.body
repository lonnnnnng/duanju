ntent_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7472287600481422398","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/4fc83847f11c594922378ef27a28fd9d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164599&x-signature=Mhn%2BXuo8llq14kTuv8pNbNFscj4%3D","duration":7916,"title":"相亲对象是佐罗","video_desc":"林梦云和唐仁在相亲节目上一见倾心，唐仁摘下面具后二人迅速领证结婚，林梦云带着隐藏身份的唐仁回家。林梦云的吸血鬼儿子王伟和儿媳丽丽上门讨钱，认为唐仁要和自己争夺林梦云的鱼档和可能拆迁的房子。林梦云仅剩的棺材本被抢走，唐仁化身冷面阎罗，戴上面具为爱妻讨回正义。林梦云给唐仁送饭，唐仁真实身份濒临泄露。王伟找到恶霸老板张有钱寻求帮助，作为交换，王伟把林梦云卖给张有钱，换取巨额利益。","series_id":"7472276355543993406","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235638D3215C16642CF1B02773\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7472276355543993406\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.07477004826068878,\\\"staytime_stream\\\":1.2102041244506836,\\\"collect\\\":0.049589015543460846,\\\"normalized_duration\\\":1.0712729692459106,\\\"stream_ctr\\\":0.03446390852332115,\\\"absolute_staytime\\\":0.17377392947673798,\\\"finish\\\":0.02931222692131996}\"}","recommend_group_id":"7472276355543993406","play_cnt":991,"book_exist":false,"copyright":"百川","sub_title":"爱情·都市爱情","score":"8.2","use_video_model":true,"episode_cnt":66,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5097,\"name\":\"闪婚\"