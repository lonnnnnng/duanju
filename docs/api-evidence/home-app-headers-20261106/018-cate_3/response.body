{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7511629997912640574","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/0ce2b7f1f4cdd52ee7ffcf442a0b6302~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164599&x-signature=Q8pIbVOWKHrlUx8JFp%2Bjr%2FMNpec%3D","duration":6191,"title":"谁许你恨海情天","video_desc":"许情孕晚期时被确诊患上胃癌，同时丈夫沈牧川先天性心脏病恶化。为保孩子和家人，她走投无路只能和情敌白语柔交易，暴雨夜狠心提离婚。当晚沈牧川气急攻心病发，许情冒死捐心。沈牧川不知，两人分别，他凭借恨意跻身富豪榜。十年后，许情人工心脏濒临报废，凑钱手术时接下婚礼小丑工作，却发现新郎正是沈牧川，殊不知，这一切皆是精心筹划的“重逢”。","series_id":"7511547395637791769","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235638D3215C16642CF1B02773\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7511547395637791769\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.06754669547080994,\\\"absolute_staytime\\\":0.1557699590921402,\\\"finish\\\":0.04535258188843727,\\\"stream_ctr\\\":0.04203132167458534,\\\"staytime_stream\\\":1.2621492147445679,\\\"collect\\\":0.040845710784196854,\\\"normalized_duration\\\":1.0807299613952637}\"}","recommend_group_id":"7511547395637791769","play_cnt":196719,"book_exist":false,"copyright":"树下的椰子","sub_title":"爱情·都市爱情","score":"8.2","use_video_model":true,"episode_cnt":50,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=总裁&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"},{\"category_id\":5342,\"name\":\"都市虐恋\",\"schema\":\"dragon8662://categorySearch?categoryId=5342&categoryName=都市虐恋&genreType=130&gender=0&source=detail\"}]","color_dominate":"#302018","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"2141万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"爱情\",\"data_type\":3},{\"content\":\"2141万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7349072260830874649","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/5af82c65ed9c0df3c72c74637c10e714~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164599&x-signature=LJWI%2FPKym5OGriX3Iu7T24qyJEs%3D","duration":8827,"title":"家产争夺战","video_desc":"谢听晚本是富家千金，却没想到谢家一夜破产，男友顾时宴也在这个时候突然联系不上了，她不得不中断学业回国。三年后，谢听晚成为了顾家三少爷顾明弋最器重的助理，也意外发现前男友竟是老板的二哥。谢听晚被迫卷入顾家三兄弟争夺家产的大战中，而她也因为跟母亲酷似的长相，被顾父当成了弥补遗憾的工具，她在三人间游走盘桓，调查当年真相，可当一切浮出水面，她却不知该作何抉择……","series_id":"7349003812255829054","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235638D3215C16642CF1B02773\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7349003812255829054\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.2925117015838623,\\\"collect\\\":0.04885777458548546,\\\"normalized_duration\\\":1.020470380783081,\\\"stream_ctr\\\":0.05913913995027542,\\\"like\\\":0.06656919419765472,\\\"absolute_staytime\\\":0.15946394205093384,\\\"finish\\\":0.023330770432949066}\"}","recommend_group_id":"7349003812255829054","play_cnt":28583,"book_exist":false,"copyright":"BFWH","sub_title":"爱情·都市爱情","score":"8.2","use_video_model":true,"episode_cnt":88,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5092,\"name\":\"故人重逢\",\"schema\":\"dragon8662://categorySearch?categoryId=5092&categoryName=故人重逢&genreType=130&gender=0&source=detail\"},{\"category_id\":5151,\"name\":\"财产争夺\",\"schema\":\"dragon8662://categorySearch?categoryId=5151&categoryName=财产争夺&genreType=130&gender=0&source=detail\"},{\"category_id\":5296,\"name\":\"古灵精怪\",\"schema\":\"dragon8662://categorySearch?categoryId=5296&categoryName=古灵精怪&genreType=130&gender=0&source=detail\"},{\"category_id\":5280,\"name\":\"欢喜冤家\",\"schema\":\"dragon8662://categorySearch?categoryId=5280&categoryName=欢喜冤家&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&