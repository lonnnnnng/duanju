:0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7572862671645576216","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/fb6d3beac2262c49e7a615172188c66e~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164584&x-signature=zZZ3%2FEurHex%2Bkp90XcSt9Z5ARgY%3D","duration":5740,"title":"督军，你家千金爱吃黑气","video_desc":"被家人遗弃的小多鱼拥有能吞噬“黑气”、治愈他人的特殊能力，最初被心怀恶意的李艳梅以“冲喜”为名送入战家，却意外解除战啸野的离魂之症并唤醒他；此后，战玉轩为争夺战氏集团权力，联合玄术师唐寅布下“九九环煞阵”，期间小多鱼多次吞噬黑气化解危机，还获得何曼妮、苏礼文、管封腾三位港城顶级势力人物的庇护；小多鱼以“白虎开天”之能彻底驱散天空阴煞，战家恢复安稳，小多鱼也正式成为战家重要成员。","series_id":"7572860149270842430","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623562389064D5BD4FA24935EB4\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7572860149270842430\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.05181565880775452,\\\"staytime_stream\\\":1.1742721796035767,\\\"finish\\\":0.0030753694009035826,\\\"like\\\":0.05184546485543251,\\\"collect\\\":0.03514484688639641,\\\"normalized_duration\\\":0.7316156029701233,\\\"absolute_staytime\\\":0.1194329634308815}\"}","recommend_group_id":"7572860149270842430","play_cnt":78225,"book_exist":false,"copyright":"tomatotv","sub_title":"都市·萌宝","score":"8.1","use_video_