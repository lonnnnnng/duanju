279,"title":"我嫁谁，谁才是大哥","video_desc":"前世沈明月替霍沉峰打江山成大嫂，却被妹妹沈明珠嫉妒刺死。姐妹双双重生回选亲日，沈明珠抢嫁“未来大哥”霍沉峰，沈明月偏选十日后必死的病弱书生霍沉舟。她凭前世眼光做健美裤生意、盘下三号铺，赚到一万块买特效药改写丈夫死局，更发现猴票背后藏着霍沉峰前世发家的秘密。我嫁谁，谁才是大哥！","series_id":"7700839942913543193","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356098AD02BEA18A510A97365\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7700839942913543193\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.005554924253374338,\\\"collect\\\":0.04023794084787369,\\\"normalized_duration\\\":0.7104924917221069,\\\"stream_ctr\\\":0.011559119448065758,\\\"like\\\":0.06371499598026276,\\\"absolute_staytime\\\":0.1893681138753891,\\\"staytime_stream\\\":1.6705384254455566}\"}","recommend_group_id":"7700839942913543193","play_cnt":5715845,"book_exist":false,"copyright":"海鱼星空","sub_title":"年代·重生逆袭","score":"8.2","use_video_model":true,"episode_cnt":94,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5021,\"name\":\"年代\",\"schema\":\"dragon8662://categorySearch?categoryId=5021&categoryName=年代&genreType=130&gender=0&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5065,\"name\":\"年代创业\",\"schema\":\"dragon8662://categorySearch?categoryId=5065&categoryName=年代创业&genreType=130&gender=0&source=detail\"},{\"category_id\":5127,\"name\":\"双重生\",\"schema\":\"dragon8662://categorySearch?categoryId=5127&categoryName=双重生&genreType=130&gender=0&source=detail\"},{\"category_id\":5095,\"name\":\"先婚后爱\",\"schema\":\"dragon8662://categorySearch?categoryId=5095&categoryName=先婚后爱&genreType=130&gender=0&source=detail\"},{\"category_id\":5093,\"name\":\"换嫁\",\"schema\":\"dragon8662://categorySearch?categoryId=5093&categoryName=换嫁&genreType=130&gender=0&source=detail\"},{\"category_id\":51