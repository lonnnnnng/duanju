type":0,"use_recommend":false,"video_data":[{"vid":"7701359432952728601","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/dc8b332a22ddf315fbd4cfdc51aae41b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164571&x-signature=bYHC7YGus5XxxP5TGAWvurQWUE8%3D","duration":7808,"title":"许君明月共余生","video_desc":"国公府嫡女沈羡鱼，自幼被拐，在棺材铺长大，天生能看见厄运。十六岁被卖入肃王府冲喜，本想逃跑，却在洞房夜被病危失控的顾承渊赠予黄金万两。沈羡鱼为投桃报李，决心留下替他吞食厄运，相处之中却发现传说中乖张弑杀的少年将军，原来是守着执念的重诺之人。两人在相处之中日久生情，顾承渊身体渐愈，幕后黑手太子终于出手。鸿门宴上，沈羡鱼拼死相助，身世浮出水面——她竟是国公府走失多年的嫡女。","series_id":"7701357402754386968","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356098AD02BEA18A510A97365\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7701357402754386968\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.015523594804108143,\\\"staytime_stream\\\":1.6529483795166016,\\\"finish\\\":0.003945406526327133,\\\"normalized_duration\\\":0.716064989566803,\\\"like\\\":0.06371499598026276,\\\"absolute_staytime\\\":0.19537930190563202,\\\"collect\\\":0.047425877302885056}\"}","recommend_group_id":"7701357402754386968","play_cnt":6751942,"book_exist":false,"copyright":"凡酷剧场","sub_title":"爱情·古风爱情","score":"8.2","use_video_model":true,"episode_cnt":64,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5196,\"name\":\"异能\",\"schema\":\"dragon8662://categorySearch?categoryId=5196&categoryName=异能&genreType=130&gender=0&source=detail\"},{\"category_id\":5095,\"name\":\"先婚后爱\",\"schema\":\"dragon8662://categorySearch?categoryId=5095&categoryName=先婚后爱&genreType=130&gender=0&source=detail\"},{\"category_id\":5178,\"name\":\"逆风翻盘\",\"schema\":\"dragon8662://categorySearch?categoryId=5178&categoryName=逆风翻盘&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#282018","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"5341万热度","data_type":27}],"pay_info":{},"tag_info":{"text":"新剧","bg_color":["#00AE83"],"dark_bg_color":["#008060"],"position":2,"is_align_to_edge":false},"support_listen":false,"recommend_reason_list":"{\"tag_info\":{\"text\":\"新剧\",\"bg_color\":[\"#00AE83\"],\"dark_bg_color\":[\"#008060\"],\"position\":2,\"is_align_to_edge\":false},\"sub_title_list\":[{\"content\":\"爱情\",\"data_type\":3},{\"content\":\"5341万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7700943522404240409","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/c15172543c91990298f0de1b39512434~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164571&x-signature=YC0edwL2xAH079Zd%2BBBhRh6F2Us%3D","duration":7367,"title":"重生螳螂，觉醒无限吞噬进化","video_desc":"史克螂意外重生，变成蛮荒丛林里一只弱小螳螂。身处弱肉强食的残酷世界，毒虫凶兽遍布四周，步步危机。所幸觉醒“无限吞噬进化”天赋！吞噬血肉，掠夺基因，不断蜕变外骨骼，解锁各类神通。猎杀猛兽，吞噬异种，持续进化变强。从底层小虫起步，挥动锋利镰刃，踏过无尽凶险，以吞噬之道，一步步成长为震慑万族的虫族至尊。","series_id":"7700941738487073817","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356098AD02BEA18A510A97365\",\"rank\":\"3\",\"queue_names\":\"comics,shortplay\",\"final_queue_name\":\"comic\",\"gid\":\"7700941738487073817\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.06278920918703079,\\\"absolute_staytime\\\":0.22313016653060913,\\\"finish\\\":0.005554924253374338,\\\"stream_ctr\\\":0.014171833172440529,\\\"staytime_stream\\\":1.9956140518188477,\\\"collect\\\":0.05921025201678276,\\\"normalized_duration\\\":0.7049634456634521}\"}","recommend_group_id":"7700941738487073817","play_cnt":30904008,"book_exist":false,"copyright":"陆尤器","sub_title":"奇幻·全96集","score":"8.3","use_video_model":true,"episode_cnt":96,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5975,\"name\":\"奇幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5975&categoryName=奇幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=1&source=detail\"},{\"category_id\":5976,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5976&categoryName=奇幻脑洞&genreType=130&gender=1&source=detail\"},{\"category_id\":6090,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=6090&categoryName=穿越&genreType=130&gender=1&source=detail\"},{\"category_id\":6099,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=6099&categoryName=系统&genreType=130&gender=1&source=detail\"},{\"category_id\":6112,\"name\":\"升级流\",\"schema\":\"dragon8662://categorySearch?categoryId=6112&categoryName=升级流&genreType=130&gender=1&source=detail\"},{\"category_id\":6299,\"name\":\"异界\",\"schema\":\"dragon8662://categorySearch?categoryId=6299&categoryName=异界&ge