样逐渐明白，自己不该出现在妈妈的世界里，母女二人互相牵挂，却又渐行渐远，直到多年后，她们解开心结，走出了困扰她们二十多年的无形牢笼！","series_id":"7576241661454339097","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235615A7A3F60F77FC739299DE\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7576241661454339097\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.039048295468091965,\\\"stream_ctr\\\":0.02518962323665619,\\\"normalized_duration\\\":1.1172159910202026,\\\"staytime_stream\\\":1.3211324214935303,\\\"collect\\\":0.05500529333949089,\\\"like\\\":0.07477004826068878,\\\"absolute_staytime\\\":0.20001259446144104}\"}","recommend_group_id":"7576241661454339097","play_cnt":1012717,"book_exist":false,"copyright":"大脸猫与蓝皮鼠","sub_title":"家庭·治愈","score":"8.1","use_video_model":true,"episode_cnt":78,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5001,\"name\":\"家庭\",\"schema\":\"dragon8662://categorySearch?categoryId=5001&categoryName=家庭&genreType=130&gender=0&source=detail\"},{\"category_id\":5116,\"name\":\"治愈\",\"schema\":\"dragon8662://categorySearch?categoryId=5116&categoryName=治愈&genreType=130&gender=0&source=detail\"},{\"category_id\":5047,\"name\":\"家庭伦理\",\"schema\":\"dragon8662://categorySearch?categoryId=5047&categoryName=家庭伦理&genreType=130&gender=0&source=detail\"},{\"category_id\":5174,\"name\":\"矛盾和解\",\"schema\":\"dragon8662://categorySearch?categoryId=5174&categoryName=矛盾和解&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"},{\"category_id\":5367,\"name\":\"亲情\",\"schema\":\"dragon8662://categorySearch?categoryId=5367&categoryName=亲情&genreType=130&gender=0&source=detail\"}]","color_dominate":"#402020","horiz_cover":"","sub_title_list":[{"content":"家庭","data_type":3},{"content":"4245万热度","data_type":27}],"