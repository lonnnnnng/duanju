how_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7599114533956750361","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/98dbbac2011ba107ff6786abcceaf0de~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164670&x-signature=FjB79GLpRJUT%2BNOtSNVPnybx%2Fw0%3D","duration":9386,"title":"婚后恋爱法则","video_desc":"房产销售余慧慧与公子宋锦荣因意外“怀孕”，二人商量领证。一纸婚约，将两个世界的人绑在一起。面对家族冷眼、前任挑衅，余慧慧都选择勇敢面对。二人从误会到心动，从契约到真心，余慧慧和宋锦荣在交锋与温情中，共同书写了一段先婚后爱的都市童话。改编自番茄小说《先婚后爱，就她吧》作者鱼子鱼酱。","series_id":"7599111589408558105","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623574960CA04A9F76B7A96E3F5\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7599111589408558105\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.06278920918703079,\\\"normalized_duration\\\":1.2579610347747803,\\\"stream_ctr\\\":0.03056681528687477,\\\"staytime_stream\\\":1.3494935035705566,\\\"finish\\\":0.05665243789553642,\\\"absolute_staytime\\\":0.2755289673805237,\\\"like\\\":0.09009299427270889}\"}","recommend_group_id":"7599111589408558105","play_cnt":1717621,"book_exist":false,"copyright":"花花夜读","sub_title":"爱情·都市爱情","score":"8.2","use_video_model":true,"episode_cnt":82,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"c