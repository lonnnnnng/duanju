source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7527223527842253886","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/b1ee5f32c478ce92103c84cd893a8f3c~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164670&x-signature=t%2BFjI8JFgvoveZMzdg2C3R5vOMI%3D","duration":6241,"title":"我妈居然是台球女王","video_desc":"60岁的余锦琴，曾是世界台球冠军，为避世仇隐于城中村，与儿子罗晨相依为命。不料，罗晨在赌球中输掉她丈夫的50万救命钱。为追回钱款并查明真相，余锦琴决定亲自出手。她凭借高超球技，在与陈宏志等人的赌局中连胜，却意外引出了二十年前的恩怨——师弟叶志鹏投靠倭国人小谷冰川，害死师傅，如今更是胁迫她为倭国效力。余锦琴坚决不从，由此展开了一系列台球对决。","series_id":"7526857024169069630","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623574960CA04A9F76B7A96E3F5\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7526857024169069630\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.05665243789553642,\\\"normalized_duration\\\":0.9737396240234375,\\\"staytime_stream\\\":1.2441011667251587,\\\"finish\\\":0.036220062524080276,\\\"stream_ctr\\\":0.03396939858794212,\\\"like\\\":0.08509904891252518,\\\"absolute_staytime\\\":0.19085334241390228}\"}","recommend_group_id":"7526857024169069630","play_cnt":23306,"book_exist":false,"copyright":"湖南六翼影视","sub_title":"都市·都市日常","score":"8.2","use_video_model":true,"episode_cnt":63,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5078,\"name\":\"都市日常\",\"schema\":\"dragon8662://categorySearch?categoryId=5078&categoryName=都市日常&genreType=130&gender=0&source=detail\"},{\"category_id\":5165,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5165&categoryN