over":"https://p3-reading-sign.fqnovelpic.com/novel-pic/95676280de9a4587cc3a64f2d343af11~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164670&x-signature=AONG12YagsWzNGw575pHGiYq1z4%3D","duration":9307,"title":"深宫策","video_desc":"将军府影阁培养的少女月，为替惨死的姐姐玲复仇，以宫女身份潜入深宫。她凭借智谋与医理知识，辅佐郦嫔争宠上位，步步为营对抗心狠手辣的皇后与权势滔天的将军府。过程中，她周旋于后宫纷争与朝堂权谋，与皇帝达成隐秘同盟，揭露皇后借影阁控制后宫、将军府私通外敌谋逆的阴谋。最终，月成功为姐报仇，瓦解影阁与将军府势力，洗清宫廷乱象后，拒绝荣华富贵，带着令牌与通关文牒，踏上行医济世的江湖之路。","series_id":"7637042423067069465","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623574960CA04A9F76B7A96E3F5\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7637042423067069465\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.08632347732782364,\\\"staytime_stream\\\":1.4692286252975464,\\\"finish\\\":0.05665243789553642,\\\"absolute_staytime\\\":0.29559943079948425,\\\"collect\\\":0.06371499598026276,\\\"normalized_duration\\\":1.2038766145706177,\\\"stream_ctr\\\":0.03954194858670235}\"}","recommend_group_id":"7637042423067069465","play_cnt":316665,"book_exist":false,"copyright":"星曜阁版权剧场","sub_title":"成长·女性成长","score":"8.0","use_video_model":true,"episode_cnt":64,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5136,\"name\":\"宫斗宅斗\",\"schema\":\"dragon8662://categorySearch?categoryId=5136&categoryName=宫斗宅斗&genreType=130&gender=0&source=detail\"},{\"category_id\":5163,\"name\":\"马甲文\",\"schema\":\"dragon8662://categorySearch?categoryId=5163&categoryName=马甲文&genreType=130&gender=0&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dra