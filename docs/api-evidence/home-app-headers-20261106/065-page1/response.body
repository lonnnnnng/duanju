eo_data":[{"vid":"7697696752232582168","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/8824990000958fbdb28fb29dca9da667~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164684&x-signature=ZxOYJTkGEKBdgyQVs%2FdLt8cyic4%3D","duration":9085,"title":"退役归来，这个保镖不好惹","video_desc":"昔日顶尖强者陈云东，回归都市后，与妹妹相依为命；之后被迫成为女总裁贴身保镖；之后他接连展露惊人本领，让高傲的女总裁逐渐心动。这时一场街头事件，竟牵出父母当年的隐秘往事。一个战力超群、精通多国语言的男人，为何甘愿屈身当保镖？他的过去究竟藏着什么秘密？","series_id":"7697622096326708286","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235803A02BD0BDDB075B908FCB\",\"rank\":\"2\",\"queue_names\":\"aigc,shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7697622096326708286\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.7201298475265503,\\\"stream_ctr\\\":0.02087186649441719,\\\"collect\\\":0.09268778562545776,\\\"normalized_duration\\\":1.309350609779358,\\\"absolute_staytime\\\":0.4250839054584503,\\\"finish\\\":0.103748619556427,\\\"like\\\":0.09401018172502518}\"}","recommend_group_id":"7697622096326708286","play_cnt":42693646,"book_exist":false,"copyright":"瑾叶剧场","sub_title":"逆袭·全100集","score":"8.2","use_video_model":true,"episode_cnt":100,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5465,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5465&categoryName=逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5505,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5505&categoryName=超凡逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5672,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5672&categoryName=隐藏大佬&genreType=130&gender=1&source=detail\"},{\"category_id\":5711,\"name\":\"强者回归\",\"schema\":\"dragon8662://categorySearch?categoryId=5711&categoryName=强者回归&genreType=130&gender=1&source=detail\"},{\"category_id\":5756,\"name\":\"大男主\",\"schema\":\"dragon8662:/