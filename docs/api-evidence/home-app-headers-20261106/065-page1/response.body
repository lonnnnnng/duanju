_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7698309376561400856","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/c37eb63db868db08eb95e0d8bacd0129~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164684&x-signature=q5UyXMv2t%2BFTab4rbencV0sQqow%3D","duration":54131,"title":"和离后我带女儿横扫魔域","video_desc":"陆清安曾是威震诸天的永夜魔帝，功成名就后，他选择回归烟火生活，与家人共度温暖岁月。一次人生转折，让他带着两个女儿重返魔域，也由此开启一段轻松热闹的新旅程。表面低调随和的他，实际拥有深不可测的实力与丰厚底蕴。面对女儿修行、亲友来访和各方奇遇，他总能从容化解难题，把珍贵功法、神兵与机缘送到家人身边。一路上，父女温情、亲友笑料与玄幻奇景不断交织。最终，陆清安守住初心，迎来圆满幸福的新生活。","series_id":"7698294694886788121","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235803A02BD0BDDB075B908FCB\",\"rank\":\"9\",\"queue_names\":\"comics,shortplay\",\"final_queue_name\":\"comic\",\"gid\":\"7698294694886788121\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.08389037847518921,\\\"normalized_duration\\\":1.358852505683899,\\\"absolute_staytime\\\":0.3855343461036682,\\\"like\\\":0.09009299427270889,\\\"staytime_stream\\\":1.4661253690719604,\\\"finish\\\":0.0034834237303584814,\\\"stream_ctr\\\":0.016952157020568848}\"}","recommend_group_id":"7698294694886788121","play_cnt":56972245,"book_exist":false,"copyright":"灵龙科技","sub_title":"玄幻·全999集","score":"8.3","use_video_model":true,"episode_cnt":999,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5967,\"name\":\"玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5967&categoryName=玄幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=1&source=detail\"},{\"category_id\":5968,\"name\":\"玄幻仙侠\",\"schema\":\"dragon8662://categorySearc