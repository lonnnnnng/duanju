{"data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7694975932020313113","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/98b26c367d292d730a2ab802e11ec7d4~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164684&x-signature=LiDmTRmFmGkW8%2B%2FHyJjX9DEROEU%3D","duration":36655,"title":"带娃摆摊，前夫找上门第一季","video_desc":"顾瑶带着儿子曜曜经营甜品小摊，在市井烟火中平静生活。一次偶遇，霍擎寒得知自己还有一个孩子，同时发现当年的离婚手续并未办结。霍擎寒试着融入母子二人的生活，学着陪伴孩子、体谅顾瑶。长久相处下，过往隔阂渐渐消散，曜曜慢慢接纳了他。伴随相处，顾瑶身世的线索缓缓浮现。一场温柔的久别重逢，一家三口慢慢靠近，在平凡日常中收获温暖与幸福。","series_id":"7694948718188973080","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235803A02BD0BDDB075B908FCB\",\"rank\":\"1\",\"queue_names\":\"aigc,shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7694948718188973080\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.009412589482963085,\\\"stream_ctr\\\":0.025942809879779816,\\\"collect\\\":0.09947021305561066,\\\"like\\\":0.13477592170238495,\\\"staytime_stream\\\":1.6672803163528442,\\\"absolute_staytime\\\":0.49118348956108093,\\\"normalized_duration\\\":1.3910768032073975}\"}","recommend_group_id":"7694948718188973080","play_cnt":8642211,"book_exist":false,"copyright":"徐州新漫跳动传媒有限公司","sub_title":"爱情·全475集","score":"8.2","use_video_model":true,"episode_cnt":475,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5463,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5463&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5491,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryI