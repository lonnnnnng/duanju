sername":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7701680675979545625","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/0f46fdba7ce0ccfd0e96dcb94209b6ba~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164684&x-signature=9FtFgkn69Gl%2BKd2sKnMVT3DAIIE%3D","duration":7569,"title":"二婚嫁对人，前夫悔破防","video_desc":"江雪婚后三年没能生育，丈夫一家把所有问题归咎于她，狠心逼迫她离婚、索要赔偿。走投无路之际，她结识了旁人议论颇多的萧晏，仓促定下第二段婚姻。她本打算借宴席拆穿前夫一家的算计，可朝夕相处中才发现，看似粗粝的萧晏内里温柔可靠，两人彼此慰藉，携手经营属于自己的小店与安稳生活。","series_id":"7701678491724418073","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235803A02BD0BDDB075B908FCB\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7701678491724418073\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.09534947574138641,\\\"staytime_stream\\\":1.6709777116775513,\\\"stream_ctr\\\":0.03222518041729927,\\\"absolute_staytime\\\":0.36931928992271423,\\\"finish\\\":0.09401018172502518,\\\"collect\\\":0.06278920918703079,\\\"normalized_duration\\\":1.2015275955200195}\"}","recommend_group_id":"7701678491724418073","play_cnt":4386966,"book_exist":false,"copyright":"吾里短剧","sub_title":"爱情·都市爱情","score":"8.0","use_video_model":true,"episode_cnt":70,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category