b7696416fad1e0935c2d56bb0629397~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164684&x-signature=DyxLtDgmHm8ljfSLmFYSduUv4xQ%3D","duration":8816,"title":"装穷参加同学会，合照把我给裁了","video_desc":"身家几十亿的周景明，穿着朴素参加高中同学会，却被当成穷打工仔百般奚落，连合照都被裁掉。唯有旧室友许大勇真心相待。周景明暗中扶持好友，收获迟来的爱情。势利同学们却因贪利陷入困境，直到登门求救，才发现苦求的董事长竟是合照被裁的周景明。面对攀交情的众人，周景明指着合照，“老同学？照片里明明没有我啊！”","series_id":"7689779819260693529","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235803A02BD0BDDB075B908FCB\",\"rank\":\"4\",\"queue_names\":\"aigc,shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7689779819260693529\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.10970577597618103,\\\"staytime_stream\\\":1.976351261138916,\\\"absolute_staytime\\\":0.44374731183052063,\\\"finish\\\":0.07696083933115005,\\\"stream_ctr\\\":0.02766554430127144,\\\"collect\\\":0.07477004826068878,\\\"normalized_duration\\\":1.2145042419433594}\"}","recommend_group_id":"7689779819260693529","play_cnt":3402185,"book_exist":false,"copyright":"新美九天深圳数字科技有限公司","sub_title":"都市·全80集","score":"8.0","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5478,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5478&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5540,\"name\":\"都市日常\",\"schema\":\"dragon8662://categorySearch?categoryId=5540&categoryName=都市日常&genreType=130&gender=1&source=detail\"},{\"category_id\":5672,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5672&categoryName=隐藏大佬&genreType=130&gender=1&source=detail\"},{\"category_id\":5736,\"name\":\"扮猪吃虎\",\"schema\":\"dragon8662://categorySearch?categoryId=5736&categoryName=扮猪吃虎&genreType=130&gender=1&source=detail\"},{\"category_id\":5734,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5734&categoryName=打脸反派&genreType=13