,"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7696541098692332569","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/ae9ceb48413c7776ed2d3667efd5d4aa~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164684&x-signature=kFpC0tm7Zi6iyMD6wzwVAufCX0U%3D","duration":18834,"title":"重生1980：赶山狩猎养妻女","video_desc":"李长生重生回到1980年，前世嗜赌，落得家破人亡，重生后决心改过自新。凭借跑山经验，他上山采收山货、下水捕鱼，凭辛勤劳作还清赌债，盖起新房。一次进山，他发现深山旧遗址，境外商人白景海觊觎里面的古遗存，派人潜入盗挖。李长生组织村民，及时上报相关部门，协同执法人员抓获盗掘团伙，守住家乡。他带领村民共同致富，守护靠山屯，一家人过上安稳日子。","series_id":"7696487220131155006","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235803A02BD0BDDB075B908FCB\",\"rank\":\"5\",\"queue_names\":\"aigc\",\"final_queue_name\":\"heji\",\"gid\":\"7696487220131155006\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":1.3748703002929688,\\\"finish\\\":0.035678550601005554,\\\"like\\\":0.11920293420553207,\\\"staytime_stream\\\":1.7795990705490112,\\\"absolute_staytime\\\":0.51475590467453,\\\"stream_ctr\\\":0.02204153500497341,\\\"collect\\\":0.09947021305561066}\"}","recommend_group_id":"7696487220131155006","play_cnt":5193322,"book_exist":false,"copyright":"宜春市剧漫文化传媒有限公司","sub_title":"年代·全358集","score":"8.0","use_video_model":true,"episode_cnt":358,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5464,\"name\":\"年代\",\"schema\":\"dragon8662://categorySearch?categoryId=5464&categoryName=年代&genreType=130&gender=1&source=detail\"},{\"category_id\":5502,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5502&categoryName=重生逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5647,\"name\":\"自我救