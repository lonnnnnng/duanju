es=1799164684&x-signature=cFmN%2Fn7Lz08IUtEeHn1MKb0NXxg%3D","duration":9447,"title":"灾年逆袭：我靠穿越养全家","video_desc":"灾年大旱，吃光全家口粮膘肥体胖的林瑶抛下丈夫和两个孩子跟别人跑了，最后被渣男骗，下场凄惨。现代农业大学生林瑶熬夜猝死，一觉醒来，自己穿进了这本年代小说里，成了即将抛夫弃子跟人跑路的胖女人，就在绝望之际，林瑶发现自己激活了穿越系统，可以自由穿梭两个世界，为了在50年代的灾年活下去，林瑶凭借着自己的专业知识以及可以穿越时空的能力，带领一家老小过上了顿顿吃肉啃大馒头的好日子！","series_id":"7690494161551625241","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235803A02BD0BDDB075B908FCB\",\"rank\":\"8\",\"queue_names\":\"aigc\",\"final_queue_name\":\"heji\",\"gid\":\"7690494161551625241\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.07696083933115005,\\\"normalized_duration\\\":1.2940961122512817,\\\"like\\\":0.10521054267883301,\\\"staytime_stream\\\":1.6970746517181396,\\\"absolute_staytime\\\":0.39007890224456787,\\\"finish\\\":0.08269734680652618,\\\"stream_ctr\\\":0.02568945102393627}\"}","recommend_group_id":"7690494161551625241","play_cnt":16093855,"book_exist":false,"copyright":"大同禾乐文化传媒有限公司","sub_title":"年代·全100集","score":"8.1","use_video_model":true,"episode_cnt":100,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5464,\"name\":\"年代\",\"schema\":\"dragon8662://categorySearch?categoryId=5464&categoryName=年代&genreType=130&gender=0&source=detail\"},{\"category_id\":5547,\"name\":\"荒年生存\",\"schema\":\"dragon8662://categorySearch?categoryId=5547&categoryName=荒年生存&genreType=130&gender=0&source=detail\"},{\"category_id\":5503,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5503&categoryName=逆袭翻身&genreType=130&gender=0&source=detail\"},{\"category_id\":5679,\"name\":\"穿书\",\"schema\":\"dragon8662://categorySearch?categoryId=5679&categoryName=穿书&genreType=130&gender=0&source=detail\"},{\"category_id\":5690,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=5690&categoryName=系统&genreType=130&gender=0&source=detail\"},{\"category_id\":5663,\"name\":\"先婚后爱\",\"schema