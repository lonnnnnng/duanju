novel-pic/5ecb5c8561ac42a64a350d280914e104~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164567&x-signature=Zu%2BHcQsQOPFs3a%2FxuUCp1z53WdU%3D","duration":4656,"title":"鱼缸里到底有什么","video_desc":"全职主妇温宁发现，丈夫沈嘉树每晚对着鱼缸坐两小时，声称养鱼静心。闺蜜苏晴来家喂鱼后突然惊恐，要求报警，随即跑出家门坠江身亡，死前攥着温宁儿子捏的橡皮泥小鱼。温宁在警方调查中撬开鱼缸底座暗格，内有屏幕和耳机孔——他看的从来不是鱼，而是监控画面。顺藤摸瓜，她查到植物人林晚！那才是沈嘉树的合法妻子，也是江景房产权人。而苏晴死前攥着的那条橡皮泥小鱼，正指向一个被隐瞒多年的真相。","series_id":"7700862621431385113","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235606CF291DD17E0A9594B8AA\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7700862621431385113\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.014957086183130741,\\\"collect\\\":0.0427221953868866,\\\"stream_ctr\\\":0.03230398893356323,\\\"like\\\":0.06754669547080994,\\\"staytime_stream\\\":1.9600249528884888,\\\"normalized_duration\\\":0.657098114490509,\\\"absolute_staytime\\\":0.21626517176628113}\"}","recommend_group_id":"7700862621431385113","play_cnt":4868436,"book_exist":false,"copyright":"快创短剧","sub_title":"悬疑·悬疑情感","score":"8.1","use_video_model":true,"episode_cnt":78,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5004,\"name\":\"悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5004&categoryName=悬疑&genreType=130&gender=0&source=detail\"},{\"category_id\":5056,\"name\":\"悬疑情感\",\"schema\":\"dragon8662://categorySearch?categoryId=5056&categoryName=悬疑情感&genreType=130&gender=0&source=detail\"},{\"category_id\":5107,\"name\":\"自我救赎\",\"schema\":\"dragon8662://categorySearch?categoryId=5107&categoryName=自我救赎&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&