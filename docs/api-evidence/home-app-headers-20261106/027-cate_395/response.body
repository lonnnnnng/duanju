video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7579953765772446745","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/298f95fad1959c3184c1ac1504d09fc7~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164615&x-signature=MJRUhyfLG4drkHBNvmucWU76ry4%3D","duration":6687,"title":"竹马难逃，开启撒娇模式","video_desc":"前世，苏念笙苦追时逾白六年无果，新婚夜遭他与青梅林以萱出轨，绝症时遭二人羞辱夺物，含恨而终。重生回大学，她决心远离渣男，挽回家人与默默守护的京圈太子爷沈隽西。她揭穿林以萱假唱真相，面对栽赃凭智慧与沈隽西相助屡屡翻盘，让其真面目暴露。两人从试探渐生情愫，沈隽西的深情融化她冰封的心。最终，苏念笙首富千金身份曝光，前世仇怨清算，她夺回一切，与沈隽西收获事业爱情双圆满。","series_id":"7579950721789856830","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235654568CBE8C61C25EA1E523\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7579950721789856830\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.09157242625951767,\\\"collect\\\":0.031143829226493835,\\\"stream_ctr\\\":0.04833480715751648,\\\"staytime_stream\\\":1.1585743427276611,\\\"finish\\\":0.002714984817430377,\\\"normalized_duration\\\":0.7287633419036865,\\\"like\\\":0.05108273774385452}\"}","recommend_group_id":"7579950721789856830","play_cnt":6278,"book_exist":false,"copyright":"tomatotv","sub_title":"爱情·都市爱情","score":"8.1","use_video_model":true,"episode_cnt":59,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\