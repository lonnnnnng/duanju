30116633","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/e69129269519084db60a487f3ae1bb11~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164615&x-signature=w329AC93q5HdWTl5oIb9meETXOI%3D","duration":8160,"title":"靳夺南枝","video_desc":"江家现任掌权人江靳年是出了名的克己复礼，性情冷淡。哪怕江、沈两家早就定有婚约，也没人将他与沈南枝联系在一起。那些年中，沈南枝也这么认为。江靳年常年在国外，性子冷，一年到头不见回来，两人几乎没有见面的机会，哪怕见了面，沈南枝也向来对他避而远之。她从没有想过，两家的婚约会阴差阳错落在她和江靳年身上。更没有想过，江靳年在领证后把她宠上天。","series_id":"7561753867541548094","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235654568CBE8C61C25EA1E523\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7561753867541548094\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.0389072895050049,\\\"absolute_staytime\\\":0.10705902427434921,\\\"collect\\\":0.03210071101784706,\\\"normalized_duration\\\":0.7035878896713257,\\\"stream_ctr\\\":0.054349400103092194,\\\"like\\\":0.046724967658519745,\\\"finish\\\":0.001455063233152032}\"}","recommend_group_id":"7561753867541548094","play_cnt":347648,"book_exist":false,"copyright":"海鱼星空","sub_title":"爱情·都市爱情","score":"8.1","use_video_model":true,"episode_cnt":79,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5096,\"name\":\"商业联姻\",\"schema\":\"dragon8662://categorySearch?categoryId=5096&categoryName=商业联姻&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=总裁&genreType=130&gender=0&source=detail\"},{\"category_id\":5327,\"name\":\"高冷\",\"schema\":\"dragon8662://categorySearch?categoryId=5327&categoryName=高冷&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"},{\"category_id\":5400,\"name\":\"都市甜宠\",\"schema\":\"dragon8662://categorySearch?categoryId=5400&categoryName=都市甜宠&genreType=130&gender=0&source=detail\"}]","color_dominate":"#202830","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"3689万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"爱情\",\"data_type\":3},{\"content\":\"3689万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7554959130784435225","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/0c312f8d75a14c9b722cf6fbbbe3ca60~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164615&x-signature=bXkMxQ2szvFNIRQ0ElSxtFOF1H0%3D","duration":9308,"title":"谁说离婚活不了，季小姐她光芒万丈","video_desc":"季姝是海城有名的少夫人，平民出身，却凭借美艳的长相被陈京白娶回家，娇养了十几年。可是，陈京白出轨了，季姝果断离婚。一年也过去了，季姝依旧美艳动人。她靠那些年为丈夫和女儿锻炼出来的手艺，养活了自己，还成了拥有千万粉丝的博主，身价上亿，全网盼着娶她的男人，数不胜数。陈京白这才知道后悔了，然而季姝却已经被顶级大佬傅政屿日日哄着，宠着，着急想要让她做傅太太呢。","series_id":"7554957091287354393","episode":true,"vertical":true,"con