{"log_id":"20261106235752172ABC95BDA263A30663","code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7586261027411479577","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/739785ac654bb32756b9cc0a5b4f45b8~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164673&x-signature=tYd%2FNc2SP1Hj0GIzRH8pjHpFkck%3D","duration":7536,"title":"萌宝助攻：冷艳总裁妈咪沦陷了","video_desc":"五年前，遭人设计的沈晚秋与隐退兵王林枭意外结缘，诞下女儿沈依依。五年后，为摆脱蒋家逼婚，沈晚秋带依依寻父，两人闪婚。林枭以保安身份潜伏，却在沈氏集团遭遇危机、蒋家与黑石会勾结等事件中屡次出手，暴露兵王实力。最终，他揭露秦家罪行，为姐报仇，重拾龙主身份，守护妻女与沈氏集团。","series_id":"7586259157284555838","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235752172ABC95BDA263A30663\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7586259157284555838\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.06097517907619476,\\\"like\\\":0.08151976019144058,\\\"absolute_staytime\\\":0.24506056308746338,\\\"stream_ctr\\\":0.03686564788222313,\\\"finish\\\":0.0534033365547657,\\\"normalized_duration\\\":1.1476258039474487,\\\"staytime_stream\\\":1.262332797050476}\"}","recommend_group_id":"7586259157284555838","play_cnt":157739,"book_exist":false,"copyright":"山海星辰","sub_title":"都市·超凡逆袭","score":"8.2","use_video_model":true,"episode_cnt":62,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662