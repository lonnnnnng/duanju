ic/429fce7362e5a8ff8cd30968cf4721f3~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164673&x-signature=xpRXfh8I7izOYaka87oedwV5xIk%3D","duration":7021,"title":"墓前梦托：守护延续","video_desc":"天骄龙王李平安率部剿灭死神恐怖组织，然而死神却明修栈道暗度陈仓，查出了李平安家人信息，将和李平安私奔相濡以沫的妻子杀害。李平安一怒之下，启动地下巨龙势力，全球剿灭恐怖分子，从此隐退，陪在妻子的墓前，其间豪门千金、女战神、昆仑圣女都轮番来向他求婚，均被他拒绝。但有天他做梦，妻子告诉他，妻子的父亲被人害死，母亲重病，妹妹一个人管理公司，被敌对势力针对，希望李平安娶妻妹，并保护她。","series_id":"7442551241084783641","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235752172ABC95BDA263A30663\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7442551241084783641\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.0772809982299805,\\\"absolute_staytime\\\":0.13963128626346588,\\\"like\\\":0.06754669547080994,\\\"collect\\\":0.0427221953868866,\\\"stream_ctr\\\":0.02156655862927437,\\\"finish\\\":0.03161877393722534,\\\"normalized_duration\\\":1.0765166282653809}\"}","recommend_group_id":"7442551241084783641","play_cnt":60904,"book_exist":false,"copyright":"湖南六翼影视","sub_title":"都市·奇幻脑洞","score":"8.3","use_video_model":true,"episode_cnt":82,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5074,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5074&categoryName=奇幻脑洞&genreType=130&gender=1&source=detail\"},{\"category_id\":5158,\"name\":\"强者回归\",\"schema\":\"dragon8662://categorySearch?categoryId=5158&categoryName=强者回归&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5204,\"name\":\"龙王\",\"schema\":\"dragon8662://categorySearch?categoryId=5204&category