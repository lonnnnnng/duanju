{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7534993210230180926","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/a7848c706fcb80dc774f041f94559cf2~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164604&x-signature=6B65BaJthfDwTyfU16m3RHQL2SE%3D","duration":5605,"title":"特工穿越古代丑妃带空间上战场","video_desc":"二十二世纪的高级特工玉梦晴穿越成为丞相府的阴阳脸嫡长女，原身家人不疼、身体废样貌丑。她凭借她的空间、医术与绝技逆袭，打脸敌人，容颜吊打了京城的第一美人，在战场用炸药击退敌人。战王楚世恒缠上了她，她果断休夫。","series_id":"7534603102838590526","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356430C5EC0AD2CE8D9961381\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7534603102838590526\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.3122957944869995,\\\"absolute_staytime\\\":0.14072643220424652,\\\"normalized_duration\\\":0.7202730178833008,\\\"stream_ctr\\\":0.04045591130852699,\\\"finish\\\":0.0033766126725822687,\\\"collect\\\":0.046724967658519745,\\\"like\\\":0.05108273774385452}\"}","recommend_group_id":"7534603102838590526","play_cnt":18646,"book_exist":false,"copyright":"阅益短剧","sub_title":"逆袭·奇幻脑洞","score":"8.3","use_video_model":true,"episode_cnt":101,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5074,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5074&categoryName=奇幻脑洞&genreType=130&gender=0&s