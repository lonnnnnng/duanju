ook_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7534602630358649881","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/20c7b50527f345fd5cd4b0d0e6d63ea7~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164604&x-signature=rdpGxhp%2Bncrtk52x0R9IISEbiCU%3D","duration":3723,"title":"情落成泥碾作尘","video_desc":"沈予安身怀系统，却为了男友周砚深选择留在他的世界。四年前，男友周砚深出车祸被碾断双腿，沈予安用了全部积分，放弃了自己的舞蹈事业，将自己的双腿换给周砚深。可她没想到，四年后，沈予安亲眼见证了周砚深的背叛，亲耳听到了他对她的嫌弃。沈予安心灰意冷，决定夺回自己的双腿，开启自己新的人生。","series_id":"7533518427663649854","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356430C5EC0AD2CE8D9961381\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7533518427663649854\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.02843603305518627,\\\"stream_ctr\\\":0.039669763296842575,\\\"like\\\":0.046724967658519745,\\\"staytime_stream\\\":0.9222773313522339,\\\"normalized_duration\\\":0.6981125473976135,\\\"absolute_staytime\\\":0.09447924792766571,\\\"finish\\\":0.014957086183130741}\"}","recommend_group_id":"7533518427663649854","play_cnt":8579,"book_exist":false,"copyright":"剧点短剧","sub_title":"都市·女性成长","score":"8.1","use_video_model":true,"episode_cnt":32,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=5130&categoryName=系统&genreType=130&gender=0&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySe