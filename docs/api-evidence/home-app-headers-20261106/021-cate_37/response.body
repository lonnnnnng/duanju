tion":6993,"title":"大炎风云录","video_desc":"唐逸意外穿越成古代官宦人家的少爷，一睁眼竟发现自己躺在床榻上。正惊疑不定之际，一群壮汉破门而入，声称要将他抓去祭天。千钧一发之时，他才意识到这是继母与嫂子联手设下的毒计，意图借机除掉他。然而，身为现代特种兵王的唐逸岂是任人宰割之辈？他临危不乱，果断反击——当场制服主谋，揭穿阴谋；面对继母的阴险算计和嫂子的虚伪嘴脸，他毫不留情地予以回击；更以雷霆手段震慑朝堂，令那些曾落井下石的文武百官闻风丧胆。","series_id":"7585192287454383166","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356430C5EC0AD2CE8D9961381\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7585192287454383166\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0023967318702489138,\\\"collect\\\":0.03210071101784706,\\\"staytime_stream\\\":1.2132518291473389,\\\"absolute_staytime\\\":0.1053992360830307,\\\"normalized_duration\\\":0.7230920195579529,\\\"stream_ctr\\\":0.04187944531440735,\\\"like\\\":0.046724967658519745}\"}","recommend_group_id":"7585192287454383166","play_cnt":127158,"book_exist":false,"copyright":"河马剧场","sub_title":"古装·古装传奇","score":"8.0","use_video_model":true,"episode_cnt":84,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5139,\"name\":\"古装传奇\",\"schema\":\"dragon8662://categorySearch?categoryId=5139&categoryName=古装传奇&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=