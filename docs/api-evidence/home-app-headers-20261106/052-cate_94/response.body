。知晓男主家两年后会东山再起的姜瑜曼，果断决定收拾包袱跟着男主一家一起下乡。因为无意间救了一个大人物的孙子，至此，姜瑜曼过上了自己梦寐以求的躺平生活。该短剧作品改编自番茄巅峰榜小说《白首与她归》，作者【牛腩焗饭】。","series_id":"7510879002026839065","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623574069E93B0A934820920761\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7510879002026839065\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.2981294393539429,\\\"absolute_staytime\\\":0.1684274673461914,\\\"finish\\\":0.04336579516530037,\\\"stream_ctr\\\":0.040691081434488297,\\\"collect\\\":0.050330642610788345,\\\"normalized_duration\\\":1.058533787727356,\\\"like\\\":0.06954174488782883}\"}","recommend_group_id":"7510879002026839065","play_cnt":47892,"book_exist":false,"copyright":"tomatotv","sub_title":"爱情·年代爱情","score":"8.3","use_video_model":true,"episode_cnt":76,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5131,\"name\":\"年代爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5131&categoryName=年代爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5170,\"name\":\"穿书\",\"schema\":\"dragon8662://categorySearch?categoryId=5170&categoryName=穿书&genreType=130&gender=0&source=detail\"},{\"category_id\":5095,\"name\":\"先婚后爱\",\"schema\":\"dragon8662://categorySearch?categoryId=5095&categoryName=先婚后爱&genreType=130&gender=0&source=detail\"},{\"category_id\":5191,\"name\":\"空间\",\"schema\":\"dragon8662://categorySearch?categoryId=5191&categoryName=空间&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&source=detail\"}]","color_dominate":"#482008","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3