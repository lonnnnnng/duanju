{"data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7501950734930283544","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/630f692eee961309ea7b076e830209d5~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164663&x-signature=wjV01L3bQGibb6A72Vq%2BsjAMJqU%3D","duration":7216,"title":"君自坐北我望南","video_desc":"大元国破，长公主秦烟被蛮族大王子看重，嫡公主秦宁心生嫉妒，暗中刺杀秦烟，最终自己也惨遭射杀，两人双双重生。秦宁刻意复刻前世秦烟的人生轨迹，却浑然不知，秦烟从无做宠妃的心思，她主动接近蛮族二王子，暗中筹谋属于自己的复国大计。","series_id":"7501903980654513214","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623574232FFF3E26D4E96ABBB14\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7501903980654513214\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0384662002325058,\\\"normalized_duration\\\":1.0508092641830444,\\\"stream_ctr\\\":0.031375326216220856,\\\"staytime_stream\\\":1.3128931522369385,\\\"absolute_staytime\\\":0.1765104979276657,\\\"collect\\\":0.04535258188843727,\\\"like\\\":0.07159119844436646}\"}","recommend_group_id":"7501903980654513214","play_cnt":252094,"book_exist":false,"copyright":"树下的椰子","sub_title":"逆袭·重生逆袭","score":"8.1","use_video_model":true,"episode_cnt":61,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=0&source=detail\"},{\"category_i