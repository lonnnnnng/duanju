立无援之际，女帝突然现身，当众揭穿宋景行真实身份，原来他竟是帝君，最终女帝严惩恶人，清算孽债。","series_id":"7485657174736112702","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623574232FFF3E26D4E96ABBB14\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7485657174736112702\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.1692451238632202,\\\"absolute_staytime\\\":0.1053992360830307,\\\"finish\\\":0.048136770725250244,\\\"collect\\\":0.04023794084787369,\\\"normalized_duration\\\":0.8946451544761658,\\\"stream_ctr\\\":0.047152698040008545,\\\"like\\\":0.05665243789553642}\"}","recommend_group_id":"7485657174736112702","play_cnt":113823,"book_exist":false,"copyright":"山海星辰","sub_title":"古装·虐渣","score":"8.1","use_video_model":true,"episode_cnt":35,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=2&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&genreType=130&gender=2&source=detail\"},{\"category_id\":5165,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5165&categoryName=隐藏大佬&genreType=130&gender=2&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=2&source=detail\"},{\"category_id\":5265,\"name\":\"女帝\",\"schema\":\"dragon8662://categorySearch?categoryId=5265&categoryName=女帝&genreType=130&gender=2&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=2&source=detail\"}]","color_dominate":"#d8a070","horiz_cover":"","sub_title_list":[{"content":"古装","data_type":3},{"content":"3296万热度","data_type":27}],"pay_info":{},"support_lis