{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7652000250680331326","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/c0ef214d107333c38d040e7bf87886b9~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164675&x-signature=VxZSmcNsY%2FQOs4lZoza4myqS3FI%3D","duration":11082,"title":"老太片场跑龙套，养活古代一家人","video_desc":"王莲花上山挖野菜，一脚踩空再睁眼，到了个妖怪窝。铁壳子满地跑，比马车还快。人穿得露胳膊露腿，不知羞！房子高得脖子仰断都看不见顶。王莲花攥紧背篓，心里只有一个念头——这咋回去？家里还等着野菜下锅呢！正懵着，一张纸片子塞到她手里阿姨，剧组招群演，盒饭管饱，一天八十！王莲花不识字，但盒饭管饱四个字，她听懂了，一把拽住那人大兄弟，这活我能干！","series_id":"7651997673351826456","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357546B5EE2802B12AE9563FF\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7651997673351826456\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":1.2074087858200073,\\\"stream_ctr\\\":0.03158164396882057,\\\"like\\\":0.08632347732782364,\\\"absolute_staytime\\\":0.24315345287322998,\\\"staytime_stream\\\":1.2090439796447754,\\\"finish\\\":0.031143829226493835,\\\"collect\\\":0.06656919419765472}\"}","recommend_group_id":"7651997673351826456","play_cnt":2702675,"book_exist":false,"copyright":"骐骥追风","sub_title":"都市·奇幻脑洞","score":"8.2","use_video_model":true,"episode_cnt":88,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5074,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categ