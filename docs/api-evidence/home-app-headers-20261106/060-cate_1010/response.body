our_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7561007529531018265","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/2f9593c3422b881ff3f63aa2f9a912e9~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164675&x-signature=qhc4ET4pFblmPg8ZiKBhAw7oefE%3D","duration":7156,"title":"末路无声","video_desc":"万大虎为了帮车祸身亡的儿子讨回公道，失手杀死了酒驾司机——耶吉县首富，成为通缉犯。他自知无法逃脱法律制裁，决定把儿子万小豹的骨灰送回老家就自首。半路碰见三个刚毕业的大学生，张东哲，陈曦和秦越，万大虎好心帮他们修车，竟得知三人是儿子的大学同学，在校期间曾多次欺辱儿子。三人不但不觉有错还帮酒驾司机说话，万大虎理论，反被几人抢走万小豹留给万大虎的唯一手表，几人临走还放火烧了万大虎车。","series_id":"7561005487605435417","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357546B5EE2802B12AE9563FF\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7561005487605435417\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.06754669547080994,\\\"stream_ctr\\\":0.039717402309179306,\\\"staytime_stream\\\":1.2438565492630005,\\\"finish\\\":0.024053551256656647,\\\"collect\\\":0.04401865601539612,\\\"normalized_duration\\\":0.9989019632339478,\\\"absolute_staytime\\\":0.13746649026870728}\"}","recommend_group_id":"7561005487605435417","play_cnt":55387,"book_exist":false,"copyright":"河马剧场","sub_title":"悬疑·犯罪","score":"8.1","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5004,\"name\":\"悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5004&categoryName=悬疑&genreType=130&gender=2&source=detail\"},{\"category_id\":5060,\"name\":\"犯