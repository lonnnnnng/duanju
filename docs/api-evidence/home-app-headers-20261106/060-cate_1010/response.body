509786462569630782","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/bc1666471062343a6e4375fe1da9f5ca~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164675&x-signature=p5tsXCyuRK9eM9%2BMmVIKM8L9Acs%3D","duration":9167,"title":"阿宝","video_desc":"贪者必贫，出身卑微的小乞丐林守诚，人生却迎来意外转机。他机缘巧合被阿宝话事人玄姨林观月收入门下，从此踏入算命风水一行。玄姨倾囊相授，他渐渐洞悉算命之中暗藏的人性学问，跟随玄姨历经少帅改命等一桩桩离奇风水命理局。在一次次布局与破局中，他不仅见识了世间人心百态，更用亲身经历，为世人层层揭开算命风水背后不为人知的真相与隐秘。","series_id":"7509726436794584089","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357546B5EE2802B12AE9563FF\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7509726436794584089\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.052618950605392456,\\\"normalized_duration\\\":1.086550235748291,\\\"absolute_staytime\\\":0.14406366646289825,\\\"staytime_stream\\\":0.9357823729515076,\\\"finish\\\":0.020645931363105774,\\\"stream_ctr\\\":0.04054499790072441,\\\"like\\\":0.06656919419765472}\"}","recommend_group_id":"7509726436794584089","play_cnt":24600,"book_exist":false,"copyright":"巨豹影业","sub_title":"逆袭·偏门传奇","score":"8.0","use_video_model":true,"episode_cnt":71,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5044,\"name\":\"偏门传奇\",\"schema\":\"dragon8662://categorySearch?categoryId=5044&categoryName=偏门传奇&genreType=130&gender=1&source=detail\"},{\"category_id\":5135,\"name\":\"玄学\",\"schema\":\"dragon8662://categorySearch?categoryId=5135&categoryName=玄学&genreType=130&gender=1&source=detail\"},{\"category_id\":5092,\"name\":\"故人重逢\",\"schema\":\"dragon8662://categorySearch?categoryId=5092&categoryName=故人重逢&genreType=130&gender=1&source=detail\"},{\"category_id\":5244,\"name\":\"小人物\",\"schema\":\"dragon8662://c