1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7473106864478096408","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/1a260eabf2bf4762d4c8f0420efee525~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164672&x-signature=JZNTuIFylsh1c2sPBWNfgy7VZpc%3D","duration":4173,"title":"一碗水端平","video_desc":"被抛弃在农村十多年的康雪，被寻来的父母认回家中。亲生父母虽然答应要对康雪以及养女康音一视同仁，但生活中处处偏袒养女康音，更是在康音对康雪“弟弟”施暴时极力维护康音，全然不顾亲生女儿康雪的感受。面对父母的偏心与养女康音的欺辱，康雪不但从未忍让，还每次及时反击打脸所有人。后来康雪为了搞清自己当年被抛弃的真相，顺藤摸瓜找出了自己与康音的身世之谜。","series_id":"7473072758407056446","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357502F9FE03E69E2BD91C5D1\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7473072758407056446\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.10215643793344498,\\\"collect\\\":0.03210071101784706,\\\"normalized_duration\\\":0.7188675403594971,\\\"like\\\":0.04885777458548546,\\\"stream_ctr\\\":0.03122619166970253,\\\"finish\\\":0.01243164949119091,\\\"staytime_stream\\\":1.0333576202392578}\"}","recommend_group_id":"7473072758407056446","play_cnt":18244,"book_exist":false,"copyright":"广州林阳文化传媒有限公司","sub_title":"家庭·家庭伦理","score":"8.2","use_video_model":true,"episode_cnt":42,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5001,\"name\":\"家庭\",\"schema\":\"dragon8662://categorySearch?categoryId=5001&categoryName=家庭&genreType=130&gender=0&source=detail\"},{\"category_id\":5047,\"name\":\"家庭伦理\",\"schema\":\"dragon8662://categorySearch?categoryId=5047&categoryName=家庭伦理&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&s