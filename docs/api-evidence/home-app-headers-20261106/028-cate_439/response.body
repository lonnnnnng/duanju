request_id\":\"20261106235656280E3DF9524B0A95BB28\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7416663065942297625\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.1151199340820312,\\\"finish\\\":0.009412589482963085,\\\"stream_ctr\\\":0.03558885678648949,\\\"like\\\":0.04885777458548546,\\\"absolute_staytime\\\":0.09447924792766571,\\\"collect\\\":0.03963883966207504,\\\"normalized_duration\\\":0.692679762840271}\"}","recommend_group_id":"7416663065942297625","play_cnt":5098,"book_exist":false,"copyright":"苏州落蒂文化传媒有限公司","sub_title":"爱情·古风爱情","score":"8.3","use_video_model":true,"episode_cnt":50,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=0&source=detail\"},{\"category_id\":5095,\"name\":\"先婚后爱\",\"schema\":\"dragon8662://categorySearch?categoryId=5095&categoryName=先婚后爱&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&source=detail\"},{\"category_id\":5312,\"name\":\"架空\",\"schema\":\"dragon8662://categorySearch?categoryId=5312&categoryName=架空&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#301810","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"1315万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_r