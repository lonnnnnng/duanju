体回摄政王府，待尸首入城便魂归。回府后，沈徽宁见皇叔宋怀砚与叶婉兮亲密相拥，心痛万分。曾经宋怀砚对她关怀备至，教她舞剑、为她祈福，还拒赐婚。如今却态度冷漠，因叶婉兮斥责她。","series_id":"7491137662305192985","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235656280E3DF9524B0A95BB28\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7491137662305192985\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.05033719912171364,\\\"like\\\":0.0541987344622612,\\\"absolute_staytime\\\":0.11575839668512344,\\\"collect\\\":0.035678550601005554,\\\"normalized_duration\\\":0.7475039958953857,\\\"staytime_stream\\\":1.1032592058181763,\\\"finish\\\":0.0015978461597114801}\"}","recommend_group_id":"7491137662305192985","play_cnt":153034,"book_exist":false,"copyright":"花生短剧","sub_title":"爱情·古风爱情","score":"8.3","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5312,\"name\":\"架空\",\"schema\":\"dragon8662://categorySearch?categoryId=5312&categoryName=架空&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#682000","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"3202万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"爱情\",\"data_type\":3},{\"content\":\"3202万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":f