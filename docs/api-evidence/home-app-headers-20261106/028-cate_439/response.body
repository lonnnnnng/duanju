"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7701562045203762201","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/e90e596337aee19261f3395fbae84bef~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164617&x-signature=6nBAYlOMj6tFzgxiFcanC5EsLA0%3D","duration":10900,"title":"乡野厨娘巧兴家","video_desc":"现代女孩安竹穿越，成为被买来冲喜的肥妻安竹。新婚夜婆婆陆母见儿子陆寒濒死，竟打算活埋安竹换命，安竹奋起反抗。陆寒死而复生，坚持认下这门婚事。安竹左手掌藏空间胎记，靠厨艺搞事业，带领乡邻做卤味、开酒楼，化解村里各种矛盾。后被神医洛郎中查出身中无情奇藤剧毒，解毒过程痛苦万分，陆寒甘愿舍身陪伴。二人在朝夕相处中，逐步揭开前世羁绊，从名义夫妻走向彼此动心，一边谋生创业，一边面对过往身份带来的危机。","series_id":"7701560211311447065","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235656280E3DF9524B0A95BB28\",\"rank\":\"5\",\"queue_names\":\"aigc\",\"final_queue_name\":\"aigc\",\"gid\":\"7701560211311447065\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.4865038394927979,\\\"stream_ctr\\\":0.03301553428173065,\\\"absolute_staytime\\\":0.19235020875930786,\\\"collect\\\":0.0534033365547657,\\\"normalized_duration\\\":0.783377468585968,\\\"finish\\\":0.004198795184493065,\\\"like\\\":0.06187598779797554}\"}","recommend_group_id":"7701560211311447065","play_cnt":318565,"book_exist":false,"copyright":"杭州禾浩文化传媒有限公司","sub_title":"古装·全206集","score":"8.2","use_video_model":true,"episode_cnt":206,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5475,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5475&categoryName=古装&genreType=130&gender=0&source=detail\"},{\"category_id\":5493,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5493&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5503,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categ