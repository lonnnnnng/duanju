el-pic/9f61512edee0f43c55de4b42aba461de~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164590&x-signature=xY5h0yA89tImz4eNZjop0bto3Tg%3D","duration":3058,"title":"装穷回家，考验俩儿子的孝心","video_desc":"二十多年前，周振山因车祸失忆，与妻儿失散。多年后，他已成为集团董事长，带着一份“两个儿子各继承一半家产”的遗嘱装穷回家认亲。但这份遗嘱还没有签字——谁真心认这个穷爹、谁真正孝顺母亲，谁才有资格继承；谁把父母当累赘，谁就可能一分钱都拿不到。一个住洋楼却连药费都不肯出，一个穷得揭不开锅却坚持养爹娘。随着一次次考验，原本五五开的继承权悄然改变。真正能继承财富的人，先要守得住亲情、孝心与担当。","series_id":"7694113790018718745","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623562907661CDEE2C174A8D3A3\",\"rank\":\"2\",\"queue_names\":\"aigc,shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7694113790018718745\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.052618950605392456,\\\"like\\\":0.07585817575454712,\\\"staytime_stream\\\":2.0932469367980957,\\\"normalized_duration\\\":0.8595320582389832,\\\"stream_ctr\\\":0.07179030030965805,\\\"absolute_staytime\\\":0.27125728130340576,\\\"finish\\\":0.08151976019144058}\"}","recommend_group_id":"7694113790018718745","play_cnt":7693762,"book_exist":false,"copyright":"杭州萧山破格出品文化创意工作室个体工商户","sub_title":"家庭·全48集","score":"8.1","use_video_model":true,"episode_cnt":48,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5468,\"name\":\"家庭\",\"schema\":\"dragon8662://categorySearch?categoryId=5468&categoryName=家庭&genreType=130&gender=1&source=detail\"},{\"category_id\":5509,\"name\":\"家庭伦理\",\"schema\":\"dragon8662://categorySearch?categoryId=5509&categoryName=家庭伦理&genreType=130&gender=1&source=detail\"},{\"category_id\":5672,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5672&categoryName=隐藏大佬&genreType=130&gender=1&source=detail\"},{\"category_id\":5734,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5734&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5777,\"name\":\"总裁\",\"schema\":\"dragon8662://cat