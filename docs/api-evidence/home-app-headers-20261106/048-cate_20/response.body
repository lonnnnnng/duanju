{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7480029684932037656","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/5f22bebb8610eca9fe6b4035dffb1cd3~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164654&x-signature=zarqj4akhw0FAmo4LnGHtAZ3Yso%3D","duration":3963,"title":"痴心似马戏","video_desc":"三十年前，盛长青为了陪伴被白月光抛弃、沉沦痛苦的陆亦婷，放弃出国继承万亿财产的机会。三十年后，盛长青成家生子，却被全家嫌弃。功成名就的白月光回国，陆亦婷和女儿在其面前笑颜如花，盛长青心灰意冷，决然出国，打算把妻女还给白月光 。","series_id":"7479257084605778969","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235733C9977BA2E984A0BA48DA\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7479257084605778969\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.03210071101784706,\\\"like\\\":0.0534033365547657,\\\"finish\\\":0.012821215204894543,\\\"normalized_duration\\\":0.692679762840271,\\\"staytime_stream\\\":1.020640254020691,\\\"absolute_staytime\\\":0.10874496400356293,\\\"stream_ctr\\\":0.04637458175420761}\"}","recommend_group_id":"7479257084605778969","play_cnt":14278,"book_exist":false,"copyright":"掌阅科技","sub_title":"成长·逆袭翻身","score":"8.2","use_video_model":true,"episode_cnt":30,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source