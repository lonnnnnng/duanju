庭背景在总决赛现场遭遇潜规则。就在张雨心灰意冷时，却得知卖牛肉面的父亲竟是金融大佬，已经为他买下整个篮球联盟，而他的篮球生涯也将走向另一个完全不同的方向。","series_id":"7471584591954840601","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235733C9977BA2E984A0BA48DA\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7471584591954840601\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.716064989566803,\\\"staytime_stream\\\":1.022534728050232,\\\"absolute_staytime\\\":0.09157242625951767,\\\"collect\\\":0.031143829226493835,\\\"finish\\\":0.001325022429227829,\\\"stream_ctr\\\":0.012789163738489151,\\\"like\\\":0.052618950605392456}\"}","recommend_group_id":"7471584591954840601","play_cnt":36497,"book_exist":false,"copyright":"漫森短剧","sub_title":"都市·竞技逆袭","score":"8.2","use_video_model":true,"episode_cnt":67,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5042,\"name\":\"竞技逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5042&categoryName=竞技逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5163,\"name\":\"马甲文\",\"schema\":\"dragon8662://categorySearch?categoryId=5163&categoryName=马甲文&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5203,\"name\":\"神豪\",\"schema\":\"dragon8662://categorySearch?categoryId=5203&categoryName=神豪&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=