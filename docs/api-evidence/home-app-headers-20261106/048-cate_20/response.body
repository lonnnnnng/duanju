"},{\"category_id\":5107,\"name\":\"自我救赎\",\"schema\":\"dragon8662://categorySearch?categoryId=5107&categoryName=自我救赎&genreType=130&gender=2&source=detail\"},{\"category_id\":5191,\"name\":\"空间\",\"schema\":\"dragon8662://categorySearch?categoryId=5191&categoryName=空间&genreType=130&gender=2&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=2&source=detail\"},{\"category_id\":5314,\"name\":\"乡村\",\"schema\":\"dragon8662://categorySearch?categoryId=5314&categoryName=乡村&genreType=130&gender=2&source=detail\"}]","color_dominate":"#402818","horiz_cover":"","sub_title_list":[{"content":"逆袭","data_type":3},{"content":"2299万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"逆袭\",\"data_type\":3},{\"content\":\"2299万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7481205614408911896","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/79e6834dc47ef8d99f5891cc6231dc51~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164654&x-signature=4dmLZ%2Fk8rjtejis2VN2QvKO2OE0%3D","duration":6275,"title":"恩意如山见孝心","video_desc":"《扶贫攻坚战》节目组带着三线艺人张瑞龙来贫困户李国强家进行直播扶贫，网友们看着李国强的家震惊了，你们管这叫贫困户？吃的野蘑菇是顶级黑松露，池塘养的是保护动物蓝鳍帝王鲑，喂猪的猪食盆是国宝级天青釉钧瓷器——满铭文双耳蟠龙盆，住的老宅子更是用价值千亿的顶级金丝楠木建造而成，这哪是贫困户，这明明就是财神爷啊！","series_id":"7481187872188402713","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235733C9977BA2E984A0BA48DA\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7481187872188402713\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0015011823270469904,\\\"normalized_duration\\\":0.6779567003250122,\\\"staytime_stream\\\":0.837309718132019,\\\"absolute_staytime\\\":0.07711171358823776,\\\"like\\\":0.05108273774385452,\\\"collect\\\":0.031143829226493835,\\\"stream_ctr\\\":0.04876890778541565}\"}","recommend_group_id":"7481187872188402713","play_cnt":121845,"book_exist":false,"copyright":"树下的椰子","sub_title":"都市·逆袭翻身","score":"8.1","use_video_model":true,"episode_cnt":55,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5252,\"name\":\"直播\",\"schema\":\"dragon8662://categorySearch?categoryId=5252&categoryName=直播&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=1&source=detail\"}]","color_dominate":"#403028","horiz_cover":"","sub_title_list":[{"content":"都市","data_type":3},{"content":"3393万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"都市\