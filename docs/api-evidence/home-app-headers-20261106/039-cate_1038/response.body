\\\":0.035678550601005554,\\\"like\\\":0.0446808747947216,\\\"staytime_stream\\\":0.9259138107299805,\\\"stream_ctr\\\":0.022471999749541283}\"}","recommend_group_id":"7424053455230094398","play_cnt":15983,"book_exist":false,"copyright":"U书网","sub_title":"传奇·战争传奇","score":"8.1","use_video_model":true,"episode_cnt":70,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5011,\"name\":\"传奇\",\"schema\":\"dragon8662://categorySearch?categoryId=5011&categoryName=传奇&genreType=130&gender=1&source=detail\"},{\"category_id\":5090,\"name\":\"战争传奇\",\"schema\":\"dragon8662://categorySearch?categoryId=5090&categoryName=战争传奇&genreType=130&gender=1&source=detail\"},{\"category_id\":5266,\"name\":\"将军\",\"schema\":\"dragon8662://categorySearch?categoryId=5266&categoryName=将军&genreType=130&gender=1&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=1&source=detail\"},{\"category_id\":5387,\"name\":\"家国情怀\",\"schema\":\"dragon8662://categorySearch?categoryId=5387&categoryName=家国情怀&genreType=130&gender=1&source=detail\"}]","color_dominate":"#301010","horiz_cover":"","sub_title_list":[{"content":"传奇","data_type":3},{"content":"1376万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"传奇\",\"data_type\":3},{\"content\":\"1376万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7433263315444304958","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/360f773f83e958f28174bc3fff16331e~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164638&x-signature=exS2RIUuLe2ttXHK7evGN%2Fm%2F%2Bf8%3D","duration":3418,"title":"归龙","video_desc":"林家弃子，初代龙王林阳，消失三年，终于在江城重新露面。然而前妻却蛇蝎心肠，因为不肯借出十万块钱，直接害死林阳生母。一怒之下，林阳恢复龙王身份，在苏氏集团庆功宴上打脸众人。然而也是在这场庆功宴上，林阳得知当年他之所以被逐出林家，皆因林家内奸林海超勾结帝京四大家族。","series_id":"7432283116800052249","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235716961570B8D1EE20A76932\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7432283116800052249\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.2675540447235107,\\\"absolute_staytime\\\":0.11219688504934311,\\\"stream_ctr\\\":0.04318547248840332,\\\"collect\\\":0.04146227985620499,\\\"normalized_duration\\\":0.7230920195579529,\\\"like\\\":0.0541987344622612,\\\"finish\\\":0.016914913430809975}\"}","recommend_group_id":"7432283116800052249","play_cnt":11103,"book_exist":false,"copyright":"广州林阳文化传媒有限公司","sub_title":"都市·超凡逆袭","score":"8.0","use_video_model":true,"episode_cnt":39,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5163,\"name\":\"马甲文\",\"schema\":\"dragon8662://categorySearch?categoryId=5163&categoryName=马甲文&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"n