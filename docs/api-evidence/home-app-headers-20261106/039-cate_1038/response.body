_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7680026445510347800","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/0108229a166db860f06eb77b3f3d19b1~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164638&x-signature=oBMK5oXDPv1t%2B35O7MotSYQJ%2BYE%3D","duration":10336,"title":"魔鬼家教上门，专治大小姐不服","video_desc":"无敌兵王叶天意外救下绝美女总裁苏凌月，两人度过美妙一夜，本以为相助过后就此别过，谁知上司以一纸密令让他保护苏凌月的三位千金！叶天化身家教入驻苏家，却发现苏家三姐妹个个身怀绝技。大姐是高岭之花，绝美总裁，二姐是宗师高手，武道女神，三妹则是天才黑客，娇俏萌妹。这三位千金向来心高气傲，视男人于无物！然而叶天只是略微出手，就把她们治得服服帖帖，争着求老师指导学习。","series_id":"7680023610152455230","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235716961570B8D1EE20A76932\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7680023610152455230\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.05251910164952278,\\\"finish\\\":0.0011695103021338582,\\\"collect\\\":0.0384662002325058,\\\"normalized_duration\\\":0.707722544670105,\\\"like\\\":0.05921025201678276,\\\"staytime_stream\\\":1.3320425748825073,\\\"absolute_staytime\\\":0.13746649026870728}\"}","recommend_group_id":"7680023610152455230","play_cnt":1299045,"book_exist":false,"copyright":"湖南六翼影视","sub_title":"逆袭·都市玄幻","score":"8.2","use_video_model":true,"episode_cnt":88,"video_platform":3,"disable_play":false,"ca