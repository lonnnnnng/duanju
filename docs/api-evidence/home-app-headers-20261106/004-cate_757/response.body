ovelpic.com/novel-pic/f1f91e1ee3bd6d7ca6cdb4db7909e780~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164572&x-signature=lUXKfJCHwRSqCzS25jw5UGpfnz4%3D","duration":6757,"title":"北凉之主","video_desc":"剑侠叶长庚，剑法无双，名震江湖。他行侠仗义，以正义公平为信仰，破敌千里，让恶徒闻风丧胆。在冒险与历练中，他提升剑法，收获友情与爱情，更加成熟坚强。叶长庚的传奇故事传颂不衰，成为后世剑侠的学习榜样。他继续行走江湖，用力量与智慧守护正义与和平，成为一代传奇剑侠。","series_id":"7412500606826335257","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235611AA83E48BEA339496AA43\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7412500606826335257\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.020571168512105942,\\\"staytime_stream\\\":1.4133280515670776,\\\"normalized_duration\\\":0.9990848898887634,\\\"absolute_staytime\\\":0.14183014631271362,\\\"like\\\":0.08756384253501892,\\\"finish\\\":0.029760098084807396,\\\"collect\\\":0.04603390023112297}\"}","recommend_group_id":"7412500606826335257","play_cnt":13234,"book_exist":false,"copyright":"心动短剧","sub_title":"都市·超凡逆袭","score":"8.1","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5158,\"name\":\"强者回归\",\"schema\":\"dragon8662://categorySearch?categoryId=5158&categoryName=强者回归&genreType=130&gender=1&source=detail\"},{\"category_id\":5204,\"name\":\"龙王\",\"schema\":\"dragon8662://categorySearch?categoryId=5204&categoryName=龙王&genreType=130&gender=1&source=detail\