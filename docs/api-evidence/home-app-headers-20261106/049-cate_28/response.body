，学生时代就与高冷校花温凝结缘。二人在相处中相互吸引，克服困难，考上大学后确定关系，开启幸福旅程。","series_id":"7491152575228562456","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235735AE60A2C7B94EBF979540\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7491152575228562456\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.05500529333949089,\\\"staytime_stream\\\":1.167923092842102,\\\"normalized_duration\\\":0.7049634456634521,\\\"stream_ctr\\\":0.04494926333427429,\\\"finish\\\":0.001987774157896638,\\\"collect\\\":0.039048295468091965,\\\"absolute_staytime\\\":0.10705902427434921}\"}","recommend_group_id":"7491152575228562456","play_cnt":19119,"book_exist":false,"copyright":"tomatotv","sub_title":"爱情·都市爱情","score":"8.2","use_video_model":true,"episode_cnt":64,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=2&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=2&source=detail\"},{\"category_id\":5054,\"name\":\"萌宝助攻\",\"schema\":\"dragon8662://categorySearch?categoryId=5054&categoryName=萌宝助攻&genreType=130&gender=2&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=2&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=2&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=2&source=detail\"}]","color_dominate":"#f0d0d0","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"1600万热度","data_type":27}],"pay_info":{}