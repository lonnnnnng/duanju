:1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7690540219098991641","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/9bac91b565d285597e920ada6feef594~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164574&x-signature=0rw1vYyihgVQh0BqGjVA8qMgLW0%3D","duration":9447,"title":"灾年逆袭：我靠穿越养全家","video_desc":"灾年大旱，吃光全家口粮膘肥体胖的林瑶抛下丈夫和两个孩子跟别人跑了，最后被渣男骗，下场凄惨。现代农业大学生林瑶熬夜猝死，一觉醒来，自己穿进了这本年代小说里，成了即将抛夫弃子跟人跑路的胖女人，就在绝望之际，林瑶发现自己激活了穿越系统，可以自由穿梭两个世界，为了在50年代的灾年活下去，林瑶凭借着自己的专业知识以及可以穿越时空的能力，带领一家老小过上了顿顿吃肉啃大馒头的好日子！","series_id":"7690494161551625241","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235613B05D87EDBCFE6F96B0A5\",\"rank\":\"9\",\"queue_names\":\"aigc,shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7690494161551625241\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.05582313612103462,\\\"normalized_duration\\\":0.8011719584465027,\\\"absolute_staytime\\\":0.224880188703537,\\\"finish\\\":0.004198795184493065,\\\"like\\\":0.07477004826068878,\\\"staytime_stream\\\":1.766563057899475,\\\"stream_ctr\\\":0.03281976655125618}\"}","recommend_group_id":"7690494161551625241","play_cnt":16093855,"book_exist":false,"copyright":"大同禾乐文化传媒有限公司","sub_title":"年代·全100集","score":"8.1","use_video_model":true,"episode_cnt":100,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5464,\"name\":\"年代\",\"schema\":\"dragon8662://categorySearch?categoryId=5464&categoryName=年代&genreType=130&gender=0&source=detail\"},{\"category_id\":5547,\"name\":\"荒年生存\",\"schema\":\"dragon8662://categorySearch?categoryId=5547&categoryName=荒年生存&genreType=130&gender=0&source=detail\"},{\"category_id\":5503,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5503&categor