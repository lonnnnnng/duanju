年的真相。","series_id":"7700862621431385113","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235613B05D87EDBCFE6F96B0A5\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7700862621431385113\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.01590639166533947,\\\"stream_ctr\\\":0.04554492607712746,\\\"staytime_stream\\\":1.855968952178955,\\\"collect\\\":0.04401865601539612,\\\"normalized_duration\\\":0.7416868805885315,\\\"absolute_staytime\\\":0.20636165142059326,\\\"like\\\":0.06656919419765472}\"}","recommend_group_id":"7700862621431385113","play_cnt":4868436,"book_exist":false,"copyright":"快创短剧","sub_title":"悬疑·悬疑情感","score":"8.1","use_video_model":true,"episode_cnt":78,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5004,\"name\":\"悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5004&categoryName=悬疑&genreType=130&gender=0&source=detail\"},{\"category_id\":5056,\"name\":\"悬疑情感\",\"schema\":\"dragon8662://categorySearch?categoryId=5056&categoryName=悬疑情感&genreType=130&gender=0&source=detail\"},{\"category_id\":5107,\"name\":\"自我救赎\",\"schema\":\"dragon8662://categorySearch?categoryId=5107&categoryName=自我救赎&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"},{\"category_id\":5370,\"name\":\"推理解谜\",\"schema\":\"dragon8662://categorySearch?categoryId=5370&categoryName=推理解谜&genreType=130&gender=0&source=detail\"}]","color_dominate":"#101820","horiz_c