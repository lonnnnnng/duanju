:[{"vid":"7540149488283831320","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/768d69d69c2accce0a2f9e36a276a51f~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164634&x-signature=oeBIwPOOfWabJ5%2F%2BJTsoczEMdpw%3D","duration":6616,"title":"清禾往事","video_desc":"80年代的准大学生苏念禾，救下军团长江砚清后，二人身中迷药，一夜后意外怀孕。饱受原生家庭迫害的苏念禾，被江砚清接回家成为江家团宠，在与江砚清感情升温的同时，仍不放弃学习提升自我，最终实现人生价值，成为更多女性的榜样。","series_id":"7540117710311525401","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235712D40A34C3146D4BA6F40B\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7540117710311525401\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.07031762599945068,\\\"absolute_staytime\\\":0.12913784384727478,\\\"finish\\\":0.028007525950670242,\\\"like\\\":0.06187598779797554,\\\"normalized_duration\\\":1.0191010236740112,\\\"staytime_stream\\\":1.0670528411865234,\\\"collect\\\":0.04208773002028465}\"}","recommend_group_id":"7540117710311525401","play_cnt":12735,"book_exist":false,"copyright":"爱微剧","sub_title":"爱情·年代爱情","score":"8.2","use_video_model":true,"episode_cnt":61,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5131,\"name\":\"年代爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5131&categoryName=年代爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&cat