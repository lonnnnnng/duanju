ic/990ee03c1bf7d8963ed210ed07e6af85~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164634&x-signature=UQ6Kb30%2F79gBtENpxi4NDuS4krk%3D","duration":7748,"title":"长恨长勿念","video_desc":"姜家大少爷姜承年爱惨了高冷团长阮语槐，三年之中，勾引了她九百九十九次，可仍旧没把她拉下神坛。姜承年的心彻底死了，答应父亲，替父亲继子去乡下联姻的要求，想以此远离阮语槐。然而当他离开后，阮语槐才发现，其实她早已喜欢上了姜承年","series_id":"7569114569340095512","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235712D40A34C3146D4BA6F40B\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7569114569340095512\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.13963128626346588,\\\"collect\\\":0.0378924235701561,\\\"like\\\":0.06371499598026276,\\\"normalized_duration\\\":1.1090631484985352,\\\"stream_ctr\\\":0.025736480951309204,\\\"staytime_stream\\\":1.2683558464050293,\\\"finish\\\":0.02843603305518627}\"}","recommend_group_id":"7569114569340095512","play_cnt":51079,"book_exist":false,"copyright":"风趣生活家5SD","sub_title":"成长·逆袭翻身","score":"8.2","use_video_model":true,"episode_cnt":66,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=1&source=detail\"},{\"category_id\":5182,\"name\":\"爱恨纠葛\",\"schema\":\"dragon8662://categorySearch?categoryId=5182&categoryName=爱恨纠葛&genreType=130&gender=1&source=detail\"},{\"category_id\":5314,\"name\":\"乡村\",\"schema\":\"dragon8662://categorySearch?categoryId=5314&categoryName=乡村&genreType=130&gender=1&source=detail\"}]","color_dominate":"#383828",