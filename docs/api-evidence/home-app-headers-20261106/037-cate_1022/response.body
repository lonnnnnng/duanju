,\\\"stream_ctr\\\":0.03535357490181923}\"}","recommend_group_id":"7585461583984200729","play_cnt":142107,"book_exist":false,"copyright":"河马剧场","sub_title":"成长·重生逆袭","score":"8.2","use_video_model":true,"episode_cnt":89,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=1&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5049,\"name\":\"婚姻经营\",\"schema\":\"dragon8662://categorySearch?categoryId=5049&categoryName=婚姻经营&genreType=130&gender=1&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"}]","color_dominate":"#182020","horiz_cover":"","sub_title_list":[{"content":"成长","data_type":3},{"content":"2358万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"成长\",\"data_type\":3},{\"content\":\"2358万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7585405540994386969","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/7ec7e9701a73dea83b1ea73de5025b33~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164634&x-signature=PfYPsx1p6umBLDN%2BxvLT9CPakVY%3D","duration":6386,"title":"灿如春花","video_desc":"杨春花惨遭未婚夫吴子轩背叛，多年付出付诸东流。她挥刀泄愤被赵辰生拦下，人生坠入谷底。为索回欠款，她与吴家展开激烈斗争。杨春花机缘巧合下住进赵家，并冒充赵辰生已退婚的未婚妻“小艳”，与赵家母子形成“假未婚妻，真合伙人”的微妙关系。赵辰生被其坚韧打动，开始默默支持。在赵辰生帮助下，杨春花重振旗鼓，盘下新铺子开设“春花包子铺”，并引入油条豆浆，开启多元化经营。吴子轩在办证、卫生等方面利用职权公报私仇。","series_id":"7585403344592587801","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235712D40A34C3146D4BA6F40B\",\"rank\":\"9\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7585403344592587801\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.0427221953868866,\\\"stream_ctr\\\":0.03226931765675545,\\\"absolute_staytime\\\":0.11575839668512344,\\\"like\\\":0.052618950605392456,\\\"normalized_duration\\\":0.9652189016342163,\\\"staytime_stream\\\":0.9721116423606873,\\\"finish\\\":0.024053551256656647}\"}","recommend_group_id":"7585403344592587801","play_cnt":2987,"book_exist":false,"copyright":"有鱼短剧","sub_title":"成长·女性成长","score":"8.2","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5046,\"name\":\"经营奋斗\",\"schema\":\"dragon8662://categorySearch?categoryId=5046&categoryName=经营奋斗&genreType=130&gender=0&source=detail\"},{\"category_id\":5131,\"name\":\"年代爱情\",\"schema\":\"dragon866