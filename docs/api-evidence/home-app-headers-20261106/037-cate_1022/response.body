的聪慧坚韧吸引，而两个女儿的遗传病、容貌等线索，也让众人发现乔星月正是谢中铭失踪多年的妻子。","series_id":"7605091731595332632","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235712D40A34C3146D4BA6F40B\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7605091731595332632\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.0534033365547657,\\\"stream_ctr\\\":0.03253879025578499,\\\"staytime_stream\\\":1.2798376083374023,\\\"finish\\\":0.03732689097523689,\\\"like\\\":0.07369627058506012,\\\"normalized_duration\\\":1.1521174907684326,\\\"absolute_staytime\\\":0.21291227638721466}\"}","recommend_group_id":"7605091731595332632","play_cnt":577638,"book_exist":false,"copyright":"树下的椰子","sub_title":"爱情·年代爱情","score":"8.1","use_video_model":true,"episode_cnt":70,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5131,\"name\":\"年代爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5131&categoryName=年代爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=0&source=detail\"},{\"category_id\":5095,\"name\":\"先婚后爱\",\"schema\":\"dragon8662://categorySearch?categoryId=5095&categoryName=先婚后爱&genreType=130&gender=0&source=detail\"},{\"category_id\":5226,\"name\":\"忠诚男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5226&categoryName=忠诚男主&genreType=130&gender=0&source=detail\"},{\"category_id\":5314,\"name\":\"乡村\",\"schema\":\"dragon8662://categorySearch?categoryId=5314&categoryName=乡村&genreType=130&gender=0&source=detail\"}]","color_dominate":"#404030","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"4422万热度","data_type":27}],"pay_info":{},"suppo