408","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/cf2bbd9d1f8ca9eb46db16df2dc3e7fb~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164634&x-signature=C4RZrpZV32xq5ZhfKvYSWKYuAJk%3D","duration":8338,"title":"八零小夫妻，闷声赚大钱","video_desc":"八十年代沪城福宁街，名声都不太好的姜梧攸与沈长庚，相亲偶遇后迅速敲定婚事。两人约法三章，冲破邻里流言、家庭矛盾，搞定难缠亲戚与骚扰者，跨过彩礼、婆媳多重考验。风光大婚之时，接亲小汽车的来路成谜，还埋下香江秘产与副业的双重伏笔。","series_id":"7703138867410390078","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235712D40A34C3146D4BA6F40B\",\"rank\":\"2\",\"queue_names\":\"aigc\",\"final_queue_name\":\"heji\",\"gid\":\"7703138867410390078\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.3678794503211975,\\\"collect\\\":0.07921033352613449,\\\"normalized_duration\\\":1.3017009496688843,\\\"stream_ctr\\\":0.027181372046470642,\\\"staytime_stream\\\":1.6842447519302368,\\\"finish\\\":0.09009299427270889,\\\"like\\\":0.08756384253501892}\"}","recommend_group_id":"7703138867410390078","play_cnt":889098,"book_exist":false,"copyright":"星河动画","sub_title":"爱情·全193集","score":"8.1","use_video_model":true,"episode_cnt":193,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5463,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5463&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5494,\"name\":\"年代爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5494&categoryName=年代爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5665,\"name\":\"闪婚\",\"schema\":\"dragon8662://categorySearch?categoryId=5665&categoryName=闪婚&genreType=130&gender=0&source=detail\"},{\"category_id\":9381,\"name\":\"圆满结局\",\"schema\":\"dragon8662://categorySearch?categoryId=9381&categoryName=圆满结局&genreType=130&gender=0&source=detail\"},{\"category_id\":5768,\"name\":\"直爽女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5768&categoryName=直爽女主&genreType