ps://p3-reading-sign.fqnovelpic.com/novel-pic/22c0c2117ad7095523c824d8710986c2~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164594&x-signature=4X4Ymez9CbqjNXGUNR71K8Z1sD8%3D","duration":3903,"title":"狐泪成珠，一黑一白辨人心","video_desc":"猎户贺长山在黑石岭救下一只会说人话的三尾白狐。谁也没想到，灵狐的一滴眼泪，竟能化成价值不菲的珠子。第一颗，是它心甘情愿报恩送的；可有了第一颗，人心就开始变了。夫妻俩从“再要一颗”，到“最后一次”，一步步把恩情变成索取。白珠越来越少，黑珠越来越多，直到所有珠子一夜腐裂，猎夹也反咬主人。等三尾灵狐再次公开现身，众人才明白，珠子有黑白，人心也有。真正属于你的福，靠抢，是留不住的。","series_id":"7684289302301264921","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623563272D32AF8F253A6AC3C1A\",\"rank\":\"6\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7684289302301264921\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.7113194465637207,\\\"absolute_staytime\\\":0.2145821899175644,\\\"stream_ctr\\\":0.030637141317129135,\\\"finish\\\":0.025957362726330757,\\\"collect\\\":0.05108273774385452,\\\"normalized_duration\\\":0.7941612601280212,\\\"like\\\":0.06560484319925308}\"}","recommend_group_id":"7684289302301264921","play_cnt":288762,"book_exist":false,"copyright":"麒麟创作","sub_title":"志怪·全62集","score":"8.1","use_video_model":true,"episode_cnt":62,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5955,\"name\":\"志怪\",\"schema\":\"dragon8662://categorySearch?categoryId=5955&categoryName=志怪&genreType=130&gender=2&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=2&source=detail\"},{\"category_id\":5956,\"name\":\"民俗志怪\",\"schema\":\"dragon8662://categorySearch?categoryId=5956&categoryName=民俗志怪&genreType=130&gender=2&source=detail\"},{\"category_id\":6146,\"name\":\"人性寓言\",\"schema\":\"dragon8662://categorySearch?categoryId=6146&categoryName=人性寓言&genreType=130&gender=2&source=detail\"},{\"category_id\":6081,\"name\":\"报恩\",\"schema\":\"dragon8662:/