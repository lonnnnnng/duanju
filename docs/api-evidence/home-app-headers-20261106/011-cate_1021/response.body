4586&x-signature=uilsF4a8CcdCWqgJbn3KShKbqmk%3D","duration":4242,"title":"红豆生南国","video_desc":"乡下女子乔希月，父母双亡，被村里人当成灾星。孤苦无依的她想要就此了结生命，最后关头，落难公子裴少商闯进来，俩人相互救了对方性命，自此一见钟情，私定终身。一个月后，裴少商需要回城处理家族内斗，担心会有危险伤害到乔希月，裴少商留下一纸婚书，承诺一定会回来娶她回家。这一去就是五年，乔希月独自生下女儿裴天恩，一直在等裴少商来接自己。","series_id":"7462562133725678617","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235625BB70925D24D0B98FB72A\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7462562133725678617\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.030675802379846573,\\\"finish\\\":0.009412589482963085,\\\"absolute_staytime\\\":0.09301449358463287,\\\"normalized_duration\\\":0.7287633419036865,\\\"stream_ctr\\\":0.044095296412706375,\\\"like\\\":0.047425877302885056,\\\"staytime_stream\\\":0.9726874232292175}\"}","recommend_group_id":"7462562133725678617","play_cnt":129841,"book_exist":false,"copyright":"触摸/亘淼","sub_title":"爱情·都市爱情","score":"8.3","use_video_model":true,"episode_cnt":53,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5182,\"name\":\"爱恨纠葛\",\"schema\":\"dragon8662://categorySearch?categoryId=5182&categoryName=爱恨纠葛&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=总裁&genreType=130&gender=0&source=detail\"},{\"category_id\":5299,\"name\":\"灰姑娘\",\"schema\":\"dragon8662://categorySearch?categoryId=5299&categoryName=灰姑娘&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId