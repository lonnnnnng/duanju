ture=HtTskrjhWin2vu3hMxkd%2BPa%2FPrM%3D","duration":10233,"title":"未来女儿托梦：我转身改嫁大佬","video_desc":"舞蹈系真千金宋青黛，反复梦见未来女儿楠楠预警未婚夫宋清珩会与假千金沈明珠出轨，自己将被逼死。订婚前夕，她一步步看清枕边人的虚伪，在闺蜜安雅牵线下结识大佬厉淮川。厉淮川看穿阴谋，多次向她施以援手。宋青黛撕碎悲惨既定命运，在江海之夜反击沈明珠，事业迎来转机，同时和厉淮川情愫渐生，一边对抗沈家、宋家的重重纠葛，一边期盼能和梦中的女儿好好告别。","series_id":"7702738405620206617","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235625BB70925D24D0B98FB72A\",\"rank\":\"5\",\"queue_names\":\"aigc\",\"final_queue_name\":\"aigc\",\"gid\":\"7702738405620206617\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.004468384198844433,\\\"stream_ctr\\\":0.033519525080919266,\\\"absolute_staytime\\\":0.19385886192321777,\\\"collect\\\":0.05184546485543251,\\\"normalized_duration\\\":0.808244526386261,\\\"like\\\":0.06278920918703079,\\\"staytime_stream\\\":1.63861882686615}\"}","recommend_group_id":"7702738405620206617","play_cnt":916103,"book_exist":false,"copyright":"九州","sub_title":"爱情·全141集","score":"8.3","use_video_model":true,"episode_cnt":141,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5463,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5463&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5491,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5491&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5644,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5644&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5754,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5754&categoryName=女强&genreType=130&gender=0&source=detail\"},{\"category_id\":5787,\"name\":\"真假千金\",\"schema\":\"dragon8662://categorySearch?categoryId=5787&categoryName=真假千金&genreType=130&gender=0&source=detail\"},{\"category_id\":5777,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=