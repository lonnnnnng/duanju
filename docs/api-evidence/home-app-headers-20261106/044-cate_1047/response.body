:{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7583354204354251801","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/34b9e67b9a403969db8a96391891bd58~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164647&x-signature=WCqtEzWcxqWfs4zK9DYoXYbINMg%3D","duration":9625,"title":"落榜后女道尊硬塞我半甲子功力","video_desc":"穿越者姬太初因家族获罪沦为死囚，被刘瑾胁迫入宫做假太监。入宫后他意外被敌对势力的皇后选中，又巧遇中毒的璇玑真人，获赠半甲子功力与功法。他周旋于皇后、钟贵妃等势力间，既要隐藏身份，又要应对宫廷争斗，还卷入皇帝修炼邪功的阴谋。最终，姬太初联手洪公公、璇玑真人等人，击败成魔的皇帝，事后拒绝留在宫中，选择携亲友仗剑天涯。","series_id":"7583352323666086937","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357253B41490D847509A38AA9\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7583352323666086937\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.04885777458548546,\\\"collect\\\":0.06187598779797554,\\\"like\\\":0.08509904891252518,\\\"staytime_stream\\\":1.6195104122161865,\\\"stream_ctr\\\":0.04068446904420853,\\\"absolute_staytime\\\":0.2691463530063629,\\\"normalized_duration\\\":1.2216413021087646}\"}","recommend_group_id":"7583352323666086937","play_cnt":1286496,"book_exist":false,"copyright":"刚刚好影视","sub_title":"古装·逆袭翻身","score":"8.1","use_video_model":true,"episode_cnt":75,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=1&source=detail\"},{\"category_id\":5191,\"name\":\"空间\",\"schema\":\"dragon8662://categorySearch?categoryId=5191&categoryName=空间&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=1&source=detail\"}]","color_dominate":"#402018","horiz_cover":"","sub_title_list":[{"content":"古装","data_type":3},{"content":"4062万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"古装\",\"data_type\":3},{\"content\":\"4062万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7604751780328524824","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/693564ca34a36fcb005e4f0750480a1b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164647&x-signature=scDd7Mhe%2BIMSI4uTbDWa8eKprx4%3D","duration":7423,"title":"江山墨染如画","video_desc":"林氏将门虎女，林染以林家军虎符为陪嫁，换来的不是凤冠霞帔，而是锥心背叛与圣旨和亲。那一夜，她斩断情丝，以天下为局，执棋对弈九五之尊。朝堂之上，她步步为营，誓要为林家满门忠烈讨回血债；宫阙之中，她算无遗策，将帝王的阴谋逐一碾碎。当龙位上的天子撕下伪善，欲行鱼死网破之时，她长刀所指，皆是民心所向。最终宫门洞开，群臣俯首，林染登临帝位，开创属于她的万里江山！","series_id":"7604749767226182680","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357253B41490D847509A38AA9\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7604749767226182680\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.393919825553894,\\\"absolute_staytime\\\":0.239383727312088,\\\"like\\\":0.07807816565036774,\\\"normalized_duration\\\":1.1577568054199219,\\\"finish\\\":0.05108273774385452,\\\"collect\\\":0.05184546485543251,\\\"stream_ctr\\\":0.037920109927654266}\"}","recommend_group_id":"7604749767226182680","play_cnt":116882,"book_exist":false,"copyright":"河马剧场","sub_title":"成长·女性成长","score":"8.2","use_video_model":true,"episode_cnt":65,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5137,\"name\":\"朝堂权谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5137&categoryName=朝堂权谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5155,\"name\":\"权臣篡位\",\"schema\":\"dragon8662://categorySearch?categoryId=5155&categoryName=权臣篡位&genreType=130&gender=0&source=detail\"},{\"category_id\":5152,\"name\":\"权力斗争\",\"schema\":\"dragon8662://categorySearch?categoryId=5152&categoryName=权力斗争&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"},{\"category_id\":5350,\"name\":\"情感觉醒\",\"schema\":\"dragon8662://categorySearch?categoryId=5350&categoryName=情感觉醒&genreType=130&gender=0&source=detail\"}]","color_dominate":"#181828","horiz_cover":"","sub_title_list":[{"content":"成长","data_type":3},{"content":"3510万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"成长\",\"data_type\":3},{\"content\":\"3510万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7585194278482086936","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/04416b72a5c889e3042d9491e65ea442~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164647&x-signature=%2Ba6l3HrrxGlLNg6humBoZxi8aIo%3D","duration":6993,"title":"大炎风云录","video_desc":"唐逸意外穿越成古代官宦人家的少爷，一睁眼竟发现自己躺在床榻上。正惊疑不定之际，一群壮汉破门而入，声称要将他抓去祭天。千钧一发之时，他才意识到这是继母与嫂子联手设下的毒计，意图借机除掉他。然而，身为现代特种兵王的唐逸岂是任人宰割之辈？他临危不乱，果断反击——当场制服主谋，揭穿阴谋；面对继母的阴险算计和嫂子的虚伪嘴脸，他毫不留情地予以回击；更以雷霆手段震慑朝堂，令那些曾落井下石的文武百官闻风丧胆。","series_id":"7585192287454383166","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357253B41490D84750