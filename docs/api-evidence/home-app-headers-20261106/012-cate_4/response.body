{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7633756387566177342","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/b665f2dbddccd082121609a20900ff0d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164588&x-signature=Ge9BAhr5G50X1%2BvbuBIct2xl244%3D","duration":7468,"title":"无主之花1","video_desc":"沈明月年少便看透法则，父亲被权贵欺压、导致丧命，让她一夜之间长大并且明白——权力即真理。为摆脱困境，她步步为营，接近金字塔尖的权贵。自此纯真是面具，狠辣是内核。她靠自己的努力渐渐从小城女孩蜕变为权贵圈人人追逐的白月光。","series_id":"7633754451936807998","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235627750FD263F40206929CE5\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7633754451936807998\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.1650340557098389,\\\"finish\\\":0.036220062524080276,\\\"collect\\\":0.05665243789553642,\\\"like\\\":0.06954174488782883,\\\"absolute_staytime\\\":0.17513687908649445,\\\"normalized_duration\\\":1.0940033197402954,\\\"stream_ctr\\\":0.04630983993411064}\"}","recommend_group_id":"7633754451936807998","play_cnt":2766717,"book_exist":false,"copyright":"无糖文化","sub_title":"成长·女性成长","score":"8.1","use_video_model":true,"episode_cnt":71,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&sou