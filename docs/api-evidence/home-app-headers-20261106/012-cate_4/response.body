2e&x-expires=1799164588&x-signature=Z7uhq6MKdNaKG54jR3YT0LYPyT0%3D","duration":9733,"title":"都重生了，别叫我假富二代","video_desc":"拿了千万拆迁款却硬装富二代，前世陆川把自己活成了全城笑话，一朝梦醒，重回十八岁，他撕掉所有浮华伪装，只想做个安分读书的透明人。然而，他越是收敛锋芒，那份前世淬炼出的顶级眼界、对财富走向的精准预判，以及骨子里透出的处事定力，却越是疯狂出卖他。在旁人眼中，这位低调的舍友，俨然成了京城深宅里走出的世家真龙。本短剧改编自番茄小说《都重生了，谁还装富二代啊》作者爱和美式","series_id":"7698297752161094680","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235627750FD263F40206929CE5\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7698297752161094680\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.058345843106508255,\\\"absolute_staytime\\\":0.28206294775009155,\\\"finish\\\":0.052618950605392456,\\\"normalized_duration\\\":1.1991831064224243,\\\"stream_ctr\\\":0.03144095465540886,\\\"like\\\":0.07696083933115005,\\\"staytime_stream\\\":1.3785591125488281}\"}","recommend_group_id":"7698297752161094680","play_cnt":11444364,"book_exist":false,"copyright":"奇迹时代","sub_title":"都市·重生逆袭","score":"8.2","use_video_model":true,"episode_cnt":103,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5107,\"name\":\"自我救赎\",\"schema\":\"dragon8662://categorySearch?categoryId=5107&categoryName=自我救赎&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=1&source=detail\"}]","color_dominate":"#302018","horiz_cover":""