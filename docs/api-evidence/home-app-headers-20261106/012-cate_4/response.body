g-sign.fqnovelpic.com/novel-pic/f00220389db43b07ea6f3652ee7ae9df~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164588&x-signature=%2BNZR%2Bd%2FWQSw6V5fLFlPwpA%2BWlp8%3D","duration":7947,"title":"一块槽头肉，养出个省状元","video_desc":"刘月姐弟原生家庭处境艰难，肉摊老板吴江得知姐弟遭遇后，不仅默许刘月拿槽头肉为营养不良的弟弟刘阳补身体，还收留两姐弟，供两姐弟读书、吃穿，多年以后，刘月高考成为省状元，工作后成长为商界精英，而刘阳则成为主治医生，二人功成名就，以丰厚回报感恩当年吴江的救命养育之恩。","series_id":"7685980827544456254","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235627750FD263F40206929CE5\",\"rank\":\"7\",\"queue_names\":\"aigc\",\"final_queue_name\":\"heji\",\"gid\":\"7685980827544456254\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.07159119844436646,\\\"like\\\":0.09268778562545776,\\\"staytime_stream\\\":1.8008029460906982,\\\"finish\\\":0.07807816565036774,\\\"stream_ctr\\\":0.030561290681362152,\\\"absolute_staytime\\\":0.31961920857429504,\\\"normalized_duration\\\":1.2288204431533813}\"}","recommend_group_id":"7685980827544456254","play_cnt":5425737,"book_exist":false,"copyright":"杭州潮汐互娱网络科技有限公司","sub_title":"家庭·全86集","score":"8.0","use_video_model":true,"episode_cnt":86,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5468,\"name\":\"家庭\",\"schema\":\"dragon8662://categorySearch?categoryId=5468&categoryName=家庭&genreType=130&gender=0&source=detail\"},{\"category_id\":5510,\"name\":\"家庭温情\",\"schema\":\"dragon8662://categorySearch?categoryId=5510&categoryName=家庭温情&genreType=130&gender=0&source=detail\"},{\"category_id\":5677,\"name\":\"报恩\",\"schema\":\"dragon8662://categorySearch?categoryId=5677&categoryName=报恩&genreType=130&gender=0&source=detail\"},{\"category_id\":5678,\"name\":\"邻里互助\",\"schema\":\"dragon8662://categorySearch?categoryId=5678&categoryName=邻里互助&genreType=130&gender=0&source=detail\"},{\"category_id\":5763,\"name\":\"小人物\",\"schema\":\"dragon8662://categorySearch?categoryId=5763&categoryName=小人物&genre