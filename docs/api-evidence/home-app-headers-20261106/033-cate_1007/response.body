jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7571328978779114558","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/4438cfc0508b3c2e1cd3e3f8a475109b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164627&x-signature=0yqSb173WCNcNdTuj%2FI%2BowOVaLM%3D","duration":7764,"title":"小农民的春天","video_desc":"乡村青年陈二柱，平凡日子里因见义勇为落入河底，意外觉醒仙人传承。自此逆天改命，一手神针通玄，能活死人肉白骨，解世间疑难杂症；一身龙气磅礴，可点化草木、催生万物，福泽乡邻；更得绝世武术傍身，拳破风云、脚踏山河，无人能敌。从乡野小子到炙手可热的传奇，他凭一身绝技惩恶扬善、守护一方，在都市与乡野间书写逆袭传奇，引无数人敬仰追随！改编自番茄小说《二柱子，乡村好快活》作者天天不等闲。","series_id":"7571321796016753726","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235705A0A3CF8BE736CFA8F716\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7571321796016753726\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.20636165142059326,\\\"collect\\\":0.060086652636528015,\\\"normalized_duration\\\":1.0482468605041504,\\\"stream_ctr\\\":0.019280215725302696,\\\"finish\\\":0.03210071101784706,\\\"like\\\":0.07263670861721039,\\\"staytime_stream\\\":1.2455716133117676}\"}","recommend_group_id":"7571321796016753726","play_cnt":57010,"book_exist":false,"copyright":"tomatotv","sub_title":"逆袭·超凡逆袭","score":"8.3","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?cate