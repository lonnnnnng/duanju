，逆袭成为了冷面帝王裴玄的最爱。她一步步的揭穿所有的谜题、制止叛乱，最终成功登顶后位，和冷面帝王裴玄一起共成一段佳话。","series_id":"7486025539539455000","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235705A0A3CF8BE736CFA8F716\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7486025539539455000\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":1.116125464439392,\\\"staytime_stream\\\":1.5000756978988647,\\\"absolute_staytime\\\":0.22139376401901245,\\\"finish\\\":0.024053551256656647,\\\"stream_ctr\\\":0.05538076534867287,\\\"like\\\":0.08269734680652618,\\\"collect\\\":0.0541987344622612}\"}","recommend_group_id":"7486025539539455000","play_cnt":52422,"book_exist":false,"copyright":"tomatotv","sub_title":"古装·宫斗宅斗","score":"8.1","use_video_model":true,"episode_cnt":109,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=0&source=detail\"},{\"category_id\":5136,\"name\":\"宫斗宅斗\",\"schema\":\"dragon8662://categorySearch?categoryId=5136&categoryName=宫斗宅斗&genreType=130&gender=0&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=0&source=detail\"},{\"category_id\":5074,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5074&categoryName=奇幻脑洞&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gend