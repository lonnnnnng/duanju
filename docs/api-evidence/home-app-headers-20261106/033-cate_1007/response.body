{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7621073948410661913","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/5b8425341fb58e3ee85d7995f2bf4fda~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164627&x-signature=GXA7fV%2FymB13RhcXYufQErs5oh4%3D","duration":7942,"title":"拥有透视眼，破烂王变鉴宝王","video_desc":"收废品独眼的林峰意外获得能看穿物品价值的能力。他从售卖漆器、古币起步，在琢璞巷赌石，挫败周凯刁难，开出极品玉石；揭穿伪大师王晓刚骗局，为兄弟追回损失；受邀参加御藏鉴宝大赛，一路晋级，最终战胜宗师秦老，赢得御藏拍卖行执掌权。其间，女商人江若曦与珍品阁苏晚晴均对他倾心。林峰在财富与情感双丰收中，开启新篇章，成为古玩圈传奇，实现人生逆袭。","series_id":"7621072101448895513","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235705A0A3CF8BE736CFA8F716\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7621072101448895513\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":1.1068991422653198,\\\"stream_ctr\\\":0.03485386446118355,\\\"staytime_stream\\\":1.5903440713882446,\\\"finish\\\":0.05749328434467316,\\\"collect\\\":0.06465348601341248,\\\"like\\\":0.09268778562545776,\\\"absolute_staytime\\\":0.32212600111961365}\"}","recommend_group_id":"7621072101448895513","play_cnt":313738,"book_exist":false,"copyright":"世禾娱乐","sub_title":"都市·逆袭翻身","score":"8.1","use_video_model":true,"episode_cnt":64,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySea