LYCBz9JsbVfxphEeJNHZI%3D","duration":7950,"title":"红颜吐珠侍君王","video_desc":"相府千金苏凌霄虐杀蚌女，姜宝珠亲见母亲惨死。五年后，苏凌霄已是贵妃却患有不孕之症，其母送姜宝珠入宫。姜宝珠设计让苏家陷害贤妃，致苏母入狱，又诱苏凌霄服虫卵使其宫宴出丑。苏家覆灭，皇帝逐她出宫，五年后她隐居洛河。","series_id":"7504879162335710233","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235736B751C090D6139CA64B55\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7504879162335710233\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.046724967658519745,\\\"staytime_stream\\\":1.2870569229125977,\\\"normalized_duration\\\":1.1725486516952515,\\\"absolute_staytime\\\":0.1984560638666153,\\\"stream_ctr\\\":0.03486892953515053,\\\"finish\\\":0.0446808747947216,\\\"like\\\":0.07159119844436646}\"}","recommend_group_id":"7504879162335710233","play_cnt":240756,"book_exist":false,"copyright":"容量短剧","sub_title":"逆袭·女性成长","score":"8.0","use_video_model":true,"episode_cnt":61,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5136,\"name\":\"宫斗宅斗\",\"schema\":\"dragon8662://categorySearch?categoryId=5136&categoryName=宫斗宅斗&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5223,\"name\":\"神女\",\"schema\":\"dragon8662://categorySearch?categoryId=5223&categoryName=神女&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#30