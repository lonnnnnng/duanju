ur_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7502721162229582872","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/be227398181d00cd50d32e9852557af1~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164658&x-signature=Bl8rpOaeLnk5gGC2DHhX9tbyWRE%3D","duration":7389,"title":"别把本宫当摆设","video_desc":"大周皇后李伽宁，心思缜密，善用手段。上一世她辅佐继子封玄，助他登上皇位，登基当日，却被继子残忍杀害，还被告知自己多年未有身孕乃是皇上所为。李伽宁含恨而终，重来一世，她竟回到过继封玄那天。李伽宁不畏皇权，拒绝封玄过继，还救下封玄母亲许眠眠。封玄本以为被拒后，便使劲讨好李伽宁，却都被李伽宁巧妙拒绝。她还设计让封玄计谋败露，致其手刃生母。封玄下线后，李伽宁过继七皇子封萧，助其登上皇位。","series_id":"7502335014852381720","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235736B751C090D6139CA64B55\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7502335014852381720\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.050330642610788345,\\\"finish\\\":0.052618950605392456,\\\"stream_ctr\\\":0.04331894963979721,\\\"staytime_stream\\\":1.529566764831543,\\\"normalized_duration\\\":1.0924019813537598,\\\"like\\\":0.07477004826068878,\\\"absolute_staytime\\\":0.24506056308746338}\"}","recommend_group_id":"7502335014852381720","play_cnt":245091,"book_exist":false,"copyright":"风姿卓越青山nl","sub_title":"成长·朝堂权谋","score":"8.2","use_video_model":true,"episode_cnt":78,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5137,\"n