{"log_id":"20261106235736B751C090D6139CA64B55","code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7467067268308945945","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/14b93c66f62cafac28f92acc2e1132ee~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164658&x-signature=VF%2FRlWLQPsJoYYMWnEy6i9TSfMI%3D","duration":7745,"title":"好孕攻略","video_desc":"柳若曦是太师嫡女，为救被大将军高鄂陷害入狱的父亲，隐姓埋名入宫求见皇帝帝辛。帝辛因厌恶外戚十年未踏后宫，却意外与柳若曦相遇。事后，帝辛误以为她是谋权女子，欲斩之。六个月后，柳若曦怀孕，被欲夺后位的高贵妃发现，高贵妃欲处其五马分尸。帝辛得知真相后救下柳若曦及孩子。后宫争斗不断，但柳若曦最终与帝辛有情人终成眷属，传为佳话。","series_id":"7466282768117287961","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235736B751C090D6139CA64B55\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7466282768117287961\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.17789487540721893,\\\"like\\\":0.07055959850549698,\\\"collect\\\":0.04401865601539612,\\\"stream_ctr\\\":0.05714935436844826,\\\"staytime_stream\\\":1.1624703407287598,\\\"finish\\\":0.03210071101784706,\\\"normalized_duration\\\":1.0770423412322998}\"}","recommend_group_id":"7466282768117287961","play_cnt":573087,"book_exist":false,"copyright":"麦芽短剧","sub_title":"成长·逆袭翻身","score":"8.2","use_video_model":true,"episode_cnt":83,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schem