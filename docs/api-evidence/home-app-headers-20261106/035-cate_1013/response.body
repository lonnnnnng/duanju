{"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7583354204354251801","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/34b9e67b9a403969db8a96391891bd58~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164630&x-signature=zn%2BCgOaywUPZS3HCtmC4ezNV1SE%3D","duration":9625,"title":"落榜后女道尊硬塞我半甲子功力","video_desc":"穿越者姬太初因家族获罪沦为死囚，被刘瑾胁迫入宫做假太监。入宫后他意外被敌对势力的皇后选中，又巧遇中毒的璇玑真人，获赠半甲子功力与功法。他周旋于皇后、钟贵妃等势力间，既要隐藏身份，又要应对宫廷争斗，还卷入皇帝修炼邪功的阴谋。最终，姬太初联手洪公公、璇玑真人等人，击败成魔的皇帝，事后拒绝留在宫中，选择携亲友仗剑天涯。","series_id":"7583352323666086937","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235709C4292D40DAAB89A9A629\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7583352323666086937\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.28206294775009155,\\\"staytime_stream\\\":1.6902810335159302,\\\"finish\\\":0.05108273774385452,\\\"collect\\\":0.06097517907619476,\\\"stream_ctr\\\":0.02804066613316536,\\\"like\\\":0.08882028609514236,\\\"normalized_duration\\\":1.2027015686035156}\"}","recommend_group_id":"7583352323666086937","play_cnt":1286496,"book_exist":false,"copyright":"刚刚好影视","sub_title":"古装·逆袭翻身","score":"8.1","use_video_model":true,"episode_cnt":75,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5