"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7587720124195408920","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/c78e6f734eed68c15e1d8f2e8b78da32~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164630&x-signature=TCUUiOULpJZwKWPleW8mzl%2BeERg%3D","duration":9756,"title":"萌兽认主：大小姐竟是真神女","video_desc":"白婉月遭继妹陷害坠崖，意外唤醒被封印的魔尊殷无玦，获神女传承重塑灵骨。她携殷无玦与认主的神兽小龙宝重返家族复仇，揭穿阴谋。为寻母亲下落，白婉月进入学院，在炼丹大赛中击败丹霞公主，获得藏书阁线索，得知母亲踪迹指向月华国。众人前往都城，救下另一神兽小白泽，并揭露皇后叛乱阴谋，更发现自己竟是月华国公主。最终，白婉月与殷无玦联手铲除宿敌凶祟，情愫渐生，一家团圆。","series_id":"7587716188822572056","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235709C4292D40DAAB89A9A629\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7587716188822572056\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.4407693147659302,\\\"normalized_duration\\\":1.0940033197402954,\\\"absolute_staytime\\\":0.224880188703537,\\\"finish\\\":0.03258974477648735,\\\"collect\\\":0.05582313612103462,\\\"stream_ctr\\\":0.0551009438931942,\\\"like\\\":0.08035746961832047}\"}","recommend_group_id":"7587716188822572056","play_cnt":31463,"book_exist":false,"copyright":"tomatotv","sub_title":"玄幻·仙侠爱情","score":"8.1","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5008,\"name\":\"玄幻\",\"schema\":\"dragon8662://ca