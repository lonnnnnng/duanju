"帝国第一驸马","video_desc":"现代学霸关宁穿越成为镇北王府的同名“废物”世子，获得情绪系统，能吸收他人的情绪值，例如怨气、嫉妒、震惊等来提升自己的武道实力。外表看似玩世不恭、嚣张跋扈，实则头脑清醒，善于利用“纨绔”身份作为保护色，行事果断，精于攻心和制造舆论。他要在危机四伏的京城中生存下去，不断变强，洗刷污名，并查明父亲失踪的真相。","series_id":"7555063834872908825","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235709C4292D40DAAB89A9A629\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7555063834872908825\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.050330642610788345,\\\"stream_ctr\\\":0.03320466727018356,\\\"like\\\":0.07263670861721039,\\\"absolute_staytime\\\":0.24315345287322998,\\\"staytime_stream\\\":1.3495248556137085,\\\"finish\\\":0.0446808747947216,\\\"normalized_duration\\\":1.1342555284500122}\"}","recommend_group_id":"7555063834872908825","play_cnt":33150,"book_exist":false,"copyright":"tomatotv","sub_title":"逆袭·奇幻脑洞","score":"8.3","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5074,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5074&categoryName=奇幻脑洞&genreType=130&gender=1&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=1&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=5130&categoryName=系统&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5268,\