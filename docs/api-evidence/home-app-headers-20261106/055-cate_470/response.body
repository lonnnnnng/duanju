lse,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7511927502063799358","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/668d8546225b5e47fda119fd28b80183~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164666&x-signature=Ja3RFETTCxxIrXJRTzgRdXHn0mc%3D","duration":6837,"title":"七零新生，替身丈夫该你挨打了","video_desc":"前世丈夫李志刚贪恋寡嫂，冒名顶替大哥李志强。再睁眼，温凤霞回到得知李志刚和双胞胎大哥李志强同时落水的那天，温凤霞第一时间去给丈夫李志刚办理了销户，并联系了养哥顾卫国。最终，李志刚一家为自己的行为付出代价。改编自《重生七零，为寡嫂当替身的丈夫我不要了》。","series_id":"7510800525844024344","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623574516677A04A9492093DDC5\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7510800525844024344\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.09747834503650665,\\\"stream_ctr\\\":0.03744165971875191,\\\"finish\\\":0.002050743205472827,\\\"collect\\\":0.028007525950670242,\\\"normalized_duration\\\":0.7049634456634521,\\\"like\\\":0.047425877302885056,\\\"staytime_stream\\\":1.056919813156128}\"}","recommend_group_id":"7510800525844024344","play_cnt":99965,"book_exist":false,"copyright":"蓝胖友和黄老鼠","sub_title":"成长·重生逆袭","score":"8.0","use_video_model":true,"episode_cnt":66,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5314,\"name\":\"乡村\",\"schema\":\"dragon8662://categorySearch?categoryId=5314&categoryName=乡村&genreType=130&gender=0&source=detail\"},{\"category_id\":5350,\"name\":\"情感觉醒\",\"schema\":\"dragon8662://categorySearch?categoryId=5350&categoryName=情感觉醒&genreType=130&gender=0&source=detail\"}]","color_dominate":"#381008","horiz_cover":"","sub_title_list":[{"content":"成长","data_type":3},{"content":"3073万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"成长\",\"data_type\":3},{\"content\":\"3073万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7596907015931169817","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/2ca6407faf85a21864a989fa2ba04656~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164666&x-signature=UG9oQDf3%2FaUBBcztvjzyS0g7wzk%3D","duration":6057,"title":"替身当成了天花板，正主输麻了","video_desc":"为给孤儿院妹妹治病，秦墨与神州集团总裁姜子悦成为合约情侣。他表面幽默市侩，实则是江东地下之王与上京秦家失散的真少爷。秦墨以“替身”身份俘获姜家众人喜爱，更让姜子悦动了真心。姜子悦的白月光郑子渊回国谋夺财产，屡次挑衅却遭秦墨花式打脸。秦墨在揭露多重隐藏身份的同时，接连挫败郑子渊与假少爷秦晨的阴谋，最终与姜子悦情根深种，携手面对家族与地下世界的重重风波。","series_id":"7596905178628885529","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623574516677A04A9492093DDC5\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7596905178628885529\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.10057263821363449,\\\"finish\\\":0.0021827169694006443,\\\"collect\\\":0.0384662002325058,\\\"normalized_duration\\\":0.714667797088623,\\\"stream_ctr\\\":0.039993368089199066,\\\"like\\\":0.05108273774385452,\\\"staytime_stream\\\":1.1560298204421997}\"}","recommend_group_id":"7596905178628885529","play_cnt":218242,"book_exist":false,"copyright":"狂人日记","sub_title":"都市·逆袭翻身","score":"8.3","use_video_model":true,"episode_cnt":70,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=1&source=detail\"},{\"category_id\":5163,\"name\":\"马甲文\",\"schema\":\"dragon8662://categorySearch?categoryId=5163&categoryName=马甲文&genreType=130&gender=1&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5119,\"name\":\"轻松搞笑\",\"schema\":\"dragon8662://categorySearch?categoryId=5119&categoryName=轻松搞笑&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=总裁&genreType=130&gender=1&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=1&source=detail\"}]","color_dominate":"#301818","horiz_cover":"","sub_title_list":[{"content":"都市","data_type":3},{"content":"2836万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"都市\",\"data_type\":3},{\"content\":\"2836万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7564243496081558552","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/65595b14dc0eebd387d4d1ff4f14c38d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164666&x-signature=CP4efMzX6VEg7y6ZHvhFS%2BhyUkY%3D","duration":5458,"title":"贬妻为妾，十万天兵迎我归神位","video_desc":"千年前，因为一场仙魔大战，神女云漱玉的师尊云崖就此陨落。为愈情伤，云漱玉在凡间找到了一个与师尊相像的男子薛逸。云漱玉不仅嫁他为妻，还赐他家财万贯，助他考取功名，没想到薛逸考取功名后带着公主登堂入室，贬妻为妾。薛逸纵容公主处处与云漱玉为难，最后在与公主大婚上，薛逸又不小心毁了自己的脸，云漱玉对薛逸彻底死心，一剑刺中薛逸心口。然而，当薛逸知道自己是师尊的替身后，悔不当初。","series_id":"7564242739483659288","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623574516677A04A9492093DDC5\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7564242739483659288\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.7980484962463379,\\\"stream_ctr\\\":0.03786392882466316,\\\"like\\\":0.0534033365547657,\\\"staytime_stream\\\":1.2800374031066895,\\\"finish\\\":0.0049054063856601715,\\\"collect\\\":0.033589500933885574,\\\"absolute_staytime\\\":0.1353352814912796}\"}","recommend_group_id":"7564242739483659288","play_cnt":142846,"book_exist":false,"copyright":"掌阅科技","sub_title":"爱情·仙侠爱情","score":"8.3","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5063,\"name\":\"仙侠爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5063&categoryName=仙侠爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5092,\"name\":\"故人重逢\",\"schema\":\"dragon8662://categorySearch?categoryId=5092&categoryName=故人重逢&genreType=130&gender=0&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5254&categoryName=揭露阴谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&genreType=130&gender=0&source=detail\"},{\"category_id\":5223,\"name\":\"神女\",\"schema\":\"dragon8662://categorySearch?categoryId=5223&categoryName=神女&genreType=130&gender=0