how_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7559544694330362905","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/240a07cb0681d0149bbec4313c1c99a0~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164677&x-signature=fbycSmjChk8sAtIocoxgH75RTR4%3D","duration":6007,"title":"护你三年，神婿不装了","video_desc":"上仙叶凡为报恩，以赘婿入冯家护其渡劫，为冯婉君续命，却遭冯婉君嫌“废物”，逼其退婚，攀欧家。叶凡给三次悔婚机会，冯婉君两次浪费致守护松动、鬼差索命，仍在冯老太怂恿下撕婚约。天雷降临后，冯小萍靠平安扣暂解危机。后冯家遭难，叶凡除天狗，转世苟公子，拒冯家复合，了结羁绊后飞升。","series_id":"7559542827193994265","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235756B4E7008297FF02A1C2C9\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7559542827193994265\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.07055959850549698,\\\"stream_ctr\\\":0.03919446840882301,\\\"collect\\\":0.04603390023112297,\\\"staytime_stream\\\":1.3871430158615112,\\\"absolute_staytime\\\":0.19537930190563202,\\\"finish\\\":0.04885777458548546,\\\"normalized_duration\\\":1.101507544517517}\"}","recommend_group_id":"7559542827193994265","play_cnt":192225,"book_exist":false,"copyright":"山海星辰","sub_title":"都市·都市玄幻","score":"8.2","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5073,\"name\":\"都市玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5073&categoryName=都市玄幻&genreType=130&gender=1&source=detail\"},{\"catego