2","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/42ef81e18bd99d41366e410f5dc2e78f~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164677&x-signature=JcrP1aRLaCDUeHWAp1INAFKQM3E%3D","duration":9960,"title":"弃我者不可攀","video_desc":"秦川是被未婚妻抛弃的落魄世子，爱得卑微，却惨遭背叛。一朝觉醒王者归来，看秦川如何扭转乾坤，登上权力巅峰！在这充满权谋与争斗的世界里，秦川能否揭开父母死亡的真相？面对唐家的刁难、白家的陷害，秦川又将如何反击？","series_id":"7478925840504327193","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235756B4E7008297FF02A1C2C9\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7478925840504327193\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.06465348601341248,\\\"finish\\\":0.029760098084807396,\\\"collect\\\":0.046724967658519745,\\\"staytime_stream\\\":1.2743629217147827,\\\"absolute_staytime\\\":0.1984560638666153,\\\"stream_ctr\\\":0.04573979601264,\\\"normalized_duration\\\":1.1782879829406738}\"}","recommend_group_id":"7478925840504327193","play_cnt":245933,"book_exist":false,"copyright":"tomatotv","sub_title":"古装·逆袭翻身","score":"8.0","use_video_model":true,"episode_cnt":82,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5312,\"name\":\"架空\",\"schema\":\"dragon8662://categorySearch?categoryId=5312&categoryName=架空&genreType=130&gender=1&sour