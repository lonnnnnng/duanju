陈落落。陈凡答应妻子封拳，可在离开南城时遭遇仇家追杀，围追堵截。陈凡一心为女，立下不再打拳的承诺，仇家恐陈凡卷土重来，要求其自断拳路，无奈之下，陈凡自毁双眼，最终带着女儿离开南域。","series_id":"7471535134051683352","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235756B4E7008297FF02A1C2C9\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7471535134051683352\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.0378924235701561,\\\"like\\\":0.05665243789553642,\\\"finish\\\":0.02262919768691063,\\\"stream_ctr\\\":0.036778807640075684,\\\"normalized_duration\\\":0.9718396663665771,\\\"staytime_stream\\\":0.8122441172599792,\\\"absolute_staytime\\\":0.09301449358463287}\"}","recommend_group_id":"7471535134051683352","play_cnt":3125,"book_exist":false,"copyright":"树下的椰子","sub_title":"剧情·江湖武侠","score":"8.2","use_video_model":true,"episode_cnt":59,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5030,\"name\":\"剧情\",\"schema\":\"dragon8662://categorySearch?categoryId=5030&categoryName=剧情&genreType=130&gender=1&source=detail\"},{\"category_id\":5138,\"name\":\"江湖武侠\",\"schema\":\"dragon8662://categorySearch?categoryId=5138&categoryName=江湖武侠&genreType=130&gender=1&source=detail\"},{\"category_id\":5158,\"name\":\"强者回归\",\"schema\":\"dragon8662://categorySearch?categoryId=5158&categoryName=强者回归&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5340,\"name\":\"民国\",\"schema\":\"dragon8662://categorySearch?categoryId=5340&categoryName=民国&genreType=130&gender=1&source=detail\"},{\"category_id\":5367,\"name\":\"亲情\",\"schema\":\"dragon8662://categorySearch?categoryId=5367&categoryName=亲情&genreType=130&gender=1&source=detail\"}]","color_dominate":"#402818","horiz_cover":"","sub_title_list":[{"content":"剧情","data_type":3},{"content":"1490万