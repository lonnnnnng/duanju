so-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164677&x-signature=S7agDCYDafQrsR23kQkNoIaDb2s%3D","duration":6971,"title":"铁马冰河入梦来","video_desc":"秦峰本是藏龙殿的殿主，势力遍布全球。七年前，秦峰救下身为林氏集团总裁的林雨欣，与林雨欣一夜邂逅。七年后，林雨欣为秦峰生下女儿，四处寻找秦峰下落，但林雨欣并没见到秦峰的脸，只记得秦峰满背的龙纹纹身，和秦峰留下的信物。七年间，秦峰退隐后在一家修车厂当修理工，同时资助战友二虎的妹妹赵蕊读研。再有两天就是赵蕊研究生毕业，两人即将走进婚姻殿堂。","series_id":"7528316137621163033","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235756B4E7008297FF02A1C2C9\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7528316137621163033\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":1.1645604372024536,\\\"staytime_stream\\\":1.3480921983718872,\\\"absolute_staytime\\\":0.2508719861507416,\\\"stream_ctr\\\":0.022571835666894913,\\\"collect\\\":0.060086652636528015,\\\"like\\\":0.09138210117816925,\\\"finish\\\":0.060086652636528015}\"}","recommend_group_id":"7528316137621163033","play_cnt":707157,"book_exist":false,"copyright":"树下的椰子","sub_title":"都市·超凡逆袭","score":"8.2","use_video_model":true,"episode_cnt":65,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5165,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5165&categoryName=隐藏大佬&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5204,\"name\