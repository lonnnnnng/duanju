02,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7694975932020313113","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/98b26c367d292d730a2ab802e11ec7d4~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164689&x-signature=dsMJVMkr6nnlSZYHaKDlKCqx0BI%3D","duration":36655,"title":"带娃摆摊，前夫找上门第一季","video_desc":"顾瑶带着儿子曜曜经营甜品小摊，在市井烟火中平静生活。一次偶遇，霍擎寒得知自己还有一个孩子，同时发现当年的离婚手续并未办结。霍擎寒试着融入母子二人的生活，学着陪伴孩子、体谅顾瑶。长久相处下，过往隔阂渐渐消散，曜曜慢慢接纳了他。伴随相处，顾瑶身世的线索缓缓浮现。一场温柔的久别重逢，一家三口慢慢靠近，在平凡日常中收获温暖与幸福。","series_id":"7694948718188973080","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235808330DA681CD6F43A89D3A\",\"rank\":\"5\",\"queue_names\":\"aigc,shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7694948718188973080\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.09670579433441162,\\\"like\\\":0.13477592170238495,\\\"staytime_stream\\\":1.6508482694625854,\\\"stream_ctr\\\":0.02993503399193287,\\\"absolute_staytime\\\":0.48926857113838196,\\\"finish\\\":0.009412589482963085,\\\"normalized_duration\\\":1.3910768032073975}\"}","recommend_group_id":"7694948718188973080","play_cnt":8642211,"book_exist":false,"copyright":"徐州新漫跳动传媒有限公司","sub_title":"爱情·全475集","score":"8.2","use_video_model":true,"episode_cnt":475,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5463,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5463&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5491,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5491&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5659,\"name\":\"故人重逢\",\"schema\":\"dragon8662://categorySearch?categoryId=5659&categoryName=故人重逢&genreType=130&gender=0&source=detail\"},{\"category_id\":5777,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5777&categoryName=总裁&genreType=130&gender=0&source=detail\"},{\"category_id\":5845,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5845&categoryName=现代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#281818","horiz_cover":"","sub_title_list":[{"content":"4802万","data_type":27,"rec_icon_url":"https://lf3-reading.fqnovelstatic.com/obj/novel-common/img_hot_value_flame_icon.png","rec_icon_url_dark":"https://lf3-reading.fqnovelstatic.com/obj/novel-common/img_hot_value_flame_dark_icon.png"},{"content":"爱情","data_type":3}],"pay_info":{},"support_listen":true,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"4802万\",\"data_type\":27,\"rec_icon_url\":\"https://lf3-reading.fqnovelstatic.com/obj/novel-common/img_hot_value_flame_icon.png\",\"rec_icon_url_dark\":\"https://lf3-reading.fqnovelstatic.com/obj/novel-common/img_hot_value_flame_dark_icon.png\"},{\"content\":\"爱情\",\"data_type\":3}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7701680675979545625","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/0f46fdba7ce0ccfd0e96dcb94209b6ba~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164689&x-signature=lEss37B8c67yOEnWkCzJ1CBnLMY%3D","duration":7569,"title":"二婚嫁对人，前夫悔破防","video_desc":"江雪婚后三年没能生育，丈夫一家把所有问题归咎于她，狠心逼迫她离婚、索要赔偿。走投无路之际，她结识了旁人议论颇多的萧晏，仓促定下第二段婚姻。她本打算借宴席拆穿前夫一家的算计，可朝夕相处中才发现，看似粗粝的萧晏内里温柔可靠，两人彼此慰藉，携手经营属于自己的小店与安稳生活。","series_id":"7701678491724418073","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235808330DA681CD6F43A89D3A\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7701678491724418073\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.06278920918703079,\\\"staytime_stream\\\":1.6562799215316772,\\\"normalized_duration\\\":1.200354814529419,\\\"absolute_staytime\\\":0.3678794503211975,\\\"finish\\\":0.09268778562545776,\\\"like\\\":0.09534947574138641,\\\"stream_ctr\\\":0.05031666159629822}\"}","recommend_group_id":"7701678491724418073","play_cnt":4386966,"book_exist":false,"copyright":"吾里短剧","sub_title":"爱情·都市爱情","score":"8.0","use_video_model":true,"episode_cnt":70,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5178,\"name\":\"逆风翻盘\",\"schema\":\"dragon8662://categorySearch?categoryId=5178&categoryName=逆风翻盘&genreType=130&gender=0&source=detail\"},{\"category_id\":5336,\"name\":\"极品亲戚\",\"schema\":\"dragon8662://categorySearch?categoryId=5336&categoryName=极品亲戚&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#382010","horiz_cover":"","sub_title_list":[{"content":"