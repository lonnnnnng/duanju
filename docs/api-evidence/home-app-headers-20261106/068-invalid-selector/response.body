-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164689&x-signature=nIkHnGndM0R3%2FtwGf8bI6HhWuNs%3D","duration":7367,"title":"重生螳螂，觉醒无限吞噬进化","video_desc":"史克螂意外重生，变成蛮荒丛林里一只弱小螳螂。身处弱肉强食的残酷世界，毒虫凶兽遍布四周，步步危机。所幸觉醒“无限吞噬进化”天赋！吞噬血肉，掠夺基因，不断蜕变外骨骼，解锁各类神通。猎杀猛兽，吞噬异种，持续进化变强。从底层小虫起步，挥动锋利镰刃，踏过无尽凶险，以吞噬之道，一步步成长为震慑万族的虫族至尊。","series_id":"7700941738487073817","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235808330DA681CD6F43A89D3A\",\"rank\":\"4\",\"queue_names\":\"comics,shortplay\",\"final_queue_name\":\"comic\",\"gid\":\"7700941738487073817\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.07921033352613449,\\\"staytime_stream\\\":1.735047698020935,\\\"normalized_duration\\\":1.0897382497787476,\\\"stream_ctr\\\":0.03051481582224369,\\\"absolute_staytime\\\":0.31961920857429504,\\\"finish\\\":0.07263670861721039,\\\"collect\\\":0.07159119844436646}\"}","recommend_group_id":"7700941738487073817","play_cnt":30904008,"book_exist":false,"copyright":"陆尤器","sub_title":"奇幻·全96集","score":"8.3","use_video_model":true,"episode_cnt":96,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5975,\"name\":\"奇幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5975&categoryName=奇幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=1&source=detail\"},{\"category_id\":5976,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5976&categoryName=奇幻脑洞&genreType=130&gender=1&source=detail\"},{\"category_id\":6090,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=6090&categoryName=穿越&genreType=130&gender=1&source=detail\"},{\"category_id\":6099,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=6099&categoryName=系统&genreType=130&gender=1&source=detail\"},{\"category_id\":6112,\"name\":\"升级流\",\"schem