expires=1799164645&x-signature=1gPiiZi15ZXQJKkBpOPtTHWl6LU%3D","duration":10302,"title":"一级戒备：真龙出狱","video_desc":"陆尘被逼替大哥顶罪入狱，幸得药皇传授绝世医术。刚出狱就被养父母一脚踢去沈家给昏迷的千金冲喜，没想到陆尘随手救醒沈知秋，震惊沈家。而后更是在白狼会里徒手接子弹救下慕容大小姐，龙家宴上一掌败宗师，用电饭煲炼出小还丹，引得整个江都为之疯狂。真龙从不需凡人认可，它只会在云端俯瞰众生。","series_id":"7632942187772120126","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235724A4E8874F52656BB6C4D4\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7632942187772120126\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.05749328434467316,\\\"normalized_duration\\\":1.2518336772918701,\\\"like\\\":0.08632347732782364,\\\"absolute_staytime\\\":0.3049827814102173,\\\"finish\\\":0.05665243789553642,\\\"staytime_stream\\\":1.4160276651382446,\\\"stream_ctr\\\":0.025498587638139725}\"}","recommend_group_id":"7632942187772120126","play_cnt":598077,"book_exist":false,"copyright":"百川中文","sub_title":"都市·都市玄幻","score":"8.2","use_video_model":true,"episode_cnt":73,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5073,\"name\":\"都市玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5073&categoryName=都市玄幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5165,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5165&categoryName=隐藏大佬&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=1&source=detail\"},{\"category_id\":5347,\"name\":\"无敌神医\",\"schema\":\"dragon8662://categorySearch?categoryId=5347&cat