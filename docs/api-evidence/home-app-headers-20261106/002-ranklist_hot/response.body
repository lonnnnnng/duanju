tent_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7660928432087239705","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/a9dc8ffd9b67ef9ef892d1f6dd14ee6d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164569&x-signature=%2BlV1cJ9tRbYBedMUkuLwHY%2Bepoo%3D","duration":11773,"title":"风水之王","video_desc":"天生命格特殊的吴劫自幼遭异类觊觎，幸得隐世高人李玄通悉心教养十五载，习得完整堪舆布局改运寻脉全套本事。他初次受托调理阴宅事宜，便揪出恶意暗设的害人阴局秘事，结伴同道挚友接连化解多地疑难诡事怪事，全程察觉暗处玄门盟势力处处作祟布局谋夺世间气运。吴劫得知自身身负特殊宿命，恩师昔日收养另有深意，对阵误入歧途的师叔反派，坚守本心正道破局止乱，不求虚名威望，安居市井凭本事助人解难，终得众人公认信服。","series_id":"7660926390761425944","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349617154\",\"request_id\":\"2026110623560831A0922B062038A5DBAE\",\"rank\":\"3\",\"gid\":\"7660926390761425944\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\"}","recommend_group_id":"7660926390761425944","play_cnt":3935489,"book_exist":false,"copyright":"东方华唐影业","sub_title":"剧情·都市玄幻","score":"8.1","use_video_model":true,"episode_cnt":109,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5030,\"name\":\"剧情\",\"schema\":\"dragon8662://categorySearch?categoryId=5030&categoryName=剧情&genreType=130&gender=1&source=detail\"},{\"category_id\":5073,\"name\":\"都市玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5073&categoryName=都市玄幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5135,\"name\":\"玄学\",\"schema\":\"dragon8662://categorySearch?categoryId=5135&categoryName=玄学&genreType=130&gender=1&source=detail\"},{\"category_id\":5178,\"name\":\"逆风翻盘\",\"schema\":\"dragon8662://categorySearch?categoryId=5178&categoryName=逆风翻盘&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=1&source=detail\"}]","color_dominate":"#481008","horiz_cover":"","sub_title_list":[{"content":"剧情","data_type":3},{"content":"4335万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"剧情\",\"data_type\":3},{\"content\":\"4335万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7667535236833496126","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/369acf564e027e28161739144064ac1b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164569&x-signature=%2BW%2Bf1oRxwgywmFlW33Z8m4JEW9I%3D","duration":6288,"title":"在麻将声中写作业，我逆风翻盘了","video_desc":"父亲早年混迹街头，母亲年少叛逆张扬，女儿苏念却是个千年一遇的数学天才。升入重点学校后，面对同学的排挤和偏见，她从不争辩内耗，只用成绩打破偏见。昔日遇事必出头的父亲，为护女儿学会隐忍退让；路痴不认路的母亲，跨省千里只为送一顿红烧排骨。带着父母的期望，苏念一路狂飙杀入国家队，18岁站上东京IMO赛场，拿下全球唯一满分金牌，被清北本硕博连读破格抢录。她向全网宣告告，没有退路，就是最大的天赋！","series_id":"7667533253082893336","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349617154\",\"request_id\":\"2026110623560831A0922B062038A5DBAE\",\"rank\":\"4\",\"gid\":\"7667533253082893336\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\"}","recommend_group_id":"7667533253082893336","play_cnt":3321424,"book_exist":false,"copyright":"刚