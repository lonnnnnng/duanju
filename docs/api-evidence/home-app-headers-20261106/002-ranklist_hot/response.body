{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7691226352963292184","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/12dd730db13d7f1f089859de9c3aa5e4~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164569&x-signature=gmegLGIZr4hUut4WWBFxNcA78hQ%3D","duration":5893,"title":"如此柔弱的她","video_desc":"八十年代工厂大院，人人眼中“柔弱不能自理”的娇太太许令仪，被丈夫宋怀山以照顾牺牲工友遗孀为名，领回一个身怀六甲的孕妇许柔。面对小三蚕食、丈夫逼签、靠山压案的层层围攻，许令仪以柔弱为壳、以字据为刀，让对方亲手写下每一份罪证，当众揭开假遗属、真骨肉、贪墨抚恤款三层黑幕，连根拔起两级蛀虫，为死者正名。","series_id":"7691224455107857433","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349617154\",\"request_id\":\"2026110623560831A0922B062038A5DBAE\",\"rank\":\"1\",\"gid\":\"7691224455107857433\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\"}","recommend_group_id":"7691224455107857433","play_cnt":7745847,"book_exist":false,"copyright":"刚刚好影视","sub_title":"成长·女性成长","score":"8.1","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5165,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5165&categoryName=隐藏大佬&genreType=130&gender=0&source=detail\"},{\"category_id\":5178,\"name\":\"逆风翻盘\",\"schema\":\"dragon8662://categorySearch?categoryId=5178&categoryName=逆风翻盘&genreType=130&gender=0&source=detail\"},{\"ca