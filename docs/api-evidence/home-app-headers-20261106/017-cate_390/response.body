{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7586939575080061977","cover":"https://p9-reading-sign.fqnovelpic.com/novel-pic/19b3549215719892c7ab7ef94fc4808e~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164597&x-signature=zHNE5L1NfP%2F4l2GlZ%2BFnlI3SegI%3D","duration":4765,"title":"夜雨霖铃梧桐落","video_desc":"战地记者宋清如为报恩嫁少帅张北霆，却遭三年冷漠、背叛与迫害。心死后她毅然离婚，重拾理想远赴战地，凭真实报道斩获国际大奖，成为“战地玫瑰”。颁奖典礼上她揭露阴谋、斩断过往，深耕事业收获幸福，演绎女性独立重生的成长史诗。","series_id":"7586937676293475352","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235636E940A92E73642EAE5E8F\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7586937676293475352\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.03258974477648735,\\\"normalized_duration\\\":0.7988281846046448,\\\"staytime_stream\\\":1.1018997430801392,\\\"absolute_staytime\\\":0.12131377309560776,\\\"finish\\\":0.007577241398394108,\\\"stream_ctr\\\":0.05793619900941849,\\\"like\\\":0.050330642610788345}\"}","recommend_group_id":"7586937676293475352","play_cnt":151817,"book_exist":false,"copyright":"树下的椰子","sub_title":"成长·女性成长","score":"8.1","use_video_model":true,"episode_cnt":51,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0