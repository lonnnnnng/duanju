命价值，人人生而平等的故事。","series_id":"7559492943350877209","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235636E940A92E73642EAE5E8F\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7559492943350877209\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.04429680481553078,\\\"like\\\":0.05582313612103462,\\\"staytime_stream\\\":1.1969983577728271,\\\"absolute_staytime\\\":0.1353352814912796,\\\"collect\\\":0.03514484688639641,\\\"normalized_duration\\\":0.7667266130447388,\\\"finish\\\":0.008315777406096458}\"}","recommend_group_id":"7559492943350877209","play_cnt":199001,"book_exist":false,"copyright":"景像小说","sub_title":"悬疑·民俗悬疑","score":"8.1","use_video_model":true,"episode_cnt":51,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5004,\"name\":\"悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5004&categoryName=悬疑&genreType=130&gender=2&source=detail\"},{\"category_id\":5059,\"name\":\"民俗悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5059&categoryName=民俗悬疑&genreType=130&gender=2&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=2&source=detail\"},{\"category_id\":5160,\"name\":\"家族诅咒\",\"schema\":\"dragon8662://categorySearch?categoryId=5160&categoryName=家族诅咒&genreType=130&gender=2&source=detail\"},{\"category_id\":5180,\"name\":\"反转\",\"schema\":\"dragon8662://categorySearch?categoryId=5180&categoryName=反转&genreType=130&gender=2&source=detail\"},{\"category_id\":5340,\"name\":\"民国\",\"schema\":\"dragon8662://categorySearch?categoryId=5340&categoryName=民国&genreType=130&gender=2&source=detail\"}]","color_dominate":"#380808","horiz_cover":"","sub_title_list":[{"content":"悬疑","data_type":3},{"content":"2736万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reas