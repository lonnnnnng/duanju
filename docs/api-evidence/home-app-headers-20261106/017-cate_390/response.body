ext_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7689521512725875737","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/2bf8070d5539199d79d6c816f2afe510~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164597&x-signature=gxBJb9kSttaJxP2aKuf7WsGdNhs%3D","duration":8162,"title":"伪人降临！我是全场唯一预言家。","video_desc":"林羊穿越进惊悚伪人副本，侥幸成了每日查验一人的预言家。伪人职业中学内，冒牌预言家横死，他拆穿伪人，验出自残博取信任的沈城。坠入黄色房间，他避开无面灵的目光，以杏仁水击杀复活的零号伪人，借谎言漏洞揪出黄毛。又凭情报寻到马尼拉房间，设诱饵局肃清残敌，后落入水池房，窗外云海翻腾，此地不在地球。池边腐尸死于饥饿，发光球体的字条直指墙体缝隙——那道缝隙，能带众人逃出生天吗？","series_id":"7689458194980015128","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235636E940A92E73642EAE5E8F\",\"rank\":\"6\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7689458194980015128\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.15946394205093384,\\\"collect\\\":0.060086652636528015,\\\"stream_ctr\\\":0.025203846395015717,\\\"like\\\":0.052618950605392456,\\\"normalized_duration\\\":0.7803233861923218,\\\"finish\\\":0.005220126826316118,\\\"staytime_stream\\\":1.3482023477554321}\"}","recommend_group_id":"7689458194980015128","play_cnt":8080777,"book_exist":false,"copyright":"圆梦传媒","sub_title":"奇幻·全136集","score":"8.3","use_video_model":true,"episode_cnt":136,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5975,\"name\":\"奇幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5975&categoryName=奇幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=1&source=detail\"},{\"category_