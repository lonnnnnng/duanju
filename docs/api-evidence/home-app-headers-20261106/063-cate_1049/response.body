0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7575018482190797849","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/132ab51e856c7efc4b64cc651491dff8~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164680&x-signature=Aq8p%2B60pV8SCC1tK6HfMrA7k7tE%3D","duration":8147,"title":"暗潮涌动","video_desc":"卧底情侣上线即高危！狙击手与顶级特工伪装恋人潜伏，步步惊心的任务里情根深种！1940年，王牌狙击手佟雪与顶级卧底沈少尘，为潜伏任务被迫假扮情侣同住。表面是郎才女貌的恩爱眷侣，实则是默契十足的战友，联手拆解危急、传递情报、狙击敌特，数次在鬼门关边缘完成高难度任务。刀光剑影中，伪装的亲密渐生真心，试探与守护交织。当身份危机逼近，两人能否在敌巢中守住信仰，亦守住悄然萌芽的爱情？","series_id":"7575016566606007320","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357597C48613D43EE39A22566\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7575016566606007320\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.036220062524080276,\\\"stream_ctr\\\":0.04037465527653694,\\\"normalized_duration\\\":1.087080955505371,\\\"collect\\\":0.07055959850549698,\\\"like\\\":0.07263670861721039,\\\"staytime_stream\\\":1.2302154302597046,\\\"absolute_staytime\\\":0.2031623274087906}\"}","recommend_group_id":"7575016566606007320","play_cnt":3465915,"book_exist":false,"copyright":"短剧版权5779376352","sub_title":"爱情·反转","score":"8.3","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5180,\"name\":\"反转\",\"schema\":\"dragon8662://categorySearch?categoryId=5180&categoryName=反转&genreType=130&gender=0&source=detail\"},{\"category_id\":5164,\"name\":\"多重身份\",\"schema\":\"dragon8662://categorySearc