_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7604444341406288921","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/24c5e460a229279f34a032deea4f276c~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164680&x-signature=n7Z%2BLM%2BKR%2FjPGNQmt5J4YvKKrLI%3D","duration":8065,"title":"一世灯火落九霄","video_desc":"相府嫡女霍昭音本天生凤体，可为夫家消灾抵煞，逆转生死。前世她嫁与三皇子陆明卿一路助他登临帝位，却落得满门被屠、惨死下场。许是母亲在天有灵，再睁眼，她竟回到大婚前陆明卿与庶妹偷欢之日，重活一世，恨意昭昭，她定要清算仇敌，不死不休！于是她嫁入摄政王府。她为他解毒，他替她撑腰，二人强强联手，步步为营，智斗白莲，手刃渣男，誓要拿回前世她失去的一切，包括这江山！","series_id":"7604442334456974398","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357597C48613D43EE39A22566\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7604442334456974398\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.555873990058899,\\\"normalized_duration\\\":1.1645604372024536,\\\"stream_ctr\\\":0.03388484567403793,\\\"collect\\\":0.06097517907619476,\\\"absolute_staytime\\\":0.2979178726673126,\\\"finish\\\":0.06097517907619476,\\\"like\\\":0.09268778562545776}\"}","recommend_group_id":"7604442334456974398","play_cnt":444499,"book_exist":false,"copyright":"树下的椰子","sub_title":"古装·重生逆袭","score":"8.2","use_video_model":true,"episode_cnt":65,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=0&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"