{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7469966995019025470","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/6aae00f1dfc6185cb40b5a321d5ac1ad~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164680&x-signature=3zDtx%2BlkqoSqmBynxH%2B4ykn4row%3D","duration":8417,"title":"离殇逢暖绽芳华","video_desc":"华灯初上，本该是温馨的结婚纪念日，安夏却惨遭离婚。心灰意冷之际，她转身嫁给江州商业天王季宴礼。此后夫妻二人默契携手，在江州豪门圈中掀起波澜，一路打脸众人。而随着行事渐显锋芒，她那全球女首富的身份也终究难以再隐藏。","series_id":"7452929467644644414","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357597C48613D43EE39A22566\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7452929467644644414\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.0541987344622612,\\\"absolute_staytime\\\":0.20001259446144104,\\\"finish\\\":0.036220062524080276,\\\"like\\\":0.08269734680652618,\\\"staytime_stream\\\":1.1406909227371216,\\\"normalized_duration\\\":1.1270785331726074,\\\"stream_ctr\\\":0.036352720111608505}\"}","recommend_group_id":"7452929467644644414","play_cnt":84228,"book_exist":false,"copyright":"河马短剧","sub_title":"爱情·都市爱情","score":"8.2","use_video_model":true,"episode_cnt":88,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&sour