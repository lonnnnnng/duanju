vel-pic/fc8a95fc84279dfd73b07ab5b5e1b9fd~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164603&x-signature=xAI%2F93rb84vm%2B8%2BmhOqJNgZOo1M%3D","duration":8701,"title":"都重生了，谁还当老妈子","video_desc":"周桂芬一生为四个儿子操碎了心，拆迁所得的房产和现金也全部分给了他们。然而，每个儿子都觉得她偏心，最终都不愿赡养她。晚年的周桂芬只能靠捡垃圾为生，最后病死在狭小的出租屋内。没想到，周桂芬竟重生回到了拆迁前，此时房子还未拆迁，钱也还在自己手中。重生后的周桂芬决定不再像前世那般软弱和糊涂，她要重新规划自己的生活，不再无条件地迁就儿子们。","series_id":"7614446169799789630","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623564123ABEAAA5411B2ACEB61\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7614446169799789630\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.4796431064605713,\\\"stream_ctr\\\":0.03607843443751335,\\\"like\\\":0.08756384253501892,\\\"normalized_duration\\\":1.1945079565048218,\\\"absolute_staytime\\\":0.2670518457889557,\\\"collect\\\":0.058345843106508255,\\\"finish\\\":0.05665243789553642}\"}","recommend_group_id":"7614446169799789630","play_cnt":318339,"book_exist":false,"copyright":"tomatotv","sub_title":"成长·家庭伦理","score":"8.1","use_video_model":true,"episode_cnt":70,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5047,\"name\":\"家庭伦理\",\"schema\":\"dragon8662://categorySearch?categoryId=5047&categoryName=家庭伦理&genreType=130&gender=0&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5314,\"name\":\"乡村\",\"schema\":\"dragon8662://categorySearch?categoryId=5314&categoryName=乡村&genreType=130&gender=0&source=detail\"},{\"category_id\":5366,\"name\":\"家长里短\",\"schema\":\"dragon8662://categorySearch?categoryId=5366&categoryName=家长里