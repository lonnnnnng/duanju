{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7673124017242393624","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/362d99ea39294dcfba35efe7c0e31eb5~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164603&x-signature=dHeA1tvQ0aWNzRycoN05A2M9RKg%3D","duration":10437,"title":"撕毁婚书，我改嫁纨绔颠覆江山","video_desc":"上一世，她被偏心的祖母养废，胆小懦弱、单纯无知，自小给她订下的亲事更是将她送入地狱。简家被害得家破人亡，她也被一杯毒酒送上绝路。苍天有眼，她重生了，重生在待嫁之年，她发誓，她要让渣男身败名裂，让他的家族灰飞烟灭，要让上一世欺她辱她的人都付出惨痛的代价。退亲、把自己嫁给渣男上一世的死对头，手撕绿茶莲花，极品亲戚。什么风花雪月都靠边站，姑娘不稀罕，她只想报仇搞事业，让疼惜她的家人活得风生水起！","series_id":"7673122208184536089","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623564123ABEAAA5411B2ACEB61\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7673122208184536089\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.06371499598026276,\\\"like\\\":0.09401018172502518,\\\"normalized_duration\\\":1.2204488515853882,\\\"staytime_stream\\\":1.5179569721221924,\\\"absolute_staytime\\\":0.3323513865470886,\\\"stream_ctr\\\":0.043542515486478806,\\\"finish\\\":0.05665243789553642}\"}","recommend_group_id":"7673122208184536089","play_cnt":2415639,"book_exist":false,"copyright":"含香言情社区","sub_title":"成长·重生逆袭","score":"8.2","use_video_model":true,"episode_cnt":73,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"sch