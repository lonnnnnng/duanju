这一世，他决心不再重蹈覆辙，凭借一身玄门本事，轻松赚得盆满钵满，狠狠打脸所有看轻他的人。他一边扫清各方阻碍，一边用实力还清债务、治好女儿，让妻女重新依靠自己。看他从落魄废婿逆袭成全城敬仰的玄门高人，守妻护女，走上人生巅峰！","series_id":"7606641529788058649","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623564123ABEAAA5411B2ACEB61\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7606641529788058649\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.060086652636528015,\\\"stream_ctr\\\":0.037710871547460556,\\\"like\\\":0.08882028609514236,\\\"finish\\\":0.06278920918703079,\\\"normalized_duration\\\":1.2156908512115479,\\\"staytime_stream\\\":1.536101222038269,\\\"absolute_staytime\\\":0.32212600111961365}\"}","recommend_group_id":"7606641529788058649","play_cnt":822499,"book_exist":false,"copyright":"山海星辰","sub_title":"都市·重生逆袭","score":"8.3","use_video_model":true,"episode_cnt":70,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5135,\"name\":\"玄学\",\"schema\":\"dragon8662://categorySearch?categoryId=5135&categoryName=玄学&genreType=130&gender=1&source=detail\"},{\"category_id\":5073,\"name\":\"都市玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5073&categoryName=都市玄幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5107,\"name\":\"自我救赎\",\"schema\":\"dragon8662://categorySearch?categoryId=5107&categoryName=自我救赎&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?cat