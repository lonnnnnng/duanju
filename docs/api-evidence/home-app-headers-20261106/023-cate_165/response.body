/16a89a91a6b1ec5aa53d02de604b3e45~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164608&x-signature=fCGtVYxw1yl%2BFbBRM2U3754YtlA%3D","duration":2254,"title":"隔门有耳","video_desc":"跟丈夫沈行结婚五年，陆清欢从未见到过自己的婆婆，每天给婆婆端茶送饭却始终不见其人。陆清欢想要打开门一探究竟，却遭到丈夫的强烈阻拦，在那扇紧闭的门后，藏着的根本不是生病的婆婆，而是丈夫沈行不可告人的秘密！","series_id":"7591450743454829592","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356477925EF89270260AC608B\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7591450743454829592\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":0.9919465780258179,\\\"collect\\\":0.03676946833729744,\\\"finish\\\":0.04146227985620499,\\\"normalized_duration\\\":0.6270074248313904,\\\"absolute_staytime\\\":0.09157242625951767,\\\"stream_ctr\\\":0.043027766048908234,\\\"like\\\":0.04603390023112297}\"}","recommend_group_id":"7591450743454829592","play_cnt":1023,"book_exist":false,"copyright":"长沙鱼戏","sub_title":"悬疑·悬疑推理","score":"8.2","use_video_model":true,"episode_cnt":35,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5004,\"name\":\"悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5004&categoryName=悬疑&genreType=130&gender=2&source=detail\"},{\"category_id\":5055,\"name\":\"悬疑推理\",\"schema\":\"dragon8662://categorySearch?categoryId=5055&categoryName=悬疑推理&genreType=130&gender=2&source=detail\"},{\"category_id\":5046,\"name\":\"经营奋斗\",\"schema\":\"dragon8662://categorySearch?categoryId=5046&categoryName=经营奋斗&genreType=130&gender=2&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=2&source=detail\"},{\"category_id\":5314,\"name\":\"乡村\",\"schema\":\"dragon8662://categorySearch?categoryId=5314&categoryName=乡村&genreType=130&gender=2&source=detail\"}]","color_dominate":"#202020","horiz_cover":"",