holder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7529434739279711294","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/134e2b7987d9db1afb9ab39bbf13baf9~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164608&x-signature=nJHZqQ%2FAAD6uB0yLuA64Pn43aFE%3D","duration":3267,"title":"谁在我的房间","video_desc":"因考研而搬进老小区独居的大三女学生周沁柔，最近察觉有人潜入家中，她不清楚此人的目的，而接下来的日子怪事连连。韩佑良对她丧心病狂的占有欲，来路不明的李大爷对她的绑架拐卖，学长孙浩的报复让她一次次陷入恐慌和险境。在房东范姐的及时帮助和闺蜜钟玲玲以命换命的拯救下，周沁柔最终回归平静生活。","series_id":"7529345706595732505","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356477925EF89270260AC608B\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7529345706595732505\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.03461884334683418,\\\"stream_ctr\\\":0.05269956961274147,\\\"like\\\":0.050330642610788345,\\\"staytime_stream\\\":1.1334586143493652,\\\"normalized_duration\\\":0.7104924917221069,\\\"absolute_staytime\\\":0.0887550562620163,\\\"finish\\\":0.01971912756562233}\"}","recommend_group_id":"7529345706595732505","play_cnt":37767,"book_exist":false,"copyright":"长沙古言","sub_title":"悬疑·悬疑情感","score":"8.2","use_video_model":true,"episode_cnt":44,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5004,\"name\":\"悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5004&categoryName=悬疑&genreType=130&gender=0&source=detail\"},{\"category_id\":5056,\"name\":\"悬疑情感\",\"schema\":\"dragon8662://categorySearch?categoryId=5056&categoryName=悬疑情感&genreType=130&gender=0&source=detail\"},{\"category_id\":5180,\"name\":\"反转\",\"schema\":\"dragon8662://categorySearch?categoryId=5180&categoryName=反转&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",