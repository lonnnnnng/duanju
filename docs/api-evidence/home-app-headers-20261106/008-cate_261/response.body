见证水稻成熟的历史时刻。怎料关键时刻，林峰老婆韩丽娟为了追星，将水稻田租给了流量明星张枫林。","series_id":"7484452942804700185","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623561995441FFE9EE0E594B3E8\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7484452942804700185\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":0.759614884853363,\\\"absolute_staytime\\\":0.06493457406759262,\\\"like\\\":0.046724967658519745,\\\"finish\\\":0.009125638753175735,\\\"normalized_duration\\\":0.6583828330039978,\\\"collect\\\":0.025957362726330757,\\\"stream_ctr\\\":0.046266812831163406}\"}","recommend_group_id":"7484452942804700185","play_cnt":982,"book_exist":false,"copyright":"树下的椰子","sub_title":"剧情·都市日常","score":"8.2","use_video_model":true,"episode_cnt":43,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5030,\"name\":\"剧情\",\"schema\":\"dragon8662://categorySearch?categoryId=5030&categoryName=剧情&genreType=130&gender=1&source=detail\"},{\"category_id\":5078,\"name\":\"都市日常\",\"schema\":\"dragon8662://categorySearch?categoryId=5078&categoryName=都市日常&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5314,\"name\":\"乡村\",\"schema\":\"dragon8662://categorySearch?categoryId=5314&categoryName=乡村&genreType=130&gender=1&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=1&source=detail\"}]","color_dominate":"#604010","horiz_cover":"","sub_title_list":[{"content":"剧情","data_type":3},{"content":"1185万热度","data_type":27}],"pay_info":{},"suppor