source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7542395991270378558","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/7abc5bcba56d7f46e7c498bb2ef5b890~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164625&x-signature=ahb93sdKpk5iWJ0gWfBC75C8psc%3D","duration":6890,"title":"长相思，与君诀","video_desc":"西夏女将军关月眠左腿残疾遭未婚夫退婚，被大将军萧景辞所救后成婚。婚后五年，她发现萧景辞娶她只为成全青梅慕容雪儿嫁入侯府，还计划夺走她的孩子。绝望的关月眠假扮人质刺杀敌首，却被萧景辞误杀。萧景辞得知真相后崩溃，一夜白头。一年后，关月眠假死归来，与药王谷谷主卫昭成婚。萧景辞最终在战场救她时双腿残疾，余生悔恨孤独。结局关月眠重获新生，萧景辞痛失所爱。","series_id":"7542341053395766296","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623570305366B738D7DEDA32972\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7542341053395766296\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.0701992511749268,\\\"stream_ctr\\\":0.05660064145922661,\\\"like\\\":0.0446808747947216,\\\"absolute_staytime\\\":0.09447924792766571,\\\"finish\\\":0.002115704119205475,\\\"collect\\\":0.027169229462742805,\\\"normalized_duration\\\":0.7188675403594971}\"}","recommend_group_id":"7542341053395766296","play_cnt":8826,"book_exist":false,"copyright":"树下的椰子","sub_title":"爱情·古风爱情","score":"8.1","use_video_model":true,"episode_cnt":43,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=