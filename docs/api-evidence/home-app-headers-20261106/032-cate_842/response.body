{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7589581743670168600","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/1fa6c3796b44ff8f617682d0a0680976~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164625&x-signature=GTdByMRce8hdiDkLsrZpSeSKOwU%3D","duration":4736,"title":"第九十九场雪落尽","video_desc":"胃癌晚期的算法天才苏念，在生命最后时刻目睹丈夫陆寒琛摔碎母亲遗物、为青梅竹马一次次伤害她。心如死灰的苏念在离婚夜被陆寒琛害死，实则被合作伙伴用她自创的“涅槃”算法救活。当她携巅峰成果重生归来，陆寒琛才痛彻心扉，宴会上，陆寒琛红着眼求她回头，却只得到她陌生而平静的一瞥——风雪已尽，那个爱他的苏念，永远死在了去年冬天。","series_id":"7589579854643727384","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623570305366B738D7DEDA32972\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7589579854643727384\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.1643191576004028,\\\"collect\\\":0.028870906680822372,\\\"like\\\":0.050330642610788345,\\\"absolute_staytime\\\":0.11575839668512344,\\\"finish\\\":0.009708477184176445,\\\"normalized_duration\\\":0.775764524936676,\\\"stream_ctr\\\":0.038597624748945236}\"}","recommend_group_id":"7589579854643727384","play_cnt":84649,"book_exist":false,"copyright":"快创短剧","sub_title":"成长·女性成长","score":"8.1","use_video_model":true,"episode_cnt":51,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId