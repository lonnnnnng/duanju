25250244}\"}","recommend_group_id":"7522327521560366105","play_cnt":41136,"book_exist":false,"copyright":"花生短剧","sub_title":"成长·女性成长","score":"8.1","use_video_model":true,"episode_cnt":57,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5131,\"name\":\"年代爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5131&categoryName=年代爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5226,\"name\":\"忠诚男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5226&categoryName=忠诚男主&genreType=130&gender=0&source=detail\"},{\"category_id\":5350,\"name\":\"情感觉醒\",\"schema\":\"dragon8662://categorySearch?categoryId=5350&categoryName=情感觉醒&genreType=130&gender=0&source=detail\"}]","color_dominate":"#281818","horiz_cover":"","sub_title_list":[{"content":"成长","data_type":3},{"content":"2564万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"成长\",\"data_type\":3},{\"content\":\"2564万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7454479555844115481","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/94590b3094e17029c54871d60c6d1fc4~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164625&x-signature=bpwUwCF%2BNzEqERqt04B5O6ShpAg%3D","duration":4287,"title":"一寸相思一寸灰","video_desc":"年仅十八的林婉婉，是耀眼明星般的存在。但因为蒙受不白之冤，她被送去偏远山区支教，受尽屈辱。本如阳光般明媚耀眼的她，最后变成了一个麻木、没有感情的人。终于，她等到了被接回的日子，本以为是救赎，殊不知一场更大的悲剧正要发生。","series_id":"7454452204372495385","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623570305366B738D7DEDA32972\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7454452204372495385\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":0.8454307913780212,\\\"absolute_staytime\\\":0.0846906527876854,\\\"stream_ctr\\\":0.023892031982541084,\\\"finish\\\":0.00712142838165164,\\\"collect\\\":0.030214590951800346,\\\"normalized_duration\\\":0.7202730178833008,\\\"like\\\":0.047425877302885056}\"}","recommend_group_id":"7454452204372495385","play_cnt":8488,"book_exist":false,"copyright":"广州林阳文化传媒有限公司","sub_title":"成长·女性成长","score":"8.1","use_video_model":true,"episode_cnt":43,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5188,\"name\":\"追妻\",\"schema\":\"dragon8662://categorySearch?categoryId=5188&categoryName=追妻&genreType=130&gender=0&source=detail\"},{\"category_id\":5314,\"name\":\"乡村\",\"schema\":\"dragon8662://categorySearch?categoryId=5314&categoryName=乡村&genreType=130&gender=0&source=detail\"},{\"category_id\":5350,\"name\":\"情感觉醒\",\"schema\":\"dragon8662://categorySearch?categoryId=5350&categoryName=情感觉醒&genreType=130&gender=0&source=detail\"}]","color_dominate":"#382820","horiz_cover":"","sub_title_list":[{"content":"成长","data_type":3},{"content":"1490万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"成长\",\"data_type\":3},{\"content\":\"1490万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7669639855785135166","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/cb648c1da45bb4ad79dc7d3da9f0ff8d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164625&x-signature=bLhpX00WSW6r%2B1Urw%2BND4FSvvfA%3D","duration":2895,"title":"别拿百万，抢走我的爱情","video_desc":"非遗酸梅汤传承人七月，偶然帮助了落魄的中奖者刘大民，引发了一场金钱对爱情的残酷考验。相恋六年的男友明浩在五十万、一百万的诱惑下逐渐暴露本性，最终与七月感情破裂。网红带货爆单危机中，刘大民为守护七月对非遗手艺的坚持，不惜卖掉刚中奖得到的房产赔付违约金，自己隐入工厂做苦力。最终，七月看清人心，被刘大民默默付出的真心打动，找到了属于自己的真爱与方向。","series_id":"76696378758