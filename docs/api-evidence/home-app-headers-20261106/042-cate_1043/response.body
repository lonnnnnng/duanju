{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7678360253980740633","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/04448e801abd5091e18aa37fdbe98c27~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164643&x-signature=fLhEcGH%2FisC%2F0wiQ3Btt2hh8E3I%3D","duration":10584,"title":"龙医出山，从离婚后开始崛起","video_desc":"陈平为妻子秦雪顶罪，入狱三年，被神秘老人收徒，成为医圣。出狱当天，迎接他的不是温情，而是秦雪的离婚协议——昔日的妻子已是身家过亿的美女总裁，嫌弃他“坐过牢、太平庸”，要用一千万买断三年感情。陈平愤而签字，净身出户。","series_id":"7678358368162958360","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623572203F236407ACF51ABC80E\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7678358368162958360\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":1.2074087858200073,\\\"like\\\":0.09401018172502518,\\\"collect\\\":0.06278920918703079,\\\"stream_ctr\\\":0.037925537675619125,\\\"staytime_stream\\\":1.6054370403289795,\\\"absolute_staytime\\\":0.3297650218009949,\\\"finish\\\":0.048136770725250244}\"}","recommend_group_id":"7678358368162958360","play_cnt":1453368,"book_exist":false,"copyright":"硕才短剧","sub_title":"都市·逆袭翻身","score":"8.1","use_video_model":true,"episode_cnt":84,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gen