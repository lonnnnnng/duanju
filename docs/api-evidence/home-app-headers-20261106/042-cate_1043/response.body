":false,"video_data":[{"vid":"7556542054222793790","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/28d0e0428d48cf8e986a946347d7838a~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164643&x-signature=0vdRdf%2FZQFRfpJTYNVR5l4m3DJs%3D","duration":7795,"title":"弟弟，你的医术好棒","video_desc":"农村屌丝林小龙被人推下山崖，获得机缘，得到龙阳真人传承，从此人生发生了翻天覆地的变化，解决了人生困境，带着全家过上好日子，获得诸多美女芳心，登上人生巅峰。","series_id":"7556537290076458009","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623572203F236407ACF51ABC80E\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7556537290076458009\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.03514484688639641,\\\"like\\\":0.07369627058506012,\\\"staytime_stream\\\":1.3445686101913452,\\\"normalized_duration\\\":1.0697048902511597,\\\"collect\\\":0.05108273774385452,\\\"stream_ctr\\\":0.03769217059016228,\\\"absolute_staytime\\\":0.19691167771816254}\"}","recommend_group_id":"7556537290076458009","play_cnt":10421,"book_exist":false,"copyright":"tomatotv","sub_title":"都市·超凡逆袭","score":"8.0","use_video_model":true,"episode_cnt":76,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=1&source=detail\"},{\"category_id\":5347,\"name\":\"无敌神医\",\"schema\":\"dragon8662://categorySearch?categoryId=5347&categoryName=无敌神医&genreType=130&gender=1&source=detail\"}]","color_dominate":"#603818","horiz_cover":"","sub_title_list":[{"content":"都市","data_type":3},{"content":"1629万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"都市\",\"data_type\":3},{\"content\":\"1629万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7568469019506773054","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/8611068686ab591a97ff3b306262d7d3~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164643&x-signature=44hLYyE37p8otzGo%2Bd2t7ZYviB0%3D","duration":6585,"title":"这个女神医太无敌了","video_desc":"一代传奇池音，既是世界首富龙妈，也是生死人肉白骨万人敬仰的医圣，为避世俗扮乞丐助善者圆梦。大夏财皇战枭之子得疑难症，三大医道泰斗均束手无策，次子战奕然遇池音赠零钱，池音为回报善意，愿帮他救兄。她因乞丐模样遭名医鄙视、战枭质疑，却轻描淡写救醒病人。战枭以半家产招她为媳，她因报答善意且有婚约婉拒。可她回家议婚时，竟意外被未婚夫通知悔婚，而要娶的女人竟是自己一手扶植的闺蜜。","series_id":"7568466605156355134","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623572203F236407ACF51ABC80E\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"hej