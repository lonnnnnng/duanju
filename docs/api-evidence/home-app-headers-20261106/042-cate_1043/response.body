,"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7563997672051330110","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/a8122eee959caba827a26abfb7665817~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164643&x-signature=iQynJMjwPRLZPoGxGb4slN7Nu5k%3D","duration":8119,"title":"超绝小乡医","video_desc":"凭借一个榴莲，林风引得了苏家姐妹花疯狂追求，回到村里，林风受前女友的背叛，幸得村中寡妇王美桃相救，意外觉醒透视神眼，而另外一头，女战神张书晴受星象点拨也前来村中寻医。四美女加上林风，在村中又会发生怎样的故事呢？","series_id":"7563996054392163352","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623572203F236407ACF51ABC80E\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7563996054392163352\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.979701042175293,\\\"stream_ctr\\\":0.03157505393028259,\\\"staytime_stream\\\":1.3152601718902588,\\\"finish\\\":0.025565212592482567,\\\"like\\\":0.06656919419765472,\\\"collect\\\":0.046724967658519745,\\\"absolute_staytime\\\":0.19691167771816254}\"}","recommend_group_id":"7563996054392163352","play_cnt":71504,"book_exist":false,"copyright":"硕才短剧","sub_title":"都市·超凡逆袭","score":"8.2","use_video_model":true,"episode_cnt":75,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5196,\"name\":\"异能\",\"schema\":\"dragon8662://categorySearch?categoryId=5196&categoryName=异能&gen