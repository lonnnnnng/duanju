egory_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7586891571472124952","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/8aa460d22075a9af33082c8d85fb3d3d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164610&x-signature=hfYV1eR2EyNHdNfUvfNa0mW8DVk%3D","duration":6778,"title":"长姐如刀，专斩弟弟烂桃花","video_desc":"全国首富最敬重的姐姐夏知月，为给弟弟的白血病女友捐献骨髓进城，却在医院提前遇到了弟弟的女友白青青。而此时白青青为了赶回病房接待初次见面的夏知月、获得夏知月的认可不仅插队看诊还推倒孕妇，夏知月仗义出手却被白青青伙同奸夫羞辱殴打，白青青看不起夏知月是个乡巴佬，却不知自己的美梦即将破碎。","series_id":"7586889489402842137","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235648CF607474B6F2B691DCCF\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7586889489402842137\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.07055959850549698,\\\"finish\\\":0.04603390023112297,\\\"staytime_stream\\\":1.2284473180770874,\\\"absolute_staytime\\\":0.1893681138753891,\\\"collect\\\":0.04208773002028465,\\\"stream_ctr\\\":0.04516869783401489,\\\"normalized_duration\\\":1.0924019813537598}\"}","recommend_group_id":"7586889489402842137","play_cnt":13929,"book_exist":false,"copyright":"麦芽短剧","sub_title":"都市·女性成长","score":"8.0","use_video_model":true,"ep