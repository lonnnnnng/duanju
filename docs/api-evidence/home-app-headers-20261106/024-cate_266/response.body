_type":0,"use_recommend":false,"video_data":[{"vid":"7637044481463684120","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/95676280de9a4587cc3a64f2d343af11~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164610&x-signature=hn8HNoN4tOZCatNaCOcxCrd%2F5rY%3D","duration":9307,"title":"深宫策","video_desc":"将军府影阁培养的少女月，为替惨死的姐姐玲复仇，以宫女身份潜入深宫。她凭借智谋与医理知识，辅佐郦嫔争宠上位，步步为营对抗心狠手辣的皇后与权势滔天的将军府。过程中，她周旋于后宫纷争与朝堂权谋，与皇帝达成隐秘同盟，揭露皇后借影阁控制后宫、将军府私通外敌谋逆的阴谋。最终，月成功为姐报仇，瓦解影阁与将军府势力，洗清宫廷乱象后，拒绝荣华富贵，带着令牌与通关文牒，踏上行医济世的江湖之路。","series_id":"7637042423067069465","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235648CF607474B6F2B691DCCF\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7637042423067069465\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.5422676801681519,\\\"normalized_duration\\\":1.1968432664871216,\\\"absolute_staytime\\\":0.29559943079948425,\\\"collect\\\":0.06187598779797554,\\\"stream_ctr\\\":0.04284351319074631,\\\"like\\\":0.08151976019144058,\\\"finish\\\":0.05582313612103462}\"}","recommend_group_id":"7637042423067069465","play_cnt":316665,"book_exist":false,"copyright":"星曜阁版权剧场","sub_title":"成长·女性成长","score":"8.0","use_video_model":true,"episode_cnt":64,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5136,\"name\":\"宫斗宅斗\",\"schema\":\"dragon8662://categorySearch?categoryId=5136&categoryName=宫斗宅斗&genreType=130&gender=0&source=detail\"},{\"category_id\":5163,\"name\":\"马甲文\",\"schema\":\"dragon8662://categorySearch?categoryId=5163&categoryName=马甲文&genreType=130&gender=0&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5254&categoryName=揭露阴谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5155,\"name\":\"权臣篡位\",\"schema\":\"dragon8662://categorySearch?categoryId=5155&categoryName=权臣篡位&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#302018","horiz_cover":"","sub_title_list":[{"content":"成长","data_type":3},{"content":"3569万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"成长\",\"data_type\":3},{\"content\":\"3569万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7665298598665391166","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/3ccc938e231bc985d9ad8a76af574055~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164610&x-signature=hdPVnX4rlJ9WRRQpQR40FtkXF54%3D","duration":8700,"title":"老婆出国旅游不带我，我笑了","video_desc":"妻子带全家和发小出国度假，将包揽七年家务、自掏腰包养全家的丈夫弃在机场，890元机票都不肯买转头就给发小一万五旅游经费，全家还骂他是吃软饭的废物。没人知晓，这个被肆意践踏的男人，竟是千亿资产张氏集团的董事长。七年隐忍换不来半分尊重，他当场决意离婚。周家生活瞬间崩塌，发小赌博骗钱的真面目彻底暴露，妻子得知丈夫真实身份后哭求复合，可他早已心死，决绝斩断这段冰冷的婚姻。","series_id":"7665296693176323096","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235648CF607474B6F2B691DCCF\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7665296693176323096\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.5019166469573975,\\\"absolute_staytime\\\":0.2588355243206024,\\\"stream_ctr\\\":0.03281503543257713,\\\"finish\\\":0.05500529333949089,\\\"normalized_duration\\\":1.2288204431533813,\\\"collect\\\":0.047425877302885056,\\\"like\\\":0.08269734680652618}\"}","recommend_group_id":"7665296693176323096","play_cnt":473637,"book_exist":false,"copyright":"湖南六翼影视","sub_title":"都市·都市日常","score":"8.2","use_video_model":true,"episode_cnt":68,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5078,\"name\":\"都市日常\",\"schema\":\"dragon8662://categorySearch?categoryId=5078&categoryName=都市日常&genreType=130&gender=1&source=detail\"},{\"category_id\":5165,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5165&categoryName=隐藏大佬&genreType=130&gender=1&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=总裁&genreType=130&gender=1&source=detail\"},{\"category_id\":5336,