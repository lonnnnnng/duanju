{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7647465770233908248","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/43f3c7898a7501082695baf4d84daee9~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164640&x-signature=uNvEZIL9lsq0MiBsBuuQT%2BOMddE%3D","duration":3467,"title":"双生子","video_desc":"生长在双子村的张丽自幼听闻双胞胎宿命传闻，十八岁前夕意外得知父母计划舍弃自己，为保全性命，她与孪生姐姐张婷临时互换身份，在郊外出游时命运发生转折。此后张丽顶着姐姐的身份求学生活，凭借优异成绩收获名校录取通知，却接连被母亲试探提防。成年后张丽与爱人小天成婚，诞下一对双胞胎儿子。因姥姥离世，一家人重返故乡双子村，接连撞见村中诡异习俗。顺着层层线索探寻，众人戳破流传百年的诅咒谣言，揭露村长的阴谋。","series_id":"7647463733144325144","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623571857054ED71A8377947AE5\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7647463733144325144\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.06560484319925308,\\\"collect\\\":0.04603390023112297,\\\"normalized_duration\\\":0.8637392520904541,\\\"like\\\":0.06465348601341248,\\\"absolute_staytime\\\":0.13117145001888275,\\\"stream_ctr\\\":0.0524558424949646,\\\"staytime_stream\\\":1.3591783046722412}\"}","recommend_group_id":"7647463733144325144","play_cnt":281594,"book_exist":false,"copyright":"源水短剧","sub_title":"悬疑·悬疑情感","score":"8.1","use_video_model":true,"episode_cnt":30,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5004,\"name\":\"悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5004&categoryName=悬疑&genreType=130&gender=0&source=detail\"},{\"category_id\":5056,\"name\":\"悬疑情感\",\"schema\":\"drago