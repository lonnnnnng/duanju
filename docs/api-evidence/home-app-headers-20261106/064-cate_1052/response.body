terval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7647865894487477272","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/78c278e7c61db68ead381b96ecd28294~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164682&x-signature=PnpgayVQZXXum2NjnwWbcHjK3Vo%3D","duration":22377,"title":"我在风花雪月里等你1","video_desc":"米高，一个在上海打拼多年的年轻人，把青春献给繁华的都市，灵魂却日渐疲倦。相爱多年的女友因为现实提出分手；同在异乡打拼的好友不幸离世。心灰意冷之际，他决定离开这座城市，带着好友的遗愿前往大理。在那里，他遇到了同样从钢铁丛林中逃离的各种各样的人，他们的灵魂自由地在大理碰撞。下关的风，上关的花，苍山的雪，洱海的月。我在风花雪月里等你","series_id":"7647862905257331736","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235801A8FB3183BC565195CB5F\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7647862905257331736\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.09596709161996841,\\\"like\\\":0.052618950605392456,\\\"staytime_stream\\\":0.9770437479019165,\\\"finish\\\":0.0005357804475352168,\\\"collect\\\":0.04603390023112297,\\\"normalized_duration\\\":0.7104924917221069,\\\"stream_ctr\\\":0.036183055490255356}\"}","recommend_group_id":"7647862905257331736","play_cnt":2848650,"book_exist":false,"copyright":"掌阅科技","sub_title":"爱情·都市爱情","score":"8.3","use_video_model":true,"episode_cnt":99,"vid