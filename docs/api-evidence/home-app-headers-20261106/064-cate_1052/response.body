rch_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7585536484120218649","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/78e328e6572457c93a10de8c830dd6da~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164682&x-signature=TFlU8UPTdg%2FkQGkOt%2BxaDmfnaN4%3D","duration":7442,"title":"娇养东宫","video_desc":"前世，姜不喜因救下重伤的太子北君临，却惨遭屠村，自身也惨死。重生回到与他相遇的那一刻，她下定决心护住自身，逆转结局。自此，泼辣寡妇与高傲太子日日较量，在相处中渐生情愫。整个皇城都知道，太子殿下嘴上厌恶姜不喜入骨，行动上却独宠她一人。改编自番茄小说《皇城震惊，绝嗣太子和寡妇生娃了》，作者 —— 阿娜宝。","series_id":"7585534254407240728","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235801A8FB3183BC565195CB5F\",\"rank\":\"9\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7585534254407240728\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.2532185316085815,\\\"finish\\\":0.0023231622762978077,\\\"collect\\\":0.03963883966207504,\\\"normalized_duration\\\":0.7607598900794983,\\\"like\\\":0.05582313612103462,\\\"absolute_staytime\\\":0.13323712348937988,\\\"stream_ctr\\\":0.04157886654138565}\"}","recommend_group_id":"7585534254407240728","play_cnt":546253,"book_exist":false,"copyright":"百川中文","sub_title":"爱情·古风爱情","score":"8.2","use_video_model":true,"episode_cnt":81,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=0&source=detail\"},{\"category_