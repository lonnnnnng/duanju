c_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7564661090458553369","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/a13272fc242eca392a2ad8cf95aa1b2d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164641&x-signature=Jiu0g%2FhZM%2FVeAa2oze7QXjNGeA4%3D","duration":7206,"title":"别惹她，她有八个哥哥","video_desc":"垃圾场孤女叶小汐得仙师授艺，携仙鼠小豆子，凭祖传玉扳指，陆续寻回八位在各界功成名就的大佬哥哥。她鉴宝炼丹救哥哥，炼器斗绑匪、鉴宝大会上捡漏，戳破反派阴谋，营救亲生父母，解决家庭内部矛盾，最终与家人团聚，开启被宠上天的幸福生活。","series_id":"7564654415420853273","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235720681E04E7BA086392AA75\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7564654415420853273\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.13117145001888275,\\\"normalized_duration\\\":0.7652305364608765,\\\"finish\\\":0.002472623949870467,\\\"like\\\":0.06371499598026276,\\\"collect\\\":0.049589015543460846,\\\"staytime_stream\\\":1.339175820350647,\\\"stream_ctr\\\":0.053136229515075684}\"}","recommend_group_id":"7564654415420853273","play_cnt":126486,"book_exist":false,"copyright":"tomatotv","sub_title":"都市·萌宝","score":"8.2","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5003