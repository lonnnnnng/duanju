1&x-signature=j%2BjuB2aUaQJrhWH4anVoYM%2F6E2A%3D","duration":7764,"title":"小农民的春天","video_desc":"乡村青年陈二柱，平凡日子里因见义勇为落入河底，意外觉醒仙人传承。自此逆天改命，一手神针通玄，能活死人肉白骨，解世间疑难杂症；一身龙气磅礴，可点化草木、催生万物，福泽乡邻；更得绝世武术傍身，拳破风云、脚踏山河，无人能敌。从乡野小子到炙手可热的传奇，他凭一身绝技惩恶扬善、守护一方，在都市与乡野间书写逆袭传奇，引无数人敬仰追随！改编自番茄小说《二柱子，乡村好快活》作者天天不等闲。","series_id":"7571321796016753726","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235720681E04E7BA086392AA75\",\"rank\":\"9\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7571321796016753726\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0011695103021338582,\\\"stream_ctr\\\":0.03671729937195778,\\\"absolute_staytime\\\":0.13117145001888275,\\\"collect\\\":0.0446808747947216,\\\"normalized_duration\\\":0.72734135389328,\\\"staytime_stream\\\":1.1533163785934448,\\\"like\\\":0.05184546485543251}\"}","recommend_group_id":"7571321796016753726","play_cnt":57010,"book_exist":false,"copyright":"tomatotv","sub_title":"逆袭·超凡逆袭","score":"8.3","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5195,\"name\":\"传承觉醒\",\"schema\":\"dragon8662://categorySearch?categoryId=5195&categoryName=传承觉醒&genreType=130&gender=1&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5254&categoryName=揭露阴谋&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5314,\"name\":\"乡村\",\"schema\":\"dragon8662