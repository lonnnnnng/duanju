{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7493431932143815705","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/628a12c349b4308716cc3a8051799702~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164641&x-signature=A7gBQo0zwuSk4dGZUwx5mjE2TtU%3D","duration":6917,"title":"苗山断情","video_desc":"苗疆圣女传人南绾为救绝症的郑堇年同蛊共生，随其赴城定终身，还以精血养蛊。郑堇年却带孕女陆烟回，贬低南绾。南绾被错害回苗寨继圣女位重生。郑堇年受骗夺圣蛊害她，大祭司以命换命。他赎罪得知圣蛊被抢，南绾揭穿阴谋，找回圣蛊后回苗寨。","series_id":"7493369341602171928","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235720681E04E7BA086392AA75\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7493369341602171928\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.7344790697097778,\\\"finish\\\":0.0018675664905458689,\\\"stream_ctr\\\":0.029463479295372963,\\\"staytime_stream\\\":1.0965169668197632,\\\"like\\\":0.05108273774385452,\\\"absolute_staytime\\\":0.11575839668512344,\\\"collect\\\":0.03210071101784706}\"}","recommend_group_id":"7493369341602171928","play_cnt":11330,"book_exist":false,"copyright":"麦芽短剧","sub_title":"成长·女性成长","score":"8.1","use_video_model":true,"episode_cnt":58,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&sou