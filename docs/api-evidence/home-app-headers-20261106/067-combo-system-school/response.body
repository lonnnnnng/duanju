。","series_id":"7616218874769329214","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062358063549B82BA3670FA2F988\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7616218874769329214\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0378924235701561,\\\"stream_ctr\\\":0.015880288556218147,\\\"like\\\":0.07585817575454712,\\\"collect\\\":0.049589015543460846,\\\"normalized_duration\\\":1.0786212682724,\\\"absolute_staytime\\\":0.19385886192321777,\\\"staytime_stream\\\":1.3078762292861938}\"}","recommend_group_id":"7616218874769329214","play_cnt":342453,"book_exist":false,"copyright":"漫森短剧","sub_title":"都市·逆袭翻身","score":"8.2","use_video_model":true,"episode_cnt":61,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5170,\"name\":\"穿书\",\"schema\":\"dragon8662://categorySearch?categoryId=5170&categoryName=穿书&genreType=130&gender=1&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=5130&categoryName=系统&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=1&source=detail\"},{\"category_id\":5360,\"name\":\"都市脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5360&categoryName=都市脑洞&genreType=130&gender=1&source=detail\"}]","color_dominate":"#381820","horiz_cover":"","sub_