{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7535352228241001534","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/aad11f31f708f0339cd405b657b8fec2~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164687&x-signature=xqZYqxxttbt7GlmKgU%2BbxI0aCa0%3D","duration":8845,"title":"重生后，我资助女神走向人生巅峰","video_desc":"齐云上一世过劳死，重生到大三时期，获得投资系统，投资评价越高，收益越高。齐云投资班上的连清雪，十年后连清雪会脱胎换骨，跻身财富排行榜。重生回来后的齐云，投资连清雪，对她处处关照，连清雪渐渐地爱上了齐云。","series_id":"7535017714021043262","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062358063549B82BA3670FA2F988\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7535017714021043262\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.02058866061270237,\\\"normalized_duration\\\":1.1036609411239624,\\\"staytime_stream\\\":1.1992053985595703,\\\"finish\\\":0.03514484688639641,\\\"like\\\":0.07263670861721039,\\\"collect\\\":0.05184546485543251,\\\"absolute_staytime\\\":0.20636165142059326}\"}","recommend_group_id":"7535017714021043262","play_cnt":431311,"book_exist":false,"copyright":"山海星辰","sub_title":"青春·奇幻爱情","score":"8.1","use_video_model":true,"episode_cnt":71,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5023,\"name\":\"青春\",\"schema\":\"dragon8662://categorySearch?categoryId=5023&categoryName=青春&genreType=130&gender=2&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=2&sou