{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7692289930420030488","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/4281f4bbbba614cfcea004aa3632719b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164612&x-signature=lS0ZlA3abRffhqBlNau0o9oLEas%3D","duration":7821,"title":"我养的大将军，跨界来撑腰","video_desc":"林穗辍学守着杂货店，与聋哑母亲相依为命，常被大伯一家欺凌。她在柴房发现一座神奇沙盘，竟连通古代朔关城。她赐粮送水，救下镇北将军萧承渊与满城军民。萧承渊可跨界来到现代，一次次替她撑腰，打脸恶亲。两人羁绊渐深，林穗靠沙盘贡品逆袭还债、签约国博。可朝廷一道赐婚圣旨，让刚动心的两人面临分离危机。","series_id":"7692287722655861822","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235650E35A7A5DE1689DA0F3CE\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7692287722655861822\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.2609511613845825,\\\"normalized_duration\\\":0.7788007855415344,\\\"finish\\\":0.0023967318702489138,\\\"stream_ctr\\\":0.03155917301774025,\\\"absolute_staytime\\\":0.14980250597000122,\\\"collect\\\":0.04535258188843727,\\\"like\\\":0.058345843106508255}\"}","recommend_group_id":"7692287722655861822","play_cnt":344650,"book_exist":false,"copyright":"海鱼星空","sub_title":"奇幻·奇幻脑洞","score":"8.2","use_video_model":true,"episode_cnt":93,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5009,\"name\":\"奇幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5009&categoryName=奇幻&genreType=130&gender=0&source=detail\"},{\"category_id\":5074,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5074&cat