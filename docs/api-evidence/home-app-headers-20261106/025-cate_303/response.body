use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7686771738423610393","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/6a560d9c5678d4463de0842448200c0c~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164612&x-signature=alaFt8AxOWzIoEsn27OYu0IYZok%3D","duration":5703,"title":"合租凶宅","video_desc":"穷鬼马哲捡漏租下一套豪华凶宅，月租只要500块，他坚信穷鬼比恶鬼更可怕。入住后诡异事件频发，“女鬼”频频现身，可马哲却微微一笑，真闹鬼啊，那房东不会涨我房租了！至此，他展开了和室友的机智周旋。一次偶然，马哲发现新任女总裁竟和“女鬼”长得一模一样！对方到底是人是鬼？富家大小姐究竟是自杀还是他杀？随着凶宅越住越顺，和女总裁越走越近，当年的死亡真相终于浮出水面。而马哲也摇身一变，成了名正言顺的豪宅主人。","series_id":"7686769630823599166","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235650E35A7A5DE1689DA0F3CE\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7686769630823599166\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0059110685251653194,\\\"stream_ctr\\\":0.044000234454870224,\\\"staytime_stream\\\":1.54193913936615,\\\"normalized_duration\\\":0.7460454702377319,\\\"absolute_staytime\\\":0.1697484850883484,\\\"collect\\\":0.04401865601539612,\\\"like\\\":0.06187598779797554}\"}","recommend_group_id":"7686769630823599166","play_cnt":1140591,"book_exist":false,"copyright":"湖南六翼影视","sub_title":"悬疑·悬疑推理","score":"8.1","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5004,\"name\":\"悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5004&categoryName=悬疑&genreType=130&gender=2&source=detail\"},{\"category_id\":5055,\"name\":\"悬疑推理\",\"schema\":\"dragon8662://categorySearch?categoryId=5055&categoryName=悬疑推理&genreTyp