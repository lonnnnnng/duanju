rt_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7697589288036207640","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/4111c99fd06d613dc891ebd809cc13ad~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164612&x-signature=L%2FwiXGP9b7sPJL7%2F4RKecFgOQqs%3D","duration":7771,"title":"糯糯与师父的温馨日常","video_desc":"仙山云深，软乎乎的小团子糯糯，日日黏着师父顾请风。晨时跟着他习字听道，午后一同在山间摘花逗云，晚风里依偎着听古老的仙话。顾请风素来清冷寡言，唯独对糯糯万般纵容，耐心接住她所有天真奇思。平淡山居时光，没有纷扰纷争，只有一师一徒细水长流的温柔相伴。这份藏在云岫仙山的温暖日常，便是糯糯下山前最珍贵的回忆。","series_id":"7697554036496550936","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235650E35A7A5DE1689DA0F3CE\",\"rank\":\"9\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7697554036496550936\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.7518967986106873,\\\"like\\\":0.05582313612103462,\\\"finish\\\":0.0023967318702489138,\\\"staytime_stream\\\":1.5651408433914185,\\\"absolute_staytime\\\":0.1724216192960739,\\\"stream_ctr\\\":0.04432182013988495,\\\"collect\\\":0.07696083933115005}\"}","recommend_group_id":"7697554036496550936","play_cnt":3687642,"book_exist":false,"copyright":"成都秋顺水文化传播有限公司","sub_title":"玄幻·全130集","score":"8.1","use_video_model":true,"episode_cnt":130,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5967,\"name\":\"玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5967&categoryName=玄幻&genreType=130&gender=2&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=2&source=detail\"},{\"category_id\":5968,\"name\":\"玄幻仙侠\",\"schema\":\"dragon8662://categorySearch?categoryId=5968&categoryName=玄幻仙侠&genreType=130&gender=2&source=detail\"},{\"category_id\":6030,\"name\":\