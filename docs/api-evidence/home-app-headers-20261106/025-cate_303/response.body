ector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7700841829192715289","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/95cd7f89fccb4b1b20114c41c81dc58a~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164612&x-signature=l6y2BEu1CLgZIoGvXXJE1DhyzSg%3D","duration":7279,"title":"我嫁谁，谁才是大哥","video_desc":"前世沈明月替霍沉峰打江山成大嫂，却被妹妹沈明珠嫉妒刺死。姐妹双双重生回选亲日，沈明珠抢嫁“未来大哥”霍沉峰，沈明月偏选十日后必死的病弱书生霍沉舟。她凭前世眼光做健美裤生意、盘下三号铺，赚到一万块买特效药改写丈夫死局，更发现猴票背后藏着霍沉峰前世发家的秘密。我嫁谁，谁才是大哥！","series_id":"7700839942913543193","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106235650E35A7A5DE1689DA0F3CE\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7700839942913543193\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.05749328434467316,\\\"finish\\\":0.004755199886858463,\\\"absolute_staytime\\\":0.17789487540721893,\\\"collect\\\":0.0384662002325058,\\\"normalized_duration\\\":0.7637373805046082,\\\"stream_ctr\\\":0.06251874566078186,\\\"staytime_stream\\\":1.5152854919433594}\"}","recommend_group_id":"7700839942913543193","play_cnt":5715845,"book_exist":false,"copyright":"海鱼星空","sub_title":"年代·重生逆袭","score":"8.2","use_video_model":true,"episode_cnt":94,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5021,\"name\":\"年代\",\"schema\":\"dragon8662://categorySearch?categoryId=5021&categoryName=年代&genreType=130&gender=0&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5065,\"name\":\"年