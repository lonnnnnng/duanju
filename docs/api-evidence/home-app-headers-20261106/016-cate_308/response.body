false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7703916961868041241","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/e11cd60d872a907ffabc711bcf048d15~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164595&x-signature=p2YxXYi1%2BMdREAem9e5P8JH3kU0%3D","duration":9742,"title":"持械入宋：新编","video_desc":"宋末年，烽火连天。一支执行任务的现代五人小队，意外坠入时空隧道，全员携械穿越到大一-口东北大宋。队长林昭一-京片子冷静果决，统帅全局。狙击手谢长风、军械师马振邦-碴子，战力拉满。通信兵王浩川一一广东仔，情报组网，眼观六路。湘妹子医官陈素一一妙手回春，战地玫瑰。以现代人的视角看大宋，这将是一场现代与古代的文化冲突，一场科技的降维碾压。大宋注定将不再平凡。且看他们如何用现代兵器在古代乱世杀出一条活路。","series_id":"7703915059314969625","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356341A17241E3FC1309376EC\",\"rank\":\"5\",\"queue_names\":\"aigc\",\"final_queue_name\":\"heji\",\"gid\":\"7703915059314969625\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.08151976019144058,\\\"staytime_stream\\\":1.5029176473617554,\\\"like\\\":0.06371499598026276,\\\"stream_ctr\\\":0.052942413836717606,\\\"finish\\\":0.058345843106508255,\\\"normalized_duration\\\":1.245736002922058,\\\"absolute_staytime\\\":0.3002544641494751}\"}","recommend_group_id":"7703915059314969625","play_cnt":494760,"book_exist":false,"copyright":"广州大动传媒有限公司","sub_title":"古装·全121集","score":"8.0","use_video_model":true,"episode_cnt":121,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5475,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5475&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5531,\"name\":\"古装传奇\",\"schema\":\"dragon8662://categorySearch?categoryId=5531&categoryName=