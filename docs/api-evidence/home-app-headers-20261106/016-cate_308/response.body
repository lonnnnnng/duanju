{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7490462944736594969","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/f15d7a689c880f1781b112d4ee5b5c16~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164595&x-signature=ECWhDXAIgXln%2FM3gm6Rwwe325Ls%3D","duration":8060,"title":"锦绣凤鸣","video_desc":"前世，沈凤宜一片真心错付。她陪伴穆宁远从王府踏入金銮殿，却因单纯不谙权谋，在波谲云诡的宫斗中一败涂地。被穆宁远无情抛弃后，含恨残死于天牢。或许是老天怜悯她的遭遇，给了沈凤宜重来一次的机会。重生归来，沈凤宜决意不再重蹈覆辙。这一世，她提前十年精心布局，苦练舞蹈与媚术，暗中经营酒楼，悄然编织势力网。这一次，她要断绝恋爱脑，搅乱穆宁远的心，一步步登上凤位，母仪天下。","series_id":"7490420333384567870","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356341A17241E3FC1309376EC\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7490420333384567870\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.2910165786743164,\\\"collect\\\":0.06097517907619476,\\\"finish\\\":0.06465348601341248,\\\"normalized_duration\\\":1.2062302827835083,\\\"like\\\":0.08509904891252518,\\\"stream_ctr\\\":0.060924090445041656,\\\"staytime_stream\\\":1.48932683467865}\"}","recommend_group_id":"7490420333384567870","play_cnt":1025812,"book_exist":false,"copyright":"山海星辰","sub_title":"古装·宫斗宅斗","score":"8.0","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=0&source=detail\"},{\"category_id\":5136,\"name\":\"宫斗宅斗\",\"schema\":\"dragon8662://categor