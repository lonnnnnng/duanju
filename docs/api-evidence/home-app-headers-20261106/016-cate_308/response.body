favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7509775111377914942","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/5dd7eca2e366e8cfdb73f8349b49e0b2~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164595&x-signature=x8yY%2Fl5z93wfXKTLWUShRBMHcNU%3D","duration":6539,"title":"负情山河决","video_desc":"明昭以孤女之身蛰伏人间，实为邻国遗珠。三载夫妻情缘，原是沈砚凛精心织就的权谋之网。当沈母苛待与崔氏算计撕碎温情面纱，她决然斩断孽缘。命运转折处邂逅夏国皇子夏元瑾，两颗孤星于权谋漩涡中相知相惜，携手冲破世俗桎梏，终在血色山河间觅得赤诚真心。","series_id":"7509719545720867865","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356341A17241E3FC1309376EC\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7509719545720867865\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.19235020875930786,\\\"staytime_stream\\\":1.5407683849334717,\\\"normalized_duration\\\":1.1353638172149658,\\\"like\\\":0.06954174488782883,\\\"collect\\\":0.0446808747947216,\\\"stream_ctr\\\":0.046371202915906906,\\\"finish\\\":0.0446808747947216}\"}","recommend_group_id":"7509719545720867865","play_cnt":135148,"book_exist":false,"copyright":"麦芽短剧","sub_title":"古装·女性成长","score":"8.0","use_video_model":true,"episode_cnt":83,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?