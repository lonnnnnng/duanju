de_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7273469651344952380","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/42f031ad40f0a5070633e259b178465b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164595&x-signature=4SLplOj4ZxfoB%2FWSiVi8jXrB6po%3D","duration":86448,"title":"天下粮仓","video_desc":"公元1735年，雍正皇帝猝然驾崩，乾隆皇帝登基后接连发生“火龙烧仓”、“阴兵借粮”、“耕牛哭田”等惊世奇案。危难之际，刑部尚书刘统勋扶棺履任，统领全国查案赈灾之职。\r\n仓场侍郎米汝成之子米河饱读诗书，不为仕途只想行走江湖。他阅尽民间苦难，最后立志做一方清官救民于水火。","series_id":"7273469647905623097","episode":true,"vertical":false,"content_type":6,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356341A17241E3FC1309376EC\",\"rank\":\"6\",\"queue_names\":\"video\",\"final_queue_name\":\"long\",\"gid\":\"7273469647905623097\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0002959571429528296,\\\"normalized_duration\\\":1.1101467609405518,\\\"like\\\":0.05184546485543251,\\\"collect\\\":0.04208773002028465,\\\"absolute_staytime\\\":0.08602434396743774,\\\"stream_ctr\\\":0.04678686708211899,\\\"staytime_stream\\\":0.7807527780532837}\"}","recommend_group_id":"7273469647905623097","play_cnt":5983,"book_exist":false,"copyright":"西瓜视频","sub_title":"古装·全31集","score":"8.1","use_video_model":true,"episode_cnt":31,"video_platform":4,"disable_play":false,"category_schema":"[{\"cat