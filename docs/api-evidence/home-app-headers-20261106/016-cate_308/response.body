s=ae45642e&x-expires=1799164595&x-signature=3O7KEl0fQr05xbef7gikmKuIX5Q%3D","duration":11676,"title":"美人辞嫁","video_desc":"上一世，沈棠到死才知道贵为皇后的嫡姐并非爹娘所出，而是害死全家的凶手。好在上天垂怜，她死后重生到嫡姐要出嫁给人冲喜前一天——前世嫡姐怕守寡，算计她替嫁，又在冲喜管用后反悔，让她背负抢夺嫡姐亲事的骂名，受尽唾弃。这一世，沈棠当场揭穿嫡姐的虚伪面孔，退了那门人人羡慕的好亲事，让嫡姐悔不当初。报仇路上，她遇神杀神，遇佛杀佛！改编自番茄小说IP闲檀原著《花轿临门她拒嫁，装病的世子气疯》。","series_id":"7509398609910041662","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062356341A17241E3FC1309376EC\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7509398609910041662\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.035678550601005554,\\\"absolute_staytime\\\":0.24891968071460724,\\\"stream_ctr\\\":0.04918062314391136,\\\"staytime_stream\\\":1.3936227560043335,\\\"normalized_duration\\\":1.1886895895004272,\\\"like\\\":0.07696083933115005,\\\"collect\\\":0.05749328434467316}\"}","recommend_group_id":"7509398609910041662","play_cnt":362928,"book_exist":false,"copyright":"萤火悦动","sub_title":"古装·宫斗宅斗","score":"8.1","use_video_model":true,"episode_cnt":84,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=0&source=detail\"},{\"category_id\":5136,\"name\":\"宫斗宅斗\",\"schema\":\"dragon8662://categorySearch?categoryId=5136&categoryName=宫斗宅斗&genreType=130&gender=0&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5254&categoryName=揭露阴谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5178,\"name\":\"逆风翻盘\",\"schema\":\"dragon8662://categorySearch?categoryId=5178&categoryName=逆风翻盘&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\