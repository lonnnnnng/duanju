":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7433323800449518654","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/a9f783c06591e61ec027a1bd0c67efab~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164636&x-signature=K6zu4sNuGAfSjHApt%2BawptcsTJk%3D","duration":2861,"title":"陪护迷途","video_desc":"宋涛为了陪丈母娘逛街，竟做出糊涂之举，将患有痴呆的母亲独自留在了封闭的车里。随着时间流逝，车内温度急剧攀升，空气愈发稀薄，母亲因炎热缺氧陷入昏迷。妹妹发现母亲不见后，心急如焚，四处拼命寻找。然而，宋涛却满不在乎，觉得妹妹是小题大做。最终，母亲在车内的高温中离世，令人痛心不已。","series_id":"7433313906166090814","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357143FB08D7187746896EEFF\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7433313906166090814\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.03161877393722534,\\\"stream_ctr\\\":0.03627830371260643,\\\"like\\\":0.05184546485543251,\\\"staytime_stream\\\":0.955235481262207,\\\"normalized_duration\\\":0.6967503428459167,\\\"collect\\\":0.03258974477648735,\\\"absolute_staytime\\\":0.08602434396743774}\"}","recommend_group_id":"7433313906166090814","play_cnt":2675,"book_exist":false,"copyright":"心动短剧","sub_title":"家庭·家庭伦理","score":"8.1","use_video_model":true,"episode_cnt":30,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5001,\"name\":\"家庭\",\"schema\":\"dragon8662://categorySearch?categoryId=5001&categoryName=家庭&genreType=130&gender=2&source=detail\"},{\"category_id\":5047,\"name\":\"家庭伦理\",\"schema\":\"dragon8662://categorySearch?categoryId=5047&categoryName=家庭伦理&genreType=130&gender=2&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&