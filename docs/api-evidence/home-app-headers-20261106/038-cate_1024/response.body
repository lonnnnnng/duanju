{"data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7388093644210719769","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/bd480fcd9378dc6d1a1aed3864293f2a~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799164636&x-signature=0b%2BuBdFMZ2t%2BDB0izw830GyvnSQ%3D","duration":7465,"title":"一闪一闪姜星星","video_desc":"姜玟因男人的背叛，为了报复男人，将自己的女儿星星与菜场卖鱼女孩幼宁调换，改写了二人的命运。幼宁成为夏家千金，却始终感到内心空虚；星星卖鱼送外卖，生活十分艰苦。十年后的一场生日宴上，两个女孩的人生再次产生了交集，她们联手探寻当年事情的真相，当真相大白时，姜玟后悔不已，她决定弥补自己的过错，用余生去守护这两个女儿。","series_id":"7388082140249869336","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357143FB08D7187746896EEFF\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7388082140249869336\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.046724967658519745,\\\"staytime_stream\\\":0.9402257800102234,\\\"normalized_duration\\\":0.7202730178833008,\\\"stream_ctr\\\":0.02477237768471241,\\\"collect\\\":0.028870906680822372,\\\"absolute_staytime\\\":0.0846906527876854,\\\"finish\\\":0.0011695103021338582}\"}","recommend_group_id":"7388082140249869336","play_cnt":44141,"book_exist":false,"copyright":"蜜糖短剧","sub_title":"家庭·家庭伦理","score":"8.0","use_video_model":true,"episode_cnt":77,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5001,\"name\":\"家庭\",\"schema\":\"dragon8662://categorySearch?categoryId=5001&categoryName=家庭&genreType=130&gender=0&source=detail\"},{\"category_id\":5047,\"name\":\"家庭伦理\",\"schema\":\"dragon8662://categorySearch?categoryId=5047&categoryName=家庭伦理&genr