_desc":"长女林安为了护弟被拐二十载逆袭成总裁，寻亲时，遇见周母惨遭儿子儿媳嫌弃刁难，认亲后强势护母，白眼狼跪地忏悔。周桂兰帮助女儿找回合作商丢失的孩子，促成两家公司永久合作，女儿又促成兄弟俩向母忏悔，一家终团圆。","series_id":"7587770815400119320","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062357143FB08D7187746896EEFF\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7587770815400119320\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.1087374687194824,\\\"absolute_staytime\\\":0.11045744270086288,\\\"finish\\\":0.027169229462742805,\\\"normalized_duration\\\":0.6967503428459167,\\\"stream_ctr\\\":0.05364431068301201,\\\"collect\\\":0.0378924235701561,\\\"like\\\":0.05582313612103462}\"}","recommend_group_id":"7587770815400119320","play_cnt":6645,"book_exist":false,"copyright":"长沙古言","sub_title":"家庭·家庭伦理","score":"8.3","use_video_model":true,"episode_cnt":50,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5001,\"name\":\"家庭\",\"schema\":\"dragon8662://categorySearch?categoryId=5001&categoryName=家庭&genreType=130&gender=2&source=detail\"},{\"category_id\":5047,\"name\":\"家庭伦理\",\"schema\":\"dragon8662://categorySearch?categoryId=5047&categoryName=家庭伦理&genreType=130&gender=2&source=detail\"},{\"category_id\":5174,\"name\":\"矛盾和解\",\"schema\":\"dragon8662://categorySearch?categoryId=5174&categoryName=矛盾和解&genreType=130&gender=2&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=总裁&genreType=130&gender=2&source=detail\"},{\"category_id\":5314,\"name\":\"乡村\",\"schema\":\"dragon8662://categorySearch?categoryId=5314&categoryName=乡村&genreType=130&gender=2&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=2&source=detail\"},{\"category_id\":5367,\"name\":\"亲情\",\"schema\":\"dragon8662://categorySearch?categoryId=5367&