，却为了男友周砚深选择留在他的世界。四年前，男友周砚深出车祸被碾断双腿，沈予安用了全部积分，放弃了自己的舞蹈事业，将自己的双腿换给周砚深。可她没想到，四年后，沈予安亲眼见证了周砚深的背叛，亲耳听到了他对她的嫌弃。沈予安心灰意冷，决定夺回自己的双腿，开启自己新的人生。","series_id":"7533518427663649854","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062330428A33B422E87FA48C8923\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7533518427663649854\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":0.926722526550293,\\\"collect\\\":0.027169229462742805,\\\"normalized_duration\\\":0.7118815779685974,\\\"absolute_staytime\\\":0.09015274047851562,\\\"stream_ctr\\\":0.0512169748544693,\\\"like\\\":0.046724967658519745,\\\"finish\\\":0.014503581449389458}\"}","recommend_group_id":"7533518427663649854","play_cnt":8579,"book_exist":false,"copyright":"剧点短剧","sub_title":"都市·女性成长","score":"8.1","use_video_model":true,"episode_cnt":32,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=5130&categoryName=系统&genreType=130&gender=0&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=0&source=detail\"},{\"category_id\":5107,\"name\":\"自我救赎\",\"schema\":\"dragon8662://categorySearch?categoryId=5107&categoryName=自我救赎&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=总裁&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categor