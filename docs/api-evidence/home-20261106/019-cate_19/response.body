{"log_id":"202611062330428A33B422E87FA48C8923","code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7580751464151125017","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/d63160c97c610fdcd09f093b0ec16514~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163044&x-signature=jihh8WYCPqe6mg%2BLnvLejHY0BYc%3D","duration":8032,"title":"情报在手商界横着走","video_desc":"被拜金女友劈腿的沈氏职员洛维，意外激活女神情报系统，凭借系统提供的情报疯狂捞金，帮顾南乔寻回耳环、助沈妍秋捉奸，为陈艾拉斥资买包。他化解沈氏危机、结交枭雄龙叔、搞定商业合作，一路逆袭成为洛氏集团掌舵人。期间，他打脸前女友及一众反派，收获多位女神芳心，最终坐拥百亿资产，朝着世界首富目标迈进，谱写了一段逆袭传奇故事。","series_id":"7580749317644766233","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062330428A33B422E87FA48C8923\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7580749317644766233\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.03461884334683418,\\\"normalized_duration\\\":0.714667797088623,\\\"like\\\":0.048136770725250244,\\\"finish\\\":0.0013670254265889525,\\\"staytime_stream\\\":1.0037440061569214,\\\"absolute_staytime\\\":0.10874496400356293,\\\"stream_ctr\\\":0.08156903833150864}\"}","recommend_group_id":"7580749317644766233","play_cnt":17225,"book_exist":false,"copyright":"tomatotv","sub_title":"都市·逆袭翻身","score":"8.1","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",