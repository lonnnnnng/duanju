io_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7699835550991125528","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/43602f164334ca1c634b207fafeb4800~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163087&x-signature=2GatlkGQqP4pTWimrIf3JPJ6GD8%3D","duration":4722,"title":"边关求生，瓦罐渡古今","video_desc":"李梦姣一家遭构陷流放边关，途中缺粮少水，她的眼泪唤醒神奇瓦罐，可穿越现代。娇娇结识玉石铺小刘，用戈壁玛瑙换取药品、粮食物资，帮家人渡过危机。流放至荒村后，李家挖到胡杨根、打出井水，又带回耐旱种子开荒。李思德定下以玛瑙换种子粮食的规矩，带动全村人捡石谋生，日子慢慢好转。就在一切安稳时，母亲杨氏突然临盆，娇娇握着发光瓦罐，静待新生命到来。","series_id":"7699835542015314968","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623312502749CE23A499891A640\",\"rank\":\"5\",\"queue_names\":\"aigc\",\"final_queue_name\":\"aigc\",\"gid\":\"7699835542015314968\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.2179613560438156,\\\"staytime_stream\\\":1.7201496362686157,\\\"collect\\\":0.05500529333949089,\\\"stream_ctr\\\":0.03892644867300987,\\\"like\\\":0.06656919419765472,\\\"finish\\\":0.014063626527786255,\\\"normalized_duration\\\":0.7788007855415344}\"}","recommend_group_id":"7699835542015314968","play_cnt":374648,"book_exist":false,"copyright":"云繁漫剧","sub_title":"奇幻·全60集","score":"8.3","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5477,\"name\":\"奇幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5477&categoryName=奇幻&genreType=130&gender=0&source=detail\"},{\"category_id\":5536,\"name\":\"奇幻脑洞\",\"schema\":\"dragon86