ration":6917,"title":"苗山断情","video_desc":"苗疆圣女传人南绾为救绝症的郑堇年同蛊共生，随其赴城定终身，还以精血养蛊。郑堇年却带孕女陆烟回，贬低南绾。南绾被错害回苗寨继圣女位重生。郑堇年受骗夺圣蛊害她，大祭司以命换命。他赎罪得知圣蛊被抢，南绾揭穿阴谋，找回圣蛊后回苗寨。","series_id":"7493369341602171928","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623312502749CE23A499891A640\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7493369341602171928\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.001810210756957531,\\\"collect\\\":0.03210071101784706,\\\"normalized_duration\\\":0.7359150052070618,\\\"absolute_staytime\\\":0.10705902427434921,\\\"staytime_stream\\\":1.0146677494049072,\\\"stream_ctr\\\":0.030177947133779526,\\\"like\\\":0.050330642610788345}\"}","recommend_group_id":"7493369341602171928","play_cnt":11330,"book_exist":false,"copyright":"麦芽短剧","sub_title":"成长·女性成长","score":"8.1","use_video_model":true,"episode_cnt":58,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5254&categoryName=揭露阴谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5188,\"name\":\"追妻\",\"schema\":\"dragon8662://categorySearch?categoryId=5188&categoryName=追妻&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5223,\"name\":\"神女\",\"s