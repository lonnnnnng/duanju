{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7508692084409289790","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/ddb7fde15f69625460e5e3d92e8c88c8~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163087&x-signature=eYKrPPGIGoPciwrmsmJaq6D9uAc%3D","duration":7806,"title":"今天也没能辞职","video_desc":"周聪在出租屋中，穿着随意，一边挠腿一边看着质量不佳的小说，对小说中穷人写有钱人的离谱情节深感不满。突然床断裂，他手中冰红茶饮料瓶飞起砸晕自己，随后穿越。在这个世界设定中冰红茶极为稀有珍贵。女主谭妍儿遭遇商战，出价500万购买周聪手中的冰红茶，周聪看着自己系统空间中的一卡车冰红茶陷入了沉思。","series_id":"7508683815187909694","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623312502749CE23A499891A640\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7508683815187909694\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.040845710784196854,\\\"finish\\\":0.000855900754686445,\\\"absolute_staytime\\\":0.0702110230922699,\\\"staytime_stream\\\":0.6647496819496155,\\\"collect\\\":0.026355355978012085,\\\"normalized_duration\\\":0.6507123708724976,\\\"stream_ctr\\\":0.06338411569595337}\"}","recommend_group_id":"7508683815187909694","play_cnt":23834,"book_exist":false,"copyright":"花生短剧","sub_title":"都市·逆袭翻身","score":"8.3","use_video_model":true,"episode_cnt":56,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryN