_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7443033176106093593","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/5281f8b7e587c0fac84c52bbf07c520c~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163087&x-signature=aRWkEuESOUpW7MekFsBINVWlt7Y%3D","duration":5052,"title":"好运到我家","video_desc":"外卖员陈默意外被系统绑定，获每秒高额利息的能力。他在商场、游艇中心等疯狂消费，迅速积累财富，成为神秘富豪。他帮苏清雪解决公司危机，与秦婉儿情定秦家，在同学会上以满天星辰赢取苏清雪芳心，又遭楚菲菲绑架逼婚。楚菲菲身患绝症，陈默为其赴樱花国买药，以强大财力和军事力量威慑，成功拿到药。","series_id":"7442993442361183257","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623312502749CE23A499891A640\",\"rank\":\"9\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7442993442361183257\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.7049634456634521,\\\"absolute_staytime\\\":0.1175813376903534,\\\"like\\\":0.05582313612103462,\\\"staytime_stream\\\":1.0676827430725098,\\\"stream_ctr\\\":0.0496838241815567,\\\"finish\\\":0.004755199886858463,\\\"collect\\\":0.0446808747947216}\"}","recommend_group_id":"7442993442361183257","play_cnt":525921,"book_exist":false,"copyright":"心动短剧","sub_title":"都市·逆袭翻身","score":"8.1","use_video_model":true,"episode_cnt":75,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=5130&categoryName=系统