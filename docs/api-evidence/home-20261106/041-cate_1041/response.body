em_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7506160309942357054","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/663e83a33c4b56b3fa6c212c3219ec4b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163087&x-signature=NyeJ%2BswHmvSD6PdRGgBjvHruDpA%3D","duration":4346,"title":"医院逃生：我能推理无限","video_desc":"港城医院的实习护士王新是个胆小怕事的年轻人，每天过着按部就班的生活。然而一场突如其来的劫持事件彻底改变了他的命运。当犯罪集团占领医院大楼时，王新在死亡边缘意外觉醒了推演未来的神奇能力，他可以在脑海中预演即将发生的事件，并在失败后重新来过。","series_id":"7506053095986564158","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623312502749CE23A499891A640\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7506053095986564158\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.0747392401099205,\\\"like\\\":0.04401865601539612,\\\"staytime_stream\\\":0.6570262312889099,\\\"finish\\\":0.004468384198844433,\\\"collect\\\":0.03676946833729744,\\\"normalized_duration\\\":0.6609596610069275,\\\"stream_ctr\\\":0.061853330582380295}\"}","recommend_group_id":"7506053095986564158","play_cnt":50085,"book_exist":false,"copyright":"郑州空港聚美影视传媒有限公司","sub_title":"都市·悬疑推理","score":"8.0","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"catego