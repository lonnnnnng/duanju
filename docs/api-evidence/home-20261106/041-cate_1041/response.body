me_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7703409477617208344","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/975b206da7e126d3fce47c8190e9c08e~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163087&x-signature=T4UC1AmmiP9gOhvJD%2F6IuX8QvEU%3D","duration":9923,"title":"病弱千金，百鬼让路","video_desc":"玄门第一天才池羽，跟厉鬼同归于尽后，穿进一本玛丽苏甜宠文里体弱多病的反派真千金，本以为拿了支票就能躺平当咸鱼、摆脱五弊三缺的命运，谁料庄园满是怨鬼，七煞阵埋在院子里耗她全家气运，地府乱套鬼门封闭恶鬼横行，连前世跟她同归于尽的厉鬼都追过来成了终极邪物，这根本不是甜宠文，是个被天道拽来填坑的救世局，池羽我就想数钱养老，怎么全世界都在逼我成神？","series_id":"7703407903297784894","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623312502749CE23A499891A640\",\"rank\":\"6\",\"queue_names\":\"comics,shortplay\",\"final_queue_name\":\"comic\",\"gid\":\"7703407903297784894\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.05665243789553642,\\\"normalized_duration\\\":0.7864435315132141,\\\"stream_ctr\\\":0.05238419398665428,\\\"absolute_staytime\\\":0.1545577496290207,\\\"staytime_stream\\\":1.2211424112319946,\\\"finish\\\":0.003945406526327133,\\\"like\\\":0.050330642610788345}\"}","recommend_group_id":"7703407903297784894","play_cnt":2776863,"book_exist":false,"copyright":"深圳惊人科技有限公司","sub_title":"奇幻·全147集","score":"8.1","use_video_model":true,"episode_cnt":147,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5975,\"name\":\"奇幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5975&categoryName=奇幻&genreType=130&gender=0&sou