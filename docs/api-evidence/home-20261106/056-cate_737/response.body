语关怀备至，甚至为了沈轻语冤枉她，训斥她，温暖伤心至极，最终选择放下执念，彻底消失。","series_id":"7524623000843340862","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623315473DCD8871953C5A1F77A\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7524623000843340862\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.029760098084807396,\\\"normalized_duration\\\":0.6953908205032349,\\\"staytime_stream\\\":0.7792619466781616,\\\"absolute_staytime\\\":0.07358051836490631,\\\"stream_ctr\\\":0.03429369255900383,\\\"finish\\\":0.0015487609198316932,\\\"like\\\":0.048136770725250244}\"}","recommend_group_id":"7524623000843340862","play_cnt":4059,"book_exist":false,"copyright":"长沙古言","sub_title":"爱情·奇幻爱情","score":"8.2","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=5130&categoryName=系统&genreType=130&gender=0&source=detail\"},{\"category_id\":5182,\"name\":\"爱恨纠葛\",\"schema\":\"dragon8662://categorySearch?categoryId=5182&categoryName=爱恨纠葛&genreType=130&gender=0&source=detail\"},{\"category_id\":5180,\"name\":\"反转\",\"schema\":\"dragon8662://categorySearch?categoryId=5180&categoryName=反转&genreType=130&gender=0&source=detail\"},{\"category_id\":5242,\"name\":\"大叔\",\"schema\":\"dragon8662://categorySearch?categoryId=5242&categoryName=大叔&genreType=130&gender=0&source=detail\"},{\"category_id\":5276,\"name\":\"年龄差\",\"schema\":\"dragon8662://categorySearch?categoryId=5276&categoryName=年龄差&genreType=130&gender=0&source=detail\"},{\"cat