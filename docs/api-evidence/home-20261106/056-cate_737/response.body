n":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7549138781253684286","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/8ab813a73ad955b1c95a40d9cb5bbc20~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163115&x-signature=CJeqH1u%2BgpiUdn6ncFhTCGRqdCg%3D","duration":3988,"title":"助教是个乖乖女","video_desc":"台球助教苏瑶为保工作被老板宋前程怂恿勾引总裁陆昭然，却陷入妻子徐柔设计的捉奸逼宫阴谋。陆昭然识破陷阱后顺势设局，与苏瑶假意暧昧刺激徐柔。随着苏父欠债、宋前程投毒等危机接连爆发，陆昭然以净身出户假象迷惑对手，最终联合苏瑶揭露徐柔转移财产、宋前程教唆投毒等罪行。真相大白后，陆昭然惩治反派，苏瑶则在经历职场陷阱与情感考验后，意外成为台球厅新老板，与陆昭然展开新篇章。","series_id":"7549133684687768600","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623315473DCD8871953C5A1F77A\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7549133684687768600\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.08737902343273163,\\\"finish\\\":0.009708477184176445,\\\"collect\\\":0.03258974477648735,\\\"normalized_duration\\\":0.6899792551994324,\\\"like\\\":0.052618950605392456,\\\"staytime_stream\\\":0.6684660911560059,\\\"stream_ctr\\\":0.051714617758989334}\"}","recommend_group_id":"7549133684687768600","play_cnt":142522,"book_exist":false,"copyright":"云梦城短剧","sub_title":"都市·都市爱情","score":"8.1","use_video_model":true,"episode_cnt":37,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"