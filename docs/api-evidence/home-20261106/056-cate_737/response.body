e,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7474940436981763097","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/6f19d538eb675ae9ca6d4db8c14545cc~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163115&x-signature=fFkj7du2esGvXqAApcai90jzNtQ%3D","duration":10035,"title":"在逃新娘她娇不可攀","video_desc":"姜闪是姜家不受宠的长女，被迫替继妹嫁给传闻中残暴不举的陆家大少陆千樊，沦为守活寡的命运。不甘屈从的她，在婚礼当天毅然逃婚，却阴差阳错地闯入了新郎陆千樊的车。不知眼前人正是自己避之不及的“未婚夫”，姜闪恳求他帮助自己逃离这场荒唐的婚姻。陆千樊表面冷峻，内心却暗藏算计，顺势将她带回家，提出协议婚姻的提议。两人从互相利用到渐生情愫，最终在阴谋与真心的交织中，爱上彼此。","series_id":"7474899397319347262","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623315473DCD8871953C5A1F77A\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7474899397319347262\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.074670672416687,\\\"absolute_staytime\\\":0.1175813376903534,\\\"stream_ctr\\\":0.062273625284433365,\\\"finish\\\":0.001325022429227829,\\\"collect\\\":0.03963883966207504,\\\"normalized_duration\\\":0.7577939629554749,\\\"like\\\":0.05749328434467316}\"}","recommend_group_id":"7474899397319347262","play_cnt":1069330,"book_exist":false,"copyright":"百川中文","sub_title":"爱情·都市爱情","score":"8.1","use_video_model":true,"episode_cnt":90,"video_platform":3,"disable_play