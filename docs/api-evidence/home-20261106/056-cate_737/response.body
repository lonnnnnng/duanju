{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7493389452912364569","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/ad85c47b47f67ddad0689435f4614af2~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163115&x-signature=kR5R5m2BhD1mpzJbqtHVoxMcN7E%3D","duration":8369,"title":"一朵桔梗花","video_desc":"温梨昏迷三年，始终被父亲旧友傅峥悉心照料。这个比她年长许多的男人，沉稳克制，却在她最无助的时光里给予了最坚定的守护。昏迷中，她逐渐察觉到继母与继姐的阴谋算计。重生回到20岁那年，温梨不再逃避，她选择正面迎战那些伤害过她的人，也开始认真面对傅峥那份深藏已久、从未越界的情感。","series_id":"7493080842621684761","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623315473DCD8871953C5A1F77A\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7493080842621684761\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0011335690505802631,\\\"like\\\":0.04885777458548546,\\\"staytime_stream\\\":0.8308184742927551,\\\"stream_ctr\\\":0.06621474772691727,\\\"collect\\\":0.030675802379846573,\\\"normalized_duration\\\":0.716064989566803,\\\"absolute_staytime\\\":0.07955950498580933}\"}","recommend_group_id":"7493080842621684761","play_cnt":75354,"book_exist":false,"copyright":"tomatotv","sub_title":"爱情·都市爱情","score":"8.3","use_video_model":true,"episode_cnt":71,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱