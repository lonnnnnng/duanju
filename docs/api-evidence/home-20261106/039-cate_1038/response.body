ifit:400:0.image?lk3s=ae45642e&x-expires=1799163083&x-signature=27poP6rPT11XMW%2BmtvQ7y5pdP6k%3D","duration":6535,"title":"凤殿至尊","video_desc":"清洁工苏叶街边扫地时，豪车中走出的商书瑾给她银行卡，称自己重病将死，想帮辛苦的她。谁知苏叶把脉说能治好，却遭三位神医指责是骗子，这时商书瑾不受控制的昏厥过去。众人来到商家，神医们都束手无策，称只有至尊能救。苏叶这时表明自己就是至尊，治好商书瑾后离去。回家后，未婚夫顾子衍送来退婚书，苏叶不愿意，婚礼上顾子衍更是当众悔婚要娶苏千雪。此时，商书瑾带聘礼赶到，宣布迎娶苏叶，众人这才知道她就是至尊。","series_id":"7512404982247738430","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233121BA566FBC4E0F158D73EE\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7512404982247738430\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.1149985790252686,\\\"absolute_staytime\\\":0.10874496400356293,\\\"finish\\\":0.0015978461597114801,\\\"normalized_duration\\\":0.7387953400611877,\\\"stream_ctr\\\":0.053634338080883026,\\\"like\\\":0.052618950605392456,\\\"collect\\\":0.03308597579598427}\"}","recommend_group_id":"7512404982247738430","play_cnt":4874,"book_exist":false,"copyright":"湖南六翼影视","sub_title":"都市·超凡逆袭","score":"8.1","use_video_model":true,"episode_cnt":70,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5163,\"name\":\"马甲文\",\"schema\":\"dragon8662://categorySearch?categoryId=5163&categoryName=马甲文&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"cate