{"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7412507576220257305","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/f1f91e1ee3bd6d7ca6cdb4db7909e780~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163083&x-signature=tK4vwv%2FTw%2FW3Idum7hDJmmdFars%3D","duration":6757,"title":"北凉之主","video_desc":"剑侠叶长庚，剑法无双，名震江湖。他行侠仗义，以正义公平为信仰，破敌千里，让恶徒闻风丧胆。在冒险与历练中，他提升剑法，收获友情与爱情，更加成熟坚强。叶长庚的传奇故事传颂不衰，成为后世剑侠的学习榜样。他继续行走江湖，用力量与智慧守护正义与和平，成为一代传奇剑侠。","series_id":"7412500606826335257","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233121BA566FBC4E0F158D73EE\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7412500606826335257\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0011695103021338582,\\\"stream_ctr\\\":0.04232470691204071,\\\"like\\\":0.048136770725250244,\\\"absolute_staytime\\\":0.0887550562620163,\\\"collect\\\":0.03161877393722534,\\\"normalized_duration\\\":0.7445897459983826,\\\"staytime_stream\\\":1.0873887538909912}\"}","recommend_group_id":"7412500606826335257","play_cnt":13234,"book_exist":false,"copyright":"心动短剧","sub_title":"都市·超凡逆袭","score":"8.1","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&g