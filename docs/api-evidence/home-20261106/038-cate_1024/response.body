{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7439589562290015257","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/0635d66f3e52d1c9c05fbe160bb9633e~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163081&x-signature=XVm%2FXY4LeHCM3S8NiS0CPcV4IGY%3D","duration":7514,"title":"父重前行","video_desc":"京海备受瞩目的第一女博士周梦秋，率团队携自主研发的高精尖仪器强势回国，引得各界目光齐聚。发布会现场，众人本以为将见证科技盛举，却惊闻她当场要审判自己的父亲周前进，瞬间舆论哗然。随着调查深入，事件抽丝剥茧，每一步进展都出人意料，本以为尘埃落定，却又意外牵出另一个隐匿多年、不为人知的惊人真相。","series_id":"7439564955503823897","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233119EAF6258ADC7D7A9EDFDA\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7439564955503823897\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0011335690505802631,\\\"collect\\\":0.028007525950670242,\\\"like\\\":0.046724967658519745,\\\"absolute_staytime\\\":0.0747392401099205,\\\"normalized_duration\\\":0.7216811180114746,\\\"stream_ctr\\\":0.04593919962644577,\\\"staytime_stream\\\":0.7536610960960388}\"}","recommend_group_id":"7439564955503823897","play_cnt":7250,"book_exist":false,"copyright":"心动短剧","sub_title":"家庭·家庭伦理","score":"8.1","use_video_model":true,"episode_cnt":72,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5001,\"name\":\"家庭\",\"schema\":\"dragon8662://categorySearch?categoryId=5001&categoryName=家庭&genreType=130&gender=0&source=detail\"},{\"category_id\":5047,\"name\":\"家庭伦理\",\"schema\":\"dragon8662://categorySearch?categoryId=5047&categoryNa