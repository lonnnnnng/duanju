世纪七十年代，宋怀慈遵家庭安排与裴书宇结婚，婚姻无真情。裴书宇带回一个男孩裴念瑾让她抚养，还把返城机会给了苏槿萱。宋怀慈用心养育裴念瑾。裴念瑾成才考入名校，裴书宇和苏槿萱归来欲认子，宋怀慈揭示秘密，化解纷争。","series_id":"7486005091523120153","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233119EAF6258ADC7D7A9EDFDA\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7486005091523120153\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.7287633419036865,\\\"finish\\\":0.007577241398394108,\\\"absolute_staytime\\\":0.1251646876335144,\\\"stream_ctr\\\":0.03549669682979584,\\\"staytime_stream\\\":1.0960670709609985,\\\"collect\\\":0.03258974477648735,\\\"like\\\":0.049589015543460846}\"}","recommend_group_id":"7486005091523120153","play_cnt":101776,"book_exist":false,"copyright":"麦芽短剧","sub_title":"家庭·家庭伦理","score":"8.1","use_video_model":true,"episode_cnt":52,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5001,\"name\":\"家庭\",\"schema\":\"dragon8662://categorySearch?categoryId=5001&categoryName=家庭&genreType=130&gender=0&source=detail\"},{\"category_id\":5047,\"name\":\"家庭伦理\",\"schema\":\"dragon8662://categorySearch?categoryId=5047&categoryName=家庭伦理&genreType=130&gender=0&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5254&categoryName=揭露阴谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5314,\"name\":\"乡村\",\"schema\":\"dragon8662://categorySearch?categoryId=5314&categoryName=乡村&genreType=130&gender=0&source=detail\"}]","color_dominate":"#282810","horiz_cover":"","sub_title_list":[{"content":"家庭","data_type":3},{"content":"2745万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"家庭\",\"data_type