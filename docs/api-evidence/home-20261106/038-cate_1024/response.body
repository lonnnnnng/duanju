3221534936088","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233119EAF6258ADC7D7A9EDFDA\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7523043221534936088\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.002714984817430377,\\\"like\\\":0.048136770725250244,\\\"normalized_duration\\\":0.7727401256561279,\\\"collect\\\":0.033589500933885574,\\\"absolute_staytime\\\":0.10057263821363449,\\\"stream_ctr\\\":0.02740626595914364,\\\"staytime_stream\\\":0.8734605312347412}\"}","recommend_group_id":"7523043221534936088","play_cnt":126137,"book_exist":false,"copyright":"掌阅科技","sub_title":"家庭·家庭温情","score":"8.0","use_video_model":true,"episode_cnt":50,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5001,\"name\":\"家庭\",\"schema\":\"dragon8662://categorySearch?categoryId=5001&categoryName=家庭&genreType=130&gender=0&source=detail\"},{\"category_id\":5048,\"name\":\"家庭温情\",\"schema\":\"dragon8662://categorySearch?categoryId=5048&categoryName=家庭温情&genreType=130&gender=0&source=detail\"},{\"category_id\":5074,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5074&categoryName=奇幻脑洞&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#183040","horiz_cover":"","sub_title_list":[{"content":"家庭","data_type":3},{"content":"2202万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"家庭\",\"data_type\":3},{\"content\":\"2202万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7388093644210719769","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/bd480fcd9378dc6d1a1aed3864293f2a~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163081&x-signature=n6A75kLX1WvZYLkZnW9QmnvWeq4%3D","duration":7465,"title":"一闪一闪姜星星","video_desc":"姜玟因男人的背叛，为了报复男人，将自己的女儿星星与菜场卖鱼女孩幼宁调换，改写了二人的命运。幼宁成为夏家千金，却始终感到内心空虚；星星卖鱼送外卖，生活十分艰苦。十年后的一场生日宴上，两个女孩的人生再次产生了交集，她们联手探寻当年事情的真相，当真相大白时，姜玟后悔不已，她决定弥补自己的过错，用余生去守护这两个女儿。","series_id":"7388082140249869336","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233119EAF6258ADC7D7A9EDFDA\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7388082140249869336\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.028007525950670242,\\\"like\\\":0.04603390023112297,\\\"absolute_staytime\\\":0.08081239461898804,\\\"normalized_duration\\\":0.725922167301178,\\\"stream_ctr\\\":0.03446909785270691,\\\"staytime_stream\\\":0.9124701619148254,\\\"finish\\\":0.0012065895134583116}\"}","recommend_group_id":"7388082140249869336","play_cnt":44141,"book_exist":false,"copyright":"蜜糖短剧","sub_title":"家庭·家庭伦理","score":"8.0","use_video_model":true,"episode_cnt":77,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5001,\"name\":\"家庭\",\"schema\":\"dragon8662://categorySearch?categoryId=5001&categoryName=家庭&genreType=130&gender