{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7586891407839743000","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/e256d9366e1cd3116ff059a8a9788636~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163111&x-signature=xQkq2HfYpsGUHVvYTiVe%2B6yBtJ0%3D","duration":8853,"title":"闪婚京圈大佬后被全家团宠","video_desc":"京市首富厉云深儿时曾身患重病，乡下养病期间邂逅小丫头宁汐，并在宁汐鼓励下成功手术，约定见面那天，宁汐突然失踪。厉云深一直寻找宁汐下落，十八年后重逢，他立刻找借口与宁汐闪婚，怕宁汐离开自己，他极尽所能对她好，后来才发现，宁汐是自愿落入他的圈套，这场蓄谋已久的爱情，从一开始就是双向奔赴，最终顶峰相见，修成正果。","series_id":"7586889487376976921","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233150C4479DDCA7970089C768\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7586889487376976921\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.04146227985620499,\\\"normalized_duration\\\":0.7803233861923218,\\\"staytime_stream\\\":1.3077006340026855,\\\"absolute_staytime\\\":0.14633232355117798,\\\"finish\\\":0.002115704119205475,\\\"stream_ctr\\\":0.044042978435754776,\\\"like\\\":0.060086652636528015}\"}","recommend_group_id":"7586889487376976921","play_cnt":348895,"book_exist":false,"copyright":"景阅文化","sub_title":"爱情·都市爱情","score":"8.0","use_video_model":true,"episode_cnt":87,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categor