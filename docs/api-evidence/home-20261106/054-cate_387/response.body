tion":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7408391552847842328","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/390cc5b91d3dc79fe1481c7bd6c206bb~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163111&x-signature=ZR6sJRGtj2nMZjJMYvohZU2DumM%3D","duration":6416,"title":"妻不可欺","video_desc":"首富之女意外坠崖后失去记忆，被善良的赵富贵捡到，在赵家村留下照顾赵富贵的儿子赵耀宗长大，并改名赵雪琴。赵耀宗和赵雪琴在青梅竹马的相处中互生情愫，长大后的赵耀宗外出上大学之前和赵雪琴举办了婚礼，赵雪琴因此怀孕生下了儿子赵天阳。但赵耀宗却背叛赵雪琴，跟首富的养女林暖暖结了婚。赵富贵去世后，赵雪琴带着孩子进城找赵耀宗，阴差阳错下来到了林家别墅，撞破了赵耀宗抛妻弃子的真相。","series_id":"7408157933466307646","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233150C4479DDCA7970089C768\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7408157933466307646\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.050330642610788345,\\\"stream_ctr\\\":0.036594364792108536,\\\"staytime_stream\\\":1.0449910163879395,\\\"absolute_staytime\\\":0.11219688504934311,\\\"finish\\\":0.0030753694009035826,\\\"collect\\\":0.03258974477648735,\\\"normalized_duration\\\":0.7548395991325378}\"}","recommend_group_id":"7408157933466307646","play_cnt":104907,"book_exist":false,"copyright":"山海星辰","sub_title":"成长·女性成长","score":"8.1","use_video_model":true,"episode_cnt":51,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5110,\"name\":\"青梅竹马\",\"schema\":\"dragon8662://cate