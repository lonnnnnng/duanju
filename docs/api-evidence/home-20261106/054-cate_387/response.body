or_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7550609897704918078","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/9081895c46d53d7c892d300a88769760~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163111&x-signature=l43RbP%2BIq9%2BXBQ59ZbnSChBv%2FjM%3D","duration":8193,"title":"笙笙向西","video_desc":"苏念笙前世为爱卑微，却惨遭背叛含恨离世。重生后，她不再执着于旧爱，转身与竹马沈隽西携手。这位昔日的太子爷将苏念笙宠上天际。面对前夫的悔悟求复合，苏念笙心意已决，她与沈隽西并肩前行，在青春岁月里活出自我价值，最终彻底摆脱前世阴影，与沈隽西开启了幸福美满的人生，完成了从为爱卑微到被宠成公主的华丽逆袭。","series_id":"7550569711461731353","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233150C4479DDCA7970089C768\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7550569711461731353\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.1194329634308815,\\\"finish\\\":0.0018675664905458689,\\\"collect\\\":0.039048295468091965,\\\"normalized_duration\\\":0.7577939629554749,\\\"like\\\":0.05582313612103462,\\\"staytime_stream\\\":1.0511252880096436,\\\"stream_ctr\\\":0.06327403336763382}\"}","recommend_group_id":"7550569711461731353","play_cnt":497736,"book_exist":false,"copyright":"tomatotv","sub_title":"爱情·青春爱情","score":"8.1","use_video_model":true,"episode_cnt":75,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5064,\"name\":\"青春爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5064&categoryName=青春爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":504