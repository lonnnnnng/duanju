alse,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7497901340023082046","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/9deee7abcaa990c3dc7bb45aacd387fe~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163069&x-signature=sc7NL5vLcwbftkbjFrzsMGN4DSI%3D","duration":7771,"title":"我以胭脂覆山河","video_desc":"闫乐岁原本是世子夫人，遭小妾赵曼香与婆母毒手，命悬一线之际，望月楼薛姨娘将她救下，传授精妙媚术。她脱胎换骨改名海棠重返将军府，以妩媚之姿接近盛怀瑾，成功让其看清小妾的真面目，令恶人受到惩戒。盛怀瑾最终认出，眼前女子正是自己的结发妻子，两人化解误会，终成眷属。","series_id":"7497536835048967192","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233108E873FB5C06A9A28C8B6C\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7497536835048967192\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.6953908205032349,\\\"stream_ctr\\\":0.08369109779596329,\\\"like\\\":0.050330642610788345,\\\"finish\\\":0.0015487609198316932,\\\"staytime_stream\\\":1.0464833974838257,\\\"absolute_staytime\\\":0.09901341795921326,\\\"collect\\\":0.03308597579598427}\"}","recommend_group_id":"7497536835048967192","play_cnt":10255,"book_exist":false,"copyright":"好有本领","sub_title":"爱情·古风爱情","score":"8.3","use_video_model":true,"episode_cnt":79,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genre