ceholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7585505305933384766","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/1c39735eef068f12ce64364b920fa273~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163069&x-signature=65tTk65u2BsU%2B0YLcZPLuMdGc84%3D","duration":8072,"title":"我和亲后，太子急疯了","video_desc":"身为将军府嫡女的祝清欢爱上了随身暗卫，然而暗卫的真实身份却是当朝太子萧云澜，守在她身边也是为了庶妹祝明月。因为祝明月的一句抱怨，萧云澜命人将祝清欢丢进土匪窝折磨，祝清欢心死，向皇上求下前去北狄和亲的圣旨。和亲前的日子，萧云澜还屡屡伤害祝清欢，等到祝清欢真的离开了，他才追悔莫及，并从祝明月口中得知，他一眼定情的人是祝清欢，可此时祝清欢已经远嫁北狄，为追回爱人，他找到祝清欢母亲的佩剑，只为引她回来。","series_id":"7585503328902073406","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233108E873FB5C06A9A28C8B6C\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7585503328902073406\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.034834686666727066,\\\"like\\\":0.05665243789553642,\\\"collect\\\":0.03161877393722534,\\\"normalized_duration\\\":0.8241857290267944,\\\"finish\\\":0.001926734927110374,\\\"staytime_stream\\\":1.304261565208435,\\\"absolute_staytime\\\":0.13117145001888275}\"}","recommend_group_id":"7585503328902073406","play_cnt":124353,"book_exist":false,"copyright":"河马剧场","sub_title":"爱情·古风爱情","score":"8.0","use_video_model":true,"episode_cnt":61,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5188,\"name\":\"追妻\",\"schema\":\"dragon8662://categorySearch?categoryId=5188&categoryName=追妻&genreType=13