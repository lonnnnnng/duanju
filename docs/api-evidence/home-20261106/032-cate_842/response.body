{"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7606744371995626521","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/d98dfff15506e92568fa2a95b2321dc3~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163069&x-signature=Dh5WTx%2BBJNUC7eqSFYGFi5vBZ2U%3D","duration":10448,"title":"是离婚的关系","video_desc":"协议结婚三年，段景阳给了沈千帆一切，唯独没给爱情。离婚后，他以为能潇洒转身，却开始疯狂想念那个肆意撒野的女孩。当发现她被继母逼婚、遭渣男欺辱、出车祸住院、怀孕却不敢说——这位港城最矜贵的段爷，终于红了眼眶。他以“前夫哥”的身份为她扫平人渣，用尽手段把她护在身后，千里追妻只为一句话“离婚了也是家人”。从被动结婚到主动求复婚，段景阳的追妻路，是全世界最好的前夫哥，最笨拙也最赤诚的告白。","series_id":"7606742543711079449","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233108E873FB5C06A9A28C8B6C\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7606742543711079449\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.05921025201678276,\\\"absolute_staytime\\\":0.14863674342632294,\\\"collect\\\":0.03963883966207504,\\\"normalized_duration\\\":0.8330870270729065,\\\"finish\\\":0.001455063233152032,\\\"stream_ctr\\\":0.04808628186583519,\\\"staytime_stream\\\":1.1984401941299438}\"}","recommend_group_id":"7606742543711079449","play_cnt":4706356,"book_exist":false,"copyright":"海鱼星空","sub_title":"爱情·都市爱情","score":"8.1","use_video_model":true,"episode_cnt":67,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662:/