15943979729947710","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/c419b5e73e162d481dc40942d365fdde~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163088&x-signature=dSIEN4dAsJn%2BQcddXtVjKY93sak%3D","duration":10248,"title":"圣徒","video_desc":"杨家因为身怀秘宝被坏人灭门，杨过虽然逃过一劫，但是被敌人种下神秘蛊毒无人可解。拈花派拈花圣女救下杨过，并收其做大弟子，杨过跟随拈花圣女学医。多年后杨过长大，作为拈花派拈花圣女的唯一弟子，已经习得一身精妙医术，但是杨过身中蛊毒，肩负灭门深仇，拈花圣女尽力压制却无法解毒。杨过蛊毒再次发作，拈花圣女也无法压制，拈花圣女只好为爱徒探寻救命良方。","series_id":"7415931996196588569","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233127E625F74B2B30E28CC7BE\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7415931996196588569\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.06349645555019379,\\\"finish\\\":0.0006667023408226669,\\\"collect\\\":0.031143829226493835,\\\"normalized_duration\\\":0.692679762840271,\\\"absolute_staytime\\\":0.0747392401099205,\\\"like\\\":0.04603390023112297,\\\"staytime_stream\\\":0.9107698202133179}\"}","recommend_group_id":"7415931996196588569","play_cnt":12286,"book_exist":false,"copyright":"比翼鸟","sub_title":"都市·超凡逆袭","score":"8.1","use_video_model":true,"episode_cnt":96,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5150,\"name\":\"奉命下山\",\"schema\":\"dragon8662://categorySearch?categoryId=5150&categoryName=奉命下山&genreType=130&gender=1&source=detail\"},{\"category_id\":5177,\"name\":\"扮猪吃虎\",\"schema\":\"dragon8662://categorySearch?categoryId=5177&categoryName=扮猪吃虎&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dr