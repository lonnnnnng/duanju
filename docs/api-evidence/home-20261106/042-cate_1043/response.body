{"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7472601007277493310","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/2168f1f358a087c02e1bfdfbbe21cea7~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163088&x-signature=mR76b5u28Hetd8xStwyI9QItI1U%3D","duration":5194,"title":"仁心冷暖","video_desc":"叶凡为乡亲们治好癌症，却被诬陷卖假药，老婆柳如烟还把他告上审判庭。审判庭上，柳如烟联合赵铭几位患者一起污蔑叶凡，叶凡极力争辩，没人愿意相信他，直到患者病情重新发作。被妻子和众人联合污蔑的叶凡认清人心，决定强大起来。","series_id":"7472576622856506393","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233127E625F74B2B30E28CC7BE\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7472576622856506393\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.0614897720515728,\\\"absolute_staytime\\\":0.0713166818022728,\\\"finish\\\":0.0022518474142998457,\\\"collect\\\":0.026355355978012085,\\\"normalized_duration\\\":0.7022150158882141,\\\"like\\\":0.04146227985620499,\\\"staytime_stream\\\":0.693605899810791}\"}","recommend_group_id":"7472576622856506393","play_cnt":1031,"book_exist":false,"copyright":"花生短剧","sub_title":"都市·超凡逆袭","score":"8.1","use_video_model":true,"episode_cnt":50,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&gender=1&source=detail\"},{\"c