rce":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7459694914830339097","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/60ee7e2e86bd1fa02e4a01976199d09b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163088&x-signature=OoqHvKejJGu54K6RcwM3IIQdeOs%3D","duration":3327,"title":"破茧新生","video_desc":"五年前，医仙谷传人林北凡入世救下周雯，周雯因思念叶允浩，把林北凡当作替身与其结婚。江城首富吴家老爷子病重，林北凡将医仙谷药方藏于周雯家，诱她发现并去为吴老治病。不料周雯抓药失误，致吴老病情恶化。危急时刻，林北凡出手挽回吴老性命。此后，吴家全力扶持周雯，江城四大世家刘、赵、钱三家，也因林北凡与周家合作，助力周家跻身江城二流世家。","series_id":"7459664301570133016","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233127E625F74B2B30E28CC7BE\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7459664301570133016\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.09901341795921326,\\\"finish\\\":0.025957362726330757,\\\"collect\\\":0.031143829226493835,\\\"like\\\":0.04336579516530037,\\\"stream_ctr\\\":0.051099568605422974,\\\"normalized_duration\\\":0.7202730178833008,\\\"staytime_stream\\\":0.8725962042808533}\"}","recommend_group_id":"7459664301570133016","play_cnt":4705,"book_exist":false,"copyright":"长沙古言","sub_title":"都市·超凡逆袭","score":"8.1","use_video_model":true,"episode_cnt":53,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&genreType=130&gender=1&source=det