{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7486423431286639641","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/be828f4cdb995074f7b393873c2969be~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163123&x-signature=PtwAHhP7j%2B%2Bx169CgWs9fFrnQTk%3D","duration":1884,"title":"狐灾","video_desc":"爷爷老白擅长捕猎和剥制狐狸皮，在村里以他的手艺闻名，然而他的行为引起了奶奶和一些村民的担忧，他们认为过多杀生会带来不幸。一天，一个道士路过，警告爷爷他养在后院的狐狸有灵性，劝他少造杀孽。但爷爷并未听从。随后，家中开始发生一系列诡异事件，家禽被咬死，孙子亮亮还陷入了狐狸制造的幻境。最终，在孙子的劝说下，爷爷意识到万物皆有灵性，决定放走那只狐狸，并承诺以后少杀生。","series_id":"7486411319046851608","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233201D4D3EF578C3CF099A471\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7486411319046851608\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.06293674558401108,\\\"finish\\\":0.048136770725250244,\\\"staytime_stream\\\":0.618893563747406,\\\"like\\\":0.05184546485543251,\\\"collect\\\":0.03732689097523689,\\\"normalized_duration\\\":0.6065306663513184,\\\"stream_ctr\\\":0.05914950743317604}\"}","recommend_group_id":"7486411319046851608","play_cnt":2791,"book_exist":false,"copyright":"雨落风起","sub_title":"志怪·民俗志怪","score":"8.2","use_video_model":true,"episode_cnt":25,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5006,\"name\":\"志怪\",\"schema\":\"dragon8662://categorySearch?categoryId=5006&categoryName=志怪&genreType=130&gender=2&source=detail\"},{\"category_id\":5134,\"name\":\"民俗志怪\",\"schema\":\"dragon8662://category