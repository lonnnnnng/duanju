，把她让给清北校长家的少爷，回老家开始自己的生活。他离开之后，程希才发现，早已离不开倪安。","series_id":"7580198102385052696","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233201D4D3EF578C3CF099A471\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7580198102385052696\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.10376515984535217,\\\"finish\\\":0.001325022429227829,\\\"staytime_stream\\\":1.0791834592819214,\\\"collect\\\":0.026759283617138863,\\\"normalized_duration\\\":0.759275496006012,\\\"like\\\":0.05184546485543251,\\\"stream_ctr\\\":0.034202661365270615}\"}","recommend_group_id":"7580198102385052696","play_cnt":31635,"book_exist":false,"copyright":"河马剧场","sub_title":"爱情·都市爱情","score":"8.2","use_video_model":true,"episode_cnt":86,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=2&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=2&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=2&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=2&source=detail\"}]","color_dominate":"#e8c8b8","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"2249万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"爱情\",\"data_type\":3},{\"content\":\"2249万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_