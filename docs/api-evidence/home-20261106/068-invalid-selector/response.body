32\",\"request_id\":\"202611062332166A361944DBFD6CA0A3D7\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7647463733144325144\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.026759283617138863,\\\"stream_ctr\\\":0.04501700773835182,\\\"like\\\":0.05921025201678276,\\\"staytime_stream\\\":1.0662099123001099,\\\"normalized_duration\\\":0.716064989566803,\\\"collect\\\":0.039048295468091965,\\\"absolute_staytime\\\":0.11575839668512344}\"}","recommend_group_id":"7647463733144325144","play_cnt":281594,"book_exist":false,"copyright":"源水短剧","sub_title":"悬疑·悬疑情感","score":"8.1","use_video_model":true,"episode_cnt":30,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5004,\"name\":\"悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5004&categoryName=悬疑&genreType=130&gender=0&source=detail\"},{\"category_id\":5056,\"name\":\"悬疑情感\",\"schema\":\"dragon8662://categorySearch?categoryId=5056&categoryName=悬疑情感&genreType=130&gender=0&source=detail\"},{\"category_id\":5059,\"name\":\"民俗悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5059&categoryName=民俗悬疑&genreType=130&gender=0&source=detail\"},{\"category_id\":5180,\"name\":\"反转\",\"schema\":\"dragon8662://categorySearch?categoryId=5180&categoryName=反转&genreType=130&gender=0&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5254&categoryName=揭露阴谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"},{\"category_id\":5367,\"name\":\"亲情\",\"schema\":\"dragon8662://categorySearch?categoryId=5367&categoryName=亲情&genreType=130&gender=0&source=detail\"}]","color_dominate":"#081830","horiz_cover":"","sub_title_list":[{"content":"悬疑","data_type":3},{"content":"3275万热度","data_type":27}],"pay_info":{},"support_listen":false,"recom