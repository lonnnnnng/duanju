e&x-expires=1799163100&x-signature=pYApK6IeKm42EBtziMRnCpR7ehQ%3D","duration":6502,"title":"重回巅峰","video_desc":"曾经的叶峰，深陷赌博泥潭，欠下巨额赌债，却执迷不悟，最终导致妻女惨死、家破人亡，那时他才追悔莫及。多年过去，他凭努力成为亿万首富，可一觉醒来，叶峰竟神奇地回到了那悔恨终身的日子，妻子健在，女儿尚在身边，他决心弥补遗憾，许妻女一世荣耀。","series_id":"7452255742079274009","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623313943ADD0EA8E56F4A08855\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7452255742079274009\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0015487609198316932,\\\"collect\\\":0.031143829226493835,\\\"stream_ctr\\\":0.07266690582036972,\\\"like\\\":0.040845710784196854,\\\"absolute_staytime\\\":0.08602434396743774,\\\"normalized_duration\\\":0.7216811180114746,\\\"staytime_stream\\\":0.9240184426307678}\"}","recommend_group_id":"7452255742079274009","play_cnt":14381,"book_exist":false,"copyright":"河马短剧","sub_title":"逆袭·重生逆袭","score":"8.2","use_video_model":true,"episode_cnt":89,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5193,\"name\":\"预知未来\",\"schema\":\"dragon8662://categorySearch?categoryId=5193&categoryName=预知未来&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"}]","color_dominate":"#c8a068","horiz_cover":"","sub_title_list":[{"content":"逆袭","data_type":3},{"content":"1681万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"逆袭\",\"data_type\":3},{\"content\":\"168