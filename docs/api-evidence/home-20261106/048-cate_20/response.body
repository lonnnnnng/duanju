{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7589239755884219454","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/b8b7e4253d3ea35d32ee9498998aeb86~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163100&x-signature=Hwmakx3oVvxkmR743Nz12xJRC6U%3D","duration":6364,"title":"我用返现系统，潇洒享受","video_desc":"刑满释放的王春海刚归家，便发现前妻孙美玲早已卷走家中所有资产。穷困潦倒、走投无路的濒死之际，他手臂上早年偶遇道士留下的神秘符文，意外激活了 “十倍返现系统”。此后，王春海不仅帮黄小芳赔偿鞋款，为她包下店里全部的手机电脑，还在拍卖会上拍下凛冬星戒赠予她，更给主播刘莎莎豪刷了千万礼物。","series_id":"7589237888915622936","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623313943ADD0EA8E56F4A08855\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7589237888915622936\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.027982505038380623,\\\"staytime_stream\\\":1.3400098085403442,\\\"finish\\\":0.003273065434768796,\\\"collect\\\":0.03963883966207504,\\\"absolute_staytime\\\":0.1632455289363861,\\\"normalized_duration\\\":0.7667266130447388,\\\"like\\\":0.06371499598026276}\"}","recommend_group_id":"7589237888915622936","play_cnt":156388,"book_exist":false,"copyright":"乐不可吱短剧","sub_title":"都市·逆袭翻身","score":"8.2","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categor