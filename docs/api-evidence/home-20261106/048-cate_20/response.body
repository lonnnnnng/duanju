aceholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7579947182711655449","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/73c13a0a5997f416a25097368300e683~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163100&x-signature=bH7aa3UEnBA18QL8BSmNU1%2Ff5rI%3D","duration":8762,"title":"花出去的钱，都成了我的资产","video_desc":"学生陈宁被分手后意外觉醒花钱返现系统，为高分美女花钱可获高额返还。他从给系花吴梦蝶买水获五万返还起步，逐步通过为多位高分女性消费积累巨额财富，跻身富豪俱乐部。期间他屡遭赵明、万家等对手挑衅，凭借系统奖励与自身实力强势反击，收购企业、拿下项目与稀世珍宝。最终他坐拥千亿资产，却面临让四位美女和睦相处的终极任务，否则资产将归零。","series_id":"7579945297632037912","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623313943ADD0EA8E56F4A08855\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7579945297632037912\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.1474800407886505,\\\"normalized_duration\\\":0.7287633419036865,\\\"stream_ctr\\\":0.0507204607129097,\\\"staytime_stream\\\":1.1795074939727783,\\\"finish\\\":0.0012843082658946514,\\\"collect\\\":0.04146227985620499,\\\"like\\\":0.06187598779797554}\"}","recommend_group_id":"7579945297632037912","play_cnt":201724,"book_exist":false,"copyright":"tomatotv","sub_title":"都市·逆袭翻身","score":"8.2","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=5130&categoryName=系统&genreType=130&gender=1&source=detail\"},{\