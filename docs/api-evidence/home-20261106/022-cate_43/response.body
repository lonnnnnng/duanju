content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7408120814656031769","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/0a74fd1ee04bc0698a9c871280a1afd4~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163050&x-signature=M2N8aMDC0gLqBYS8xAumzvSlTWQ%3D","duration":6361,"title":"逆袭天后一战成名","video_desc":"孟繁星在洗手间意外撞破丈夫与女网红的不堪私情，恰在此时，另一个世界的顶流蔡天后的灵魂穿越到孟繁星身上，并拥有了她这具身体的记忆。戴着顶流灵魂的孟繁星毅然决定奋起反击，登上《天赐歌手》的海选舞台，誓要报复丈夫和小三。孟繁星凭借蔡天后记忆，精彩演绎各种经典唱跳曲目，狠狠打脸前夫和小三，成功赢得大众的认可和欣赏。孟繁星最终成功夺冠，荣登大夏歌坛天后之位。","series_id":"7408023887478279193","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623304871ACDDFAA8358A883841\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7408023887478279193\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.7287633419036865,\\\"like\\\":0.05500529333949089,\\\"absolute_staytime\\\":0.11219688504934311,\\\"stream_ctr\\\":0.05487341433763504,\\\"staytime_stream\\\":1.0853925943374634,\\\"finish\\\":0.0015978461597114801,\\\"collect\\\":0.03210071101784706}\"}","recommend_group_id":"7408023887478279193","play_cnt":27435,"book_exist":false,"copyright":"巨准剧场","sub_title":"逆袭·女性成长","score":"8.1","use_video_model":true,"episode_cnt":55,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5128,\"name\":\"重生\",\"schema\":\"dragon8662://categorySearch?categoryId=5128&categoryName=重生&genreType=130&gender=0&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\"