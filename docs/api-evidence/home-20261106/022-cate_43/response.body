6x%2F8l8T8a5nyDU%3D","duration":2622,"title":"春晚不能停","video_desc":"2025年龙国春晚前夕，艺术审美滑坡，清洁工林聪却独善其身。他质疑歌手刘华华唱《数鸭子》获赞，引起导演陈书瑶注意，受邀登台。林聪编排“大棉袄二棉裤”节目获认可，却遭叶梵尘嫉妒刁难。他还拒绝张大谋邀请。春晚表演时，林聪因多为模仿陷入自责，经陈书瑶鼓励，最终在舞台上绽放光彩，成为真正艺术家。","series_id":"7488165679535770648","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623304871ACDDFAA8358A883841\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7488165679535770648\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.08366037160158157,\\\"normalized_duration\\\":0.618493378162384,\\\"collect\\\":0.028870906680822372,\\\"staytime_stream\\\":0.5772213339805603,\\\"like\\\":0.039048295468091965,\\\"absolute_staytime\\\":0.05730456858873367,\\\"finish\\\":0.018833132460713387}\"}","recommend_group_id":"7488165679535770648","play_cnt":12638,"book_exist":false,"copyright":"稻谷文化","sub_title":"都市·逆袭翻身","score":"8.1","use_video_model":true,"episode_cnt":30,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=5130&categoryName=系统&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5320,\"name\":\"娱乐圈\",\"schema\":\"dragon8662://categorySearch?categoryId=5320&categoryName=娱乐圈&genreType=130&gender=1&sour