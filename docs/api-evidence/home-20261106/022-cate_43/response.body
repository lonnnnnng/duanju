es=1799163050&x-signature=EMxQaws6rp2yN0CR0gfjP%2B9Nc9U%3D","duration":6869,"title":"了不起的谢轻轻","video_desc":"谢轻轻与林星辰年少相恋，林星辰为救她昏迷七日，她许下七次原谅的承诺。七年中林星辰一再任性，终在第七次带叶婉儿回家，耗尽所有情意。谢轻轻心死离开，斩获设计大赛冠军。林星辰悔悟挽回被拒，林姐造谣被她轻松反转。叶婉儿设计陷害，林星辰相救却促成谢轻轻与孙浩宇感情升温。叶婉儿盗取设计稿致林家公司危机，最终入狱。林家悔悟求和被拒，谢轻轻远赴米兰深造，与孙浩宇相约顶峰相见。","series_id":"7464179234383072280","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623304871ACDDFAA8358A883841\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7464179234383072280\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.0169963836669922,\\\"normalized_duration\\\":0.7188675403594971,\\\"like\\\":0.050330642610788345,\\\"absolute_staytime\\\":0.0846906527876854,\\\"finish\\\":0.0013670254265889525,\\\"stream_ctr\\\":0.059205375611782074,\\\"collect\\\":0.029760098084807396}\"}","recommend_group_id":"7464179234383072280","play_cnt":4223,"book_exist":false,"copyright":"容量短剧","sub_title":"成长·女性成长","score":"8.1","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5188,\"name\":\"追妻\",\"schema\":\"dragon8662://categorySearch?categoryId=5188&categoryName=追妻&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"},{\"category_id\":5350,\"name\":\"情感觉醒\",\"schema\":\"dragon8662:/