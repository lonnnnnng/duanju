nd":false,"video_data":[{"vid":"7513853006417234969","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/dd5eb56b39e57cc219af28d99b0b937d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163050&x-signature=yNd0OGSDG5Mz1uqwxdN816FL9K8%3D","duration":7228,"title":"十八岁太奶奶驾到，重整家族荣耀","video_desc":"1955年，荣遇教授为救儿子意外身亡，醒来竟穿到七十年后同名的十八岁少女容遇身上。面对豪门宴会上的挑衅与陌生家族，她凭借旧时代积累的学识和胆识强势反击，并逐步确认年迈的纪舜英正是自己的儿子。容遇以长辈姿态整顿不孝子孙，介入纪氏职场与家族纷争，在身份质疑、权力博弈和接连考验中屡次破局，也收获家人的敬重与支持，最终成为全家争相维护的核心。","series_id":"7512797350914444313","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623304871ACDDFAA8358A883841\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7512797350914444313\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.13639673590660095,\\\"finish\\\":0.0029810327105224133,\\\"staytime_stream\\\":1.0252118110656738,\\\"normalized_duration\\\":0.8153795599937439,\\\"collect\\\":0.0534033365547657,\\\"stream_ctr\\\":0.06036403402686119,\\\"like\\\":0.05500529333949089}\"}","recommend_group_id":"7512797350914444313","play_cnt":5928011,"book_exist":false,"copyright":"光剧场","sub_title":"家族·家族振兴","score":"7.8","use_video_model":true,"episode_cnt":90,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5002,\"name\":\"家族\",\"schema\":\"dragon8662://categorySearch?categoryId=5002&categoryName=家族&genreType=130&gender=0&source=detail\"},{\"category_id\":5050,\"name\":\"家族振兴\",\"schema\":\"dragon8662://categorySearch?categoryId=5050&categoryName=家族振兴&genreType=130&gender=0&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"catego