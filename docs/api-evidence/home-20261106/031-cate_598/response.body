{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7564294614593571902","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/06a140df9f03c02d330756b6076d8a35~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163067&x-signature=1V8Jjwjv%2FqsPOuvj7s9OVAVahKI%3D","duration":6765,"title":"穿越七零，傻娘护崽超凶哒","video_desc":"《穿越七零：傻娘护崽超凶哒》讲述了力大无穷的田春芽穿越到七十年代，主动嫁给残疾退伍的恩人田战，并收养三个异能萌娃。她斗极品、打猎养家，用灵泉治愈丈夫腿伤。田战腿愈后重返岗位，身世揭开竟是京市林家之子。两人先婚后爱，带着萌娃进京团圆，开启事业与家庭双丰收的幸福生活。","series_id":"7564287256047930393","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233106BDF1B74E77610B8CEDB6\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7564287256047930393\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.05108273774385452,\\\"absolute_staytime\\\":0.09301449358463287,\\\"staytime_stream\\\":0.9757306575775146,\\\"normalized_duration\\\":0.716064989566803,\\\"finish\\\":0.0015978461597114801,\\\"collect\\\":0.03676946833729744,\\\"stream_ctr\\\":0.06617000699043274}\"}","recommend_group_id":"7564287256047930393","play_cnt":8518,"book_exist":false,"copyright":"tomatotv","sub_title":"爱情·年代爱情","score":"8.2","use_video_model":true,"episode_cnt":59,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5131,\"name\":\"年代爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5131&categoryName=