on":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7456637684040076313","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/d58b32a572e4173ed337f5eae52f6e1d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163042&x-signature=fnL%2BEYjziEkMmATloy7OnRJP97c%3D","duration":4117,"title":"借位双生","video_desc":"林心怡与付子阳相爱多年，本将步入婚姻殿堂，却遭付子越破坏。婚后林心怡因丈夫反常起疑，后发现付子阳尸体决心报复。付子越在其精神折磨下疯狂并策划让林心怡流产。计划成功后，林心怡当众揭穿了付子越的真实面目，告诉后续事情的真相，付子越精神崩溃自杀。虽历经磨难，但林心怡勇敢面对，最终为自己和亲人讨回公道。","series_id":"7456032674960903193","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233040BA8EE3307499589B933B\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7456032674960903193\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":0.7383377552032471,\\\"normalized_duration\\\":0.6635465621948242,\\\"finish\\\":0.007345827762037516,\\\"like\\\":0.046724967658519745,\\\"absolute_staytime\\\":0.0833776593208313,\\\"collect\\\":0.030675802379846573,\\\"stream_ctr\\\":0.0596059113740921}\"}","recommend_group_id":"7456032674960903193","play_cnt":1034,"book_exist":false,"copyright":"博易创为","sub_title":"爱情·都市爱情","score":"8.2","use_video_model":true,"episode_cnt":37,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5161,\"name\":\"替身文学\",\"schema\":\"dragon8662://categorySearch?categoryId=5161&categoryName=替