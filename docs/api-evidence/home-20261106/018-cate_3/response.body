b10ee1e8c77e1234621f21c97c433~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163042&x-signature=NUf0TWcsNWEe5CqpDRC1hZ3w46o%3D","duration":4231,"title":"财神请归位","video_desc":"苏念念因失误致霍凌风濒临破产，为弥补过错前去救助却适得其反，还失去特殊技能，被迫限期助其重回巅峰。过程中，两人屡遭挫折，苏念念也对霍凌风渐生情愫。最终，她拼尽全力助霍凌风挽回财产，自己却身份降级。霍凌风找到苏念念坚持追求，两人甜蜜相恋，但苏念念被迫归位。春节时，装扮成财神发糖的苏念念再现，两人故事得以延续，再续前缘。","series_id":"7471878173219638297","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233040BA8EE3307499589B933B\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7471878173219638297\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.030675802379846573,\\\"normalized_duration\\\":0.6596699953079224,\\\"like\\\":0.04208773002028465,\\\"absolute_staytime\\\":0.0702110230922699,\\\"finish\\\":0.004070138093084097,\\\"stream_ctr\\\":0.054740484803915024,\\\"staytime_stream\\\":0.7320258021354675}\"}","recommend_group_id":"7471878173219638297","play_cnt":11541,"book_exist":false,"copyright":"麦芽短剧","sub_title":"爱情·奇幻爱情","score":"8.2","use_video_model":true,"episode_cnt":50,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5119,\"name\":\"轻松搞笑\",\"schema\":\"dragon8662://categorySearch?categoryId=5119&categoryName=轻松搞笑&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=总裁&genreType=130&gender=0&source=detail\"},{\"category_id\":5294,\"name\":\"甜妹\",\"schema\":\"dragon8662://categorySearch?categoryId=5294&categoryName=甜妹&genreType=130&gender=0&source=detai