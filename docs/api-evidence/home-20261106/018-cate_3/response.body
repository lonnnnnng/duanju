{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7349072260830874649","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/5af82c65ed9c0df3c72c74637c10e714~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163042&x-signature=q3bq10QOCIR7mBoNUQ1VzQEDJv8%3D","duration":8827,"title":"家产争夺战","video_desc":"谢听晚本是富家千金，却没想到谢家一夜破产，男友顾时宴也在这个时候突然联系不上了，她不得不中断学业回国。三年后，谢听晚成为了顾家三少爷顾明弋最器重的助理，也意外发现前男友竟是老板的二哥。谢听晚被迫卷入顾家三兄弟争夺家产的大战中，而她也因为跟母亲酷似的长相，被顾父当成了弥补遗憾的工具，她在三人间游走盘桓，调查当年真相，可当一切浮出水面，她却不知该作何抉择……","series_id":"7349003812255829054","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233040BA8EE3307499589B933B\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7349003812255829054\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.6886329650878906,\\\"like\\\":0.04885777458548546,\\\"absolute_staytime\\\":0.09447924792766571,\\\"stream_ctr\\\":0.07752807438373566,\\\"staytime_stream\\\":1.14008367061615,\\\"finish\\\":0.0012448437046259642,\\\"collect\\\":0.03676946833729744}\"}","recommend_group_id":"7349003812255829054","play_cnt":28583,"book_exist":false,"copyright":"BFWH","sub_title":"爱情·都市爱情","score":"8.2","use_video_model":true,"episode_cnt":88,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySea