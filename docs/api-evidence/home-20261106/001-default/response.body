8","#FF4C6D","#EFB662"],"dark_bg_color":["#FF6868","#FF4C6D","#EFB662"],"position":2,"is_align_to_edge":false},"support_listen":true,"recommend_reason_list":"{\"tag_info\":{\"text\":\"爆剧\",\"bg_color\":[\"#FF6868\",\"#FF4C6D\",\"#EFB662\"],\"dark_bg_color\":[\"#FF6868\",\"#FF4C6D\",\"#EFB662\"],\"position\":2,\"is_align_to_edge\":false},\"sub_title_list\":[{\"content\":\"6518万\",\"data_type\":27,\"rec_icon_url\":\"https://lf3-reading.fqnovelstatic.com/obj/novel-common/img_hot_value_flame_icon.png\",\"rec_icon_url_dark\":\"https://lf3-reading.fqnovelstatic.com/obj/novel-common/img_hot_value_flame_dark_icon.png\"},{\"content\":\"爱情\",\"data_type\":3}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7700943522404240409","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/c15172543c91990298f0de1b39512434~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163009&x-signature=UTTlxMcreBbV09H4hIADH4n1DxQ%3D","duration":7367,"title":"重生螳螂，觉醒无限吞噬进化","video_desc":"史克螂意外重生，变成蛮荒丛林里一只弱小螳螂。身处弱肉强食的残酷世界，毒虫凶兽遍布四周，步步危机。所幸觉醒“无限吞噬进化”天赋！吞噬血肉，掠夺基因，不断蜕变外骨骼，解锁各类神通。猎杀猛兽，吞噬异种，持续进化变强。从底层小虫起步，挥动锋利镰刃，踏过无尽凶险，以吞噬之道，一步步成长为震慑万族的虫族至尊。","series_id":"7700941738487073817","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332