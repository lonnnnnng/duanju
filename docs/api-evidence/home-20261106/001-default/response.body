，闺蜜为了炫耀，将这一幕悄悄直播了出去。在外出差的姜南刷到了这场直播。姜南怀着怒火回到别墅，宋媛菲却将她误认成是小三，直到管家到来，拿出别墅房本证明姜南的身份，宋媛菲才知，许墨言只是个吃软饭的渣男，小三竟是她自己。","series_id":"7575194897678863385","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623300881CC692F4616B58B12CF\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7575194897678863385\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.6160821318626404,\\\"like\\\":0.05582313612103462,\\\"absolute_staytime\\\":0.1474800407886505,\\\"stream_ctr\\\":0.03357873484492302,\\\"staytime_stream\\\":1.3895516395568848,\\\"collect\\\":0.03161877393722534,\\\"finish\\\":0.06278920918703079}\"}","recommend_group_id":"7575194897678863385","play_cnt":10537,"book_exist":false,"copyright":"长沙古言","sub_title":"都市·女性成长","score":"8.0","use_video_model":true,"episode_cnt":39,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&genreType=130&gender=0&source=detail\"},{\"category_id\":5103,\"name\":\"暗恋成真\",\"schema\":\"dragon8662://categorySearch?categoryId=5103&categoryName=暗恋成真&genreType=130&gender=0&source=detail\"},{\"category_id\":5163,\"name\":\"马甲文\",\"schema\":\"dragon8662://categorySearch?categoryId=5163&categoryName=马甲文&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206