{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7417676032368446489","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/aa61ee0266d323d811bdf6c6c09b079a~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163106&x-signature=K%2B1CeplyAclvlXB5cSxbzSWb8P8%3D","duration":3942,"title":"梦回大曦","video_desc":"慕纯宁起初一心改写命运，坚决不愿成为皇后，却在与萧楚澜婚后相处中得知隐藏真相，是妹妹顶替自己救了落难之时的萧楚澜。两人误会解开相约白头，而景国开战，慕纯宁为两国和平牺牲自己。谁知竟扭转了命运的轨迹，使她重新回到了现代社会，萧楚澜殉情追随，两人于现代圆满重逢，再续前缘。","series_id":"7416663065942297625","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233144CC6B6346DA425D9E6916\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7416663065942297625\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":0.9642987251281738,\\\"finish\\\":0.008847354911267757,\\\"collect\\\":0.039048295468091965,\\\"normalized_duration\\\":0.6967503428459167,\\\"stream_ctr\\\":0.04813332110643387,\\\"absolute_staytime\\\":0.08737902343273163,\\\"like\\\":0.04885777458548546}\"}","recommend_group_id":"7416663065942297625","play_cnt":5098,"book_exist":false,"copyright":"苏州落蒂文化传媒有限公司","sub_title":"爱情·古风爱情","score":"8.3","use_video_model":true,"episode_cnt":50,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古