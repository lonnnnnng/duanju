ignature=9JHFqAMZz1sNqgv7khk2gvl14FA%3D","duration":8112,"title":"重回80：我的赘婿人生开了挂","video_desc":"苏汉东重生回到八零年代，觉醒打脸系统，为弥补前世遗憾，选择留在妻子周妍身边，通过前世知识和系统打脸他人，发家致富，加入保收队，将钓鱼技术传授给村民们，带全村致富。苏汉东驯养猎犬参加秋围，帮忙抓捕坏人，获得表彰。苏汉东拒绝回首富苏家，与妻子幸福的生活在一起。","series_id":"7577975196645067801","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623312982FE8B73C147609B2FE2\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7577975196645067801\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.11396373808383942,\\\"normalized_duration\\\":0.6899792551994324,\\\"like\\\":0.05108273774385452,\\\"collect\\\":0.035678550601005554,\\\"staytime_stream\\\":1.0273923873901367,\\\"finish\\\":0.0015011823270469904,\\\"stream_ctr\\\":0.05486159399151802}\"}","recommend_group_id":"7577975196645067801","play_cnt":13995,"book_exist":false,"copyright":"tomatotv","sub_title":"逆袭·奇幻脑洞","score":"8.1","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5074,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5074&categoryName=奇幻脑洞&genreType=130&gender=1&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=5130&categoryName=系统&genreType=130&gender=1&source=detail\"},{\"category_id\":5128,\"name\":\"重生\",\"schema\":\"dragon8662://categorySearch?categoryId=5128&categoryName=重生&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5226,\"name\":\"忠诚男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5226&categoryName=忠诚男主&genreType=1