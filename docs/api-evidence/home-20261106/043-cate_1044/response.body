ze":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7605179418339724313","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/075a2814455fcbbc1388197aca6fc39f~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163091&x-signature=CEVPCbBG1vexLY3nS6FVW5aWNm0%3D","duration":5237,"title":"赘婿他过分强大","video_desc":"深山里强得变态，下山却成豪门赘婿？为突破纯阳瓶颈，林辰被迫贴身保护嫌弃他的未婚妻沈清欢。白天他是毒舌保镖，怼天怼地；夜晚他是隐形大佬，默默扫清一切威胁。杀手女王对他倾心，家族兄长暗中下毒，昔日叛徒卷土重来，当所有危机爆发，他徒手接子弹、怒斩强敌，护她在怀动我女人，问过我这软饭硬不硬了吗？","series_id":"7605177289394899992","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623312982FE8B73C147609B2FE2\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7605177289394899992\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.7104924917221069,\\\"like\\\":0.05108273774385452,\\\"finish\\\":0.004331502597779036,\\\"stream_ctr\\\":0.04478968679904938,\\\"absolute_staytime\\\":0.10874496400356293,\\\"collect\\\":0.03514484688639641,\\\"staytime_stream\\\":0.9222880601882935}\"}","recommend_group_id":"7605177289394899992","play_cnt":3702,"book_exist":false,"copyright":"tomatotv","sub_title":"都市·都市玄幻","score":"8.3","use_video_model":true,"episode_cnt":51,"video_platform":3,"d