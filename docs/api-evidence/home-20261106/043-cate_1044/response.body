false,"video_data":[{"vid":"7533508722769792062","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/96f261d32ba0152052a6ecb898995932~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163091&x-signature=qC9CbBFcEHR4nkwG2kLxg%2BlBwVI%3D","duration":5742,"title":"逆光","video_desc":"在岳父柳大年的寿宴上，上门女婿江北饱受岳母李秀梅的刻薄和亲戚们的轻视。而当岳父得意的大女婿、二女婿以及妻子柳冰月的富豪前男友李承烨相继到来时，江北的处境更是雪上加霜。李承烨的炫耀与岳父母的谄媚和他之前的处境形成鲜明对比，而柳冰月与李承烨同车出现，更让江北心寒。饭后，在众人怂恿下，一场以娱乐为名的牌局开始。面对李承烨的咄咄逼人和柳冰月的不信任，江北起初坚决拒绝，却反被嘲讽“没胆量”、“扫兴”。","series_id":"7533434062652836926","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623312982FE8B73C147609B2FE2\",\"rank\":\"9\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7533434062652836926\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.7518967986106873,\\\"finish\\\":0.003945406526327133,\\\"collect\\\":0.028870906680822372,\\\"absolute_staytime\\\":0.10874496400356293,\\\"like\\\":0.04535258188843727,\\\"stream_ctr\\\":0.04658119007945061,\\\"staytime_stream\\\":0.8847012519836426}\"}","recommend_group_id":"7533434062652836926","play_cnt":73324,"book_exist":false,"copyright":"树下的椰子","sub_title":"都市·都市日常","score":"8.2","use_video_model":true,"episode_cnt":61,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5078,\"name\":\"都市日常\",\"schema\":\"dragon8662://categorySearch?categoryId=5078&categoryName=都市日常&genreType=130&gender=1&source=detail\"},{\"category_id\":5165,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5165&categoryName=隐藏大佬&genreType=130&gender=1&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&genreType=130&gender=1&source=detail\"