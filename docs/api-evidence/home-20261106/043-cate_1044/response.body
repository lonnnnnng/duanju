{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7523149388504370201","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/6bf1d5508535acdbb5254d7e54337642~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163091&x-signature=HAnECtKhDh6QAPAg9t8iKZZGPu4%3D","duration":7335,"title":"伤心者联盟","video_desc":"陆辰本是星辰集团创始人，因爱放弃事业，与濒临破产的苏家千金苏清雪成婚，婚后照料她，助苏家成天海首富。三年后，苏清雪嫌弃陆辰，爱上初恋江浩辰。与此同时，龙国首富独女童颜也被江浩辰抛弃。陆辰与童颜同病相怜，离婚后结婚，携手对江浩辰和苏清雪展开复仇 。","series_id":"7523039798500527128","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623312982FE8B73C147609B2FE2\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7523039798500527128\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.0497591495513916,\\\"absolute_staytime\\\":0.10705902427434921,\\\"normalized_duration\\\":0.725922167301178,\\\"like\\\":0.0541987344622612,\\\"collect\\\":0.033589500933885574,\\\"stream_ctr\\\":0.03683970123529434,\\\"finish\\\":0.0012843082658946514}\"}","recommend_group_id":"7523039798500527128","play_cnt":47468,"book_exist":false,"copyright":"魔方短剧","sub_title":"都市·都市日常","score":"8.1","use_video_model":true,"episode_cnt":64,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5078,\"name\":\"都市日常\",\"schema\":\"dragon8662://categorySearch?categoryId=5078&categoryName=都市日常&genreType=130&ge