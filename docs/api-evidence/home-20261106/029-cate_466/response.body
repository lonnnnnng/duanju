{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7439275939860581401","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/b1d18cf046560414e61336a9be346744~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163063&x-signature=iCFkY2Bh0wN4oRi%2FTSeHFxC%2F%2FY0%3D","duration":7957,"title":"老伴，我真是首富","video_desc":"年过五十的许清柔凭一己之力建立晴宇集团，艰难把儿子许言礼拉扯大，眼看着他有了女朋友却迟迟不肯结婚，追问下许言礼推脱只有母亲找到老伴自己才会考虑结婚，于是许清柔便伪装成保洁找人领证意图蒙骗儿子，不料相亲后阴差阳错闪婚嫁给同样被女儿催婚的首富贺文轩，贺文轩担心对方惦记自己的财产，也给自己伪造了一个群演的身份，两人领证后险些被各自助理戳破身份，为了掩护自己的马甲绞尽脑汁最终蒙混过关。","series_id":"7439266508846402585","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331028A9D71C332E914A39FE9\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7439266508846402585\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.1348841190338135,\\\"collect\\\":0.03514484688639641,\\\"stream_ctr\\\":0.06007334962487221,\\\"finish\\\":0.0012065895134583116,\\\"normalized_duration\\\":0.7548395991325378,\\\"absolute_staytime\\\":0.11219688504934311,\\\"like\\\":0.05665243789553642}\"}","recommend_group_id":"7439266508846402585","play_cnt":39467,"book_exist":false,"copyright":"触摸/亘淼","sub_title":"爱情·都市爱情","score":"8.2","use_video_model":true,"episode_cnt":59,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"