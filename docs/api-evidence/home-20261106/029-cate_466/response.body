2,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7468218080565414936","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/9baf97d9f7ef4405f45c1afae0e17eb8~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163063&x-signature=ZK87i1VwbHdSoy53S8b8Thr9uHQ%3D","duration":7745,"title":"天下无双","video_desc":"外卖员秦风小时候从乞丐手里买了一本武功秘籍，苦练十数年成为绝世高手，但并不自知。在带着收养的女儿秦佳佳送外卖的时候，偶然闯入古武世家陈家大小姐陈梦瑶的比武招亲现场。秦佳佳刻意为之，秦风无意中击败各路高手获得陈梦瑶青睐。陈梦瑶将秦风带回家，在父母考验过后认同秦风这个绝世高手的女婿，但秦风依旧不知道自己的武力，直到争夺武林盟主的比武大典上，陈梦瑶和秦佳佳的生命受到威胁，秦风被动出手，惊艳四座。","series_id":"7467059050463644696","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331028A9D71C332E914A39FE9\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7467059050463644696\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":0.9972240328788757,\\\"stream_ctr\\\":0.09233149886131287,\\\"finish\\\":0.0011335690505802631,\\\"normalized_duration\\\":0.7022150158882141,\\\"absolute_staytime\\\":0.0887550562620163,\\\"collect\\\":0.03210071101784706,\\\"like\\\":0.046724967658519745}\"}","recommend_group_id":"7467059050463644696","play_cnt":76490,"book_exist":false,"copyright":"时来欢聚","sub_title":"都市·超凡逆袭","score":"8.2","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5157,\"name\":\"天下无敌\",\"schema\":\"dragon8662://categorySearch?categoryId=5157&categoryName=天下无敌&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=