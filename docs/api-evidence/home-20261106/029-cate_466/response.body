tle":"花间喜事昭月归","video_desc":"小道士昭瑜在山上清修多年灵力毫无长进，被师傅踹下了山，临走前他赠与一颗种子，告诉她找到真爱，修为就会大涨。结果种子被慕岑误打误撞吞下，还因此直接得了个娃？！生孩子，上哪去讲道理！嬉笑打闹中，命运的齿轮徐徐推进，慕岑注定要死在某个月黑风高的晚上。人人都劝她放弃，爱意随风起，她说，她偏要勉强。","series_id":"7491889448867613721","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331028A9D71C332E914A39FE9\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7491889448867613721\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.04535258188843727,\\\"finish\\\":0.0009399441769346595,\\\"normalized_duration\\\":0.7245057225227356,\\\"staytime_stream\\\":0.9260565638542175,\\\"absolute_staytime\\\":0.08208499848842621,\\\"collect\\\":0.028870906680822372,\\\"stream_ctr\\\":0.052815355360507965}\"}","recommend_group_id":"7491889448867613721","play_cnt":38283,"book_exist":false,"copyright":"花生短剧","sub_title":"爱情·奇幻爱情","score":"8.0","use_video_model":true,"episode_cnt":59,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5097,\"name\":\"闪婚\",\"schema\":\"dragon8662://categorySearch?categoryId=5097&categoryName=闪婚&genreType=130&gender=0&source=detail\"},{\"category_id\":5095,\"name\":\"先婚后爱\",\"schema\":\"dragon8662://categorySearch?categoryId=5095&categoryName=先婚后爱&genreType=130&gender=0&source=detail\"},{\"category_id\":5119,\"name\":\"轻松搞笑\",\"schema\":\"dragon8662://categorySearch?categoryId=5119&categoryName=轻松搞笑&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=总裁&genreType=130&gender=0&source=detail\"},{\"category_id\":5226,