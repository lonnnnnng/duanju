{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7498665706385329214","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/b617f48305a24d3d0dd7e55372bf8e40~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163093&x-signature=JR0wMA4FYm2pxG34xCBgETg%2BAeg%3D","duration":7898,"title":"君王何不配吴钩","video_desc":"大楚末年，内忧外患交织。天灾频发，百姓苦不堪言；外有蛮族伺机而动。朝堂之上，奸相魏贤权倾朝野，把持朝政。小皇帝楚青初登大宝，却遭魏贤胁迫，无奈下令斩杀抗蛮英雄岳青山，更目睹母亲惨死，气绝身亡。现代特种兵意外穿越，借楚青之躯重生。面对魏贤咄咄逼人，他怒不可遏，当场斩杀魏贤党羽神棍，并威逼魏贤告老还乡。魏贤却暗中勾结南蛮，引来使臣逼降。楚青毅然剑斩使臣，随后亲征蛮族，终平定乱世。","series_id":"7498256778820324377","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623313166414191314A489E0E2A\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7498256778820324377\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.11219688504934311,\\\"collect\\\":0.03732689097523689,\\\"like\\\":0.0541987344622612,\\\"stream_ctr\\\":0.041940487921237946,\\\"staytime_stream\\\":1.1635797023773193,\\\"finish\\\":0.001648483332246542,\\\"normalized_duration\\\":0.725922167301178}\"}","recommend_group_id":"7498256778820324377","play_cnt":19178,"book_exist":false,"copyright":"容量短剧","sub_title":"古装·朝堂权谋","score":"8.3","use_video_model":true,"episode_cnt":66,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5137,\"name\":\"朝堂权谋\",\"schema\":\"dragon866