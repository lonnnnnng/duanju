ion":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7482995037576367128","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/0ebff6f9db9b526391782b8658a8b9d4~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163093&x-signature=ZE4FxItgs1D9XGpZca2bntChZIY%3D","duration":5101,"title":"龙飞九天","video_desc":"赵祯曾是身份尊贵的皇子，却因宫廷斗争被流放至荒凉边关。生活艰苦，他却在“地狱模式”中崛起，成为让敌军闻风丧胆的无敌战神——东方龙飞。多年后荣耀回归，他隐姓埋名，期待爱情，却遭祝芊洛退婚，心碎不已。与此同时，壮龙族暗谋中原，趁机搅动朝堂。面对感情危机与家国大患，赵祯如何逆转局势，挽回爱与安宁？一场传奇故事就此展开。","series_id":"7482755268724395032","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623313166414191314A489E0E2A\",\"rank\":\"9\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7482755268724395032\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.040840860456228256,\\\"staytime_stream\\\":1.0771479606628418,\\\"normalized_duration\\\":0.7202730178833008,\\\"absolute_staytime\\\":0.07832605391740799,\\\"collect\\\":0.033589500933885574,\\\"finish\\\":0.00255091255530715,\\\"like\\\":0.04023794084787369}\"}","recommend_group_id":"7482755268724395032","play_cnt":40878,"book_exist":false,"copyright":"阅文短剧","sub_title":"古装·古装传奇","score":"8.2","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5139,\"name\":\"古装传奇\",\"schema\":\"dragon8662://categorySearch?categoryId=5139&categoryName=古装传奇&genreType=130&gender=1&source=detail\"},{\"category_id\":5137,\"name\":\"朝堂权谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5137&cate