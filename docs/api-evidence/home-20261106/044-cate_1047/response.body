},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7703469081269128216","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/1c0a4bce2608b39f68ef207e1825d360~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163093&x-signature=zzAR1GEyESv21dJ0IUkLIAV55uo%3D","duration":7198,"title":"无敌皇子，双面王爷谋天下","video_desc":"穿越异世，萧万平成为大炎人人嗤笑的痴傻八皇子。白日疯傻伪装自保，入夜才恢复清醒。母妃骤然病逝，兄长离奇战死，靠山尽数崩塌。父皇满心猜忌，诸位兄弟虎视眈眈欲除他性命，满朝文武无人相护。他借傻子外壳苟命蛰伏，暗中积蓄势力，不动声色铲除劲敌。待到先帝驾崩，萧万平手握百万雄师兵临皇城，用昔日父皇的说辞，狠狠回击昔日仇敌。","series_id":"7703469074914741272","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623313166414191314A489E0E2A\",\"rank\":\"6\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7703469074914741272\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.1632455289363861,\\\"stream_ctr\\\":0.03783443942666054,\\\"staytime_stream\\\":0.9897453784942627,\\\"normalized_duration\\\":0.7022150158882141,\\\"collect\\\":0.04603390023112297,\\\"finish\\\":0.0030753694009035826,\\\"like\\\":0.058345843106508255}\"}","recommend_group_id":"7703469074914741272","play_cnt":1008,"book_exist":false,"copyright":"溪水咪","sub_title":"3D·全77集","score":"8.4","use_video_model":true,"episode_cnt":77,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=1&source=detail\"},{\"category_id\":5958,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5958&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5902,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5902&categoryName=逆袭翻身