:{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7514258719677352985","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/089731125eac6396674a6c22c9eaf00b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163093&x-signature=MfSz2kPUelIcZeXIJZ%2FXW7VJA10%3D","duration":5885,"title":"蛊女","video_desc":"阿萝以蛊女身份隐秘守护部落，与霍沉安相恋后，因身份被其知晓，遭背叛，霍沉安欲揭露并伤她孩子。阿萝借蛊术自保、寻真相，发现威胁部落的大阴谋。这场信任、爱情与生存之争里，众人面临艰难抉择，人性复杂与光明尽显。","series_id":"7512736314307906585","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623313166414191314A489E0E2A\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7512736314307906585\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.035678550601005554,\\\"staytime_stream\\\":1.0891367197036743,\\\"absolute_staytime\\\":0.12131377309560776,\\\"stream_ctr\\\":0.061418309807777405,\\\"finish\\\":0.004331502597779036,\\\"normalized_duration\\\":0.783377468585968,\\\"like\\\":0.04885777458548546}\"}","recommend_group_id":"7512736314307906585","play_cnt":5150,"book_exist":false,"copyright":"华阳短剧","sub_title":"古装·女性成长","score":"8.0","use_video_model":true,"episode_cnt":61,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5254&categoryName=揭露阴谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"s