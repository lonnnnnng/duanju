_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7604751780328524824","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/693564ca34a36fcb005e4f0750480a1b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163093&x-signature=0SSUkMOzcY38ZWYRraqaVT3J1%2FE%3D","duration":7423,"title":"江山墨染如画","video_desc":"林氏将门虎女，林染以林家军虎符为陪嫁，换来的不是凤冠霞帔，而是锥心背叛与圣旨和亲。那一夜，她斩断情丝，以天下为局，执棋对弈九五之尊。朝堂之上，她步步为营，誓要为林家满门忠烈讨回血债；宫阙之中，她算无遗策，将帝王的阴谋逐一碾碎。当龙位上的天子撕下伪善，欲行鱼死网破之时，她长刀所指，皆是民心所向。最终宫门洞开，群臣俯首，林染登临帝位，开创属于她的万里江山！","series_id":"7604749767226182680","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623313166414191314A489E0E2A\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7604749767226182680\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.05665243789553642,\\\"collect\\\":0.035678550601005554,\\\"stream_ctr\\\":0.038176313042640686,\\\"staytime_stream\\\":1.187246322631836,\\\"absolute_staytime\\\":0.14072643220424652,\\\"finish\\\":0.0023967318702489138,\\\"normalized_duration\\\":0.7879810333251953}\"}","recommend_group_id":"7604749767226182680","play_cnt":116882,"book_exist":false,"copyright":"河马剧场","sub_title":"成长·女性成长","score":"8.2","use_video_model":true,"episode_cnt":65,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":