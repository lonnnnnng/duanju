f1930321295d9593631b59707~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163130&x-signature=N6Di8eJdt1UIjKYjPO1Gvv4d2vU%3D","duration":4293,"title":"作精八零好运妻：阮紫依的书中梦","video_desc":"阮紫依意外穿入书中，成了即将被扫地出门的恶毒女配。她放弃离婚，打算用一个孩子留在沈家。丈夫沈郁峥双腿残疾、性情冷戾，起初对她厌恶至极，却在她一次次靠近中，悄然软化了心防。可她没想到，自己随手动笔修改的剧本，正悄悄偏离原书——而那个本该属于女主的位置，也渐渐开始摇晃起来。","series_id":"7667444089696046104","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623320962AF9AD5A41C049D40A9\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7667444089696046104\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.05500529333949089,\\\"finish\\\":0.014503581449389458,\\\"collect\\\":0.0384662002325058,\\\"staytime_stream\\\":1.0429383516311646,\\\"absolute_staytime\\\":0.1175813376903534,\\\"normalized_duration\\\":0.7431368827819824,\\\"stream_ctr\\\":0.03158882260322571}\"}","recommend_group_id":"7667444089696046104","play_cnt":618253,"book_exist":false,"copyright":"快创短剧","sub_title":"爱情·年代爱情","score":"8.2","use_video_model":true,"episode_cnt":61,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5131,\"name\":\"年代爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5131&categoryName=年代爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5170,\"name\":\"穿书\",\"schema\":\"dragon8662://categorySearch?categoryId=5170&categoryName=穿书&genreType=130&gender=0&source=detail\"},{\"category_id\":5095,\"name\":\"先婚后爱\",\"schema\":\"dragon8662://categorySearch?categoryId=5095&categoryName=先婚后爱&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category