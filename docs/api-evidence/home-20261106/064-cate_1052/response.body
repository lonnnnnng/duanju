_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7536485254815550488","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/720ce5e428549faaf7153e43faf97ca7~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163130&x-signature=J3purIzoKwP51hredp3aEqK6mtg%3D","duration":8882,"title":"裙下臣","video_desc":"林灿灿在娱乐圈底层挣扎，意外与李熠灵魂相连。李熠助她摆脱欺辱、获取资源，她逐渐成长。过程中揭露父亲剽窃母亲作品等秘密，最终二人携手，她实现演员梦想，收获真爱。","series_id":"7536053516167547929","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623320962AF9AD5A41C049D40A9\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7536053516167547929\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.09301449358463287,\\\"finish\\\":0.0017546142917126417,\\\"collect\\\":0.03161877393722534,\\\"normalized_duration\\\":0.7063416242599487,\\\"stream_ctr\\\":0.03311833366751671,\\\"like\\\":0.046724967658519745,\\\"staytime_stream\\\":0.9649016857147217}\"}","recommend_group_id":"7536053516167547929","play_cnt":140235,"book_exist":false,"copyright":"海鱼星空","sub_title":"爱情·奇幻爱情","score":"8.0","use_video_model":true,"episode_cnt":71,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5178,\"name\":\"逆风翻盘\",\"schema\":\"dragon8662://categorySearch?categoryId=5178&categoryName=逆风翻盘&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearc