80645956670","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/d352f388d80b98ffeae19aea501760a0~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163130&x-signature=1uFmHstnApjtae%2BYhakdyBXsx%2Bw%3D","duration":5837,"title":"谢他曾误芳华","video_desc":"沈昭宁是大夏最受宠的公主，自幼被选定四位童养夫。前世她执意选择爱慕的江承渊，却不知他心属庶妹苏萋萋，最终甚至亲手将她杀害。重生归来，她毅然放弃江承渊，转而选择前世冤家萧云野。江承渊得知后悔恨不已。沈昭宁与萧云野携手破除阻碍、揭穿阴谋，终得圆满相守。","series_id":"7547533238198078488","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623320962AF9AD5A41C049D40A9\",\"rank\":\"9\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7547533238198078488\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.004331502597779036,\\\"stream_ctr\\\":0.04080736264586449,\\\"absolute_staytime\\\":0.13117145001888275,\\\"collect\\\":0.03732689097523689,\\\"normalized_duration\\\":0.7489653825759888,\\\"like\\\":0.05921025201678276,\\\"staytime_stream\\\":1.1485741138458252}\"}","recommend_group_id":"7547533238198078488","play_cnt":148184,"book_exist":false,"copyright":"树下的椰子","sub_title":"爱情·古风爱情","score":"8.3","use_video_model":true,"episode_cnt":57,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5128,\"name\":\"重生\",\"schema\":\"dragon8662://categorySearch?categoryId=5128&categoryName=重生&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&cate