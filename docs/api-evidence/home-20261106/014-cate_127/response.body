师资助力学生。20天冲刺后，学生们考进全市前三，保住学校。后续宋昊阳网暴抹黑，学生们挺身而出守护秋海棠，最终真相大白，学院正常办学，秋海棠也领悟教书育人的意义。","series_id":"7571323579908754456","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623303326F1F0C56C88288CC18D\",\"rank\":\"9\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7571323579908754456\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.7697274684906006,\\\"like\\\":0.04885777458548546,\\\"collect\\\":0.03514484688639641,\\\"stream_ctr\\\":0.05408346280455589,\\\"absolute_staytime\\\":0.11219688504934311,\\\"staytime_stream\\\":1.1626373529434204,\\\"finish\\\":0.001926734927110374}\"}","recommend_group_id":"7571323579908754456","play_cnt":23997,"book_exist":false,"copyright":"tomatotv","sub_title":"成长·女性成长","score":"8.3","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5165,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5165&categoryName=隐藏大佬&genreType=130&gender=0&source=detail\"},{\"category_id\":5145,\"name\":\"网络暴力\",\"schema\":\"dragon8662://categorySearch?categoryId=5145&categoryName=网络暴力&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"},{\"category_id\":5315,\"name\":\"校园\",\"schema\":\"dragon8662://categorySearch?categoryId=5315&categoryName=校园&genr