ll,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7667542401707166745","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/f9f0c37cab0abbf52ba7766a37441962~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163034&x-signature=NRyG3OunXjeiCcIkGs0C9sJMFNI%3D","duration":9386,"title":"这才是医生","video_desc":"江城中心医院送来一名胸口插刀的重伤者，一众医生束手无策，顶尖医学顾问叶天星临危出手，惊险挽回伤者生命。他敏锐察觉到行凶少年身体异常，断定对方也命悬一线。此后医院接连接诊多名症状怪异、病因难寻的病患，一桩暗藏心机的投毒阴谋也随之浮出水面。叶天星凭借精湛医术与细致观察，接连破解一道道医疗难题，在救人的同时见证人间百态，以医者担当守护生命。","series_id":"7667540469118667801","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623303326F1F0C56C88288CC18D\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7667540469118667801\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.2381237745285034,\\\"finish\\\":0.0017546142917126417,\\\"absolute_staytime\\\":0.14980250597000122,\\\"normalized_duration\\\":0.7637373805046082,\\\"like\\\":0.06187598779797554,\\\"collect\\\":0.047425877302885056,\\\"stream_ctr\\\":0.040632907301187515}\"}","recommend_group_id":"7667540469118667801","play_cnt":1695282,"book_exist":false,"copyright":"湖南六翼影视","sub_title":"都市·医疗","score":"8.0","use_video_model":true,"episode_cnt":73,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5077,\"name\":\"医疗\",\"schema\":\"dragon8662://categorySearch?categoryId=5077&categoryName=医疗&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5207,\"name\":\"业界精英\",\"s