le":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7470069230856047641","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/f43be8bc76470d2564a6c68871e6a0d7~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163034&x-signature=K%2BpOpjvv07t1JbwxgtS%2B26D7Bz4%3D","duration":2857,"title":"归来之沉冤昭雪","video_desc":"前世，我被养妹哄骗给病人输液，却惨遭家人陷害，成为了人嫌鬼憎的罪犯，被人打死在法庭门口，临死前，我见到了哥哥和养妹的嘲弄笑容，但没想到，老天爷又给了我一次机会，这一世，我重生过来，绝对不会再重蹈覆辙，我要提前布局，将这些一切都逆转。","series_id":"7470054376044760126","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623303326F1F0C56C88288CC18D\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7470054376044760126\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.07832605391740799,\\\"like\\\":0.0427221953868866,\\\"staytime_stream\\\":0.9499850273132324,\\\"finish\\\":0.026759283617138863,\\\"collect\\\":0.027169229462742805,\\\"normalized_duration\\\":0.6766338348388672,\\\"stream_ctr\\\":0.04769730195403099}\"}","recommend_group_id":"7470054376044760126","play_cnt":120526,"book_exist":false,"copyright":"山海星辰","sub_title":"都市·重生逆袭","score":"8.3","use_video_model":true,"episode_cnt":29,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5254&categoryName=揭露阴谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#101018","horiz_cover":"","sub_title_list":[{"content":"都市","data_type":3},{"content":"3329万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"都市\",\"data_type\":3},{\"content\":\"3329万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7640066635071491134","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/9d29ff8d2a86065a1ea2b2afe7d256d5~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163034&x-signature=0NTvCLgW43Lh0Ro%2BsRPos%2FJGD8Y%3D","duration":5967,"title":"误撩天价老公，盛爷追着要负责","video_desc":"云城盛家，顶级尊贵，掌权人盛司宴却因血脉诅咒，终生只能接触一名异性。为避麻烦，他公开标榜“厌女”，直到那晚，走投无路的小可怜，顶着一双红通通的兔子眼，不知死活地吻上他的唇。得知误惹了禁欲冰山大佬，夏柠吓得只想逃跑，却一头撞进他步步为营的温柔陷阱！起初，盛司宴冷脸甩下婚书“娶你，只是对孩子负责。”后来，他抱着她深情表白“柠柠，这辈子，我都赖上你了。”","series_id":"7640064703888116760","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623303326F1F0C56C88288CC18D\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7640064703888116760\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.5201925039291382,\\\"absolute_staytime\\\":0.1645258665084839,\\\"normalized_duration\\\":0.8027382493019104,\\\"finish\\\":0.004468384198844433,\\\"collect\\\":0.04208773002028465,\\\"stream_ctr\\\":0.03991194814443588,\\\"like\\\":0.06278920918703079}\"}","recommend_group_id":"7640064703888116760","play_cnt":173989,"book_exist":false,"copyright":"古麦嘉禾","sub_title":"爱情·都市爱情","score":"8.2","use_video_model":true,"episode_cnt":61,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5246,\"name\":\"霸道男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5246&categoryName=霸道男主&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&category