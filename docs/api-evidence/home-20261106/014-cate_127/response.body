:"7474889634682506264","cover":"https://p9-reading-sign.fqnovelpic.com/novel-pic/54db9dba417e9730620d3f3b2ff9f8e5~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163034&x-signature=u35rz1XXKCewJOEQ%2FLc0aHRmw3I%3D","duration":5212,"title":"巾帼仁医","video_desc":"白寒梅是华夏第一中医，有着近五十年临床经验，医术高超，却在小医院就职。学生孙玥以科室主任身份，在她看诊时将其辞退。白寒梅痛心，更放心不下患罕见病的小女孩，可离开医院就无法就诊，只能无奈离去 。","series_id":"7474828295855426622","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623303326F1F0C56C88288CC18D\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7474828295855426622\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.09901341795921326,\\\"like\\\":0.052618950605392456,\\\"finish\\\":0.00255091255530715,\\\"stream_ctr\\\":0.06559402495622635,\\\"normalized_duration\\\":0.707722544670105,\\\"staytime_stream\\\":1.0148143768310547,\\\"collect\\\":0.035678550601005554}\"}","recommend_group_id":"7474828295855426622","play_cnt":7433,"book_exist":false,"copyright":"乐不可吱","sub_title":"都市·医疗","score":"8.1","use_video_model":true,"episode_cnt":53,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5077,\"name\":\"医疗\",\"schema\":\"dragon8662://categorySearch?categoryId=5077&categoryName=医疗&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&source=detail\"},{\"category_id\":5208,\"name\":\"医生\",\"schema\":\"dragon8662://categorySearch?categoryId=5208&categoryName=医生&genreType=130&gender=