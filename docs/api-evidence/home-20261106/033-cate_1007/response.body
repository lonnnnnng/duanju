eading-sign.fqnovelpic.com/novel-pic/7d66784f5c097ec19d1c1d4a4b3f8e0c~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163071&x-signature=xNJxHy%2BNPolKMLHBWQIb5OrAIMk%3D","duration":5622,"title":"尘缘了却时","video_desc":"男主厉南辰原是蓬莱玄龟族太子，因意外沦落凡间，被司家老祖母所救，产生因果，为报答救命之恩，厉南辰甘当司家的保家仙。多年后，当司扶摇命悬一线之际，司家后来的主母司静慈乞求厉南辰救治司扶摇。为了救治司扶摇，厉南辰冒险硬扛天雷，化形现身，为司扶摇逆天改命，司扶摇也因此对厉南辰芳心暗许。","series_id":"7546804137740995646","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233110E817556A0EBCD89DE455\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7546804137740995646\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.060766056180000305,\\\"normalized_duration\\\":0.7489653825759888,\\\"like\\\":0.0384662002325058,\\\"finish\\\":0.0028895812574774027,\\\"collect\\\":0.024053551256656647,\\\"staytime_stream\\\":0.8789254426956177,\\\"absolute_staytime\\\":0.0833776593208313}\"}","recommend_group_id":"7546804137740995646","play_cnt":6660,"book_exist":false,"copyright":"树下的椰子","sub_title":"玄幻·玄幻仙侠","score":"8.1","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5008,\"name\":\"玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5008&categoryName=玄幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5072,\"name\":\"玄幻仙侠\",\"schema\":\"dragon8662://categorySearch?categoryId=5072&categoryName=玄幻仙侠&genreType=130&gender=1&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5265,\"name\":\"女帝\",\"schema\":\"dragon8662://categorySearch?categoryId=5265&categoryName=女帝&genreType=130&