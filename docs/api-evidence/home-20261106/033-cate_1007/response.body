{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7488937027279277081","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/caff1f929650e2766effac9e15681cb9~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163071&x-signature=ptluYByOu5021qj3DugPfZ7JMTo%3D","duration":3710,"title":"明王风云录","video_desc":"多年前，孤云宗、龙吟山庄、药王谷为夺《不死明王咒》血洗长生教，教主二儿子冷凌云被裴春秋扔下山谷，得长生老祖搭救并获传《明王咒》。多年后，身负重振长生教使命的冷凌云踏上归途，却不想，江湖因此再度掀起血雨腥风。","series_id":"7488905056121539608","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233110E817556A0EBCD89DE455\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7488905056121539608\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.009412589482963085,\\\"collect\\\":0.03514484688639641,\\\"stream_ctr\\\":0.06824377179145813,\\\"normalized_duration\\\":0.7035878896713257,\\\"staytime_stream\\\":0.8492146730422974,\\\"absolute_staytime\\\":0.08081239461898804,\\\"like\\\":0.04336579516530037}\"}","recommend_group_id":"7488905056121539608","play_cnt":12684,"book_exist":false,"copyright":"麦芽短剧","sub_title":"古装·江湖武侠","score":"8.3","use_video_model":true,"episode_cnt":50,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5138,\"name\":\"江湖武侠\",\"schema\":\"dragon8662://categorySearch?categoryId=5138&categoryName=江湖武侠&genreType=130&gender=1&source=detail