d":"7499048213458996286","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/f31befc1f19dbf54faf58e67d6fc17b2~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163094&x-signature=%2Bz81Ot%2Bdg83oVS0D%2BzBk0gp8E2E%3D","duration":7751,"title":"荒年全村啃树皮，我有系统满仓肉","video_desc":"程弯弯一觉醒来，竟穿越到古代大河村，成了三十三岁的农妇。四个儿子跪在床前唤娘，儿媳更是身怀六甲，母胎单身三十三年的她，直接升级成了奶奶。她不仅要费心管教四个儿子，还接连遭遇蝗灾、旱灾、雪灾等重重天灾。好在她意外拥有交易商城，凭借商城物资，她定下两个目标：一是带领全家平安度过荒年，二是在古代活出属于自己的精彩人生。本剧改编自番茄小说《荒年全村啃树皮，我有系统满仓肉》，作者朝云紫。","series_id":"7499015543093988377","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233133304382DC57BD129E95EA\",\"rank\":\"9\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7499015543093988377\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0029810327105224133,\\\"collect\\\":0.049589015543460846,\\\"normalized_duration\\\":0.7980484962463379,\\\"staytime_stream\\\":1.0568256378173828,\\\"stream_ctr\\\":0.04831663891673088,\\\"like\\\":0.05582313612103462,\\\"absolute_staytime\\\":0.12131377309560776}\"}","recommend_group_id":"7499015543093988377","play_cnt":1410997,"book_exist":false,"copyright":"广州林阳文化传媒有限公司","sub_title":"逆袭·女性成长","score":"7.8","use_video_model":true,"episode_cnt":76,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5074,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5074&categoryName=奇幻脑洞&genreType=130&gender=0&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=0&source=detail\"},{\