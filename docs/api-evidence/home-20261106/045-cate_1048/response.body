"video_desc":"重生回被问当日，桑竹微笑“选状元吧，他最怜香惜玉。”她亲手将陆凝雪推向天阉的顾文杰，自己则暗中设计，哄骗其退掉将军婚约，伪造落红蛰伏，只为夺回卖身契。直至那日，将军将她护入怀中。替嫁两世，丫鬟逆袭攀上高枝，踏着仇人悔恨，登上巅峰。","series_id":"7595967420288732185","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233133304382DC57BD129E95EA\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7595967420288732185\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.005384938325732946,\\\"collect\\\":0.04146227985620499,\\\"like\\\":0.06187598779797554,\\\"absolute_staytime\\\":0.14863674342632294,\\\"staytime_stream\\\":1.2746927738189697,\\\"stream_ctr\\\":0.034176334738731384,\\\"normalized_duration\\\":0.7301880717277527}\"}","recommend_group_id":"7595967420288732185","play_cnt":2294645,"book_exist":false,"copyright":"tomatotv","sub_title":"成长·女性成长","score":"8.3","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5069,\"name\":\"重生逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5069&categoryName=重生逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5127,\"name\":\"双重生\",\"schema\":\"dragon8662://categorySearch?categoryId=5127&categoryName=双重生&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"drago