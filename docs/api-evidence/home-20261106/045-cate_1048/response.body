18","horiz_cover":"","sub_title_list":[{"content":"成长","data_type":3},{"content":"1480万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"成长\",\"data_type\":3},{\"content\":\"1480万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7704629503078714393","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/2f8e189d57b4c6c94c5aefe6afba1bab~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163094&x-signature=EYgSATUsxHFIDk1nJwe6S4wicXs%3D","duration":7248,"title":"母亲瘫痪十五年，大姐出嫁全家慌了","video_desc":"徐春兰放弃高考，照顾瘫痪的母亲直到三十五岁，本想嫁人过几天清净日子，没成想被人毁了清白，导致全家人都成了整个家属院的笑柄。她为了赎罪，在徐家当了三十年免费保姆，最后被从小带大的侄子赶出家门。在一个桥洞下遇见了当年的凶手，得知了惨剧的真相，悲愤交加之下，一把火拉着全家人同归于尽。一睁眼，她回到了1982年，这一世，她再也不当任人拿捏的软包子，誓要为自己活个痛快。","series_id":"7704627845913381912","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233133304382DC57BD129E95EA\",\"rank\":\"6\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7704627845913381912\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.046724967658519745,\\\"stream_ctr\\\":0.057687558233737946,\\\"like\\\":0.05665243789553642,\\\"normal