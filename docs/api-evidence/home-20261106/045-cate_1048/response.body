{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7575197731212250136","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/bebe009ee3120aef71007d3ae1719748~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163094&x-signature=RVUaofZ81tj1cchlOw6Xqr4ZgwE%3D","duration":2746,"title":"金屋难藏娇","video_desc":"江旅集团总裁姜南，出差期间，未婚夫许墨言冒充她总裁的身份，将她价值十亿的别墅，借给小三宋媛菲举办闺蜜聚会派对，将别墅弄得一团糟，闺蜜为了炫耀，将这一幕悄悄直播了出去。在外出差的姜南刷到了这场直播。姜南怀着怒火回到别墅，宋媛菲却将她误认成是小三，直到管家到来，拿出别墅房本证明姜南的身份，宋媛菲才知，许墨言只是个吃软饭的渣男，小三竟是她自己。","series_id":"7575194897678863385","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233133304382DC57BD129E95EA\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7575194897678863385\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.714667797088623,\\\"staytime_stream\\\":1.1516196727752686,\\\"finish\\\":0.04603390023112297,\\\"stream_ctr\\\":0.03859344497323036,\\\"like\\\":0.049589015543460846,\\\"absolute_staytime\\\":0.1194329634308815,\\\"collect\\\":0.03210071101784706}\"}","recommend_group_id":"7575194897678863385","play_cnt":10537,"book_exist":false,"copyright":"长沙古言","sub_title":"都市·女性成长","score":"8.0","use_video_model":true,"episode_cnt":39,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categ