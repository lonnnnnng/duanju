l,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7586891571472124952","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/8aa460d22075a9af33082c8d85fb3d3d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163094&x-signature=DBnY%2FvvqzNKzjph%2FsP8tIN0xTzA%3D","duration":6778,"title":"长姐如刀，专斩弟弟烂桃花","video_desc":"全国首富最敬重的姐姐夏知月，为给弟弟的白血病女友捐献骨髓进城，却在医院提前遇到了弟弟的女友白青青。而此时白青青为了赶回病房接待初次见面的夏知月、获得夏知月的认可不仅插队看诊还推倒孕妇，夏知月仗义出手却被白青青伙同奸夫羞辱殴打，白青青看不起夏知月是个乡巴佬，却不知自己的美梦即将破碎。","series_id":"7586889489402842137","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233133304382DC57BD129E95EA\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7586889489402842137\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.02931222692131996,\\\"absolute_staytime\\\":0.12131377309560776,\\\"stream_ctr\\\":0.06952101737260818,\\\"like\\\":0.05500529333949089,\\\"normalized_duration\\\":0.7518967986106873,\\\"staytime_stream\\\":1.044352412223816,\\\"finish\\\":0.002472623949870467}\"}","recommend_group_id":"7586889489402842137","play_cnt":13929,"book_exist":false,"copyright":"麦芽短剧","sub_title":"都市·女性成长","score":"8.0","use_video_model":true,"episode_cnt":58,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://