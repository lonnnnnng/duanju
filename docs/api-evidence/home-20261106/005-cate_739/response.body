"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7687509139135679513","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/90caee4c4897714d8f42d0efb40aab6e~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163016&x-signature=P92oLMPVJ4F4FPw0sx7%2BZA8AOI8%3D","duration":2201,"title":"极寒末日：我的雪蟒老公超护短","video_desc":"前世我拼死拼活赚积分，养出一只高高在上的白眼狼火狐，最终被他嫌弃惨死。重活一世，渣兽竟然也重生了，还想跟绿茶妹妹联手踩着我上位？笑死！我果断转身契约了极寒雪蟒。渣兽嘲笑我选了个废物，直到极寒末日降临，我带着化身为半人半蛇、战力爆表的雪松冷香美男杀穿副本，赚取亿万积分！渣兽红着眼眶跪地求复合，我家冰冷蛇夫眼神一暗“敢觊觎我的女人，死！”","series_id":"7687506916150365208","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233015AF6EC093EC07C9A172B9\",\"rank\":\"4\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7687506916150365208\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.039951350539922714,\\\"like\\\":0.07369627058506012,\\\"absolute_staytime\\\":0.13963128626346588,\\\"finish\\\":0.10970577597618103,\\\"collect\\\":0.06465348601341248,\\\"staytime_stream\\\":1.268698811531067,\\\"normalized_duration\\\":0.6953908205032349}\"}","recommend_group_id":"7687506916150365208","play_cnt":2145768,"book_exist":false,"copyright":"漫引力","sub_title":"灾难·全50集","score":"8.1","use_video_model":true,"episode_cnt":50,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5998,\"name\":\"灾难\",\"schema\":\"dragon8662://categorySearch?categoryId=5998&categoryName=灾难&genreType=130&gender=0&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130