favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7700864561875799065","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/5ecb5c8561ac42a64a350d280914e104~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163016&x-signature=BoY0%2FzmqRkTysk6QScaNdiAIYAw%3D","duration":4656,"title":"鱼缸里到底有什么","video_desc":"全职主妇温宁发现，丈夫沈嘉树每晚对着鱼缸坐两小时，声称养鱼静心。闺蜜苏晴来家喂鱼后突然惊恐，要求报警，随即跑出家门坠江身亡，死前攥着温宁儿子捏的橡皮泥小鱼。温宁在警方调查中撬开鱼缸底座暗格，内有屏幕和耳机孔——他看的从来不是鱼，而是监控画面。顺藤摸瓜，她查到植物人林晚！那才是沈嘉树的合法妻子，也是江景房产权人。而苏晴死前攥着的那条橡皮泥小鱼，正指向一个被隐瞒多年的真相。","series_id":"7700862621431385113","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233015AF6EC093EC07C9A172B9\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7700862621431385113\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.705239176750183,\\\"normalized_duration\\\":0.7431368827819824,\\\"absolute_staytime\\\":0.19691167771816254,\\\"finish\\\":0.014957086183130741,\\\"collect\\\":0.04401865601539612,\\\"stream_ctr\\\":0.03487977758049965,\\\"like\\\":0.06754669547080994}\"}","recommend_group_id":"7700862621431385113","play_cnt":4868436,"book_exist":false,"copyright":"快创短剧","sub_title":"悬疑·悬疑情感","score":"8.1","use_video_model":true,"episode_cnt":78,"video_platform":3,"disable_play":false,"category_schema":"[{\"cate