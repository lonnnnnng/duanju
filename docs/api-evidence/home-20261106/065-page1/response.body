":"1579万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"古装\",\"data_type\":3},{\"content\":\"1579万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7486423431286639641","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/be828f4cdb995074f7b393873c2969be~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163132&x-signature=l73SSlYoIS2ROvORZdFfDa7EqD0%3D","duration":1884,"title":"狐灾","video_desc":"爷爷老白擅长捕猎和剥制狐狸皮，在村里以他的手艺闻名，然而他的行为引起了奶奶和一些村民的担忧，他们认为过多杀生会带来不幸。一天，一个道士路过，警告爷爷他养在后院的狐狸有灵性，劝他少造杀孽。但爷爷并未听从。随后，家中开始发生一系列诡异事件，家禽被咬死，孙子亮亮还陷入了狐狸制造的幻境。最终，在孙子的劝说下，爷爷意识到万物皆有灵性，决定放走那只狐狸，并承诺以后少杀生。","series_id":"7486411319046851608","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233211DBC03EA0334D08A64DE4\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7486411319046851608\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.03676946833729744,\\\"stream_ctr\\\":0.08670185506343842,\\\"like\\\":0.05108273774385452,\\\"staytime_stream\\\":0.6111468076705933,\\\"absolute_staytime\\\":0.06293674558401108,\\\"finish\\\":