/novel-pic/28ba6a27723a861c01b6b1940aa1a063~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163136&x-signature=1BQxU4uXvhX8JOAL0qvfTBxAU7M%3D","duration":8843,"title":"病娇女帝：找到你了我的太傅大人","video_desc":"林衍穿越到异世界，辅佐白洛颜成为女帝，但因害怕被背叛而假死逃脱。回归现实后，林衍高考优异，进入大学。白洛颜穿越到现实，成为白家千金，强势倒追林衍。两人在大学中经历种种波折，逐渐解开误会，最终走到一起","series_id":"7510879002089753625","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062332158A237565B617158FC740\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7510879002089753625\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.04336579516530037,\\\"staytime_stream\\\":0.6839302778244019,\\\"collect\\\":0.02843603305518627,\\\"normalized_duration\\\":0.6913281679153442,\\\"stream_ctr\\\":0.044162824749946594,\\\"absolute_staytime\\\":0.06595715135335922,\\\"finish\\\":0.000855900754686445}\"}","recommend_group_id":"7510879002089753625","play_cnt":39909,"book_exist":false,"copyright":"tomatotv","sub_title":"爱情·奇幻爱情","score":"8.1","use_video_model":true,"episode_cnt":78,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=2&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=2&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=2&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=5130&categoryName=系统&genreType=130&gender=2&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=2&source=detail\"}]","color_dominate":"#e8d0d8