ort_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"家庭\",\"data_type\":3},{\"content\":\"1140万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7612942985491139608","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/0fda9723876107ae7abddc92441a63e8~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163136&x-signature=7aCBhOTUx%2BS07TlmdBskZhSWcvo%3D","duration":7849,"title":"我真没想轰动全校","video_desc":"富二代顾尘秉持有福硬享有难人当的摆烂信条，本想躺平混日子，却意外收到清北录取通知书，还被家里断粮，每月仅1500生活费。绝境中他绑定最强摆烂系统，以睡衣躺懒人沙发报到，获200万奖励，借系统赋予的语言天赋当志愿者免军训，却因带交流团去洗浴中心丢了志愿资格；后又在迎新晚会翻车，凭系统奖励的大师级唱功逆风翻盘。他一边用系统奖励改善生活，一边在摆烂中化解麻烦，活出了让同学震惊、老师无奈的另类大学生活。","series_id":"7612940957557738521","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062332158A237565B617158FC740\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7612940957557738521\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.09015274047851562,\\\"staytime_stream\\\":0.7377853393554688,\\\"collect\\\":0.033589500933885574,\\\"finish\\\":0.0011335690505802631,\\\"normalized_duration\\\":0.7118815779685974,\\\"stream_ctr\\\":0.016