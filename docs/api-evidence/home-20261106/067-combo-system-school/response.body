p_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7514622147336080409","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/5dedb9b0172f12998f2b955fb9616bb5~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163136&x-signature=xTdC17H4ZPVv8kvgjUKy5SQXfEI%3D","duration":5689,"title":"姐姐，我真不想当学霸啊","video_desc":"天之骄子何棠意外绑定“最强学渣系统”，需考倒数第一才能兑换千亿奖励，失败则遭天劫。校长之女林青雯紧盯他，年少时说要保护的林青雯也成任务阻碍。他在各种场合刻意摆烂却次次逆袭，比如街舞比赛踩香蕉皮都能夺冠。最终天劫倒计时，他为守护林青雯放弃任务，却发现系统是对他心性的考验，不仅成功保命，还与林青雯收获爱情，用实力证明“学霸”可自由掌控，开启了别样的人生篇章。","series_id":"7514552458048179224","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062332158A237565B617158FC740\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7514552458048179224\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.707722544670105,\\\"stream_ctr\\\":0.058572106063365936,\\\"staytime_stream\\\":0.732097864151001,\\\"finish\\\":0.0028895812574774027,\\\"like\\\":0.04535258188843727,\\\"absolute_staytime\\\":0.07955950498580933,\\\"collect\\\":0.03161877393722534}\"}","recommend_group_id":"7514552458048179224","play_cnt":15738,"book_exist":false,"copyright":"合肥迪迅信息","sub_title":"都市·逆袭翻身","score":"8.1","use_video_model":true,"episode_cnt":58,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\