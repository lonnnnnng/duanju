{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7507490156123802686","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/c4d3b1511d79e548b5b0aee675176eb4~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163073&x-signature=5xjkFsr0%2Fp6zx2NNBbkr5%2BQmUa4%3D","duration":5450,"title":"恋综BE后，我成了男主的白月光","video_desc":"林青雅在三年前参加恋综的时候遇到阳光帅气的傅慎行，两人迅速进入热恋。但傅慎行却在此时看到她和一个大龄男性的亲密画面，因为这一场误会，傅慎行选择单方面分手。三年后，林青雅再次遇到已经创业成功的傅慎行，命运再次重启。","series_id":"7507462975393893401","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331125C4020FFE5377CA700AA\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7507462975393893401\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.04885777458548546,\\\"absolute_staytime\\\":0.09747834503650665,\\\"stream_ctr\\\":0.07606924325227737,\\\"staytime_stream\\\":0.8568789958953857,\\\"finish\\\":0.003273065434768796,\\\"collect\\\":0.028870906680822372,\\\"normalized_duration\\\":0.7416868805885315}\"}","recommend_group_id":"7507462975393893401","play_cnt":31018,"book_exist":false,"copyright":"兔叽叽剧场","sub_title":"爱情·都市爱情","score":"8.3","use_video_model":true,"episode_cnt":59,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gen