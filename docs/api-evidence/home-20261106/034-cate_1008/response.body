7466282768117287961","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331125C4020FFE5377CA700AA\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7466282768117287961\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.032233715057373,\\\"collect\\\":0.031143829226493835,\\\"normalized_duration\\\":0.7416868805885315,\\\"stream_ctr\\\":0.052900053560733795,\\\"like\\\":0.05184546485543251,\\\"absolute_staytime\\\":0.11045744270086288,\\\"finish\\\":0.002050743205472827}\"}","recommend_group_id":"7466282768117287961","play_cnt":573087,"book_exist":false,"copyright":"麦芽短剧","sub_title":"成长·逆袭翻身","score":"8.2","use_video_model":true,"episode_cnt":83,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=0&source=detail\"},{\"category_id\":5136,\"name\":\"宫斗宅斗\",\"schema\":\"dragon8662://categorySearch?categoryId=5136&categoryName=宫斗宅斗&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"},{\"category_id\":5351,\"name\":\"宫廷爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5351&categoryName=宫廷爱情&genreType=130&gender=0&source=detail\"}]","color_dominate":"#d8d0c8","horiz_cover":"","sub_title_list":[{"content":"成长","data_type":3},{"content":"3623万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"成长\",\"data_type\":3},{\"content\":\"3623万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7511629997912640574","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/0ce2b7f1f4cdd52ee7ffcf442a0b6302~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163073&x-signature=op6De%2FYwJKPELIDS93nhcueX6m8%3D","duration":6191,"title":"谁许你恨海情天","video_desc":"许情孕晚期时被确诊患上胃癌，同时丈夫沈牧川先天性心脏病恶化。为保孩子和家人，她走投无路只能和情敌白语柔交易，暴雨夜狠心提离婚。当晚沈牧川气急攻心病发，许情冒死捐心。沈牧川不知，两人分别，他凭借恨意跻身富豪榜。十年后，许情人工心脏濒临报废，凑钱手术时接下婚礼小丑工作，却发现新郎正是沈牧川，殊不知，这一切皆是精心筹划的“重逢”。","series_id":"7511547395637791769","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331125C4020FFE5377CA700AA\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7511547395637791769\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.028870906680822372,\\\"stream_ctr\\\":0.05070086941123009,\\\"like\\\":0.050330642610788345,\\\"finish\\\":0.004331502597779036,\\\"normalized_duration\\\":0.7682255506515503,\\\"staytime_stream\\\":1.0408591032028198,\\\"absolute_staytime\\\":0.10705902427434921}\"}","recommend_group_id":"7511547395637791769"