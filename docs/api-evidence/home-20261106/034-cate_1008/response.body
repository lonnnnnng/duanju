lse,"video_data":[{"vid":"7466021114020383769","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/e75d77ae1a2e341e489f017ac70586a7~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163073&x-signature=9nP8QBKdBLN6MyxRxarfUwLe3Mk%3D","duration":5735,"title":"冬庭雪","video_desc":"十年前盛沧澜救下一无所有的裴昭，两人以玉簪定情，爱的死心塌地，裴昭带兵出征前，立下得胜后便成婚的誓言。盛沧澜满心欢喜在家中等候，不想裴昭归来后却迎娶了宋娇娇，将她抛弃。面对宋娇娇的挑衅以及裴昭的漠视，盛沧澜心灰意冷，答应了慕容尘的求婚。结果在盛沧澜嫁给慕容尘的新婚当日，才得知裴昭断情真相，面对裴昭的解释，盛沧澜决定追随本心，而今早已物是人非，有些人错过了便是一生。","series_id":"7465648096794381336","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331125C4020FFE5377CA700AA\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7465648096794381336\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.005554924253374338,\\\"collect\\\":0.03732689097523689,\\\"normalized_duration\\\":0.7202730178833008,\\\"staytime_stream\\\":1.2772823572158813,\\\"like\\\":0.05500529333949089,\\\"absolute_staytime\\\":0.12131377309560776,\\\"stream_ctr\\\":0.05116596445441246}\"}","recommend_group_id":"7465648096794381336","play_cnt":205423,"book_exist":false,"copyright":"河马短剧","sub_title":"爱情·古风爱情","score":"8.1","use_video_model":true,"episode_cnt":45,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5182,\"name\":\"爱恨纠葛\",\"schema\":\"dragon8662://categorySearch?categoryId=5182&categoryName=爱恨纠葛&genreType=130&gender=0&source=detail\"},{\"category_id\":5188,\"name\":\"追妻\",\"schema\":\"dragon8662://categorySearch?categoryId=5188&categoryName=追妻&genreType=130&gender=0&source=detail\"},{\"category_id\"