bac67d78393a1ba79c3e229~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163125&x-signature=dVdL6TMXH0nYxQoaZSLhJ%2BixT54%3D","duration":5994,"title":"美飒厨娘天下无敌","video_desc":"林薇薇以传说中的神级厨艺，佛光普照，横扫十八国厨王，获封世界厨神，引来整个美食界所有餐厅协会的追捧。然而，在经历了无尽的掌声与赞誉，她却遭陷害，被大量商家唾骂，失去追求美食的初心。心灰意冷之下，林薇薇毅然退出厨师界。一年后，当林薇薇再度出现，却成了中华酒楼的三灶，而她却也领悟了神级厨艺的最终奥义，佛跳墙・万佛朝宗！","series_id":"7460785495274949694","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623320311EE76084E893A89F5B9\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7460785495274949694\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.001987774157896638,\\\"stream_ctr\\\":0.04909462854266167,\\\"like\\\":0.05665243789553642,\\\"normalized_duration\\\":0.7518967986106873,\\\"staytime_stream\\\":0.9759871959686279,\\\"absolute_staytime\\\":0.10874496400356293,\\\"collect\\\":0.03732689097523689}\"}","recommend_group_id":"7460785495274949694","play_cnt":10966,"book_exist":false,"copyright":"山海星辰","sub_title":"成长·女性成长","score":"8.0","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5165,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5165&categoryName=隐藏大佬&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&source=deta