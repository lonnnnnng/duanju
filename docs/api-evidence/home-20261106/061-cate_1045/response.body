,\"name\":\"神豪\",\"schema\":\"dragon8662://categorySearch?categoryId=5203&categoryName=神豪&genreType=130&gender=1&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=1&source=detail\"},{\"category_id\":5360,\"name\":\"都市脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5360&categoryName=都市脑洞&genreType=130&gender=1&source=detail\"}]","color_dominate":"#302820","horiz_cover":"","sub_title_list":[{"content":"都市","data_type":3},{"content":"2704万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"都市\",\"data_type\":3},{\"content\":\"2704万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7490397240419159065","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/522e0b4b394fd25788bbfda7fe94e459~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163125&x-signature=1u2hXA%2FsG9mknxG0tAzHlLCDPFQ%3D","duration":5062,"title":"少林球神","video_desc":"十年前，球神李长城因一场被二师兄高天宝设计陷害的球赛而名誉扫地，自此意志消沉，隐退在小镇球馆，不再碰足球。十年后，龙城足球沦为笑柄，霓虹向龙城发起挑衅，龙城渴望球神再现，为龙城洗刷屈辱，足球大联盟的会长东方雪苦寻球神李长城未果。与此同时，小镇球馆遭遇危机，李长城终于不再忍耐，使出成名绝技飞龙在天，拯救球馆。而后在东方雪的劝说下，李长城决定找回曾经的师兄弟们，重组少林球队。","series_id":"7489363389001518104","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623320311EE76084E893A89F5B9\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7489363389001518104\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.049589015543460846,\\\"collect\\\":0.03210071101784706,\\\"normalized_duration\\\":0.7104924917221069,\\\"finish\\\":0.003945406526327133,\\\"staytime_stream\\\":0.910964846611023,\\\"absolute_staytime\\\":0.09157242625951767,\\\"stream_ctr\\\":0.04582858085632324}\"}","recommend_group_id":"7489363389001518104","play_cnt":8804,"book_exist":false,"copyright":"天津读本","sub_title":"都市·都市日常","score":"8.2","use_video_model":true,"episode_cnt":62,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5078,\"name\":\"都市日常\",\"schema\":\"dragon8662://categorySearch?categoryId=5078&categoryName=都市日常&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5338,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=5338&categoryName=现代&genreType=130&gender=1&source=detail\"}]","color_dominate":"#483028","horiz_cover":"","sub_title_list":[{"content":"都市","data_type":3},{"content":"1381万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"都市\",\"data_type\":3},{\"content\":\"1381万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_it