{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7701328426518465561","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/dd47bf8f4357b931ef542a2f91478aed~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163022&x-signature=RSOfpE8T0R84wSlzjF2zH8kOt6M%3D","duration":12551,"title":"装穷提亲，娶到全家嫌弃的她","video_desc":"顾承川装穷提亲，本想退掉爷爷定下的婚约，却被林家塞来不受待见的长女林小满。她不嫌他穷，甚至愿卖掉母亲遗镯替他还债。他被真心打动，决意护她一生。婚礼当天，百万彩礼、千万豪宅接连送到，嫌贫爱富的林家彻底傻眼！","series_id":"7701328280862854168","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233021D5A83ACCC4E1D3A2F8C6\",\"rank\":\"1\",\"queue_names\":\"aigc,shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7701328280862854168\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.12727831304073334,\\\"collect\\\":0.04885777458548546,\\\"normalized_duration\\\":0.7803233861923218,\\\"like\\\":0.07585817575454712,\\\"finish\\\":0.001810210756957531,\\\"staytime_stream\\\":2.0430374145507812,\\\"absolute_staytime\\\":0.25482264161109924}\"}","recommend_group_id":"7701328280862854168","play_cnt":17375571,"book_exist":false,"copyright":"新美九天深圳数字科技有限公司","sub_title":"爱情·全80集","score":"8.1","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5463,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5463&categoryName=爱情&genreType=130&gender=1&source=detail\"},{\"category_id\":5491,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5491&categoryName=都市爱情&genreType=