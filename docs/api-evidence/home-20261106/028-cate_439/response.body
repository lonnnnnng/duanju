开相约白头，而景国开战，慕纯宁为两国和平牺牲自己。谁知竟扭转了命运的轨迹，使她重新回到了现代社会，萧楚澜殉情追随，两人于现代圆满重逢，再续前缘。","series_id":"7416663065942297625","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331007C1946CED8536BA67379\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7416663065942297625\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.0887550562620163,\\\"stream_ctr\\\":0.04629173502326012,\\\"staytime_stream\\\":1.0179383754730225,\\\"collect\\\":0.0384662002325058,\\\"normalized_duration\\\":0.7063416242599487,\\\"like\\\":0.048136770725250244,\\\"finish\\\":0.009125638753175735}\"}","recommend_group_id":"7416663065942297625","play_cnt":5098,"book_exist":false,"copyright":"苏州落蒂文化传媒有限公司","sub_title":"爱情·古风爱情","score":"8.3","use_video_model":true,"episode_cnt":50,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=0&source=detail\"},{\"category_id\":5095,\"name\":\"先婚后爱\",\"schema\":\"dragon8662://categorySearch?categoryId=5095&categoryName=先婚后爱&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&source=detail\"},{\"category_id\":5312,\"name\":\"架空\",\"schema\":\"dragon8662://categorySearch?categoryId=5312&categoryName=架空&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&