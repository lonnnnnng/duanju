642e&x-expires=1799163061&x-signature=CxcVek84lpY7mjFs%2FZ%2FGzchTnNI%3D","duration":10900,"title":"乡野厨娘巧兴家","video_desc":"现代女孩安竹穿越，成为被买来冲喜的肥妻安竹。新婚夜婆婆陆母见儿子陆寒濒死，竟打算活埋安竹换命，安竹奋起反抗。陆寒死而复生，坚持认下这门婚事。安竹左手掌藏空间胎记，靠厨艺搞事业，带领乡邻做卤味、开酒楼，化解村里各种矛盾。后被神医洛郎中查出身中无情奇藤剧毒，解毒过程痛苦万分，陆寒甘愿舍身陪伴。二人在朝夕相处中，逐步揭开前世羁绊，从名义夫妻走向彼此动心，一边谋生创业，一边面对过往身份带来的危机。","series_id":"7701560211311447065","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331007C1946CED8536BA67379\",\"rank\":\"6\",\"queue_names\":\"aigc\",\"final_queue_name\":\"aigc\",\"gid\":\"7701560211311447065\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.18498139083385468,\\\"stream_ctr\\\":0.038523685187101364,\\\"finish\\\":0.004468384198844433,\\\"normalized_duration\\\":0.7864435315132141,\\\"like\\\":0.06187598779797554,\\\"staytime_stream\\\":1.378759503364563,\\\"collect\\\":0.052618950605392456}\"}","recommend_group_id":"7701560211311447065","play_cnt":318565,"book_exist":false,"copyright":"杭州禾浩文化传媒有限公司","sub_title":"古装·全206集","score":"8.2","use_video_model":true,"episode_cnt":206,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5475,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5475&categoryName=古装&genreType=130&gender=0&source=detail\"},{\"category_id\":5493,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5493&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5503,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5503&categoryName=逆袭翻身&genreType=130&gender=0&source=detail\"},{\"category_id\":5691,\"name\":\"空间\",\"schema\":\"dragon8662://categorySearch?categoryId=5691&categoryName=空间&genreType=130&gender=0&source=detail\"},{\"category_id\":5751,\"name\":\"美食\",\"schema\":\"dragon8662://categorySearch?categoryId=5751&categoryName=美食&genreType=130&gender=0&source=detail\"},{\"category_id\":5663,\"name