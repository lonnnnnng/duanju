n_type":0,"use_recommend":false,"video_data":[{"vid":"7508689958824070206","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/2955bd5c30324e6a6eafa6347a17d59b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163061&x-signature=ZFCZU7euribyG9S4U7b4GqhIV6o%3D","duration":8188,"title":"独占姝色","video_desc":"沈纭曾是花楼妓子，赎身从良后，嫁与书生萧泊谦为妻，安稳度日。一日，萧泊谦因酒后妄议朝政被抓入狱，为救夫君免受牢狱之苦，走投无路的沈纭，只得向大理寺少卿自荐枕席。令她万万没想到的是，这位大理寺少卿，正是她为妓时所接的唯一一位恩客陆庭洲。陆庭洲身为京城第一世家嫡三子，初见沈纭时便将她视作自己的所有物，也正因如此，他一直恼怒沈纭当年用自己的玉佩擅自赎身、离他而去。","series_id":"7508633887036148798","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331007C1946CED8536BA67379\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7508633887036148798\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.7287633419036865,\\\"absolute_staytime\\\":0.10705902427434921,\\\"staytime_stream\\\":1.065853476524353,\\\"finish\\\":0.0018675664905458689,\\\"collect\\\":0.036220062524080276,\\\"like\\\":0.052618950605392456,\\\"stream_ctr\\\":0.08457928895950317}\"}","recommend_group_id":"7508633887036148798","play_cnt":38619,"book_exist":false,"copyright":"树下的椰子","sub_title":"爱情·古风爱情","score":"8.2","use_video_model":true,"episode_cnt":61,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#802018","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"1771万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"爱情\",\"data_type\":3},{\"content\":\"1771万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7491146849986825241","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/5e78b7c7b0700a22d66cf6aaff3a427d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163061&x-signature=HMLig%2Ffd1QdraNlenMpn%2F%2BtWrgg%3D","duration":8809,"title":"旧识桃花落马归","video_desc":"大苍女将军沈徽宁战场杀敌，夺得蛮族王旗，却不幸身中数箭力竭而亡。濒死之际，菩萨因她保家卫国功德圆满，却前尘未了，赐她灵体回摄政王府，待尸首入城便魂归。回府后，沈徽宁见皇叔宋怀砚与叶婉兮亲密相拥，心痛万分。曾经宋怀砚对她关怀备至，教她舞剑、为她祈福，还拒赐婚。如今却态度冷漠，因叶婉兮斥责她。","series_id":"7491137662305192985","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331007C1946CED8536BA67379\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7491137662305192985\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.11045744270086288,\\\"staytime_stream\\\":1.026676893234253,\\\"finish\\\":0.001455063233152032,\\\"collect\\\":0.03514484688639641,\\\"normalized_duration\\\":0.7563153505325317,\\\"like\\\":0.0541987344622612,\\\"stream_ctr\\\":0.06504696607589722}\"}","recommend_group_id":"7491137662305192985","play_cnt":153034,"book_exist":false,"copyright":"花生短剧","sub_title":"爱情·古风爱情","score":"8.3","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5312,\"name\":\"架空\",\"schema\":\"dragon8662://categorySearch?categoryId=5312&categoryName=架空&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#682000","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"3202万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"爱情\",\"data_type\":3},{\"content\":\"3202万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7482980011843013656","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/0ca2a5e00a5bef83afef42089e5411d7~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163061&x-signature=jSUrBoiiMe%2FuIs7C9erS2gBm6wQ%3D","duration":5483,"title":"刀如水","video_desc":"黎云起，他有几副面孔？到底是瓦舍头牌的男魁，还是潜伏东宫的密探，更是秘阁阁主越召手中，最锋利的刀，也是最趁手的棋子。他为复仇而来，却在越召的深情与算计中迷失。刀锋之间，爱失毫厘，落子无悔，贪了指尖余温。","series_id":"7482600854856403992","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331007C1946CED8536BA67379\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7482600854856403992\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.055998653173446655,\\\"finish\\\":0.0029810327105224133,\\\"collect\\\":0.030214590951800346,\\\"normalized_duration\\\":0.6779567003250122,\\\"staytime_stream\\\":0.6990575194358826,\\\"like\\\":0.035678550601005554,\\\"absolute_staytime\\\":0.059123601764440536}\"}","recommend_group_id":"7482600854856403992","play_cnt":12749,"book_exist":false,"copyright":"狐踪影坊","sub_title":"古装·朝堂权谋","score":"7.9","use_video_model":true,"episode_cnt":24,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=0&source=detail\"},{\"category_id\":5137,\"name\":\"朝堂权谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5137&categoryName=朝堂权谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5177,\"name\":\"扮猪吃虎\",\"schema\":\"dragon8662://categorySearch?categoryId=5177&categoryName=扮猪吃虎&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5152,\"name\":\"权力斗争\",\"schema\":\"dragon8662://categorySearch?categoryId=5152&categoryName=权力斗争&genreType=130&gender=0&source=detail\"},{\"category_id\":5300,\"name\":\"姐弟恋\",\"schema\":\"dragon8662://categorySearch?categoryId=5300&categoryName=姐弟恋&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#90a898","horiz_cover":"","sub_title_list":[{"content":"古装","data_type":3},{"content":"1404万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"古装\",\"data_type\":3},{\"content\":\"1404万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7702705336402070552","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/cd31902e447c61538f320bbc5dd28311~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163061&x-signature=6C1vteH3CM%2FLoCsb3eL06kp2Fqc%3D","duration":10473,"title":"桃落京华","video_desc":"现代女生陶桃穿越成京城人人耻笑的丞相府胖嫡女洛倾城，开局便遭继妹构陷、心上人当众羞辱。她一改往日痴傻恋爱脑模样，手撕绿茶继妹、智斗后宅刁难，还意外结识盛王、临王、诀王与温润国公世子。本想专心减肥搞钱做自在咸鱼，却引得数位优秀男子接连倾心，上演啼笑皆非的修罗场，走出一条笑点与爽点并存的逆袭之路。","series_id":"7702705333487012889","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062331007C1946CED8536BA67379\",\"rank\":\"5\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7702705333487012889\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.004198795184493065,\\\"collect\\\":0.052618950605392456,\\\"normalized_duration\\\":0.7667266130447388,\\\"like\\\":0.0541987344622612,\\\"absolute_staytime\\\":0.17513687908649445,\\\"staytime_stream\\\":1.454206109046936,\\\"stream_ctr\\\":0.03601580485701561}\"}","recommend_group_id":"7702705333487012889","play_cnt":890426,"book_exist":false,"copyright":"一往无前溪水8aDii2","sub_title":"爱情·全228集","score":"8.2","use_video_model":true,"episode_cnt":228,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5876,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5876&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=0&source=detail\"},{\"category_id\":5883,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5883&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":6031,\"name\":\"轻松搞笑\",\"schema\":\"dragon8662://categorySearch?categoryId=6031&categoryName=轻松搞笑&genreType=130&gender=0&source=detail\"},{\"category_id\":6171,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=6171&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":6205,\"name\":\"豪门千金\",\"schema\":\"dragon8662://categorySearch?categoryId=6205&categoryName=豪门千金&gen