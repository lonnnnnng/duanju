{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7409867718184160281","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/35cdb7f694eb1ff63314c7ae7fb767c4~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163121&x-signature=3s1Sm8qE8NsPDFP2RJuipYP1JYA%3D","duration":8594,"title":"天神归位","video_desc":"叶玄，曾以玄帝之名震慑全球的超级强者，为国运隐退多年。如今，随着真龙柱即将重现，他被召回稳定国运。重返江城。他暗中注资代号零项目，意外助苏清涵公司转亏为盈。苏清涵寻找失踪女儿的执着触动了叶玄，两人命运交织。面对各方势力的挑战，叶玄如何运筹帷幄，重新崛起？","series_id":"7409310417672997913","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233159A08ACE78076A5B9018D4\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7409310417672997913\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.042663127183914185,\\\"collect\\\":0.03461884334683418,\\\"like\\\":0.052618950605392456,\\\"finish\\\":0.0010322309099137783,\\\"normalized_duration\\\":0.7460454702377319,\\\"absolute_staytime\\\":0.11045744270086288,\\\"staytime_stream\\\":0.954890787601471}\"}","recommend_group_id":"7409310417672997913","play_cnt":28899,"book_exist":false,"copyright":"趣逗网络","sub_title":"都市·超凡逆袭","score":"8.2","use_video_model":true,"episode_cnt":82,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5043,\"name\":\"超凡逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5043&categoryName=超凡逆袭&genreType=1