799163109&x-signature=O8n%2BBrqJvfz%2BZtEmw6VIdJf4tcc%3D","duration":7758,"title":"我在仙界搞科研","video_desc":"作为现代人的陈长生意外穿越到了一个充满修仙者的古代世界。在这个世界中，他凭借现代科学知识和机智勇敢，从一个不学无术的二世子摇身一变成了代表凡人的一国栋梁。面对仙界的权谋斗争和修仙者的轻视，陈长生不仅没有屈服，反而利用自己的科学知识与现代发明，颠覆了仙界对凡人的认知。在陈长生的影响下凡人们开始逐渐接受和利用现代科技，为自己战斗。面对仙界宗门的威胁，陈长生始终坚持自己的信念，保护无辜，维护正义。","series_id":"7385018619324812312","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233148A4F01B9862FBEE8CFE57\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7385018619324812312\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.019972801208496,\\\"finish\\\":0.0015011823270469904,\\\"stream_ctr\\\":0.06786655634641647,\\\"like\\\":0.048136770725250244,\\\"absolute_staytime\\\":0.1175813376903534,\\\"normalized_duration\\\":0.716064989566803,\\\"collect\\\":0.035678550601005554}\"}","recommend_group_id":"7385018619324812312","play_cnt":786818,"book_exist":false,"copyright":"博易创为","sub_title":"逆袭·玄幻仙侠","score":"8.1","use_video_model":true,"episode_cnt":79,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=1&source=detail\"},{\"category_id\":5072,\"name\":\"玄幻仙侠\",\"schema\":\"dragon8662://categorySearch?categoryId=5072&categoryName=玄幻仙侠&genreType=130&gender=1&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5310,\"name\":\"异界\",\"schema\":\"dragon8662://categorySearch?categoryId=5310&categoryName=异界&genreType=130&gender=1&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"d