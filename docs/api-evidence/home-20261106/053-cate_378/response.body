0,"title":"我回三国当贤臣","video_desc":"现代宅男楚鸿穿越到幽燕，恰逢女帝慕容清雪遇危机，相国司马炎逼她和亲。楚鸿为保护与初恋长相一样的女帝，应下筹粮任务。他凭借现代知识和物品化解难题，还在朝堂上与反派周旋，助力女帝守护幽燕。","series_id":"7475567783720258584","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233148A4F01B9862FBEE8CFE57\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7475567783720258584\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":0.8528635501861572,\\\"finish\\\":0.01798621006309986,\\\"stream_ctr\\\":0.0592489056289196,\\\"collect\\\":0.0378924235701561,\\\"normalized_duration\\\":0.6622518301010132,\\\"like\\\":0.04885777458548546,\\\"absolute_staytime\\\":0.10874496400356293}\"}","recommend_group_id":"7475567783720258584","play_cnt":3849,"book_exist":false,"copyright":"时刻剧场","sub_title":"古装·逆袭翻身","score":"8.1","use_video_model":true,"episode_cnt":30,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5137,\"name\":\"朝堂权谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5137&categoryName=朝堂权谋&genreType=130&gender=1&source=detail\"},{\"category_id\":5074,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5074&categoryName=奇幻脑洞&genreType=130&gender=1&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=1&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=1&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categor