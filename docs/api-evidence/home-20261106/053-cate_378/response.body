ource_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7525341063553240089","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/c419b91337f3e59daf380dcfdfc4ee6d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163109&x-signature=0kzkusGxj4zEic6tVKVYFlzHDsA%3D","duration":7608,"title":"扶腰","video_desc":"幼时亲眼目睹母亲被宫内太监暗害，沈明棠忍辱负重，藏于浣衣局。以粗布掩世家血仇。太子萧景珩常年被毒害，她以血为引相救，得东宫太子庇护，二人情愫渐生，互为羽翼，他立排众议帮她翻家族旧冤、揭宫廷阴谋。她终登青昭女帝，推新政开盛世。","series_id":"7525299854168296510","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233148A4F01B9862FBEE8CFE57\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7525299854168296510\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.036220062524080276,\\\"absolute_staytime\\\":0.05820697918534279,\\\"collect\\\":0.026355355978012085,\\\"normalized_duration\\\":0.714667797088623,\\\"finish\\\":0.0010322309099137783,\\\"stream_ctr\\\":0.08272293955087662,\\\"staytime_stream\\\":0.629839301109314}\"}","recommend_group_id":"7525299854168296510","play_cnt":42474,"book_exist":false,"copyright":"丝黛络科技","sub_title":"古装·女性成长","score":"8.2","use_video_model":true,"episode_cnt":70,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#381010","horiz_cover":"","sub_title_list":[{"content":"古装","data_type":3},{"content":"1596万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"古装\",\"data_type\":3},{\"content\":\"1596万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7552859697955474457","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/a65cd6da17d6d342f420c4693ced8d73~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163109&x-signature=p%2Fft9yAQyBldefTWBW9ew2N4%2BXg%3D","duration":5987,"title":"重生后，女帝用江山换我一句原谅","video_desc":"前世，吴骁帮助赵灵素平定天下成为女帝，最终却被赵灵素软禁，最终被叶天赐设计杀死。死后的吴骁竟然重生回到了多年前赵灵素登基前五天。吴骁意外得知赵灵素将要把叶天赐也纳入宫中的消息。但随后赵灵素的一系列行为让吴骁心寒。最终在叶天赐设计下，吴骁的兵当众哗变。虽然吴骁出面解决，但是赵灵素却不信任吴骁，吴骁彻底对赵灵素心寒，卸任了官职，拆掉仓库，最终毁掉了时空门。","series_id":"75528