tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163126&x-signature=pSjsVAaYI7XZg%2FPSbygYJnP2Kn8%3D","duration":4667,"title":"剑断万古","video_desc":"天榜第一剑圣陆寻，化名陆山河，隐匿于青龙武馆做杂役。武馆因持有他的《无妄剑经》，被藏剑山庄觊觎，双方结下死仇。《无妄剑经》难度极高，武馆众人苦修数月，连首式都未能学会。不久后，藏剑山庄少庄主慕容羽亲自率领高手上门寻仇，青龙武馆实力不敌，节节败退。危急时刻，一直低调的陆寻终于不再隐藏，出手应对。","series_id":"7566920671024925758","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233205711C9EB692B7CDA329C4\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7566920671024925758\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.006488270126283169,\\\"like\\\":0.0534033365547657,\\\"staytime_stream\\\":1.1103407144546509,\\\"absolute_staytime\\\":0.13323712348937988,\\\"collect\\\":0.04146227985620499,\\\"normalized_duration\\\":0.750429630279541,\\\"stream_ctr\\\":0.046819861978292465}\"}","recommend_group_id":"7566920671024925758","play_cnt":59720,"book_exist":false,"copyright":"山海星辰","sub_title":"玄幻·玄幻仙侠","score":"8.3","use_video_model":true,"episode_cnt":57,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5008,\"name\":\"玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5008&categoryName=玄幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5072,\"name\":\"玄幻仙侠\",\"schema\":\"dragon8662://categorySearch?categoryId=5072&categoryName=玄幻仙侠&genreType=130&gender=1&source=detail\"},{\"category_id\":5165,\"name\":\"隐藏大佬\",\"schema\":\"dragon8662://categorySearch?categoryId=5165&categoryName=隐藏大佬&genreType=130&gender=1&source=detail\"},{\"category_id\":5157,\"name\":\"天下无敌\",\"schema\":\"dragon8662://categorySearch?categoryId=5157&categoryName=天下无敌&genreType=130&gender=1&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=1&source=detail\"},{\"category_id\":5312,\"name\":\"架