"video_data":[{"vid":"7631590028254137368","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/747553d8ef2185dcc78697f600321e1d~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163126&x-signature=18y%2FZSk9pgFK7WeGwIpJc70K0ko%3D","duration":10404,"title":"我女仙尊，回来宠孙了","video_desc":"仙界仙尊林羽曦，本是地球人，在60年前意外落江穿越修仙界，历时六万年成就仙尊！她剑开天门后，回到地球，才发现仅过去六十年，而唯一的弟弟林建国不仅还活着，且为林家开枝散叶！林羽曦与弟弟林建国相认，也认下一众子孙后代，却发现自己家族后人都是受尽欺负的废柴。羽曦仙尊表示：“没关系，有我在，无人能欺负我儿孙后辈！你们随意，姑奶奶无敌！” 于是，年轻的姑奶奶，带领着孱弱的林家，一步步成为巅峰世家。","series_id":"7631587986286595097","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233205711C9EB692B7CDA329C4\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7631587986286595097\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.03490632027387619,\\\"staytime_stream\\\":1.1304099559783936,\\\"absolute_staytime\\\":0.1353352814912796,\\\"finish\\\":0.0009399441769346595,\\\"collect\\\":0.0378924235701561,\\\"normalized_duration\\\":0.7387953400611877,\\\"like\\\":0.05921025201678276}\"}","recommend_group_id":"7631587986286595097","play_cnt":425355,"book_exist":false,"copyright":"硕才短剧","sub_title":"都市·都市玄幻","score":"8.1","use_video_model":true,"episode_cnt":79,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=0&source=detail\"},{\"category_id\":5073,\"name\":\"都市玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5073&categoryName=都市玄幻&genreType=130&gender=0&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"}