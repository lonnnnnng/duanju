wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7665269401960057880","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/d8211fc5c9c12bd9dcd6d31db4c25681~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163126&x-signature=Ldft5dEbfEEUsAp02AB185pzgqs%3D","duration":9978,"title":"捡的乞丐老公是条龙","video_desc":"乞丐叶枭本是龙族太子，渡劫化龙时，救下被下药的财神之女江初雪。她醒来向叶枭求婚，叶枭答应，遇丐帮太子挑衅。叶枭一怒，天地色变，翻手掌生死，当即镇杀。回江家途中遭女狙击手刺杀，他一指灭杀，展露锋芒。初入江家，江家人震怒，以叶枭身为乞丐为耻，威胁江初雪二选一，离开叶枭，或滚出江家，江初雪力挺叶枭，叶枭觉得这女人值，亲手为她戴上王冠！","series_id":"7665267571939101720","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233205711C9EB692B7CDA329C4\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7665267571939101720\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.13963128626346588,\\\"stream_ctr\\\":0.0390213206410408,\\\"like\\\":0.060086652636528015,\\\"finish\\\":0.0012065895134583116,\\\"collect\\\":0.0446808747947216,\\\"normalized_duration\\\":0.7607598900794983,\\\"staytime_stream\\\":1.2358946800231934}\"}","recommend_group_id":"7665267571939101720","play_cnt":723524,"book_exist":false,"copyright":"湖南六翼影视","sub_title":"都市·都市玄幻","score":"8.0","use_video_model":true,"episode_cnt":88,"video_platform":3,"disable