fqnovelpic.com/novel-pic/e69129269519084db60a487f3ae1bb11~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163059&x-signature=9%2BaEB2XweWNe97nJ%2B48QDJ7Ui0k%3D","duration":8160,"title":"靳夺南枝","video_desc":"江家现任掌权人江靳年是出了名的克己复礼，性情冷淡。哪怕江、沈两家早就定有婚约，也没人将他与沈南枝联系在一起。那些年中，沈南枝也这么认为。江靳年常年在国外，性子冷，一年到头不见回来，两人几乎没有见面的机会，哪怕见了面，沈南枝也向来对他避而远之。她从没有想过，两家的婚约会阴差阳错落在她和江靳年身上。更没有想过，江靳年在领证后把她宠上天。","series_id":"7561753867541548094","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623305883E61A3852E011A0996A\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7561753867541548094\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.10376515984535217,\\\"stream_ctr\\\":0.06414759904146194,\\\"like\\\":0.04603390023112297,\\\"collect\\\":0.031143829226493835,\\\"finish\\\":0.0015487609198316932,\\\"normalized_duration\\\":0.714667797088623,\\\"staytime_stream\\\":1.0051748752593994}\"}","recommend_group_id":"7561753867541548094","play_cnt":347648,"book_exist":false,"copyright":"海鱼星空","sub_title":"爱情·都市爱情","score":"8.1","use_video_model":true,"episode_cnt":79,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5096,\"name\":\"商业联姻\",\"schema\":\"dragon8662://categorySearch?categoryId=5096&categoryName=商业联姻&genreType=130&gender=0&source=detail\"},{\"category_id\":5206,\"name\":\"总裁\",\"schema\":\"dragon8662://categorySearch?categoryId=5206&categoryName=总裁&genreType=130&gender=0&source=detail\"},{\"category_id\":5327,\"name\":\"高冷\",\"schema\":\"dragon8662://categorySearch?categoryId=5327&categoryNam