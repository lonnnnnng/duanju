_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7402179129539300414","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/d632f38aeb1ba1ed4bea853289c0b390~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163075&x-signature=adt1fKWePJVAGUpivBd7ke8KfHY%3D","duration":7753,"title":"神笔马良之罗刹国","video_desc":"马骥与马良兄弟二人，凭借过人技艺号称 “音画双绝”—— 哥哥马骥精通音律，一曲可动人心弦；弟弟马良画技高超，笔下之物栩栩如生。马骥此前误打误撞，被罗刹国公主强行掳走立为驸马，身陷囹圄。几年后他设法传讯马良，盼弟弟前来救自己脱离苦海。要知罗刹国是个黑白颠倒、颠倒是非的诡异之地，马良抵达后，一场跌宕起伏、精彩纷呈的故事即将拉开帷幕。","series_id":"7402174302209985560","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623311480FFD1D70B1EA79D2EF1\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7402174302209985560\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.03514484688639641,\\\"stream_ctr\\\":0.06268461048603058,\\\"like\\\":0.04146227985620499,\\\"staytime_stream\\\":0.8081982135772705,\\\"finish\\\":0.0005703158094547689,\\\"absolute_staytime\\\":0.059123601764440536,\\\"normalized_duration\\\":0.6846097707748413}\"}","recommend_group_id":"7402174302209985560","play_cnt":30035,"book_exist":false,"copyright":"合恕短剧","sub_title":"玄幻·玄幻仙侠","score":"8.0","use_video_model":true,"episode_cnt":86,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5008,\"name\":\"玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5008&categoryName=玄幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5072,\"name\":\"玄幻仙侠\",\"schema\"