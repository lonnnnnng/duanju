alse,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7704315836277738558","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/e54498f6931b0a06efa185367dcb6721~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163075&x-signature=%2BXNjQXZMk11Hgwl5Kx3rzgUAzDQ%3D","duration":20824,"title":"穿越修仙，末世归途","video_desc":"末世倒计时降临，孤女林灿意外激活母亲遗留的玉镯空间，囤满百亿物资，却被强制传送至修仙界。外界百年，故乡仅过三月！五灵根被视作废柴，她却手握逆天空间，种灵草、炼极品丹药，驭藤斩妖兽，偶遇秘境夺得灵脉，结识一众知己，智斗宗门暗流，一边疯狂提升实力，一边积攒底牌。在弱肉强食的修仙世界步步杀伐成长，她要冲破界域桎梏，赶在末日浩劫来临前，回去守护自己珍视的亲友！","series_id":"7704313969506257982","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623311480FFD1D70B1EA79D2EF1\",\"rank\":\"6\",\"queue_names\":\"aigc\",\"final_queue_name\":\"aigc\",\"gid\":\"7704313969506257982\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.16197511553764343,\\\"collect\\\":0.05665243789553642,\\\"stream_ctr\\\":0.038227226585149765,\\\"finish\\\":0.0037072536069899797,\\\"normalized_duration\\\":0.7622472047805786,\\\"like\\\":0.05749328434467316,\\\"staytime_stream\\\":1.2205030918121338}\"}","recommend_group_id":"7704313969506257982","play_cnt":484506,"book_exist":false,"copyright":"杭州恩漓","sub_title":"玄幻·全253集","score":"8.4","use_video_model":true,"episode_cnt":253,"video_platform":3,"disable_play"