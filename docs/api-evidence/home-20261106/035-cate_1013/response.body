ovelpic.com/novel-pic/6bda4dbc9e5e7e994591640090acd286~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163075&x-signature=3s4rR0EOND%2BXIm9P2KNEzRuTntY%3D","duration":22048,"title":"败家小师妹，带飞全宗门","video_desc":"君小七穿成修仙界人人喊打的舔狗女配，开局就是众宗围杀的修罗场。绑定超级败家系统后，她当场碾碎神还丹，高调拜入负债累累的仙云宗，带飞五位妖孽师兄——逆天神丹当糖豆吃，万年仙草泡脚用，保命符篆当厕纸。别人修仙靠天赋，她靠钞能力与离谱操作，一路打脸各路天骄，从万人嫌逆袭成团宠，又颠又强，笑傲仙途！","series_id":"7704678870246493209","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623311480FFD1D70B1EA79D2EF1\",\"rank\":\"5\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7704678870246493209\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.003273065434768796,\\\"absolute_staytime\\\":0.1474800407886505,\\\"collect\\\":0.0534033365547657,\\\"normalized_duration\\\":0.7622472047805786,\\\"stream_ctr\\\":0.08251453191041946,\\\"like\\\":0.048136770725250244,\\\"staytime_stream\\\":1.2337802648544312}\"}","recommend_group_id":"7704678870246493209","play_cnt":13690,"book_exist":false,"copyright":"屁股大王","sub_title":"3D·全365集","score":"8.5","use_video_model":true,"episode_cnt":365,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=0&source=detail\"},{\"category_id\":5967,\"name\":\"玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5967&categoryName=玄幻&genreType=130&gender=0&source=detail\"},{\"category_id\":5902,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5902&categoryName=逆袭翻身&genreType=130&gender=0&source=detail\"},{\"category_id\":5968,\"name\":\"玄幻仙侠\",\"schema\":\"dragon8662://categorySearch?categoryId=5968&categoryName=玄幻仙侠&genreType=130&gender=0&source=detail\"},{\"category_id\":6087,\"name\":\"穿书\",\"schema\":\"dragon8662://categorySearch?categoryId=6087&categoryName=穿书&genreType=130&g