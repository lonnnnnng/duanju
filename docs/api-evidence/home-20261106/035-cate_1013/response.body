{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7496082918968675353","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/55deb1e9f6b020d7e712ab369e240908~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163075&x-signature=dBiUDTYsJl5AJQitGI21qrotvBM%3D","duration":4028,"title":"筑基3000次我一步登仙","video_desc":"许幽幽身负三千超品金丹化作星辰的亘古天赋，却因迟迟未能踏入金丹期，备受打击。仙帝道麟以天禁镯封其通星之力，唯恐许幽幽为此界带来浩劫。许幽幽遭家族折辱，为护母亲周全，改变命运，她携筑基残力赴承天宗试炼，却因封印，沦为试练末尾。","series_id":"7495633728945802302","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623311480FFD1D70B1EA79D2EF1\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7495633728945802302\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.11045744270086288,\\\"stream_ctr\\\":0.04460751265287399,\\\"staytime_stream\\\":1.066632866859436,\\\"finish\\\":0.01322282012552023,\\\"collect\\\":0.034100428223609924,\\\"normalized_duration\\\":0.7301880717277527,\\\"like\\\":0.0427221953868866}\"}","recommend_group_id":"7495633728945802302","play_cnt":32434,"book_exist":false,"copyright":"上海探云云计算有限公司","sub_title":"玄幻·玄幻仙侠","score":"7.4","use_video_model":true,"episode_cnt":55,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5008,\"name\":\"玄幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5008&categoryName=玄幻&genreType=130&gender=0&source=detail\"},{\"category_id\":5072,\"name\":\"玄幻仙侠\",\"schema\":\"dragon8662://categorySearch?categoryId=5072&categoryName=玄幻仙侠&genreType=130&g