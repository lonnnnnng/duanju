type":0,"use_recommend":false,"video_data":[{"vid":"7515271982225574974","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/1d2dc80b7cf6d63bf097c9a71b5ed622~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163098&x-signature=EPev5UDBjB%2Fwos4KP7R3z28MuWE%3D","duration":3592,"title":"商战玫瑰","video_desc":"叶真身为叶氏独女，放弃继承权创立星辰科技，与方平成婚育子。不料方平成功后与白夕婚外情，还转移财产造假。分娩时发现真相的叶真回归叶家任CEO。方平签约羞辱叶真，反被审计录音揭露，合作方退场。方平向叶氏总裁求情，惊见是叶真。叶真与方平对赌，暗插“草包”搅局，联合白夕诱其入陷阱，截获资金。白夕跑路失败，方平血本无归入狱。五年后，叶真将方氏（更名真心集团）做成跨国企业。","series_id":"7515237020646509593","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233137785E0178D0B8948CA017\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7515237020646509593\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.08602434396743774,\\\"normalized_duration\\\":0.692679762840271,\\\"finish\\\":0.012053780257701874,\\\"stream_ctr\\\":0.04304075986146927,\\\"staytime_stream\\\":0.801965594291687,\\\"collect\\\":0.03210071101784706,\\\"like\\\":0.04401865601539612}\"}","recommend_group_id":"7515237020646509593","play_cnt":1140,"book_exist":false,"copyright":"百川","sub_title":"成长·女性成长","score":"8.3","use_video_model":true,"episode_cnt":30,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5254&categoryName=揭露阴谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&genreType=130&gender=0&source=deta