m_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7507524877314706494","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/de99b960b39bf0df89db1199cf28b5fc~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163052&x-signature=rkjv54cYyRevEjv0B2j0YvItXpE%3D","duration":4406,"title":"午夜公交车","video_desc":"一年前那场惨烈的车祸后，十四路公交车仿佛被阴霾笼罩，在接连三位司机神秘失踪后，司机间关于14路公交车“闹鬼”的流言甚嚣尘上。急需筹钱给母亲做肝移植的张寒，咬咬牙预支了三个月工资，接过了14路的公交车钥匙。首班出车那晚，他注意到百般引诱自己下车的两姐妹，后遇到黑狗拦路，经过一系列怪事后他觉察出，有人正借着“闹鬼”的幌子掩盖犯罪的事实，而张寒的真实身份也浮出水面。","series_id":"7507513081958779929","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233050CB3D69694583ACA6E709\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7507513081958779929\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.05108273774385452,\\\"normalized_duration\\\":0.7387953400611877,\\\"finish\\\":0.01590639166533947,\\\"like\\\":0.06278920918703079,\\\"absolute_staytime\\\":0.13746649026870728,\\\"stream_ctr\\\":0.050867825746536255,\\\"staytime_stream\\\":1.0663914680480957}\"}","recommend_group_id":"7507513081958779929","play_cnt":112695,"book_exist":false,"copyright":"剧点短剧","sub_title":"悬疑·悬疑推理","score":"8.2","use_video_model":true,"episode_cnt":32,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5004,\"name\":\"悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5004&categoryName=悬疑&genreType=130&gender=2&source=detail\"},{\"category_id\":5055,\"name\":\"悬疑推理\",\"schema\":\"dragon8662://categorySearch?categoryId=5055&categoryName=悬疑推理&genreType=130&gender=2&source=detail\"},{\"category_id\":5163,\"name\":\"马甲文\",\"schema\":\"dragon8662://categorySearch?categoryId=5163&categoryName=马甲文&genreTyp