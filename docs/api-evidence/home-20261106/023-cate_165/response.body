{"log_id":"20261106233050CB3D69694583ACA6E709","code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7703868765628271640","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/1567262f0a86f38fcc09ffb6470f3287~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163052&x-signature=L%2BxV4Fmjk9GOGe0YRqZtbrWZVXo%3D","duration":4849,"title":"视频里的女儿","video_desc":"十六岁的女儿参加夏令营后，每晚发来视频。第七晚，她突然叫了声“妈妈”，但岑静并未欣喜，反而报警。母女曾约定，只有在危险时才这样称呼。警方到场后，发现女儿一切正常。然而，岑静发现连续七晚视频并非女儿所发。刑警沈砚进一步查实，视频中的女孩动作和窗外背景均为重复素材。最终揭露了一个利用夏令营筛选儿童、收集家庭隐私并用合成视频拖延报警的犯罪团伙。","series_id":"7703867121293347902","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233050CB3D69694583ACA6E709\",\"rank\":\"1\",\"queue_names\":\"aigc\",\"final_queue_name\":\"heji\",\"gid\":\"7703867121293347902\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.1684274673461914,\\\"stream_ctr\\\":0.04479363188147545,\\\"staytime_stream\\\":1.503959059715271,\\\"collect\\\":0.047425877302885056,\\\"like\\\":0.06278920918703079,\\\"normalized_duration\\\":0.7563153505325317,\\\"finish\\\":0.010013570077717304}\"}","recommend_group_id":"7703867121293347902","play_cnt":83260,"book_exist":false,"copyright":"北京点点阅信息技术有限公司","sub_title":"悬疑·全80集","score":"8.2","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5471,\"name\":\"悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5471&categoryName=悬疑&genreType=130&gender=0&source=detail\"},{\"category_id\":5516,\"name\":\