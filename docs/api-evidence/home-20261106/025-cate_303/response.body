r_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7700159333765499966","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/0ed57ade53591665e228927a4999f0d7~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163056&x-signature=B9OPNQbd2dJtNv3YkELmp6134xg%3D","duration":7497,"title":"悍妻种田：赘婿王爷被亲到失控","video_desc":"现代女主意外穿书成了又胖又丑的恶毒女配唐抹布，解锁的奇葩系统要求每日亲吻落魄王爷才能瘦身变美。原主夫君战死，还要拉扯一双性格迥异的儿女。绑定系统的她，任务是救赎被贬为奴隶的残疾前朝凉王李湛，赚够一亿两白银。女主干脆花钱买下落魄王爷当赘婿，一边靠植物异能开荒种田搞事业，一边“艰难”完成系统任务。两人吵吵闹闹互相磨合，携手养家过日子，可就在感情修成正果之际，本该战死的原配丈夫竟突然生还归来了。","series_id":"7700156299475962905","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233054D64C5677D7D31B89D418\",\"rank\":\"7\",\"queue_names\":\"comics,shortplay\",\"final_queue_name\":\"comic\",\"gid\":\"7700156299475962905\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.004331502597779036,\\\"absolute_staytime\\\":0.18069632351398468,\\\"stream_ctr\\\":0.033182453364133835,\\\"like\\\":0.05749328434467316,\\\"collect\\\":0.05184546485543251,\\\"staytime_stream\\\":1.3448573350906372,\\\"normalized_duration\\\":0.7682255506515503}\"}","recommend_group_id":"7700156299475962905","play_cnt":6022178,"book_exist":false,"copyright":"溪文文化","sub_title":"爱情·全87集","score":"8.1","use_video_model":true,"episode_cnt":87,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5876,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5876&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreTyp