:null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7501252083056659518","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/70c6abbb5838773d93d062e789fd5efc~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163056&x-signature=Pf%2Bn9ESJKSyKdyERSboAP8%2FbQY8%3D","duration":8932,"title":"贵妃娘娘有点萌","video_desc":"帅哥张一明遭诅咒缠身，一朝穿越，竟成了大焱朝皇贵妃张一萌。他惊觉自己竟与四名男子共处一室，更让他措手不及的是腹中已然有了一个尚未出世的小生命。雪上加霜的是皇帝三日后便要归朝，还点名要召她侍寝。眼看欺君之事即将败露，张一萌正心慌意乱之际，猛地抬头，却撞见了一张熟悉的面孔 ——老天爷！这九五之尊的皇帝，赫然是他在现代的挚友！","series_id":"7501202858079947800","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233054D64C5677D7D31B89D418\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7501202858079947800\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0011695103021338582,\\\"normalized_duration\\\":0.6806101202964783,\\\"stream_ctr\\\":0.06873220950365067,\\\"like\\\":0.05108273774385452,\\\"collect\\\":0.03514484688639641,\\\"staytime_stream\\\":0.9507120251655579,\\\"absolute_staytime\\\":0.10215643793344498}\"}","recommend_group_id":"7501202858079947800","play_cnt":72032,"book_exist":false,"copyright":"花生短剧","sub_title":"古装·轻喜剧","score":"8.0","use_video_model":t