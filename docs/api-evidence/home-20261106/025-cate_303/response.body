p_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7702763537420012568","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/bd28846b550c06533bf7abb40122e603~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163056&x-signature=GHldH8MwUYRdoRYEmPExcsE6jQk%3D","duration":7243,"title":"末世度假酒店","video_desc":"末日第三年，夏言在丧尸横行的城市开了一家“无人度假酒店”。这里能吃饭、住宿、喝水，却整整两年没有一个客人。直到冯贝被尸群追杀，跌跌撞撞闯入，用一枚一级晶核换来末日里第一口热饭。随后队友赶来，大门敞开，丧尸却在店门外一米处游荡。无人酒店终于有了客人，而老板的异能与末世的秘密才刚刚揭晓。","series_id":"7702761598066117694","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233054D64C5677D7D31B89D418\",\"rank\":\"6\",\"queue_names\":\"comics,shortplay\",\"final_queue_name\":\"comic\",\"gid\":\"7702761598066117694\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.05582313612103462,\\\"normalized_duration\\\":0.7988281846046448,\\\"like\\\":0.05582313612103462,\\\"staytime_stream\\\":1.4139264822006226,\\\"absolute_staytime\\\":0.1684274673461914,\\\"stream_ctr\\\":0.03591082990169525,\\\"finish\\\":0.004331502597779036}\"}","recommend_group_id":"7702761598066117694","play_cnt":10323044,"book_exist":false,"copyright":"泉州韵皓宇阅科技有限公司","sub_title":"灾难·全143集","score":"8.2","use_video_model":true,"episode_cnt":143,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5998,\"name\":\"灾难\",\"schema\":\"dragon8662://categorySearch?categoryId=5998&categoryName=灾难&genreType=130&gender=0&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=0&source=detail\"},{\"category_id\":5999,\"name\":\"末世灾难\",\"schema\":\"dragon8662:/