{"data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7495680910663109657","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/93397bdcf504b5e2ff4eaefa944e5da8~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163030&x-signature=lM7NEYpb095yHq1QcZT2y6SoOEE%3D","duration":6270,"title":"曲终离人泪","video_desc":"京都孟家千金孟南汐为了照顾因车祸而聋哑的男友薛鹤白，与父亲吵架离家出走，伪装成先天聋哑陪在薛鹤白身边三年，期间不断打工为薛鹤白挣钱治病。薛鹤白病好后对过往的聋哑生活感到厌弃，觉得有一个“聋哑”女友很丢脸，转头与不怀好意的汪舒雅暧昧不清，对孟南汐百般冷落、伤害。孟南汐终于死心，决定与薛鹤白分手，听从家里安排出国，与叶明川在一起，回归真正的幸福千金生活。","series_id":"7495671917114838041","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062330281B30F4DE21440A8EF7F2\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7495671917114838041\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.05604070797562599,\\\"staytime_stream\\\":1.0387073755264282,\\\"normalized_duration\\\":0.7416868805885315,\\\"like\\\":0.04885777458548546,\\\"finish\\\":0.0029810327105224133,\\\"absolute_staytime\\\":0.09301449358463287,\\\"collect\\\":0.029760098084807396}\"}","recommend_group_id":"7495671917114838041","play_cnt":40005,"book_exist":false,"copyright":"时来欢聚","sub_title":"成长·女性成长","score":"8.2","use_video_model":true,"episode_cnt":70,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&category