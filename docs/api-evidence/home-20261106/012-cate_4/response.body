expires=1799163030&x-signature=yeP1OuCmRUavzjwZfTcM6YACImk%3D","duration":2842,"title":"穿成数学52分学渣，清北学神笑出声","video_desc":"北大数学天才江念意外离世，魂魄游荡一年后，附身于高三学生林晚予。她接管身体后，在课堂上展现出惊人天赋，一路斩获省赛冠军，更被张远山教授认出——那熟悉的解题笔迹，仿佛故人归来。国赛金牌、保送北大、高考夺魁，她以新身份替两个人走完未尽之路。最终，她向顾夜城道出那个无法言说的秘密——而一切，才刚刚开始。","series_id":"7666484946973756440","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062330281B30F4DE21440A8EF7F2\",\"rank\":\"5\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7666484946973756440\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.05108273774385452,\\\"normalized_duration\\\":0.7910650968551636,\\\"like\\\":0.06097517907619476,\\\"finish\\\":0.07921033352613449,\\\"stream_ctr\\\":0.031721409410238266,\\\"staytime_stream\\\":1.4241939783096313,\\\"absolute_staytime\\\":0.17513687908649445}\"}","recommend_group_id":"7666484946973756440","play_cnt":1014166,"book_exist":false,"copyright":"快创短剧","sub_title":"青春·全40集","score":"8.3","use_video_model":true,"episode_cnt":40,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5987,\"name\":\"青春\",\"schema\":\"dragon8662://categorySearch?categoryId=5987&categoryName=青春&genreType=130&gender=0&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=0&source=detail\"},{\"category_id\":5902,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5902&categoryName=逆袭翻身&genreType=130&gender=0&source=detail\"},{\"category_id\":6220,\"name\":\"学神\",\"schema\":\"dragon8662://categorySearch?categoryId=6220&categoryName=学神&genreType=130&gender=0&source=detail\"},{\"category_id\":6274,\"name\":\"现代\",\"schema\":\"dragon8662://categorySearch?categoryId=6274&categoryName=现代&genreType=130&gender=0&source=detail\"},{\"category_id\":6283,\"name\":\"校园\",\"schema\":\"dragon8662://categorySearch?category