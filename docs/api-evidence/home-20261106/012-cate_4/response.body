_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7508690544277589054","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/46bcb879b9b0bfff667d841a8a623854~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163030&x-signature=dcXGh9tlHMJw6l0PgB5n5MFxoqA%3D","duration":5560,"title":"寸草春晖","video_desc":"周东因为成绩一般导致中考落榜，父母为了让他有更好的未来，砸锅卖铁将其送进一所私立贵族高中，周东却在见识到富二代们的奢靡生活后，渐渐叛离本心，走上虚荣，以各种名义从父母手中骗取钱财以购买新款鞋子，手机等与同学攀比，后逐渐不满足，借下高利贷，偷取母亲的救命钱，彻底走上了不归路。","series_id":"7508624486481005630","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062330281B30F4DE21440A8EF7F2\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7508624486481005630\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.04365987330675125,\\\"staytime_stream\\\":0.8532987833023071,\\\"absolute_staytime\\\":0.0833776593208313,\\\"collect\\\":0.03210071101784706,\\\"normalized_duration\\\":0.7607598900794983,\\\"like\\\":0.05500529333949089,\\\"finish\\\":0.0035936038475483656}\"}","recommend_group_id":"7508624486481005630","play_cnt":61289,"book_exist":false,"copyright":"花生短剧","sub_title":"家庭·治愈","score":"8.0","use_video_model":true,"episode_cnt":49,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5001,\"name\":\"家庭\",\"schema\":\"dragon8662://categorySearch?categoryId=5001&categoryName=家庭&genreType=130&gender=2&source=detail\"},{\"category_id\":5116,\"name\":\"治愈\",\"schema\":\"dragon8662://categorySearch?categoryId=5116&categoryName=治愈&genreType=130&gender=2&source=detail\"},{\"category_id\":5047,\"name\":\"家庭伦理\",\"schema\":\"dragon8662://categorySearch?categoryId=5047&categoryName=家庭伦理&genreType=130&gender=2&source=detail\"},{\"cat