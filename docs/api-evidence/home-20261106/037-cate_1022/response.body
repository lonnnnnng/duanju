她斗极品、打猎养家，用灵泉治愈丈夫腿伤。田战腿愈后重返岗位，身世揭开竟是京市林家之子。两人先婚后爱，带着萌娃进京团圆，开启事业与家庭双丰收的幸福生活。","series_id":"7564287256047930393","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233118D72BB875DA1C988BF422\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7564287256047930393\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0015978461597114801,\\\"collect\\\":0.03676946833729744,\\\"normalized_duration\\\":0.716064989566803,\\\"stream_ctr\\\":0.09324474632740021,\\\"staytime_stream\\\":0.9773504137992859,\\\"like\\\":0.05108273774385452,\\\"absolute_staytime\\\":0.09301449358463287}\"}","recommend_group_id":"7564287256047930393","play_cnt":8518,"book_exist":false,"copyright":"tomatotv","sub_title":"爱情·年代爱情","score":"8.2","use_video_model":true,"episode_cnt":59,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5131,\"name\":\"年代爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5131&categoryName=年代爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5054,\"name\":\"萌宝助攻\",\"schema\":\"dragon8662://categorySearch?categoryId=5054&categoryName=萌宝助攻&genreType=130&gender=0&source=detail\"},{\"category_id\":5092,\"name\":\"故人重逢\",\"schema\":\"dragon8662://categorySearch?categoryId=5092&categoryName=故人重逢&genreType=130&gender=0&source=detail\"},{\"category_id\":5097,\"name\":\"闪婚\",\"schema\":\"dragon8662://categorySearch?categoryId=5097&categoryName=闪婚&genreType=130&gender=0&source=detail\"},{\"category_id\":5095,\"name\":\"先婚后爱\",\"schema\":\"dragon8662://categorySearch?categoryId=5095&categoryName=先婚后爱&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreT