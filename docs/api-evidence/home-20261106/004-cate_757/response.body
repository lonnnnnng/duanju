lk3s=ae45642e&x-expires=1799163015&x-signature=yHx2n%2BCv909D6BFJlNjz4xjKUhU%3D","duration":3467,"title":"双生子","video_desc":"生长在双子村的张丽自幼听闻双胞胎宿命传闻，十八岁前夕意外得知父母计划舍弃自己，为保全性命，她与孪生姐姐张婷临时互换身份，在郊外出游时命运发生转折。此后张丽顶着姐姐的身份求学生活，凭借优异成绩收获名校录取通知，却接连被母亲试探提防。成年后张丽与爱人小天成婚，诞下一对双胞胎儿子。因姥姥离世，一家人重返故乡双子村，接连撞见村中诡异习俗。顺着层层线索探寻，众人戳破流传百年的诅咒谣言，揭露村长的阴谋。","series_id":"7647463733144325144","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623301356DE9EDE5397B68BD521\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7647463733144325144\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.0427221953868866,\\\"normalized_duration\\\":0.6635465621948242,\\\"stream_ctr\\\":0.022222356870770454,\\\"like\\\":0.06954174488782883,\\\"absolute_staytime\\\":0.14294256269931793,\\\"staytime_stream\\\":1.2757049798965454,\\\"finish\\\":0.03210071101784706}\"}","recommend_group_id":"7647463733144325144","play_cnt":281594,"book_exist":false,"copyright":"源水短剧","sub_title":"悬疑·悬疑情感","score":"8.1","use_video_model":true,"episode_cnt":30,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5004,\"name\":\"悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5004&categoryName=悬疑&genreType=130&gender=0&source=detail\"},{\"category_id\":5056,\"name\":\"悬疑情感\",\"schema\":\"dragon8662://categorySearch?categoryId=5056&categoryName=悬疑情感&genreType=130&gender=0&source=detail\"},{\"category_id\":5059,\"name\":\"民俗悬疑\",\"schema\":\"dragon8662://categorySearch?categoryId=5059&categoryName=民俗悬疑&genreType=130&gender=0&source=detail\"},{\"category_id\":5180,\"name\":\"反转\",\"schema\":\"dragon8662://categorySearch?categoryId=5180&categoryName=反转&genreType=130&gender=0&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5254&categoryName=揭露阴谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5338,\"name