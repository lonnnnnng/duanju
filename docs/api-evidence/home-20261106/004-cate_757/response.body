1572889","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/844a67b760c1b97de9d14344b74fc00b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163015&x-signature=WplOGb1YOwMtr30aqU0PmUNLvVY%3D","duration":12272,"title":"盛夏芬德拉","video_desc":"自由摄影师白清枚被迫与亨泰总裁周晟安订婚，她抗拒并立“约法三章”，暗嫌他无趣。周晟安以拎鞋、煮红糖水等细致包容渐暖其心，情愫渐生。但白清枚因家族阴影与对“开放式关系”的恐惧，误认其包容为不爱而退婚。遇张九刓轻薄，周晟安出手相护并追至京北求婚。经波折，白清枚终走出阴影，拥抱深情，盛夏芬德拉为二人绽放。改编自番茄小说《深情诱引》 作者：鸟松米。","series_id":"7550544718799588376","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623301356DE9EDE5397B68BD521\",\"rank\":\"6\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7550544718799588376\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.06278920918703079,\\\"staytime_stream\\\":1.3759489059448242,\\\"absolute_staytime\\\":0.14406366646289825,\\\"normalized_duration\\\":0.7460454702377319,\\\"stream_ctr\\\":0.016485245898365974,\\\"like\\\":0.06465348601341248,\\\"finish\\\":0.0015978461597114801}\"}","recommend_group_id":"7550544718799588376","play_cnt":5410254,"book_exist":false,"copyright":"星链无限","sub_title":"爱情·都市爱情","score":"8.0","use_video_model":true,"episode_cnt":82,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5061,\"name\":\"都市爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5061&categoryName=都市爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5095,\"name\":\"先婚后爱\",\"schema\":\"dragon8662://categorySearch?categoryId=5095&categoryName=先婚后爱&genreType=130&gender=0&source=detail\"},{\"category_id\":5096,\"name\":\"商业联姻\",\"schema\":\"dragon8662://categorySearch?categoryId=5096&categoryName=商业联姻&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dra