，早已命中注定。","series_id":"7582510168395500569","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233116A76E35715757208C626C\",\"rank\":\"7\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7582510168395500569\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.05184546485543251,\\\"staytime_stream\\\":1.1650593280792236,\\\"finish\\\":0.0010322309099137783,\\\"collect\\\":0.039048295468091965,\\\"normalized_duration\\\":0.7245057225227356,\\\"absolute_staytime\\\":0.11045744270086288,\\\"stream_ctr\\\":0.0486171655356884}\"}","recommend_group_id":"7582510168395500569","play_cnt":723095,"book_exist":false,"copyright":"短剧版权5254800799","sub_title":"爱情·奇幻爱情","score":"8.1","use_video_model":true,"episode_cnt":77,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&source=detail\"},{\"category_id\":5280,\"name\":\"欢喜冤家\",\"schema\":\"dragon8662://categorySearch?categoryId=5280&categoryName=欢喜冤家&genreType=130&gender=0&source=detail\"},{\"category_id\":5312,\"name\":\"架空\",\"schema\":\"dragon8662://categorySearch?categoryId=5312&categoryName=架空&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#402010"