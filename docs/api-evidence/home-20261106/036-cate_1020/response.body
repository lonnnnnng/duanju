"vid":"7493091464356842521","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/763143e4b5b9bd9d227d12995b8cca61~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163077&x-signature=dabFDYGcO%2FLu8UWJgLsNVWdmHB8%3D","duration":7882,"title":"柔情许你","video_desc":"父母偏心养妹，丈夫移情别恋，儿子也想换妈妈，向晴心死之后答应系统要求，三天后换身份重生。刚醒来，她便被前夫的死对头霍家大少爷强势求婚。素不相识的霍少却清楚她所有的喜好，还总是帮她撑腰，打脸前夫和家人，她心中越来越疑惑，本以为自己只是替身，最后却发现原来她是霍少的白月光。","series_id":"7493078215880084504","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233116A76E35715757208C626C\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7493078215880084504\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.03161877393722534,\\\"normalized_duration\\\":0.7533667683601379,\\\"absolute_staytime\\\":0.1194329634308815,\\\"finish\\\":0.0017546142917126417,\\\"stream_ctr\\\":0.04549708589911461,\\\"like\\\":0.05500529333949089,\\\"staytime_stream\\\":1.2432762384414673}\"}","recommend_group_id":"7493078215880084504","play_cnt":195299,"book_exist":false,"copyright":"百川中文","sub_title":"成长·女性成长","score":"8.2","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5010,\"name\":\"成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5010&categoryName=成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5128,\"name\":\"重生\",\"schema\":\"dragon8662://categorySearch?categoryId=5128&categoryName=重生&genreType=130&gender=0&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?c