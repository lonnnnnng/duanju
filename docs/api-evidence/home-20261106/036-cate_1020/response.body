d":"7560590107812564030","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/f4f3d68da6dfabf737606ea10414c9cc~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163077&x-signature=0tta2PAo3GI4mPz%2BFqBO%2FxwkhGo%3D","duration":6133,"title":"请回答1937","video_desc":"女大学生陈念初在张园探寻曾祖父陈云祥失踪之谜时，手机意外坠入1937年，被张彦卿拾得。她假称未来人寻亲借助手机与张彦卿建立联系。日军轰炸时，陈念初预警，张彦卿救下全家后协助她找到陈云祥。陈云祥赴前线前托张彦卿埋下绝笔信。百年后陈念初挖信正名，张彦卿却早已牺牲。当她补入照片时，转身遇见与他神似的男子，隔世约定终得圆满。","series_id":"7560588131834006553","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233116A76E35715757208C626C\",\"rank\":\"9\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7560588131834006553\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":0.9500355124473572,\\\"finish\\\":0.002714984817430377,\\\"collect\\\":0.040845710784196854,\\\"stream_ctr\\\":0.04937127232551575,\\\"like\\\":0.05184546485543251,\\\"absolute_staytime\\\":0.10057263821363449,\\\"normalized_duration\\\":0.7022150158882141}\"}","recommend_group_id":"7560588131834006553","play_cnt":93086,"book_exist":false,"copyright":"影谭北京","sub_title":"爱情·奇幻爱情","score":"8.2","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5124,\"name\":\"时空对话\",\"schema\":\"dragon8662://categorySearch?categoryId=5124&categoryName=时空对话&genreType=130&gender=0&source=detail\"},{\"category_id\":5115,\"name\":\"甜虐交织\",\"schema\":\"dragon8662://categorySearch?categoryId=5115&categoryName=甜虐交织&genreType=130&gender=0&source=detail\"},{\"category_id\":5226,\"name\":\"忠诚男主\",\"schema\"