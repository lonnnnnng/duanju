b9588c9014e92080~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163077&x-signature=dRrzuAemtAUYqS6ORjJXGrsuBqs%3D","duration":6138,"title":"你好许姣姣","video_desc":"80 年代物资匮乏，原身许姣姣被重男轻女的养父母逼迫嫁人，只为换肉给弟弟吃。原身坚决反抗，却被养父母断粮活活饿死，现代许姣姣就此穿越而来，还意外随身携带一个万能代购群。凭借这个代购群，许姣姣结识了供销社主任宗凛，主动帮供销社解决了运输难题，随后就地创业，将现代外卖模式搬到 80 年代，大获成功。她狠狠打脸了偏心的养父母，同时与宗凛在相处中渐生情愫，最终携手走进了幸福的婚姻。","series_id":"7470055035905264665","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233116A76E35715757208C626C\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7470055035905264665\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.002472623949870467,\\\"collect\\\":0.029760098084807396,\\\"normalized_duration\\\":0.6899792551994324,\\\"stream_ctr\\\":0.05390053987503052,\\\"like\\\":0.0446808747947216,\\\"absolute_staytime\\\":0.0846906527876854,\\\"staytime_stream\\\":0.8805351853370667}\"}","recommend_group_id":"7470055035905264665","play_cnt":28692,"book_exist":false,"copyright":"树下的椰子","sub_title":"逆袭·女性成长","score":"8.0","use_video_model":true,"episode_cnt":57,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5260,\"name\":\"大女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5260&categoryName=大女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5350,\"name\":\"情感觉醒\",\"schema\":\"dragon8662://categorySearch?categoryId=5350&categoryName=情感觉醒&genreType=130&gender=0&source=detail\"}]","color_dominate":"#481010","horiz_cover":"","sub_title_list":[{"content":"逆袭","data_type":3},{"content":"1364万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"逆袭\",\"data_type\":3},{\"content\":\"1364万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7468561010857610264","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/2884e9b580aad395dbc73beb7de9491e~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163077&x-signature=kEa55M6fyh%2FYqdTf3COH6HTiudg%3D","duration":7753,"title":"她来自蔚蓝深处","video_desc":"在浩渺大海孤独漂泊许久的人鱼公主，某次上岸躲避风暴时，邂逅了为逃婚而慌乱奔逃的胖姑娘田秀秀。机缘巧合之下，人鱼公主化用田秀秀之名，与船舶厂坚毅的工人许铮开启了婚后生活。只是初涉人间情感的她懵懵懂懂，尚不明白爱究竟是什么，单纯地以为亲密的索吻便是爱的表达。","series_id":"7468522923188309016","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233116A76E35715757208C626C\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7468522923188309016\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.030675802379846573,\\\"normalized_duration\\\":0.7022150158882141,\\\"stream_ctr\\\":0.046206675469875336,\\\"staytime_stream\\\":0.90593022108078,\\\"finish\\\":0.0012065895134583116,\\\"like\\\":0.046724967658519745,\\\"absolute_staytime\\\":0.08081239461898804}\"}","recommend_group_id":"7468522923188309016","play_cnt":36331,"book_exist":false,"copyright":"吾里短剧","sub_title":"爱情·奇幻爱情","score":"8.1","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5250,\"name\":\"直爽女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5250&categoryName=直爽女主&genreType=130&gender=0&source=detail\"}]","color_dominate":"#482818","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"1412万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"爱情\",\"data_type\":3},{\"content\":\"1412万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7704731448112057368","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/be177738d048e22884513a9b63d3ee07~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163077&x-signature=RsUr7yIAXqhZH4%2FXWYD3IgxQ2r4%3D","duration":2208,"title":"蛟龙守乡","video_desc":"石怀宁本是被苏知予幼时救下的花斑狸精，遭难后被石守直、温桂婆夫妇收养。为求迎娶苏知予，他依苏景垣的考验，凭自身本事修好危桥、盖起新房、改良大片盐碱地。苏知予看中他本心良善，不因他的异类身份退缩。婚后村里新田缺水，他带领乡亲合力开凿水渠，让田地得以灌溉。后来山洪暴发，石怀宁舍身疏导洪水保护村庄，失联许久，历经波折，最终平安归来，和苏知予在桥头重逢，相守相伴，和一村人安稳度日。","series_id":"7704729894059527230","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233116A76E35715757208C626C\",\"rank\":\"5\",\"queue_names\":\"aigc\",\"final_queue_name\":\"aigc\",\"gid\":\"7704729894059527230\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.6558160185813904,\\\"stream_ctr\\\":0.06265119463205338,\\\"absolute_staytime\\\":0.12913784384727478,\\\"finish\\\":0.09138210117816925,\\\"like\\\":0.049589015543460846,\\\"staytime_stream\\\":1.1379518508911133,\\\"collect\\\":0.0446808747947216}\"}","recommend_group_id":"7704729894059527230","play_cnt":998,"book_exist":false,"copyright":"厦门素屿沐文化传媒有限公司","sub_title":"奇幻·更新至42集","score":"8.4","use_video_model":true,"episode_cnt":42,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5477,\"name\":\"奇幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5477&categoryName=奇幻&genreType=130&gender=1&source=detail\"},{\"category_id\":5496,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5496&categoryName=