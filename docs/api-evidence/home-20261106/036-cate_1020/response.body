{"data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7491945203176066110","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/c65e64c43d08714f5d5f964cab333c0c~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163077&x-signature=jrE1w4U65wSpveMt8BQSHOwyJtU%3D","duration":7472,"title":"花间喜事昭月归","video_desc":"小道士昭瑜在山上清修多年灵力毫无长进，被师傅踹下了山，临走前他赠与一颗种子，告诉她找到真爱，修为就会大涨。结果种子被慕岑误打误撞吞下，还因此直接得了个娃？！生孩子，上哪去讲道理！嬉笑打闹中，命运的齿轮徐徐推进，慕岑注定要死在某个月黑风高的晚上。人人都劝她放弃，爱意随风起，她说，她偏要勉强。","series_id":"7491889448867613721","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233116A76E35715757208C626C\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7491889448867613721\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.08208499848842621,\\\"collect\\\":0.02843603305518627,\\\"finish\\\":0.0009697522036731243,\\\"normalized_duration\\\":0.7188675403594971,\\\"stream_ctr\\\":0.07760116457939148,\\\"like\\\":0.04535258188843727,\\\"staytime_stream\\\":0.9257510900497437}\"}","recommend_group_id":"7491889448867613721","play_cnt":38283,"book_exist":false,"copyright":"花生短剧","sub_title":"爱情·奇幻爱情","score":"8.0","use_video_model":true,"episode_cnt":59,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5062,\"name\":\"奇幻爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5062&categoryName=奇幻爱情&genreType=130&gender