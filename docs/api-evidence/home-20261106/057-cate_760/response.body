定叛乱的重要力量。","series_id":"7414025295927184446","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233155A61B36F989B59F9A7F14\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7414025295927184446\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0026316738221794367,\\\"collect\\\":0.03514484688639641,\\\"absolute_staytime\\\":0.1175813376903534,\\\"normalized_duration\\\":0.7772811651229858,\\\"staytime_stream\\\":1.308458685874939,\\\"stream_ctr\\\":0.038080181926488876,\\\"like\\\":0.05665243789553642}\"}","recommend_group_id":"7414025295927184446","play_cnt":89283,"book_exist":false,"copyright":"顶好剧场","sub_title":"古装·治愈","score":"8.1","use_video_model":true,"episode_cnt":91,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=0&source=detail\"},{\"category_id\":5116,\"name\":\"治愈\",\"schema\":\"dragon8662://categorySearch?categoryId=5116&categoryName=治愈&genreType=130&gender=0&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5244,\"name\":\"小人物\",\"schema\":\"dragon8662://categorySearch?categoryId=5244&categoryName=小人物&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#301810","horiz_cover":"","sub_title_list":[{"content":"古装","data_type":3},{"content":"3208万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":