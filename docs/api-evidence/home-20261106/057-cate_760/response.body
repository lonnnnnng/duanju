{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7606572567469493310","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/5009bde1d287341a80549f1f48788ede~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163117&x-signature=WwlWmOzgMVAARwu9y8JeZM%2F44xc%3D","duration":10915,"title":"榜下捉婿","video_desc":"为逃避“克妻”世子的婚约，将军之女黎婉铭当街抢亲，却错绑了病弱书生程立青。两人假成亲，约定十日后和离。黎婉铭不知，她捡回的“软饭夫君”，正是那位传闻中的“阎王世子”萧靖南。自此，鸡飞狗跳的契约生活开启，智斗刻薄亲戚，笑对伪装成补丁农户上门认亲的戏精公婆（宁王夫妇）。在联手创业、共抗危机的闹腾日常中，假戏悄然成真。当世子马甲摇摇欲坠，这对欢喜冤家必须决定，是将错就错，还是将这场荒唐闹剧结束。","series_id":"7606570659761638424","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233155A61B36F989B59F9A7F14\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7606570659761638424\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.033589500933885574,\\\"staytime_stream\\\":1.144608974456787,\\\"absolute_staytime\\\":0.11045744270086288,\\\"normalized_duration\\\":0.7489653825759888,\\\"stream_ctr\\\":0.03499883785843849,\\\"like\\\":0.05184546485543251,\\\"finish\\\":0.0011335690505802631}\"}","recommend_group_id":"7606570659761638424","play_cnt":476339,"book_exist":false,"copyright":"硕才短剧","sub_title":"爱情·古风爱情","score":"8.1","use_video_model":true,"episode_cnt":82,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"d