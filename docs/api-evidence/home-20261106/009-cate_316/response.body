//categorySearch?categoryId=5178&categoryName=逆风翻盘&genreType=130&gender=1&source=detail\"},{\"category_id\":5224,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5224&categoryName=大男主&genreType=130&gender=1&source=detail\"}]","color_dominate":"#381810","horiz_cover":"","sub_title_list":[{"content":"古装","data_type":3},{"content":"1993万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"古装\",\"data_type\":3},{\"content\":\"1993万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7700864561875799065","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/5ecb5c8561ac42a64a350d280914e104~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163024&x-signature=fHuOjyvZnReWOQPFele%2FMOTcFzQ%3D","duration":4656,"title":"鱼缸里到底有什么","video_desc":"全职主妇温宁发现，丈夫沈嘉树每晚对着鱼缸坐两小时，声称养鱼静心。闺蜜苏晴来家喂鱼后突然惊恐，要求报警，随即跑出家门坠江身亡，死前攥着温宁儿子捏的橡皮泥小鱼。温宁在警方调查中撬开鱼缸底座暗格，内有屏幕和耳机孔——他看的从来不是鱼，而是监控画面。顺藤摸瓜，她查到植物人林晚！那才是沈嘉树的合法妻子，也是江景房产权人。而苏晴死前攥着的那条橡皮泥小鱼，正指向一个被隐瞒多年的真相。","series_id":"7700862621431385113","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623302300CA3F294775F299F681\",\"rank\":\"5\",\"queue_name