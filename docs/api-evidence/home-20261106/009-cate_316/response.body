ason_list":"{\"sub_title_list\":[{\"content\":\"4801万\",\"data_type\":27,\"rec_icon_url\":\"https://lf3-reading.fqnovelstatic.com/obj/novel-common/img_hot_value_flame_icon.png\",\"rec_icon_url_dark\":\"https://lf3-reading.fqnovelstatic.com/obj/novel-common/img_hot_value_flame_dark_icon.png\"},{\"content\":\"灾难\",\"data_type\":3}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7691685523022171160","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/6f63ae77e40dbe1c291202b9cffcdf4b~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163024&x-signature=64PdZLDp3U8LdvXjPd37fYLoHDk%3D","duration":8537,"title":"技能一块钱升一级，请叫我SSS级法神","video_desc":"穿越到职业觉醒世界的萧凡，觉醒低阶法师职业，惨遭女友柳如烟分手、队友排挤。原本他的系统需要一万块才能提升一级技能，意外获得补偿删掉一字，变为一块钱升一级。手握氪金系统的萧凡，孤身挑战高难度九层妖塔，一路碾压闯关，打脸轻视他的旧队友。出城历练后，萧凡遭遇邪恶组织灭灵会成员偷袭，依靠氪金强化的保命装备死里逃生，反杀敌人。单刷变异蚁巢副本集齐传说套装，等级达到转职门槛，前往转职神殿，新的较量就此拉开。","series_id":"7691647607470312473","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623302300CA3F294775F299F681\",\"rank\":\"7\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7691647607470312473\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.193858861923