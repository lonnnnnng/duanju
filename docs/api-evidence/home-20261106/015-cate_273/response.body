{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7671977925326949400","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/3edbd9c6ab15ebff3fd0853ec74a4f27~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163036&x-signature=rfbbppUfBSPJkCA9FPW2HCnSObs%3D","duration":9260,"title":"持械入宋：第一季","video_desc":"宋末年，烽火连天。一支执行任务的现代五人小队，意外坠入时空隧道，全员携械穿越到大宋。队长林昭京片子冷静果决，统帅全局。狙击手谢长风、军械师马振邦-一口东北大碴子，战力拉满。通信兵王浩川-广东仔，情报组网，眼观六路。湘妹子医官陈素--妙手回春，战地玫瑰。以现代人的视角看大宋，这将是一场现代与古代的文化冲突，将是一场科技的降维碾压。大宋注定将不再平凡。","series_id":"7671966197985856536","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623303567D3A970635301A51F3A\",\"rank\":\"1\",\"queue_names\":\"aigc,shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7671966197985856536\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.19385886192321777,\\\"staytime_stream\\\":1.5022238492965698,\\\"finish\\\":0.0033766126725822687,\\\"normalized_duration\\\":0.7926116585731506,\\\"stream_ctr\\\":0.057125773280858994,\\\"collect\\\":0.10087861120700836,\\\"like\\\":0.06371499598026276}\"}","recommend_group_id":"7671966197985856536","play_cnt":16108339,"book_exist":false,"copyright":"瑾叶剧场","sub_title":"古装·全100集","score":"8.3","use_video_model":true,"episode_cnt":100,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5475,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5475&categoryName=古装&genreType=130&gender=2&source=detail\"},{\"category_id\":5682,\"name\":\"穿越\",\"schema\":\"dragon8662://