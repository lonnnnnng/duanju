e":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7486023054338837529","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/fbfbdfd9adb320f69131ed377d9309a1~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163036&x-signature=ejabzS41Q6HsFMI03Pj76jT7hsg%3D","duration":7434,"title":"我儿扶我青云志","video_desc":"牧良穿越异界，初来乍到便遭美女锦衣卫以造反罪名相逼，他凭现代知识揭穿阴谋，却仍陷危机，老爹以命根子为赌，与锦衣卫定下击溃匈奴之约。牧良古今穿越，智败匈奴，赢美女心，后太傅发难，牧良再施妙计，除之后快。三国来犯，牧良以现代武器克敌，战功赫赫，终娶女帝，权倾天下，古今无双。","series_id":"7485962563751005246","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623303567D3A970635301A51F3A\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7485962563751005246\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.05184546485543251,\\\"normalized_duration\\\":0.6981125473976135,\\\"staytime_stream\\\":1.1074079275131226,\\\"finish\\\":0.001064963056705892,\\\"collect\\\":0.0378924235701561,\\\"absolute_staytime\\\":0.10705902427434921,\\\"stream_ctr\\\":0.061742786318063736}\"}","recommend_group_id":"7485962563751005246","play_cnt":27722,"book_exist":false,"copyright":"容量短剧","sub_title":"古装·古装传奇","score":"8.3","use_video_model":true,"episode_cnt":62,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5139,\"name\":\"古装传奇\",\"schema\":\"dragon8662://categorySearch?categoryId=5139&categoryName=古装传奇&genreType=130&gender=1&source=detail\"},{\"category_id\":5074,\