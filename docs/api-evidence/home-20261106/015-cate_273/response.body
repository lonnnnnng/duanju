7","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/22c0c2117ad7095523c824d8710986c2~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163036&x-signature=HLK%2BnXQgmM59Nz4C82BQN5FZUFE%3D","duration":3903,"title":"狐泪成珠，一黑一白辨人心","video_desc":"猎户贺长山在黑石岭救下一只会说人话的三尾白狐。谁也没想到，灵狐的一滴眼泪，竟能化成价值不菲的珠子。第一颗，是它心甘情愿报恩送的；可有了第一颗，人心就开始变了。夫妻俩从“再要一颗”，到“最后一次”，一步步把恩情变成索取。白珠越来越少，黑珠越来越多，直到所有珠子一夜腐裂，猎夹也反咬主人。等三尾灵狐再次公开现身，众人才明白，珠子有黑白，人心也有。真正属于你的福，靠抢，是留不住的。","series_id":"7684289302301264921","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623303567D3A970635301A51F3A\",\"rank\":\"6\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7684289302301264921\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.025957362726330757,\\\"like\\\":0.06465348601341248,\\\"absolute_staytime\\\":0.20158131420612335,\\\"stream_ctr\\\":0.04069133475422859,\\\"staytime_stream\\\":1.676288366317749,\\\"collect\\\":0.049589015543460846,\\\"normalized_duration\\\":0.7980484962463379}\"}","recommend_group_id":"7684289302301264921","play_cnt":288762,"book_exist":false,"copyright":"麒麟创作","sub_title":"志怪·全62集","score":"8.1","use_video_model":true,"episode_cnt":62,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5955,\"name\":\"志怪\",\"schema\":\"dragon8662://categorySearch?categoryId=5955&categoryName=志怪&genreType=130&gender=2&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=2&source=detail\"},{\"category_id\":5956,\"name\":\"民俗志怪\",\"schema\":\"dragon8662://categorySearch?categoryId=5956&categoryName=民俗志怪&genreType=130&gender=2&source=detail\"},{\"category_id\":6146,\"name\":\"人性寓言\",\"schema\":\"dragon8662://categorySearch?categoryId=6146&categoryName=人性寓言&genreType=130&gender=2&source=detail\"},{\"category_id\":6081,\"name\":\"报恩\",\"schema\":\"dragon8662://categorySearch?categoryId=6081&categoryName=报恩&genreType=130&gender=2&source=detail\"},{\"category_id\":6233,\"name\":\"神怪\",\"schema\":\"dragon8662://categorySearch?categoryId=6233&categoryName=神怪&genreType=130&gender=2&source=detail\"},{\"category_id\":6181,\"name\":\"小人物\",\"schema\":\"dragon8662://categorySearch?categoryId=6181&categoryName=小人物&genreType=130&gender=2&source=detail\"},{\"category_id\":6282,\"name\":\"乡村\",\"schema\":\"dragon8662://categorySearch?categoryId=6282&categoryName=乡村&genreType=130&gender=2&source=detail\"},{\"category_id\":6275,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=6275&categoryName=古代&genreType=130&gender=2&source=detail\"}]","color_dominate":"#a09898","horiz_cover":"","sub_title_list":[{"content":"3745万","data_type":27,"rec_icon_url":"https://lf3-reading.fqnovelstatic.com/obj/novel-common/img_hot_value_flame_icon.png","rec_icon_url_dark":"https://lf3-reading.fqnovelstatic.com/obj/novel-common/img_hot_value_flame_dark_icon.png"},{"content":"志怪","data_type":3}],"pay_info":{},"support_listen":true,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"3745万\",\"data_type\":27,\"rec_icon_url\":\"https://lf3-reading.fqnovelstatic.com/obj/novel-common/img_hot_value_flame_icon.png\",\"rec_icon_url_dark\":\"https://lf3-reading.fqnovelstatic.com/obj/novel-common/img_hot_value_flame_dark_icon.png\"},{\"content\":\"志怪\",\"data_type\":3}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7666716007511100440","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/e93b56196e8421b36d1566746891c34c~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163036&x-signature=6V0ALX2yb%2F03cF5Gcqp19gbMFsA%3D","duration":2646,"title":"我助关羽麦城突围，全营都跪了","video_desc":"现代青年意外穿越为关羽麾下亲卫赵铁柱，恰逢武圣困守麦城的生死绝境。熟知三国结局的他，深知走小路突围必遭埋伏殒命，遂冒死强谏。突围途中吴军伏兵骤起，一路损兵折将奔赴上庸，岂料守将刘封惧祸闭门不纳。众人西撤至断桥时遭追兵堵截，关羽孤身断后血战，最终坠河失踪，仅留下青龙偃月刀。数月后，历经九死一生的关羽辗转归蜀，君臣兄弟终得重逢。两年后关羽识破主角穿越身份，主角一梦回归现代，一条短信了结千年三国意难平。","series_id":"7666713793900055577","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"2026110623303567D3A970635301A51F3A\",\"rank\":\"7\",\"queue_names\":\"comics\",\"final_queue_name\":\"comic\",\"gid\":\"7666713793900055577\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"collect\\\":0.04885777458548546,\\\"like\\\":0.050330642610788345,\\\"staytime_stream\\\":1.2090578079223633,\\\"finish\\\":0.07369627058506012,\\\"absolute_staytime\\\":0.1645258665084839,\\\"normalized_duration\\\":0.7287633419036865,\\\"stream_ctr\\\":0.0458015538752079}\"}","recommend_group_id":"7666713793900055577","play_cnt":24704,"book_exist":false,"copyright":"赴梦文化","sub_title":"冒险·全30集","score":"8.2","use_video_model":true,"episode_cnt":30,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":6003,\"name\":\"冒险\",\"schema\":\"dragon8662://categorySearch?categoryId=6003&categoryName=冒险&genreType=130&gender=1&source=detail\"},{\"category_id\":5415,\"name\":\"3D\",\"schema\":\"dragon8662://categorySearch?categoryId=5415&categoryName=3D&genreType=130&gender=1&source=detail\"},{\"category_id\":5963,\"name\":\"古装传奇\",\"schema\":\"dragon8662://categorySearch?categoryId=5963&categoryName=古装传奇&genr