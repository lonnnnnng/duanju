ide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7571041112677157950","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/3b0900f2a01590c5cb1f848d849d8833~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163048&x-signature=tayPG66UFZ3pdtvtqCWiRp1nYLA%3D","duration":9484,"title":"神医傻妃名动天下","video_desc":"天生痴傻的相府嫡女云青瑶，被赐婚给人人惧怕的貌丑鬼王萧炎。一个恶鬼，一个傻女，天生一对？可有一天人们发现，那痴傻的王妃是神医，而掌控天下的王者，是那容貌奇丑的鬼王。曾经你笑的声有多大，今天哭的声就有多大！鬼王萧炎对天下人道，“谁动我的王妃，我诛他九族！”","series_id":"7571039752728611864","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233046989066B685D966B07478\",\"rank\":\"5\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7571039752728611864\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.4046823978424072,\\\"absolute_staytime\\\":0.17513687908649445,\\\"collect\\\":0.04401865601539612,\\\"like\\\":0.06097517907619476,\\\"finish\\\":0.0014103589346632361,\\\"normalized_duration\\\":0.7637373805046082,\\\"stream_ctr\\\":0.03266578167676926}\"}","recommend_group_id":"7571039752728611864","play_cnt":235904,"book_exist":false,"copyright":"含香言情社区","sub_title":"爱情·古风爱情","score":"8.2","use_video_model":true,"episode_cnt":80,"video_platform":3,"disable_play":false,"category_schema":"[{\"cat