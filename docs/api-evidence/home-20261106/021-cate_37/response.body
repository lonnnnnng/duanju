.fqnovelpic.com/novel-pic/27b697487ed940efc69488853c91906f~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163048&x-signature=oAqkOOBxcz7BOYQzosbl4%2F2p654%3D","duration":5117,"title":"乐神归来，从离婚开始逆袭","video_desc":"叶宁曾为支持妻子李潇潇隐于幕后创作，却在对方登顶天后时被离婚。离婚后他绑定“乐神系统”，以“听叶”之名爆红，并受邀为李潇潇的对手姜涵打造参赛曲。他助力姜涵屡创佳绩，狠狠打脸前妻。随着身份揭晓，叶宁跻身乐坛顶流，不仅赢回尊严，还收获了姜涵的真挚情感。最终，他与姜涵、女儿组成幸福家庭，在音乐领域创下传奇，过上圆满生活。","series_id":"7626630132131712062","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233046989066B685D966B07478\",\"rank\":\"9\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7626630132131712062\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"stream_ctr\\\":0.03158917278051376,\\\"staytime_stream\\\":1.2701972723007202,\\\"absolute_staytime\\\":0.1645258665084839,\\\"collect\\\":0.04023794084787369,\\\"like\\\":0.05921025201678276,\\\"finish\\\":0.006488270126283169,\\\"normalized_duration\\\":0.759275496006012}\"}","recommend_group_id":"7626630132131712062","play_cnt":64428,"book_exist":false,"copyright":"tomatotv","sub_title":"都市·逆袭翻身","score":"8.3","use_video_model":true,"episode_cnt":52,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5022,\"name\":\"都市\",\"schema\":\"dragon8662://categorySearch?categoryId=5022&categoryName=都市&genreType=130&gender=1&source=detail\"},{\"category_id\":5070,\"name\":\"逆袭翻身\",\"schema\":\"dragon8662://categorySearch?categoryId=5070&categoryName=逆袭翻身&genreType=130&gender=1&source=detail\"},{\"category_id\":5123,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5123&categoryName=穿越&genreType=130&gender=1&source=detail\"},{\"category_id\":5130,\"name\":\"系统\",\"schema\":\"dragon8662://categorySearch?categoryId=5130&categoryName=系统&genreType=130&gender=1&source=detail\"},{\"category_id\":5176,\"name\":\"虐渣\",\"schema\":\"dragon8662://categorySearch?categoryId=5176&categoryName=虐渣&g