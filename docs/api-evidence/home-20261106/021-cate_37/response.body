e?lk3s=ae45642e&x-expires=1799163048&x-signature=Z0DtxtiRaGFlMyR1sUnd1cu7ceQ%3D","duration":6113,"title":"拳王入魂我躺赢","video_desc":"世界拳王苏惊鸿意外身亡，醒来竟穿越成了拳击世家之女——体弱内向的林莜。面对父亲离世后虎视眈眈的亲戚、咄咄逼人的家族训练赛，她以拳王之魂爆发出惊人实力，一拳打爆测试仪，震慑全场！然而危机接踵而至，死对头薛剑携三大高手踢馆，拳协新会长竟由北牧国宿敌篡位，林莜以女子之躯，横扫强敌，守护家产，重振大夏拳坛声威！然而世界幕后黑手的浮现，才是一切挑战的开始。","series_id":"7616729115650968601","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233046989066B685D966B07478\",\"rank\":\"2\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7616729115650968601\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.06465348601341248,\\\"finish\\\":0.0028895812574774027,\\\"normalized_duration\\\":0.775764524936676,\\\"stream_ctr\\\":0.03613758459687233,\\\"absolute_staytime\\\":0.1545577496290207,\\\"staytime_stream\\\":1.3810267448425293,\\\"collect\\\":0.0427221953868866}\"}","recommend_group_id":"7616729115650968601","play_cnt":26707,"book_exist":false,"copyright":"河马剧场","sub_title":"逆袭·女性成长","score":"8.2","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5031,\"name\":\"逆袭\",\"schema\":\"dragon8662://categorySearch?categoryId=5031&categoryName=逆袭&genreType=130&gender=0&source=detail\"},{\"category_id\":5045,\"name\":\"女性成长\",\"schema\":\"dragon8662://categorySearch?categoryId=5045&categoryName=女性成长&genreType=130&gender=0&source=detail\"},{\"category_id\":5254,\"name\":\"揭露阴谋\",\"schema\":\"dragon8662://categorySearch?categoryId=5254&categoryName=揭露阴谋&genreType=130&gender=0&source=detail\"},{\"category_id\":5147,\"name\":\"擂台比武\",\"schema\":\"dragon8662://categorySearch?categoryId=5147&categoryName=擂台比武&genreType=130&gender=0&source=detail\"},{\"category_id\":5175,\"name\":\"打脸反派\",\"schema\":\"dragon8662://categorySearch?categoryId=5175&categoryName=打脸反派&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schem