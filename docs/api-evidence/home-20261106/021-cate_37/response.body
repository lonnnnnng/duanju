{"code":0,"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7497192428093328446","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/bf6ee3e3d2cc87435a1506b74366eed8~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163048&x-signature=sty42kXp4vuoc32yAqe05Hxri30%3D","duration":9279,"title":"卷王后宅晋升记","video_desc":"沈薇身为当代卷王，竟意外穿成古代王府里最低等的丫鬟，因被其他原因吓退妻妾的燕王，沈薇却迎难而上开启疯狂内卷模式，花样百出以身引诱，一路内卷上位！等人淡如菊的王妃坐不住的时候已为时过晚，此时燕王已经被沈薇狠狠拿捏！","series_id":"7497081662585441342","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233046989066B685D966B07478\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7497081662585441342\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.3094305992126465,\\\"like\\\":0.06656919419765472,\\\"normalized_duration\\\":0.7373537421226501,\\\"absolute_staytime\\\":0.14406366646289825,\\\"collect\\\":0.046724967658519745,\\\"finish\\\":0.001325022429227829,\\\"stream_ctr\\\":0.08714809268712997}\"}","recommend_group_id":"7497081662585441342","play_cnt":56059,"book_exist":false,"copyright":"震麟文化","sub_title":"爱情·古风爱情","score":"8.3","use_video_model":true,"episode_cnt":81,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=