lse,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7654107737248255038","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/c17c0b3f204d2e61a2beda4f6e42ed21~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163048&x-signature=1v19NWSnRoee3MjHkc9B%2Br7DESA%3D","duration":7442,"title":"冒牌皇帝","video_desc":"现代特工周玄遭队友背叛身亡，穿越到大周王朝，成了太后秦幽兰从邻国绑来、冒充已故皇帝的傀儡太监。朝堂之上，丞相林天中联合兵部尚书王煜逼宫，指证他身份造假。周玄当众斩杀证人立威群臣，又借落水遇刺案撤去丞相侄子林越的禁军右统领之职。林天中提出让女儿林若曦侍寝验身，周玄欣然赴约并反制对方。次日朝堂，他直接册封林若曦为皇贵妃，铁腕化解危机。太后震惊于冒牌货的帝王之气，后宫纷争与朝堂暗战才刚刚拉开序幕。","series_id":"7654105896682802238","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233046989066B685D966B07478\",\"rank\":\"8\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7654105896682802238\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0022518474142998457,\\\"stream_ctr\\\":0.03013705462217331,\\\"collect\\\":0.0427221953868866,\\\"normalized_duration\\\":0.7652305364608765,\\\"staytime_stream\\\":1.4012951850891113,\\\"absolute_staytime\\\":0.17929011583328247,\\\"like\\\":0.05921025201678276}\"}","recommend_group_id":"7654105896682802238","play_cnt":212300,"book_exist":false,"copyright":"河马剧场","sub_title":"古装·朝堂权谋","score":"8.3","use_video_model":true,"episode_cnt":70,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5137,\"name\":\"朝堂权谋\",\"