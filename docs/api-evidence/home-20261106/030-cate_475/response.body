start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7560968888796597310","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/8fd5b701eefcad1d8563bbfa581a8343~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163065&x-signature=jjFxspusz89wfe9ZfpMoLzQZwS8%3D","duration":6637,"title":"荆棘之吻","video_desc":"古董富商宋家遗孤宋怀真，十五年后以家庭教师何茵身份重新归来，进入顾家为当年宋家灭门惨案复仇。顾老爷最受宠的儿子顾鸿生回来参加父亲与新姨太的订婚典礼，意外发现父亲要娶的姨太何茵竟是自己三年前不辞而别的初恋女友。为复仇，何茵不得不在两个男人之间游走，利用他们对自己的感情不断挑拨，实现自己的目的。","series_id":"7560967156880378942","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"20261106233104702EE7EAD81A1788E90A\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7560967156880378942\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"finish\\\":0.0023231622762978077,\\\"collect\\\":0.03461884334683418,\\\"staytime_stream\\\":1.1286317110061646,\\\"normalized_duration\\\":0.7489653825759888,\\\"absolute_staytime\\\":0.10874496400356293,\\\"stream_ctr\\\":0.037638403475284576,\\\"like\\\":0.04535258188843727}\"}","recommend_group_id":"7560967156880378942","play_cnt":171437,"book_exist":false,"copyright":"影谭北京","sub_title":"爱情·女强","score":"8.1","use_video_model":true,"episode_cnt":81,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&source=detail\"},{\"category_id\":5340,\"name\":\"民国\",\"schema\":\"dragon8662://categorySearch?categoryId=5340&categoryName=民国&genreType=130&gender=0&source=detail\"}]","color_dominate":"#301810","horiz_cover":"","sub_title_l