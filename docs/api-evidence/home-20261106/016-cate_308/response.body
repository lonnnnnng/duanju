{"message":"SUCCESS","data":{"tab_index":0,"tab_item":[{"tab_type":8,"client_tab_type":0,"title":"找剧","cell_data":[{"cell_id":6952850996422770718,"show_type":401,"cell_name":"","cell_operation_type":1,"use_recommend":true,"cell_abstract":"","cell_id_str":"6952850996422770718","cell_data":[{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7490462944736594969","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/f15d7a689c880f1781b112d4ee5b5c16~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163038&x-signature=et9kRRnEruice5LRWkyLTvuAfIU%3D","duration":8060,"title":"锦绣凤鸣","video_desc":"前世，沈凤宜一片真心错付。她陪伴穆宁远从王府踏入金銮殿，却因单纯不谙权谋，在波谲云诡的宫斗中一败涂地。被穆宁远无情抛弃后，含恨残死于天牢。或许是老天怜悯她的遭遇，给了沈凤宜重来一次的机会。重生归来，沈凤宜决意不再重蹈覆辙。这一世，她提前十年精心布局，苦练舞蹈与媚术，暗中经营酒楼，悄然编织势力网。这一次，她要断绝恋爱脑，搅乱穆宁远的心，一步步登上凤位，母仪天下。","series_id":"7490420333384567870","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062330370E0699CDC982039309F3\",\"rank\":\"1\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7490420333384567870\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"absolute_staytime\\\":0.16197511553764343,\\\"normalized_duration\\\":0.7772811651229858,\\\"stream_ctr\\\":0.07623584568500519,\\\"collect\\\":0.04208773002028465,\\\"like\\\":0.05921025201678276,\\\"staytime_stream\\\":1.3346284627914429,\\\"finish\\\":0.0028009277302771807}\"}","recommend_group_id":"7490420333384567870","play_cnt":1025812,"book_exist":false,"copyright":"山海星辰","sub_title":"古装·宫斗宅斗","score":"8.0","use_video_model":true,"episode_cnt":60,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5007,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5007&categoryName=古装&genreType=130&gender=0&source=detail\"},{\"category_id\":5136,\"name\":\"宫斗宅斗\",\"schema\":\"dragon8662://categorySearch?categoryId=5136&categoryName=宫斗宅斗&genreType=130&gender=0&source=detail\"},{\"category_id\":5128,\"name\":\"重生\",\"schema\":\"dragon8662://categorySearch?categoryId=5128&categoryName=重生&genreType=130&gender=0&source=detail\"},{\"category_id\":5253,\"name\":\"黑化归来\",\"schema\":\"dragon8662://categorySearch?categoryId=5253&categoryName=黑化归来&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"}]","color_dominate":"#582018","horiz_cover":"","sub_title_list":[{"content":"古装","data_type":3},{"content":"4124万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"古装\",\"data_type\":3},{\"content\":\"4124万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7703916961868041241","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/e11cd60d872a907ffabc711bcf048d15~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163038&x-signature=PDVM14l9fy5dcPp4uBjl9o7%2BBik%3D","duration":9742,"title":"持械入宋：新编","video_desc":"宋末年，烽火连天。一支执行任务的现代五人小队，意外坠入时空隧道，全员携械穿越到大一-口东北大宋。队长林昭一-京片子冷静果决，统帅全局。狙击手谢长风、军械师马振邦-碴子，战力拉满。通信兵王浩川一一广东仔，情报组网，眼观六路。湘妹子医官陈素一一妙手回春，战地玫瑰。以现代人的视角看大宋，这将是一场现代与古代的文化冲突，一场科技的降维碾压。大宋注定将不再平凡。且看他们如何用现代兵器在古代乱世杀出一条活路。","series_id":"7703915059314969625","episode":true,"vertical":false,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062330370E0699CDC982039309F3\",\"rank\":\"2\",\"queue_names\":\"aigc\",\"final_queue_name\":\"heji\",\"gid\":\"7703915059314969625\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"like\\\":0.0446808747947216,\\\"staytime_stream\\\":1.3496968746185303,\\\"stream_ctr\\\":0.07363444566726685,\\\"collect\\\":0.06187598779797554,\\\"absolute_staytime\\\":0.1645258665084839,\\\"finish\\\":0.004331502597779036,\\\"normalized_duration\\\":0.759275496006012}\"}","recommend_group_id":"7703915059314969625","play_cnt":494760,"book_exist":false,"copyright":"广州大动传媒有限公司","sub_title":"古装·全121集","score":"8.0","use_video_model":true,"episode_cnt":121,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5475,\"name\":\"古装\",\"schema\":\"dragon8662://categorySearch?categoryId=5475&categoryName=古装&genreType=130&gender=1&source=detail\"},{\"category_id\":5531,\"name\":\"古装传奇\",\"schema\":\"dragon8662://categorySearch?categoryId=5531&categoryName=古装传奇&genreType=130&gender=1&source=detail\"},{\"category_id\":5682,\"name\":\"穿越\",\"schema\":\"dragon8662://categorySearch?categoryId=5682&categoryName=穿越&genreType=130&gender=1&source=detail\"},{\"category_id\":9409,\"name\":\"热血\",\"schema\":\"dragon8662://categorySearch?categoryId=9409&categoryName=热血&genreType=130&gender=1&source=detail\"},{\"category_id\":5728,\"name\":\"征战\",\"schema\":\"dragon8662://categorySearch?categoryId=5728&categoryName=征战&genreType=130&gender=1&source=detail\"},{\"category_id\":5756,\"name\":\"大男主\",\"schema\":\"dragon8662://categorySearch?categoryId=5756&categoryName=大男主&genreType=130&gender=1&source=detail\"},{\"category_id\":5846,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5846&categoryName=古代&genreT