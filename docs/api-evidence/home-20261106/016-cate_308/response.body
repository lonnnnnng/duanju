l-pic/fccece8fc4bda92a90e8a80506980c72~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163038&x-signature=aJM0tO3juk0GuwzMg2Pss4fILsE%3D","duration":7241,"title":"蔷薇花谢即归来","video_desc":"沈家庶女沈蔷薇因不愿被继母卖给恶霸为妾，带着小妹投奔京城名门之首姨母张氏，惨遭被拒，为求生路，私下里勾引萧晏清，得以以表姑娘的名义留在萧府。白日，两人是恪守礼节的表兄妹，夜里，两人暧昧厮磨。沈蔷薇本想等萧晏清娶妻后便悄然离开，不曾想外表看似克己复礼的萧晏清，内心腹黑偏执，对她满是占有欲，执意要纳她为妾。本剧改编自番茄小说《疯批权臣夺她，是你先勾我的》，作者-笑语晏晏。","series_id":"7510194759202245694","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062330370E0699CDC982039309F3\",\"rank\":\"3\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7510194759202245694\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"staytime_stream\\\":1.2722597122192383,\\\"absolute_staytime\\\":0.14294256269931793,\\\"stream_ctr\\\":0.06115183234214783,\\\"collect\\\":0.04603390023112297,\\\"like\\\":0.0541987344622612,\\\"finish\\\":0.004198795184493065,\\\"normalized_duration\\\":0.812200665473938}\"}","recommend_group_id":"7510194759202245694","play_cnt":626648,"book_exist":false,"copyright":"快创短剧","sub_title":"爱情·古风爱情","score":"8.2","use_video_model":true,"episode_cnt":83,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5000,\"name\":\"爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5000&categoryName=爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5051,\"name\":\"古风爱情\",\"schema\":\"dragon8662://categorySearch?categoryId=5051&categoryName=古风爱情&genreType=130&gender=0&source=detail\"},{\"category_id\":5104,\"name\":\"日久生情\",\"schema\":\"dragon8662://categorySearch?categoryId=5104&categoryName=日久生情&genreType=130&gender=0&source=detail\"},{\"category_id\":5091,\"name\":\"暧昧拉扯\",\"schema\":\"dragon8662://categorySearch?categoryId=5091&categoryName=暧昧拉扯&genreType=130&gender=0&source=detail\"},{\"category_id\":5178,\"name\":\"逆风翻盘\",\"schema\":\"dragon8662://categorySearch?categoryId=5178&categoryName=逆风翻盘&genreType=130&gender=0&source=detail\"},{\"category_id\":5324,\"name\":\"腹黑\",\"schema\":\"dragon8662://categorySearch?categoryId=5324&categoryName=腹黑&genreType=130&gender=0&source=detail\"},{\"category_id\":5319,\"name\":\"世家\",\"schema\":\"dragon8662://categorySearch?categoryId=5319&categoryName=世家&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"dragon8662://categorySearch?categoryId=5339&categoryName=古代&genreType=130&gender=0&source=detail\"},{\"category_id\":5402,\"name\":\"宅斗家斗\",\"schema\":\"dragon8662://categorySearch?categoryId=5402&categoryName=宅斗家斗&genreType=130&gender=0&source=detail\"}]","color_dominate":"#581008","horiz_cover":"","sub_title_list":[{"content":"爱情","data_type":3},{"content":"3935万热度","data_type":27}],"pay_info":{},"support_listen":false,"recommend_reason_list":"{\"sub_title_list\":[{\"content\":\"爱情\",\"data_type\":3},{\"content\":\"3935万热度\",\"data_type\":27}]}"}],"category_tag_ids":null,"style":{"cover_size":0,"interval_type":0,"use_wide_item_space":false,"use_new_booklist_style":false,"with_favorite_button":false,"show_more_book_abstract":false,"candidate_postion":0,"jump_to_page":0,"topic_square_with_book":false,"use_aweme_sdk":false,"use_new_one_to_one_point_four_ratio_style":false,"hide_tab_selector":false,"audio_both_jump_player":false,"show_username":false,"use_selector_v2":false,"video_inner_next_item":0},"group_id_type":9,"cell_long_press_action":{"type":0},"cell_item_source_info":{"item_source":1},"ai_search_placeholder":null,"push_start_info":null,"book_hot_content_data":null},{"cell_id":6952850996422770718,"show_type":402,"cell_name":"小卡","cell_operation_type":0,"use_recommend":false,"video_data":[{"vid":"7510552280135896126","cover":"https://p3-reading-sign.fqnovelpic.com/novel-pic/4c9b22107336168d4892edd861a29dcb~tplv-81nmtwyey9-superreso-aifit:400:0.image?lk3s=ae45642e&x-expires=1799163038&x-signature=dyhAY6WDi%2FmcT37q18mHId4p960%3D","duration":6427,"title":"妖妃她多子多福","video_desc":"墨海棠与姐姐是修炼千年的黑白兔精，姐姐心善，曾为落难公主驱散狼群。岂料公主嚣张跋扈，以皇室独女之尊恩将仇报，将姐姐烤作养颜肉膳。血仇灼心，墨海棠潜入深宫，誓以妖胎颠覆龙脉——她要让兔精化作公主的噩梦，令朱墙内爬满争宠的皇嗣，撕碎唯一的冠冕。","series_id":"7510279466996730942","episode":true,"vertical":true,"content_type":1,"recommend_info":"{\"channel_id\":\"94349560332\",\"request_id\":\"202611062330370E0699CDC982039309F3\",\"rank\":\"4\",\"queue_names\":\"shortplay\",\"final_queue_name\":\"heji\",\"gid\":\"7510279466996730942\",\"plan_id\":\"1\",\"is_show_ad_flag\":\"0\",\"series_pred_score\":\"{\\\"normalized_duration\\\":0.7941612601280212,\\\"stream_ctr\\\":0.04437067732214928,\\\"collect\\\":0.04023794084787369,\\\"like\\\":0.058345843106508255,\\\"staytime_stream\\\":1.3261467218399048,\\\"absolute_staytime\\\":0.1533549726009369,\\\"finish\\\":0.004198795184493065}\"}","recommend_group_id":"7510279466996730942","play_cnt":969530,"book_exist":false,"copyright":"广州林阳文化传媒有限公司","sub_title":"奇幻·奇幻脑洞","score":"8.2","use_video_model":true,"episode_cnt":70,"video_platform":3,"disable_play":false,"category_schema":"[{\"category_id\":5009,\"name\":\"奇幻\",\"schema\":\"dragon8662://categorySearch?categoryId=5009&categoryName=奇幻&genreType=130&gender=0&source=detail\"},{\"category_id\":5074,\"name\":\"奇幻脑洞\",\"schema\":\"dragon8662://categorySearch?categoryId=5074&categoryName=奇幻脑洞&genreType=130&gender=0&source=detail\"},{\"category_id\":5136,\"name\":\"宫斗宅斗\",\"schema\":\"dragon8662://categorySearch?categoryId=5136&categoryName=宫斗宅斗&genreType=130&gender=0&source=detail\"},{\"category_id\":5177,\"name\":\"扮猪吃虎\",\"schema\":\"dragon8662://categorySearch?categoryId=5177&categoryName=扮猪吃虎&genreType=130&gender=0&source=detail\"},{\"category_id\":5221,\"name\":\"女强\",\"schema\":\"dragon8662://categorySearch?categoryId=5221&categoryName=女强&genreType=130&gender=0&source=detail\"},{\"category_id\":5250,\"name\":\"直爽女主\",\"schema\":\"dragon8662://categorySearch?categoryId=5250&categoryName=直爽女主&genreType=130&gender=0&source=detail\"},{\"category_id\":5339,\"name\":\"古代\",\"schema\":\"drago